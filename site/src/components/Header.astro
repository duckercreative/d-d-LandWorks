							<a href="/service-area" class="mt-5 flex items-center gap-1 border-t border-slate-100 pt-4 text-sm font-display font-bold uppercase tracking-wide text-brand-blue hover:text-brand-blue-dark transition-colors">
								View Full Service Area
								<svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
									<path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
								</svg>
							</a>
						</div>
					</div>
				</div>

				<a href="/commercial-excavation" class="text-ink hover:text-brand-blue transition-colors">Commercial</a>
				<a href="/resources" class="text-ink hover:text-brand-blue transition-colors">Resources</a>
				<a href="/blog" class="text-ink hover:text-brand-blue transition-colors">Blog</a>
				<a href="/about" class="text-ink hover:text-brand-blue transition-colors">About</a>
				<a href="/contact" class="text-ink hover:text-brand-blue transition-colors">Contact</a>
			</nav>

			<div class="hidden lg:block border-l border-slate-200 pl-6">

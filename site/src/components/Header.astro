					<p class="font-display font-bold uppercase tracking-wide text-xs text-slate-500 mt-2">Additional Services</p>
					{additionalServices.map((service) => (
						<a href={service.href} class="font-display font-semibold uppercase tracking-wide text-lg text-slate-200 hover:text-brand-blue-light transition-colors">
							{service.label}
						</a>
					))}
					<a href="/services" class="font-display font-bold uppercase tracking-wide text-sm text-brand-blue-light mt-1">View All Services →</a>
				</div>
			</details>

			<details class="border-b border-white/10 group">
				<summary class="font-display font-black uppercase tracking-tight text-4xl text-white py-3 cursor-pointer list-none flex items-center justify-between">
					Service Areas
					<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 shrink-0 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
						<path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
					</svg>
				</summary>
				<div class="pb-4 flex flex-col gap-3">
					<p class="font-display font-bold uppercase tracking-wide text-xs text-brand-blue-light mt-1">Primary Coverage</p>
					{primaryAreas.map((area) => (
						<a href={area.href} class="font-display font-semibold uppercase tracking-wide text-lg text-slate-200 hover:text-brand-blue-light transition-colors">
							{area.label}
						</a>
					))}
					<p class="font-display font-bold uppercase tracking-wide text-xs text-slate-500 mt-2">Also Serving</p>
					{secondaryAreas.map((area) => (
						<a href={area.href} class="font-display font-semibold uppercase tracking-wide text-lg text-slate-200 hover:text-brand-blue-light transition-colors">
							{area.label}
						</a>
					))}
					<p class="font-display font-bold uppercase tracking-wide text-xs text-slate-500 mt-2">Further Out</p>
					{furtherAreas.map((area) => (
						<a href={area.href} class="font-display font-semibold uppercase tracking-wide text-lg text-slate-200 hover:text-brand-blue-light transition-colors">
							{area.label}
						</a>
					))}
					<a href="/service-area" class="font-display font-bold uppercase tracking-wide text-sm text-brand-blue-light mt-1">View Full Service Area →</a>
				</div>
			</details>

			<a href="/commercial-excavation" class="font-display font-black uppercase tracking-tight text-4xl text-white py-3 border-b border-white/10 hover:text-brand-blue transition-colors">
				Commercial
			</a>
			<a href="/resources" class="font-display font-black uppercase tracking-tight text-4xl text-white py-3 border-b border-white/10 hover:text-brand-blue transition-colors">
				Resources
			</a>
			<a href="/blog" class="font-display font-black uppercase tracking-tight text-4xl text-white py-3 border-b border-white/10 hover:text-brand-blue transition-colors">
				Blog
			</a>
			<a href="/about" class="font-display font-black uppercase tracking-tight text-4xl text-white py-3 border-b border-white/10 hover:text-brand-blue transition-colors">
				About

		class="fixed inset-0 z-50 bg-ink lg:hidden opacity-0 pointer-events-none -translate-y-2 overflow-y-auto"
		style="transition: opacity 200ms ease, transform 200ms ease;"
	>
		<div class="mx-auto max-w-6xl px-4 py-6 flex items-center justify-between">
			<img src="/logo.png" alt="D&D Land Works" class="h-12 w-auto" />
			<button type="button" id="menu-close" aria-label="Close menu" class="p-2 -mr-2 text-white">
				<svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
					<path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
				</svg>
			</button>
		</div>
		<nav class="mx-auto max-w-6xl px-4 mt-4 flex flex-col gap-2 pb-10">
			<a href="/" class="font-display font-black uppercase tracking-tight text-4xl text-white py-3 border-b border-white/10 hover:text-brand-blue transition-colors">
				Home
			</a>

			<details class="border-b border-white/10 group">
				<summary class="font-display font-black uppercase tracking-tight text-4xl text-white py-3 cursor-pointer list-none flex items-center justify-between">
					Services
					<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 shrink-0 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
						<path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
					</svg>
				</summary>
				<div class="pb-4 flex flex-col gap-3">
					<p class="font-display font-bold uppercase tracking-wide text-xs text-brand-blue-light mt-1">Core Services</p>
					{coreServices.map((service) => (
						<a href={service.href} class="font-display font-semibold uppercase tracking-wide text-lg text-slate-200 hover:text-brand-blue-light transition-colors">
							{service.label}
						</a>

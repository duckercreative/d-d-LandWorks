---

<!-- Top utility bar: quick contact + social, sits above the sticky nav. Scrolls away on purpose — only the nav below stays pinned. -->
<div class="bg-ink text-white">
	<div class="mx-auto max-w-6xl px-4 py-2 flex items-center justify-between gap-4 text-sm">
		<span class="font-semibold whitespace-nowrap">Licensed &amp; Bonded (CCB #261742)</span>

		<div class="hidden sm:flex items-center gap-2">
			{socialLinks.map((social) => (
				<a
					href={social.href}
					aria-label={social.label}
					class="flex h-7 w-7 items-center justify-center rounded bg-brand-blue text-white hover:bg-brand-blue-dark transition-colors"
				>
					<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="h-3.5 w-3.5 fill-current">
						<path d={social.path} />
					</svg>
				</a>
			))}
		</div>

		<a href="mailto:david@ddlandworks.com" class="hidden sm:inline font-semibold underline underline-offset-2 whitespace-nowrap hover:text-brand-blue-light transition-colors">
			david@ddlandworks.com
		</a>
	</div>
</div>

<!--
	`sticky` lives on <header> itself, not a div nested inside it — a sticky
	element can only stay pinned while its containing block (immediate parent)
	is still in view, and the old wrapper (<header> holding both this bar and
	the utility bar above) was barely taller than its own contents, so it
	scrolled fully out of view after ~44px and dragged the "sticky" bar with
	it. <header>'s real parent is <body>, which spans the whole page, so this
	works for the entire scroll range.
-->
<header class="sticky top-0 z-40 border-b border-slate-200 bg-white shadow-sm">
	<div class="mx-auto max-w-6xl px-4 flex items-center justify-between gap-4 py-3">
			<a href="/" class="shrink-0">
				<img src="/logo.png" alt="D&D Land Works" class="h-12 w-auto md:h-14" />
			</a>

			<nav class="hidden lg:flex items-center gap-6 border-l border-slate-200 pl-6 font-display font-semibold uppercase tracking-wide text-sm">
				<a href="/" class="text-ink hover:text-brand-blue transition-colors">Home</a>

				<div class="group relative">
					<button type="button" class="flex items-center gap-1 text-ink hover:text-brand-blue transition-colors">
						Services
						<svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 transition-transform group-hover:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
							<path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
						</svg>
					</button>
					<div class="invisible absolute left-1/2 top-full -translate-x-1/2 pt-3 opacity-0 transition-all duration-150 group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100">
						<div class="w-[32rem] rounded-(--radius-brand-card) border border-slate-200 bg-white p-6 shadow-lg normal-case tracking-normal">
							<div class="grid grid-cols-2 gap-x-8">
								<div>
									<p class="font-display font-bold uppercase tracking-wide text-xs text-brand-blue mb-3">Core Services</p>
									<ul class="flex flex-col gap-2">
										{coreServices.map((service) => (
											<li><a href={service.href} class="block text-sm font-medium text-ink hover:text-brand-blue transition-colors">{service.label}</a></li>
										))}
									</ul>
								</div>
								<div>
									<p class="font-display font-bold uppercase tracking-wide text-xs text-slate-500 mb-3">Additional Services</p>
									<ul class="flex flex-col gap-2">
										{additionalServices.map((service) => (
											<li><a href={service.href} class="block text-sm font-medium text-ink hover:text-brand-blue transition-colors">{service.label}</a></li>
										))}
									</ul>
								</div>
							</div>
							<a href="/services" class="mt-5 flex items-center gap-1 border-t border-slate-100 pt-4 text-sm font-display font-bold uppercase tracking-wide text-brand-blue hover:text-brand-blue-dark transition-colors">
								View All Services
								<svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
									<path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
								</svg>
							</a>
						</div>
					</div>
				</div>

				<div class="group relative">
					<button type="button" class="flex items-center gap-1 text-ink hover:text-brand-blue transition-colors">
						Service Areas
						<svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 transition-transform group-hover:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
							<path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
						</svg>
					</button>
					<div class="invisible absolute left-1/2 top-full -translate-x-1/2 pt-3 opacity-0 transition-all duration-150 group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100">
						<div class="w-[42rem] rounded-(--radius-brand-card) border border-slate-200 bg-white p-6 shadow-lg normal-case tracking-normal">
							<div class="grid grid-cols-3 gap-x-6">
								<div>
									<p class="font-display font-bold uppercase tracking-wide text-xs text-brand-blue mb-3">Primary Coverage</p>
									<ul class="flex flex-col gap-2">
										{primaryAreas.map((area) => (
											<li><a href={area.href} class="block text-sm font-medium text-ink hover:text-brand-blue transition-colors">{area.label}</a></li>

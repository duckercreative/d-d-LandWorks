---
const coreServices = [
  { label: 'Site Preparation', href: '/site-preparation-contractor-eugene-or' },
  { label: 'Excavation', href: '/excavation-contractor-eugene-or' },
  { label: 'Land Clearing', href: '/land-clearing-services-eugene-or' },
  { label: 'Grading & Leveling', href: '/land-grading-services-eugene-or' },
  { label: 'Septic Install & Repairs', href: '/septic-installation-lane-county-or' },
];

const additionalServices = [
  { label: 'Foundation Excavation', href: '/foundation-excavation-eugene-or' },
  { label: 'Drainage Excavation', href: '/drainage-installation-eugene-or' },
  { label: 'Utility Excavation', href: '/utility-trenching-eugene-or' },
  { label: 'Driveway Repair', href: '/driveway-excavation-grading-eugene-or' },
  { label: 'Trenching & Backfill', href: '/trenching-services-eugene-or' },
  { label: 'Brush Clearing', href: '/brush-clearing-eugene-or' },
  { label: 'Slope Stabilization', href: '/slope-stabilization-eugene-or' },
];

const primaryAreas = [
  { label: 'Lane County, OR (all areas)', href: '/service-area' },
  { label: 'Eugene, OR', href: '/excavation-contractor-eugene-or' },
  { label: 'Springfield, OR', href: '/excavation-contractor-springfield-or' },
];

const secondaryAreas = [
  { label: 'Cottage Grove, OR', href: '/excavation-contractor-cottage-grove-or' },
  { label: 'Junction City, OR', href: '/excavation-contractor-junction-city-or' },
  { label: 'Creswell, OR', href: '/excavation-contractor-creswell-or' },
  { label: 'Veneta, OR', href: '/excavation-contractor-veneta-or' },
];

const furtherAreas = [
  { label: 'Florence, OR', href: '/excavation-contractor-florence-or' },
  { label: 'Oakridge, OR', href: '/locations/oakridge' },
  { label: 'Coburg, OR', href: '/excavation-contractor-coburg-or' },
  { label: 'Lowell, OR', href: '/excavation-contractor-lowell-or' },
];
---

<!-- Utility bar: credentials + contact, scrolls away -->
<div class="bg-ink-deep text-white/70 text-xs font-body">
  <div class="mx-auto max-w-6xl px-4 py-2 flex items-center justify-between gap-4">
    <div class="flex items-center gap-4">
      <span class="font-semibold text-white whitespace-nowrap">CCB #261742</span>
      <span class="hidden sm:inline text-white/40">·</span>
      <span class="hidden sm:inline whitespace-nowrap">Licensed &amp; Bonded</span>
      <span class="hidden md:inline text-white/40">·</span>
      <span class="hidden md:inline whitespace-nowrap">DEQ Certified Septic</span>
    </div>
    <div class="hidden sm:flex items-center gap-4">
      <a href="mailto:david@ddlandworks.com" class="hover:text-white transition-colors whitespace-nowrap">
        david@ddlandworks.com
      </a>
      <span class="text-white/40">·</span>
      <span class="whitespace-nowrap">Mon–Sat &nbsp;7am–6pm</span>
    </div>
  </div>
</div>

<!-- Sticky nav -->
<header class="sticky top-0 z-40 bg-white border-b border-slate-200 shadow-sm">
  <div class="mx-auto max-w-6xl px-4 flex items-center justify-between gap-4 py-3">

    <a href="/" class="shrink-0">
      <img src="/logo.png" alt="D&D Land Works" class="h-11 w-auto md:h-13" />
    </a>

    <nav class="hidden lg:flex items-center gap-1 font-display font-semibold uppercase tracking-[0.1em] text-sm text-ink">

      <div class="group relative">
        <button type="button" class="flex items-center gap-1 px-3 py-2 rounded hover:text-accent transition-colors">
          Services
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 transition-transform group-hover:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
          </svg>
        </button>
        <div class="invisible absolute left-1/2 top-full -translate-x-1/2 pt-3 opacity-0 transition-all duration-150 group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100">
          <div class="w-[32rem] rounded-(--radius-brand-card) border border-slate-200 bg-white p-6 shadow-lg normal-case tracking-normal">
            <div class="grid grid-cols-2 gap-x-8">
              <div>
                <p class="font-display font-bold uppercase tracking-[0.1em] text-xs text-accent mb-3">Core Services</p>
                <ul class="flex flex-col gap-2">
                  {coreServices.map((service) => (
                    <li><a href={service.href} class="block text-sm font-medium text-ink hover:text-accent transition-colors">{service.label}</a></li>
                  ))}
                </ul>
              </div>
              <div>
                <p class="font-display font-bold uppercase tracking-[0.1em] text-xs text-slate-400 mb-3">Additional</p>
                <ul class="flex flex-col gap-2">
                  {additionalServices.map((service) => (
                    <li><a href={service.href} class="block text-sm font-medium text-ink hover:text-accent transition-colors">{service.label}</a></li>
                  ))}
                </ul>
              </div>
            </div>
            <a href="/services" class="mt-5 flex items-center gap-1 border-t border-slate-100 pt-4 text-sm font-display font-bold uppercase tracking-[0.1em] text-accent hover:text-accent-dark transition-colors">
              View All Services
              <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          </div>
        </div>
      </div>

      <div class="group relative">
        <button type="button" class="flex items-center gap-1 px-3 py-2 rounded hover:text-accent transition-colors">
          Service Area
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 transition-transform group-hover:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
          </svg>
        </button>
        <div class="invisible absolute left-1/2 top-full -translate-x-1/2 pt-3 opacity-0 transition-all duration-150 group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100">
          <div class="w-[42rem] rounded-(--radius-brand-card) border border-slate-200 bg-white p-6 shadow-lg normal-case tracking-normal">
            <div class="grid grid-cols-3 gap-x-6">
              <div>
                <p class="font-display font-bold uppercase tracking-[0.1em] text-xs text-accent mb-3">Primary Coverage</p>
                <ul class="flex flex-col gap-2">
                  {primaryAreas.map((area) => (
                    <li><a href={area.href} class="block text-sm font-medium text-ink hover:text-accent transition-colors">{area.label}</a></li>
                  ))}
                </ul>
              </div>
              <div>
                <p class="font-display font-bold uppercase tracking-[0.1em] text-xs text-slate-400 mb-3">Also Serving</p>
                <ul class="flex flex-col gap-2">
                  {secondaryAreas.map((area) => (
                    <li><a href={area.href} class="block text-sm font-medium text-ink hover:text-accent transition-colors">{area.label}</a></li>
                  ))}
                </ul>
              </div>
              <div>
                <p class="font-display font-bold uppercase tracking-[0.1em] text-xs text-slate-400 mb-3">Further Out</p>
                <ul class="flex flex-col gap-2">
                  {furtherAreas.map((area) => (
                    <li><a href={area.href} class="block text-sm font-medium text-ink hover:text-accent transition-colors">{area.label}</a></li>
                  ))}
                </ul>
              </div>
            </div>
            <a href="/service-area" class="mt-5 flex items-center gap-1 border-t border-slate-100 pt-4 text-sm font-display font-bold uppercase tracking-[0.1em] text-accent hover:text-accent-dark transition-colors">
              View Full Service Area
              <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          </div>
        </div>
      </div>

      <a href="/about" class="px-3 py-2 rounded hover:text-accent transition-colors">About</a>
      <a href="/blog" class="px-3 py-2 rounded hover:text-accent transition-colors">Blog</a>
      <a href="/contact" class="px-3 py-2 rounded hover:text-accent transition-colors">Contact</a>
    </nav>

    <div class="hidden lg:flex items-center gap-3">
      <a href="tel:5414018726" class="font-display font-semibold text-sm text-ink hover:text-accent transition-colors whitespace-nowrap">
        541-401-8726
      </a>
      <a href="/contact" class="btn btn-cta btn-sm">Free Estimate</a>
    </div>

    <div class="flex items-center gap-3 lg:hidden">
      <a href="tel:5414018726" class="btn btn-cta btn-sm">Call</a>
      <button
        type="button"
        id="menu-toggle"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Open menu"
        class="p-2 -mr-2 text-ink"
      >
        <svg id="icon-open" xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="icon-close" xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

  </div>
</header>

<!-- Full-screen mobile menu -->
<div
  id="mobile-menu"
  class="fixed inset-0 z-50 bg-ink lg:hidden opacity-0 pointer-events-none -translate-y-2 overflow-y-auto"
  style="transition: opacity 200ms ease, transform 200ms ease;"
>
  <div class="mx-auto max-w-6xl px-4 py-5 flex items-center justify-between">
    <img src="/logo.png" alt="D&D Land Works" class="h-11 w-auto" />
    <button type="button" id="menu-close" aria-label="Close menu" class="p-2 -mr-2 text-white">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>
  <nav class="mx-auto max-w-6xl px-4 mt-2 flex flex-col gap-1 pb-10">
    <a href="/" class="font-display font-semibold uppercase tracking-[0.1em] text-3xl text-white py-3 border-b border-white/10 hover:text-accent-light transition-colors">
      Home
    </a>

    <details class="border-b border-white/10 group">
      <summary class="font-display font-semibold uppercase tracking-[0.1em] text-3xl text-white py-3 cursor-pointer list-none flex items-center justify-between">
        Services
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 shrink-0 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
        </svg>
      </summary>
      <div class="pb-4 flex flex-col gap-3">
        <p class="font-display font-semibold uppercase tracking-[0.15em] text-xs text-accent-light mt-1">Core Services</p>
        {coreServices.map((service) => (
          <a href={service.href} class="font-display font-semibold uppercase tracking-[0.08em] text-lg text-white/80 hover:text-accent-light transition-colors">
            {service.label}
          </a>
        ))}
        <p class="font-display font-semibold uppercase tracking-[0.15em] text-xs text-white/40 mt-2">Additional</p>
        {additionalServices.map((service) => (
          <a href={service.href} class="font-display font-semibold uppercase tracking-[0.08em] text-lg text-white/80 hover:text-accent-light transition-colors">
            {service.label}
          </a>
        ))}
        <a href="/services" class="font-display font-bold uppercase tracking-[0.1em] text-sm text-accent-light mt-1">View All Services →</a>
      </div>
    </details>

    <details class="border-b border-white/10 group">
      <summary class="font-display font-semibold uppercase tracking-[0.1em] text-3xl text-white py-3 cursor-pointer list-none flex items-center justify-between">
        Service Area
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 shrink-0 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
        </svg>
      </summary>
      <div class="pb-4 flex flex-col gap-3">
        {[...primaryAreas, ...secondaryAreas, ...furtherAreas].map((area) => (
          <a href={area.href} class="font-display font-semibold uppercase tracking-[0.08em] text-lg text-white/80 hover:text-accent-light transition-colors">
            {area.label}
          </a>
        ))}
        <a href="/service-area" class="font-display font-bold uppercase tracking-[0.1em] text-sm text-accent-light mt-1">View Full Service Area →</a>
      </div>
    </details>

    <a href="/about" class="font-display font-semibold uppercase tracking-[0.1em] text-3xl text-white py-3 border-b border-white/10 hover:text-accent-light transition-colors">About</a>
    <a href="/blog" class="font-display font-semibold uppercase tracking-[0.1em] text-3xl text-white py-3 border-b border-white/10 hover:text-accent-light transition-colors">Blog</a>
    <a href="/contact" class="font-display font-semibold uppercase tracking-[0.1em] text-3xl text-white py-3 border-b border-white/10 hover:text-accent-light transition-colors">Contact</a>
  </nav>
  <div class="mx-auto max-w-6xl px-4 mt-2 pb-10 flex flex-col sm:flex-row gap-3">
    <a href="tel:5414018726" class="btn btn-outline-white btn-lg flex-1 sm:flex-none">Call 541-401-8726</a>
    <a href="/contact" class="btn btn-cta btn-lg flex-1 sm:flex-none">Free Estimate</a>
  </div>
</div>

<script>
  const toggle = document.getElementById('menu-toggle');
  const closeBtn = document.getElementById('menu-close');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');

  function openMenu() {
    menu?.classList.remove('opacity-0', 'pointer-events-none', '-translate-y-2');
    toggle?.setAttribute('aria-expanded', 'true');
    iconOpen?.classList.add('hidden');
    iconClose?.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  }

  function closeMenu() {
    menu?.classList.add('opacity-0', 'pointer-events-none', '-translate-y-2');
    toggle?.setAttribute('aria-expanded', 'false');
    iconOpen?.classList.remove('hidden');
    iconClose?.classList.add('hidden');
    document.body.style.overflow = '';
  }

  toggle?.addEventListener('click', openMenu);
  closeBtn?.addEventListener('click', closeMenu);
  menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', closeMenu));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeMenu(); });
</script>

<style>
  @media (prefers-reduced-motion: reduce) {
    #mobile-menu { transition: none !important; }
  }
</style>

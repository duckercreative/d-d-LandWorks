---
/*
  About section for right below the hero — layout inspired by Brynion
  (competitor) reference: image + overlapping stat badge on the left,
  eyebrow/headline/copy/feature-pair/CTA on the right. Unlike Brynion's
  "100% Satisfied Customers" (unverifiable), the badge and features here
  use only confirmed facts — see business-info.md Open Items.
*/
interface Props {
  phone?: string;
  ctaLabel?: string;
  ctaHref?: string;
  eyebrow?: string;
  headlineHtml?: string;
  descriptionHtml?: string;
}

const {
  phone = '541-401-8726',
  ctaLabel = 'Meet David',
  ctaHref = '/about',
  eyebrow = 'About D&amp;D Land Works',
  headlineHtml = 'Lane County\'s Owner-Operated <span class="text-brand-blue">Excavation &amp; Site Prep</span> Team',
  descriptionHtml,
} = Astro.props;
const phoneHref = `tel:${phone.replace(/[^0-9]/g, '')}`;
---

<section class="relative overflow-hidden bg-white">
	<div class="pointer-events-none absolute -right-32 top-1/4 h-80 w-80 rounded-full bg-brand-blue-light/50 blur-3xl" aria-hidden="true"></div>

	<div class="relative mx-auto max-w-6xl px-4 py-16 md:py-24">
		<div class="grid gap-12 lg:grid-cols-2 lg:items-center">
			<div class="relative">
				<span
					class="pointer-events-none absolute -left-2 top-1/2 hidden -translate-y-1/2 -rotate-90 font-display font-black uppercase tracking-widest text-6xl text-slate-100 select-none md:block"
					aria-hidden="true"
				>D&amp;D</span>

				<div class="relative aspect-square overflow-hidden rounded-(--radius-brand-card) shadow-lg sm:aspect-4/5">
					<img
						src="/service-site-preparation.webp"
						alt="D&D Land Works excavation equipment on a job site in Lane County, Oregon"
						class="h-full w-full object-cover"
						loading="lazy"
					/>
				</div>

				<div class="absolute -bottom-6 left-6 flex items-center gap-3 rounded-(--radius-brand-card) bg-brand-blue px-5 py-4 text-white shadow-lg sm:left-8">
					<span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-white/15">
						<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
							<path stroke-linecap="round" stroke-linejoin="round" d="M4 18h16M6 18v-3a6 6 0 0 1 12 0v3M10 9V6a2 2 0 1 1 4 0v3" />
						</svg>
					</span>
					<div class="leading-tight">
						<p class="font-display font-black text-2xl">100%</p>
						<p class="font-body text-sm text-white/90">Owner-Operated</p>
					</div>
				</div>
			</div>

			<div>
				<div class="mb-3 flex items-center gap-2">
					<img src="/logo.png" alt="" class="h-6 w-auto" aria-hidden="true" />
					<p class="font-display font-semibold uppercase tracking-widest text-sm text-brand-blue" set:html={eyebrow} />
				</div>

				<h2 class="font-display font-black uppercase tracking-tight text-3xl md:text-4xl text-ink" set:html={headlineHtml} />

				{descriptionHtml ? (
					<div class="mt-5 flex flex-col gap-4 text-slate-700 leading-relaxed" set:html={descriptionHtml} />
				) : (
					<p class="mt-5 text-slate-700 leading-relaxed">
						David Deggelman owns D&amp;D Land Works and runs the equipment himself, no sales team, no
						subcontracted crew you've never met. Licensed and bonded under Oregon
						<span class="font-semibold text-ink">CCB #261742</span>, and
						<span class="font-semibold text-ink">DEQ certified</span> for septic install and repair, we
						handle site prep, grading, drainage, and utility excavation for homeowners and builders
						across Eugene, Springfield, and the rest of Lane County.
					</p>
				)}

				<div class="mt-8 grid gap-6 sm:grid-cols-2">
					<div class="flex gap-3">
						<span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-brand-blue-light text-brand-blue">
							<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
								<circle cx="12" cy="8" r="3.2" />
								<path stroke-linecap="round" stroke-linejoin="round" d="M5 21v-1.5a7 7 0 0 1 14 0V21" />
							</svg>
						</span>
						<div>
							<p class="font-display font-bold uppercase tracking-wide text-sm text-ink">No Subcontractors</p>
							<p class="mt-1 text-sm text-slate-600">The person who quotes your job is the one who digs it.</p>
						</div>
					</div>

					<div class="flex gap-3">
						<span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-brand-blue-light text-brand-blue">
							<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
								<path stroke-linecap="round" stroke-linejoin="round" d="M12 21c4.4-3.4 7-7 7-10.5A7 7 0 0 0 5 10.5C5 14 7.6 17.6 12 21Z" />
								<circle cx="12" cy="10.5" r="2.3" />
							</svg>
						</span>
						<div>
							<p class="font-display font-bold uppercase tracking-wide text-sm text-ink">Local Equipment &amp; Crew</p>
							<p class="mt-1 text-sm text-slate-600">Based in Lane County, no crews trucked in from out of the area.</p>
						</div>
					</div>
				</div>

				<div class="mt-9 flex flex-wrap items-center gap-6">
					<a href={ctaHref} class="btn-pill">
						{ctaLabel}
						<span class="btn-pill-icon">
							<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
								<path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M17 7H7M17 7V17" />
							</svg>
						</span>
					</a>

					<a href={phoneHref} class="group flex items-center gap-3">
						<span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-safety-orange text-white transition-colors group-hover:bg-safety-orange-dark">
							<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
								<path d="M6.6 10.8c1.4 2.8 3.8 5.2 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.9 21 3 13.1 3 3c0-.6.4-1 1-1h3.2c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.4 0 .8-.2 1L6.6 10.8z" />
							</svg>
						</span>
						<span class="flex flex-col leading-tight text-left">
							<span class="font-body text-sm text-slate-500">Call us any time</span>
							<span class="font-display font-bold text-lg text-ink">{phone}</span>
						</span>
					</a>
				</div>
			</div>
		</div>
	</div>
</section>

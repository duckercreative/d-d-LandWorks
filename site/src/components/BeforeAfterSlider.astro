---
interface Props {
  before: string;
  after: string;
  caption: string;
  id: string;
}

const { before, after, caption, id } = Astro.props;
---

<div class="card overflow-hidden p-0">
	<div
		class="before-after relative aspect-4/3 w-full select-none overflow-hidden"
		data-before-after
		style="--reveal: 50%;"
	>
		<img src={after} alt={`${caption} — after`} class="absolute inset-0 h-full w-full object-cover" loading="lazy" draggable="false" />
		<img
			src={before}
			alt={`${caption} — before`}
			class="absolute inset-0 h-full w-full object-cover"
			style="clip-path: inset(0 calc(100% - var(--reveal)) 0 0);"
			loading="lazy"
			draggable="false"
		/>

		<span class="pointer-events-none absolute left-3 top-3 rounded-(--radius-brand) bg-ink/70 px-2.5 py-1 font-display font-bold uppercase tracking-wide text-xs text-white">
			Before
		</span>
		<span class="pointer-events-none absolute right-3 top-3 rounded-(--radius-brand) bg-brand-blue/90 px-2.5 py-1 font-display font-bold uppercase tracking-wide text-xs text-white">
			After
		</span>

		<div class="pointer-events-none absolute inset-y-0 w-0.5 bg-white shadow-[0_0_0_1px_rgba(0,0,0,0.15)]" style="left: var(--reveal);">
			<span class="pointer-events-none absolute top-1/2 left-1/2 flex h-9 w-9 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full bg-white shadow-lg">
				<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-ink" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
					<path stroke-linecap="round" stroke-linejoin="round" d="M8 7 4 12l4 5M16 7l4 5-4 5" />
				</svg>
			</span>
		</div>

		<input
			type="range"
			min="0"
			max="100"
			value="50"
			aria-label={`Drag to compare ${caption} before and after`}
			class="before-after-input absolute inset-0 h-full w-full cursor-ew-resize appearance-none bg-transparent opacity-0"
			id={`ba-${id}`}
		/>
	</div>
	<p class="p-4 font-display font-bold uppercase tracking-wide text-sm text-ink">
		{caption}
	</p>
</div>

<script>
	function initSliders() {
		document.querySelectorAll<HTMLInputElement>('.before-after-input').forEach((input) => {
			const wrapper = input.closest<HTMLElement>('[data-before-after]');
			if (!wrapper || wrapper.dataset.wired) return;
			wrapper.dataset.wired = 'true';

			const update = () => {
				wrapper.style.setProperty('--reveal', `${input.value}%`);
			};
			input.addEventListener('input', update);
			update();
		});
	}

	initSliders();
	document.addEventListener('astro:page-load', initSliders);
</script>

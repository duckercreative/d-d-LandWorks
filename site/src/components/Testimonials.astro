---
/*
  Google-review widget, restyled to match the "Live Google Reviews" reference
  layout (dark header band + white review panel + numbered pagination).
  With no `reviews` passed, it still falls back to an honest "no reviews yet"
  state instead of showing placeholder stars/names/counts by default — the
  rating/reviewCount/reviews passed in from index.astro right now are demo
  content only, requested to preview this design. Swap them for real data
  once the Google Business Profile exists and has actual reviews (see
  business-info.md open items / build plan Phase 8).
*/
interface Review {
  name: string;
  initial?: string;
  photo?: string;
  date: string;
  stars: number;
  text: string;
}

interface Props {
  businessName: string;
  rating?: number;
  reviewCount?: number;
  googleReviewUrl?: string;
  reviews?: Review[];
}

const { businessName, rating, reviewCount, googleReviewUrl, reviews = [] } = Astro.props;

function stars(count: number) {
  const filled = Math.round(count);
  return Array.from({ length: 5 }, (_, i) => i < filled);
}

const pageSize = 3;
const pages = Array.from({ length: Math.ceil(reviews.length / pageSize) }, (_, i) =>
  reviews.slice(i * pageSize, i * pageSize + pageSize)
);
---

<section class="bg-ink py-16 md:py-20">
	<div class="mx-auto max-w-3xl px-4 text-center">
		<span class="inline-block rounded-full bg-white/10 px-4 py-1.5 font-display font-semibold uppercase tracking-widest text-xs text-safety-orange">
			Google Reviews
		</span>
		<h2 class="mt-4 font-display font-black uppercase tracking-tight text-3xl text-white md:text-4xl">
			Live Google Reviews for {businessName}
		</h2>
		<p class="mt-3 text-slate-300">
			Read live Google reviews from customers who have worked with {businessName}.
		</p>
	</div>

	<div class="mx-auto mt-10 max-w-6xl px-4">
		<div class="rounded-2xl bg-white p-6 shadow-2xl md:p-10">
			{pages.length > 0 && rating && reviewCount ? (
				<>
					<div class="flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between">
						<h3 class="font-display font-bold text-xl text-ink">
							What our clients say about us
						</h3>
						<div class="flex items-center gap-4">
							<div class="text-right">
								<p class="font-display font-black text-3xl text-ink">{rating.toFixed(2)}</p>
								<p class="flex items-center justify-end gap-1 text-sm text-slate-500">
									<span class="flex gap-0.5">
										{stars(rating).map((filled) => (
											<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" class={`h-4 w-4 ${filled ? 'fill-safety-orange' : 'fill-slate-300'}`}>
												<path d="M10 1.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L10 14.8l-5.2 2.8 1-5.8-4.3-4.1 5.9-.9L10 1.5z" />
											</svg>
										))}
									</span>
									{reviewCount} reviews
								</p>
							</div>
							<a href={googleReviewUrl ?? '#'} class="btn btn-primary btn-sm shrink-0">
								Write a Review
							</a>
						</div>
					</div>

					<div class="mt-8">
						{pages.map((page, i) => (
							<div class="review-page grid gap-4 sm:grid-cols-2 lg:grid-cols-3" data-page={i} style={i === 0 ? '' : 'display:none'}>
								{page.map((review) => (
									<div class="rounded-(--radius-brand-card) border border-slate-200 p-5">
										<div class="flex items-center justify-between gap-2">
											<span class="flex items-center gap-1 font-display font-bold text-ink">
												{review.stars}
												<span class="flex gap-0.5">
													{stars(review.stars).map((filled) => (
														<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" class={`h-3.5 w-3.5 ${filled ? 'fill-safety-orange' : 'fill-slate-300'}`}>
															<path d="M10 1.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L10 14.8l-5.2 2.8 1-5.8-4.3-4.1 5.9-.9L10 1.5z" />
														</svg>
													))}
												</span>
											</span>
											<span class="text-xs text-slate-400">{review.date}</span>
										</div>
										<p class="mt-3 text-sm text-slate-700 leading-relaxed">{review.text}</p>
										<div class="mt-4 flex items-center gap-3 border-t border-slate-100 pt-3">
											{review.photo ? (
												<img src={review.photo} alt={review.name} class="h-8 w-8 rounded-full object-cover" />
											) : (
												<div class="flex h-8 w-8 items-center justify-center rounded-full bg-slate-200 text-xs font-semibold text-slate-600">
													{review.initial ?? review.name.charAt(0)}
												</div>
											)}
											<p class="text-sm font-medium text-ink">{review.name}</p>
											<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" class="ml-auto h-4 w-4 shrink-0">
												<path fill="#4285F4" d="M45.1 24.5c0-1.6-.1-3.1-.4-4.6H24v9h11.8c-.5 2.7-2.1 5.1-4.4 6.6v5.4h7.1c4.2-3.8 6.6-9.5 6.6-16.4z"/>
												<path fill="#34A853" d="M24 46c6 0 11-2 14.6-5.4l-7.1-5.4c-2 1.3-4.5 2.1-7.5 2.1-5.8 0-10.6-3.9-12.4-9.1H4.3v5.6C7.9 41 15.3 46 24 46z"/>
												<path fill="#FBBC05" d="M11.6 28.2c-.5-1.3-.7-2.7-.7-4.2s.3-2.9.7-4.2v-5.6H4.3C2.8 17.1 2 20.4 2 24s.8 6.9 2.3 9.8l7.3-5.6z"/>
												<path fill="#EA4335" d="M24 10.7c3.3 0 6.2 1.1 8.5 3.3l6.3-6.3C34.9 4.2 30 2 24 2 15.3 2 7.9 7 4.3 14.2l7.3 5.6c1.8-5.2 6.6-9.1 12.4-9.1z"/>
											</svg>
										</div>
									</div>
								))}
							</div>
						))}
					</div>

					{pages.length > 1 && (
						<div class="mt-8 flex items-center justify-center gap-2" id="review-pagination">
							<button type="button" class="review-page-prev flex h-8 w-8 items-center justify-center rounded-full text-slate-400 hover:text-ink" aria-label="Previous reviews">
								<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" /></svg>
							</button>
							{pages.map((_, i) => (
								<button
									type="button"
									class:list={["review-page-dot flex h-8 w-8 items-center justify-center rounded-full font-display font-semibold text-sm", i === 0 ? 'bg-ink text-white' : 'text-slate-500 hover:bg-slate-100']}
									data-page-target={i}
								>
									{i + 1}
								</button>
							))}
							<button type="button" class="review-page-next flex h-8 w-8 items-center justify-center rounded-full text-slate-400 hover:text-ink" aria-label="Next reviews">
								<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
							</button>
						</div>
					)}
				</>
			) : (
				<div class="py-8 text-center">
					<p class="font-display font-bold uppercase tracking-wide text-ink">No Reviews Yet</p>
					<p class="mt-2 text-slate-600">
						{businessName} is a new business building its Google presence. Worked with us on a
						project? Be the first to leave a review.
					</p>
					{googleReviewUrl && (
						<a href={googleReviewUrl} target="_blank" rel="noopener" class="btn btn-primary btn-sm mt-4">
							Leave a Review
						</a>
					)}
				</div>
			)}
		</div>
	</div>
</section>

<script>
	document.querySelectorAll<HTMLElement>('#review-pagination').forEach((nav) => {
		const container = nav.closest('section');
		if (!container) return;
		const pageEls = Array.from(container.querySelectorAll<HTMLElement>('.review-page'));
		const dots = Array.from(nav.querySelectorAll<HTMLButtonElement>('.review-page-dot'));
		let current = 0;

		function show(index: number) {
			current = (index + pageEls.length) % pageEls.length;
			pageEls.forEach((el, i) => { el.style.display = i === current ? '' : 'none'; });
			dots.forEach((dot, i) => {
				dot.classList.toggle('bg-ink', i === current);
				dot.classList.toggle('text-white', i === current);
				dot.classList.toggle('text-slate-500', i !== current);
			});
		}

		const AUTOPLAY_MS = 6000;
		let timer: ReturnType<typeof setInterval> | undefined;

		function stopAutoplay() {
			if (timer) clearInterval(timer);
			timer = undefined;
		}

		function startAutoplay() {
			stopAutoplay();
			if (pageEls.length < 2) return;
			timer = setInterval(() => show(current + 1), AUTOPLAY_MS);
		}

		function goTo(index: number) {
			show(index);
			startAutoplay();
		}

		dots.forEach((dot, i) => dot.addEventListener('click', () => goTo(i)));
		nav.querySelector('.review-page-prev')?.addEventListener('click', () => goTo(current - 1));
		nav.querySelector('.review-page-next')?.addEventListener('click', () => goTo(current + 1));

		container.addEventListener('mouseenter', stopAutoplay);
		container.addEventListener('mouseleave', startAutoplay);

		startAutoplay();
	});
</script>

---
interface Props {
  headline: string;
  subheadline?: string;
  ctaLabel?: string;
  ctaHref?: string;
  phone?: string;
}

const {
  headline,
  subheadline,
  ctaLabel = 'Book Appointment',
  ctaHref = '/contact',
  phone = '541-401-8726',
} = Astro.props;

const phoneHref = `tel:${phone.replace(/[^0-9]/g, '')}`;
---

<section class="relative bg-brand-blue">
	<div class="relative mx-auto max-w-6xl px-4 py-16 md:py-20">
		<div class="max-w-lg">
			<h2 class="font-display font-black uppercase tracking-tight text-3xl leading-tight text-white md:text-4xl">
				{headline}
			</h2>
			{subheadline && (
				<p class="mt-4 text-blue-100 leading-relaxed">
					{subheadline}
				</p>
			)}
			<div class="mt-8 flex flex-wrap items-center gap-6">
				<a
					href={ctaHref}
					class="inline-flex items-center gap-3 rounded-full bg-white py-1.5 pl-6 pr-1.5 font-display font-semibold uppercase tracking-wide text-brand-blue transition-colors hover:bg-blue-50"
				>
					{ctaLabel}
					<span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-brand-blue text-white">
						<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
							<path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M17 7H7M17 7V17" />
						</svg>
					</span>
				</a>

				<a href={phoneHref} class="group flex items-center gap-3">
					<span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-safety-orange text-white transition-colors group-hover:bg-safety-orange-dark">
						<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
							<path d="M6.6 10.8c1.4 2.8 3.8 5.2 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.9 21 3 13.1 3 3c0-.6.4-1 1-1h3.2c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.4 0 .8-.2 1L6.6 10.8z" />
						</svg>
					</span>
					<span class="flex flex-col text-left leading-tight">
						<span class="font-body text-sm text-blue-100">Call us any time</span>
						<span class="font-display font-bold text-lg text-white">{phone}</span>
					</span>
				</a>
			</div>
		</div>
	</div>

	<img
		src="/ctaimage.png"
		alt=""
		aria-hidden="true"
		class="pointer-events-none absolute bottom-0 right-2 hidden w-80 drop-shadow-2xl sm:right-4 md:block md:w-[26rem] lg:right-6 lg:w-[32rem] xl:right-10 xl:w-[36rem]"
	/>
</section>

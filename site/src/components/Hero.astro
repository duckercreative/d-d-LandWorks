---
interface Cta {
  label: string;
  href: string;
}

interface Props {
  eyebrow?: string;
  headline: string;
  subheadline?: string;
  primaryCta?: Cta;
  secondaryCta?: Cta;
  backgroundImages?: string[];
}

const { eyebrow, headline, subheadline, primaryCta, secondaryCta, backgroundImages = [] } = Astro.props;

const phoneNumber = primaryCta?.label.replace(/^Call\s*/i, '') ?? '';
---

<section class="relative bg-ink text-white overflow-hidden">
	{backgroundImages.length > 0 && (
		<>
			<div class="hero-bg-slideshow absolute inset-0">
				{backgroundImages.map((src, i) => (
					<img
						src={src}
						alt=""
						aria-hidden="true"
						class="hero-bg-slide absolute inset-0 h-full w-full object-cover transition-opacity duration-1000 ease-in-out"
						style={i === 0 ? 'opacity:1' : 'opacity:0'}
					/>
				))}
			</div>
			<div class="absolute inset-0 bg-linear-to-r from-ink/70 via-ink/55 to-ink/25"></div>
		</>
	)}
	<div class="relative mx-auto max-w-6xl px-4 py-20 md:py-28">
		{eyebrow && (
			<p class="font-display font-semibold uppercase tracking-widest text-sm text-brand-blue-light mb-3">
				{eyebrow}
			</p>
		)}
		<h1 class="font-display font-black uppercase tracking-tight text-5xl md:text-7xl max-w-3xl">
			{headline}
		</h1>
		{subheadline && (
			<p class="mt-5 text-lg text-slate-300 max-w-2xl">
				{subheadline}
			</p>
		)}
		{(primaryCta || secondaryCta) && (
			<div class="mt-8 flex flex-wrap items-center gap-6">
				{secondaryCta && (
					<a href={secondaryCta.href} class="btn-pill">
						{secondaryCta.label}
						<span class="btn-pill-icon">
							<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
								<path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M17 7H7M17 7V17" />
							</svg>
						</span>
					</a>
				)}
				{primaryCta && (
					<a href={primaryCta.href} class="group flex items-center gap-3">
						<span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-safety-orange text-white transition-colors group-hover:bg-safety-orange-dark">
							<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
								<path d="M6.6 10.8c1.4 2.8 3.8 5.2 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.9 21 3 13.1 3 3c0-.6.4-1 1-1h3.2c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.4 0 .8-.2 1L6.6 10.8z" />
							</svg>
						</span>
						<span class="flex flex-col leading-tight text-left">
							<span class="font-body text-sm text-slate-300">Call us any time</span>
							<span class="font-display font-bold text-lg text-white">{phoneNumber}</span>
						</span>
					</a>
				)}
			</div>
		)}
	</div>
</section>

<script>
	document.querySelectorAll<HTMLElement>('.hero-bg-slideshow').forEach((container) => {
		const slides = Array.from(container.querySelectorAll<HTMLElement>('.hero-bg-slide'));
		if (slides.length < 2) return;
		let current = 0;
		setInterval(() => {
			const next = (current + 1) % slides.length;
			slides[current].style.opacity = '0';
			slides[next].style.opacity = '1';
			current = next;
		}, 2000);
	});
</script>

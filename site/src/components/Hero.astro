---
interface Cta {
  label: string;
  href: string;
}

interface TrustItem {
  label: string;
  sub?: string;
}

interface Props {
  eyebrow?: string;
  headline: string;
  headlineAccent?: string;
  subheadline?: string;
  primaryCta?: Cta;
  secondaryCta?: Cta;
  backgroundImages?: string[];
  trustItems?: TrustItem[];
  fullBleed?: boolean;
}

const {
  eyebrow,
  headline,
  headlineAccent,
  subheadline,
  primaryCta,
  secondaryCta,
  backgroundImages = [],
  trustItems = [],
  fullBleed = false,
} = Astro.props;
---

{fullBleed ? (
  <section class="relative min-h-[88vh] flex flex-col justify-end bg-ink-deep text-white overflow-hidden">
    {backgroundImages[0] && (
      <img
        src={backgroundImages[0]}
        alt=""
        aria-hidden="true"
        class="absolute inset-0 h-full w-full object-cover object-center"
        loading="eager"
      />
    )}
    <!-- Gradient: uniform dark on mobile, left-fade on sm+ -->
    <div class="absolute inset-0 bg-[#0E1011]/80 sm:bg-none sm:bg-gradient-to-r sm:from-[#0E1011]/95 sm:via-[#0E1011]/80 sm:to-[#0E1011]/30"></div>
    <!-- Bottom gradient for trust strip readability -->
    <div class="absolute inset-x-0 bottom-0 h-40 bg-gradient-to-t from-[#0E1011]/70 to-transparent"></div>

    <!-- Main copy — left-aligned, stops at ~55% of viewport -->
    <div class="relative z-10 w-full max-w-3xl px-6 sm:px-10 lg:px-16 pb-28 md:pb-36 pt-24">
      {eyebrow && (
        <p class="section-label text-accent-light mb-5">{eyebrow}</p>
      )}
      <h1 class="font-display leading-[1.05] text-[clamp(2.8rem,7vw,5rem)]">
        <span class="block font-light">{headline}</span>
        {headlineAccent && <span class="block font-semibold">{headlineAccent}</span>}
      </h1>
      {subheadline && (
        <p class="mt-5 text-base sm:text-lg text-white/75 max-w-lg leading-relaxed">{subheadline}</p>
      )}
      {(primaryCta || secondaryCta) && (
        <div class="mt-8 flex flex-wrap items-center gap-4">
          {primaryCta && (
            <a href={primaryCta.href} class="btn btn-cta btn-lg">{primaryCta.label}</a>
          )}
          {secondaryCta && (
            <a href={secondaryCta.href} class="btn btn-outline-white">{secondaryCta.label}</a>
          )}
        </div>
      )}
    </div>

    <!-- Trust strip — pinned to bottom -->
    {trustItems.length > 0 && (
      <div class="relative z-10 border-t border-white/10 bg-ink-deep/80 backdrop-blur-sm">
        <div class="mx-auto max-w-6xl px-6 sm:px-10 lg:px-16 py-4 flex flex-wrap justify-center gap-x-10 gap-y-3">
          {trustItems.map((item) => (
            <div class="flex flex-col gap-0.5 items-center text-center">
              <span class="font-display font-semibold text-sm text-white leading-tight">{item.label}</span>
              {item.sub && <span class="font-body text-xs text-white/55">{item.sub}</span>}
            </div>
          ))}
        </div>
      </div>
    )}
  </section>
) : (
  <section class="relative bg-ink text-white overflow-hidden">
    {backgroundImages.length > 0 && (
      <>
        <div class="hero-bg-slideshow absolute inset-0">
          {backgroundImages.map((src, i) => (
            <img
              src={src}
              alt=""
              aria-hidden="true"
              class="hero-bg-slide absolute inset-0 h-full w-full object-cover transition-opacity duration-1000 ease-in-out"
              style={i === 0 ? 'opacity:1' : 'opacity:0'}
            />
          ))}
        </div>
        <div class="absolute inset-0 bg-gradient-to-r from-ink/75 via-ink/60 to-ink/30"></div>
      </>
    )}
    <div class="relative mx-auto max-w-6xl px-4 py-20 md:py-28">
      {eyebrow && (
        <p class="section-label text-accent-light mb-4">{eyebrow}</p>
      )}
      <h1 class="font-display font-semibold text-4xl md:text-6xl leading-tight max-w-3xl">
        {headline}
        {headlineAccent && <span class="block font-light">{headlineAccent}</span>}
      </h1>
      {subheadline && (
        <p class="mt-5 text-lg text-white/70 max-w-2xl leading-relaxed">{subheadline}</p>
      )}
      {(primaryCta || secondaryCta) && (
        <div class="mt-8 flex flex-wrap items-center gap-5">
          {primaryCta && (
            <a href={primaryCta.href} class="btn btn-cta">{primaryCta.label}</a>
          )}
          {secondaryCta && (
            <a href={secondaryCta.href} class="btn btn-outline-white">{secondaryCta.label}</a>
          )}
        </div>
      )}
    </div>
  </section>
)}

<script>
  document.querySelectorAll<HTMLElement>('.hero-bg-slideshow').forEach((container) => {
    const slides = Array.from(container.querySelectorAll<HTMLElement>('.hero-bg-slide'));
    if (slides.length < 2) return;
    let current = 0;
    setInterval(() => {
      const next = (current + 1) % slides.length;
      slides[current].style.opacity = '0';
      slides[next].style.opacity = '1';
      current = next;
    }, 4000);
  });
</script>

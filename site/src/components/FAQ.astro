---
/*
  Reusable FAQ accordion. Emits FAQPage JSON-LD alongside the visible
  markup so the same content serves both readers and AI/search citation.
  Uses native <details>/<summary> to match the disclosure pattern already
  used in Header.astro's mobile menu — no JS needed for open/close.
*/
interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  heading?: string;
  items: FaqItem[];
}

const { heading = 'Frequently Asked Questions', items } = Astro.props;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};
---

<section class="mx-auto max-w-4xl px-4 py-16">
	<h2 class="font-display font-bold uppercase tracking-tight text-3xl text-ink text-center">
		{heading}
	</h2>
	<div class="mt-8 flex flex-col gap-3">
		{items.map((item) => (
			<details class="card group">
				<summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-display font-semibold text-ink [&::-webkit-details-marker]:hidden">
					{item.question}
					<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 shrink-0 text-brand-blue transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
						<path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
					</svg>
				</summary>
				<p class="mt-3 text-slate-700 leading-relaxed">{item.answer}</p>
			</details>
		))}
	</div>
</section>

<script type="application/ld+json" set:html={JSON.stringify(schema)} />

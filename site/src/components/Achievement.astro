---
/*
  Photo-collage "achievement" section — layout inspired by Brynion (competitor)
  reference: staggered photo pair, floating phone card, stat row, CTA. Unlike
  Brynion's "15+ Years Experience / 100+ Happy Clients / 100% Satisfaction"
  (unverifiable), the stat row here uses only confirmed facts — see
  business-info.md Open Items.

  Stat row is deliberately the "licensing spotlight": CCB #261742 + DEQ get
  their specific numbers/names here, since AboutSection/WhyChooseUs cover
  different angles (owner-operated, process, scope) to avoid every homepage
  section repeating the same handful of trust facts identically.
*/
interface Props {
  phone?: string;
  descriptionHtml?: string;
}

const { phone = '541-401-8726', descriptionHtml } = Astro.props;
const phoneHref = `tel:${phone.replace(/[^0-9]/g, '')}`;

const stats = [
  { value: 'CCB', label: 'Licensed & Bonded (#261742)' },
  { value: 'DEQ', label: 'Certified for Septic' },
  { value: '1', label: 'Contractor for the Full Job' },
];
---

<section class="overflow-hidden bg-white">
	<div class="mx-auto max-w-6xl px-4 py-16 md:py-24">
		<div class="grid gap-16 lg:grid-cols-2 lg:items-center lg:gap-12">
			<div class="relative mx-auto w-full max-w-md pb-16 sm:pb-24 lg:mx-0 lg:max-w-none">
				<img
					src="/service-grading-leveling.webp"
					alt="D&D Land Works job site in Lane County, Oregon"
					class="aspect-3/4 w-4/5 rounded-(--radius-brand-card) object-cover shadow-xl"
					loading="lazy"
				/>

				<img
					src="/service-driveway-repair.webp"
					alt="D&D Land Works site preparation work"
					class="absolute bottom-0 right-0 aspect-4/3 w-3/5 rounded-(--radius-brand-card) border-4 border-white object-cover shadow-xl"
					loading="lazy"
				/>

				<a
					href={phoneHref}
					class="absolute right-0 top-20 flex items-center gap-2 rounded-full bg-white px-5 py-3 text-ink shadow-lg transition-colors hover:text-brand-blue sm:top-24 sm:right-2"
				>
					<span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-brand-blue-light text-brand-blue">
						<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
							<path d="M6.6 10.8c1.4 2.8 3.8 5.2 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.9 21 3 13.1 3 3c0-.6.4-1 1-1h3.2c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.4 0 .8-.2 1L6.6 10.8z" />
						</svg>
					</span>
					<span class="font-display font-bold text-sm whitespace-nowrap">{phone}</span>
				</a>
			</div>

			<div>
				<div class="mb-3 flex items-center gap-2">
					<img src="/logo.png" alt="" class="h-6 w-auto" aria-hidden="true" />
					<p class="font-display font-semibold uppercase tracking-widest text-sm text-brand-blue">
						Our Commitment
					</p>
				</div>

				<h2 class="font-display font-black uppercase tracking-tight text-3xl text-ink md:text-4xl">
					Building Strong Foundations for Lane County, Oregon
				</h2>

				{descriptionHtml ? (
					<p class="mt-4 text-slate-700 leading-relaxed" set:html={descriptionHtml} />
				) : (
					<p class="mt-4 text-slate-700 leading-relaxed">
						Most crews that can grade your lot can't legally touch a septic system, and vice versa.
						D&amp;D Land Works holds both the general excavation license and the DEQ septic
						certification, so one contractor covers the full job from site prep through system install.
					</p>
				)}

				<div class="card mt-8 grid grid-cols-3 gap-4 sm:gap-8">
					{stats.map((stat) => (
						<div class="text-center">
							<p class="font-display font-black text-2xl text-brand-blue sm:text-3xl">{stat.value}</p>
							<p class="mt-1 text-xs text-slate-600 sm:text-sm">{stat.label}</p>
						</div>
					))}
				</div>

				<a href="/service-area" class="btn-pill mt-8 inline-flex">
					Learn More
					<span class="btn-pill-icon">
						<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
							<path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M17 7H7M17 7V17" />
						</svg>
					</span>
				</a>
			</div>
		</div>
	</div>
</section>

---
/*
  Alternating photo + content block for service-page sections that would
  otherwise be a bare heading + paragraph. Same visual language as
  AboutSection.astro (image + floating fact badge, eyebrow, CTA row) so a
  page built from several of these reads as one designed page, not a
  one-off "about" block followed by plain text.
*/
interface Props {
  eyebrow: string;
  headline: string;
  bodyHtml: string;
  image: string;
  imageAlt: string;
  badgeValue: string;
  badgeLabel: string;
  ctaLabel: string;
  ctaHref: string;
  phone?: string;
  imageSide?: 'left' | 'right';
}

const {
  eyebrow,
  headline,
  bodyHtml,
  image,
  imageAlt,
  badgeValue,
  badgeLabel,
  ctaLabel,
  ctaHref,
  phone = '541-401-8726',
  imageSide = 'left',
} = Astro.props;

const phoneHref = `tel:${phone.replace(/[^0-9]/g, '')}`;
---

<section class="bg-white border-b border-slate-200">
	<div class="mx-auto max-w-6xl px-4 py-16 md:py-20">
		<div class="grid gap-12 lg:grid-cols-2 lg:items-center">
			<div class:list={["relative mx-auto w-full max-w-md pb-16 sm:pb-20 lg:mx-0 lg:max-w-none", imageSide === 'right' && 'lg:order-2']}>
				<div class="relative aspect-4/3 overflow-hidden rounded-(--radius-brand-card) shadow-lg">
					<img src={image} alt={imageAlt} class="h-full w-full object-cover" loading="lazy" />
				</div>

				<div class="absolute -bottom-6 left-6 flex items-center gap-3 rounded-(--radius-brand-card) bg-brand-blue px-5 py-4 text-white shadow-lg">
					<span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-white/15">
						<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
							<path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
						</svg>
					</span>
					<div class="leading-tight">
						<p class="font-display font-black text-xl">{badgeValue}</p>
						<p class="font-body text-sm text-white/90">{badgeLabel}</p>
					</div>
				</div>
			</div>

			<div class:list={[imageSide === 'right' && 'lg:order-1']}>
				<div class="mb-3 flex items-center gap-2">
					<img src="/logo.png" alt="" class="h-6 w-auto" aria-hidden="true" />
					<p class="font-display font-semibold uppercase tracking-widest text-sm text-brand-blue">
						{eyebrow}
					</p>
				</div>

				<h2 class="font-display font-black uppercase tracking-tight text-2xl md:text-3xl text-ink">
					{headline}
				</h2>

				<div class="mt-5 flex flex-col gap-4 text-slate-700 leading-relaxed" set:html={bodyHtml} />

				<div class="mt-8 flex flex-wrap items-center gap-6">
					<a href={ctaHref} class="btn-pill">
						{ctaLabel}
						<span class="btn-pill-icon">
							<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
								<path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M17 7H7M17 7V17" />
							</svg>
						</span>
					</a>

					<a href={phoneHref} class="group flex items-center gap-3">
						<span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-safety-orange text-white transition-colors group-hover:bg-safety-orange-dark">
							<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
								<path d="M6.6 10.8c1.4 2.8 3.8 5.2 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.9 21 3 13.1 3 3c0-.6.4-1 1-1h3.2c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.4 0 .8-.2 1L6.6 10.8z" />
							</svg>
						</span>
						<span class="flex flex-col leading-tight text-left">
							<span class="font-body text-sm text-slate-500">Call us any time</span>
							<span class="font-display font-bold text-lg text-ink">{phone}</span>
						</span>
					</a>
				</div>
			</div>
		</div>
	</div>
</section>

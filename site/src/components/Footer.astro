---
const year = new Date().getFullYear();

const services = [
  { label: 'Site Preparation', href: '/site-preparation-contractor-eugene-or' },
  { label: 'Excavation', href: '/excavation-contractor-eugene-or' },
  { label: 'Land Clearing', href: '/land-clearing-services-eugene-or' },
  { label: 'Grading & Leveling', href: '/land-grading-services-eugene-or' },
  { label: 'Foundation Excavation', href: '/foundation-excavation-eugene-or' },
  { label: 'Drainage Excavation', href: '/drainage-installation-eugene-or' },
  { label: 'Utility Excavation', href: '/utility-trenching-eugene-or' },
  { label: 'Driveway Repair', href: '/driveway-excavation-grading-eugene-or' },
  { label: 'Septic Install & Repairs', href: '/septic-installation-lane-county-or' },
  { label: 'Slope Stabilization', href: '/slope-stabilization-eugene-or' },
];

const serviceAreas = [
  { label: 'Eugene, OR', href: '/excavation-contractor-eugene-or' },
  { label: 'Springfield, OR', href: '/excavation-contractor-springfield-or' },
  { label: 'Cottage Grove', href: '/excavation-contractor-cottage-grove-or' },
  { label: 'Junction City', href: '/excavation-contractor-junction-city-or' },
  { label: 'Creswell', href: '/excavation-contractor-creswell-or' },
  { label: 'Veneta', href: '/excavation-contractor-veneta-or' },
  { label: 'Florence', href: '/excavation-contractor-florence-or' },
  { label: 'Oakridge', href: '/locations/oakridge' },
  { label: 'Coburg', href: '/excavation-contractor-coburg-or' },
  { label: 'Lowell', href: '/excavation-contractor-lowell-or' },
];
---

<footer class="bg-ink-deep text-white">
  <div class="mx-auto max-w-6xl px-6 pt-16 pb-12 grid gap-10 sm:grid-cols-2 lg:grid-cols-12">

    <!-- Brand column -->
    <div class="sm:col-span-2 lg:col-span-4 flex flex-col gap-5">
      <div class="inline-block w-fit bg-white rounded-(--radius-brand) px-3 py-2">
        <img src="/logo.png" alt="D&D Land Works" class="h-10 w-auto" />
      </div>
      <p class="text-white/60 text-sm leading-relaxed max-w-xs">
        Excavation, grading, land clearing, drainage, septic, and site prep for residential and commercial properties across Lane County, Oregon.
      </p>
      <div class="flex flex-col gap-1.5 text-sm">
        <span class="text-white/40 uppercase tracking-widest text-xs font-display font-semibold">Contact</span>
        <a href="tel:5414018726" class="text-accent-light font-display font-semibold text-xl hover:text-white transition-colors">
          541-401-8726
        </a>
        <a href="mailto:david@ddlandworks.com" class="text-white/60 hover:text-white transition-colors text-sm">
          david@ddlandworks.com
        </a>
      </div>
      <div class="flex flex-col gap-1 text-xs text-white/40">
        <span>CCB #261742 — Licensed &amp; Bonded</span>
        <span>DEQ Certified (Septic)</span>
        <span>Lane County, Oregon</span>
      </div>
      <a href="/contact" class="btn btn-cta self-start mt-1">Free Estimate</a>
    </div>

    <!-- Services column -->
    <div class="lg:col-span-3">
      <h3 class="font-display font-semibold uppercase tracking-[0.15em] text-xs text-white/40 mb-4">
        Services
      </h3>
      <ul class="flex flex-col gap-2">
        {services.map((service) => (
          <li>
            <a href={service.href} class="text-sm text-white/65 hover:text-white transition-colors">{service.label}</a>
          </li>
        ))}
      </ul>
    </div>

    <!-- Areas column -->
    <div class="lg:col-span-2">
      <h3 class="font-display font-semibold uppercase tracking-[0.15em] text-xs text-white/40 mb-4">
        Areas
      </h3>
      <ul class="flex flex-col gap-2">
        {serviceAreas.map((area) => (
          <li>
            <a href={area.href} class="text-sm text-white/65 hover:text-white transition-colors">{area.label}</a>
          </li>
        ))}
      </ul>
    </div>

    <!-- Quick links -->
    <div class="lg:col-span-3">
      <h3 class="font-display font-semibold uppercase tracking-[0.15em] text-xs text-white/40 mb-4">
        Company
      </h3>
      <ul class="flex flex-col gap-2">
        <li><a href="/about" class="text-sm text-white/65 hover:text-white transition-colors">About D&amp;D Land Works</a></li>
        <li><a href="/service-area" class="text-sm text-white/65 hover:text-white transition-colors">Full Service Area</a></li>
        <li><a href="/blog" class="text-sm text-white/65 hover:text-white transition-colors">Blog</a></li>
        <li><a href="/contact" class="text-sm text-white/65 hover:text-white transition-colors">Contact</a></li>
      </ul>
    </div>

  </div>

  <div class="border-t border-white/10">
    <div class="mx-auto max-w-6xl px-6 py-4 text-xs text-white/30 flex flex-col sm:flex-row justify-between gap-2">
      <p>&copy; {year} D&D Land Works. All rights reserved.</p>
      <p>Site by <a href="https://duckercreative.com" class="hover:text-white/60 transition-colors">Ducker Creative</a></p>
    </div>
  </div>
</footer>

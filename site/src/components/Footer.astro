---

<footer class="bg-ink text-white">
	<div class="mx-auto max-w-6xl px-4 py-14 grid gap-10 sm:grid-cols-2 lg:grid-cols-12">
		<div class="sm:col-span-2 lg:col-span-4 flex flex-col gap-4">
			<div class="inline-block w-fit rounded-(--radius-brand-card) bg-white px-4 py-3">
				<img src="/logo.png" alt="D&D Land Works" class="h-12 w-auto" />
			</div>
			<p class="font-display font-bold uppercase tracking-wide text-brand-blue-light">
				D&D Land Works
			</p>
			<p class="text-slate-300 max-w-xs">
				Excavation contractor services including site preparation, land clearing, grading,
				drainage, utility excavation, gravel driveway work, and DEQ certified septic install &amp;
				repair for Eugene, Springfield, and Lane County, OR.
			</p>
			<a href="/service-area" class="font-display font-bold text-white hover:text-brand-blue-light transition-colors">
				View Full Service Area
			</a>
			<ul class="flex flex-col gap-1.5 text-sm text-slate-400">
				{credentials.map((item) => <li>{item}</li>)}
			</ul>
		</div>

		<div class="lg:col-span-3">
			<h3 class="font-display font-bold uppercase tracking-wide text-sm text-brand-blue-light mb-4">
				Services
			</h3>
			<ul class="flex flex-col gap-2 text-slate-300 list-disc list-inside marker:text-slate-500">
				{services.map((service) => (
					<li><a href={service.href} class="hover:text-white transition-colors">{service.label}</a></li>
				))}
			</ul>
		</div>

		<div class="lg:col-span-2">
			<h3 class="font-display font-bold uppercase tracking-wide text-sm text-brand-blue-light mb-4">
				Service Areas
			</h3>
			<ul class="flex flex-col gap-2 text-slate-300 list-disc list-inside marker:text-slate-500">
				{serviceAreas.map((area) => (
					<li><a href={area.href} class="hover:text-white transition-colors">{area.label}</a></li>
				))}
			</ul>
		</div>

		<div class="lg:col-span-3">
			<h3 class="font-display font-bold uppercase tracking-wide text-sm text-brand-blue-light mb-4">
				Contact
			</h3>
			<ul class="flex flex-col gap-2 text-slate-300 list-disc list-inside marker:text-slate-500">
				{contactLinks.map((item) => (
					<li>
						{item.href ? (
							<a href={item.href} class="hover:text-white transition-colors">{item.label}</a>
						) : (
							<span>{item.label}</span>
						)}
					</li>
				))}
			</ul>
			<div class="flex flex-wrap gap-2 mt-4">
				{socialLinks.map((social) => (
					<a
						href={social.href}
						aria-label={social.label}
						class="flex h-9 w-9 items-center justify-center rounded-(--radius-brand) bg-white/10 text-white hover:bg-brand-blue transition-colors"
					>
						<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="h-4 w-4 fill-current">
							<path d={social.path} />
						</svg>
					</a>
				))}
			</div>
			<a href="tel:5414018726" class="btn btn-cta self-start mt-4">Call 541-401-8726</a>
		</div>
	</div>

	<div class="border-t border-white/10">
		<div class="mx-auto max-w-6xl px-4 py-4 text-xs text-slate-400 flex flex-col sm:flex-row justify-between gap-2">
			<p>&copy; {year} D&D Land Works. All rights reserved.</p>
			<p>Licensed &amp; Bonded, DEQ Certified</p>
		</div>
	</div>
</footer>

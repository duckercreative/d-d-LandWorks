---
import ServicePageTemplate from '../layouts/ServicePageTemplate.astro';

const inclItems = [
  { num: '01', title: 'Utility and Water Lines', desc: 'Water lines and other underground utilities may need a trench to reach the right location. The digging is separate from the plumbing or utility work that follows.', href: '/contact', accent: true },
  { num: '02', title: 'Electrical Conduit', desc: 'Electrical conduit can run underground inside a trench. D&D can handle the excavation, while the electrical work is handled by the proper electrical professional.', href: '/contact' },
  { num: '03', title: 'Irrigation Lines', desc: 'Irrigation lines may need a narrow trench across part of a property. The route can depend on the layout of the yard, ground conditions, and access.', href: '/contact' },
  { num: '04', title: 'Drainage and Ditches', desc: 'Water problems may call for a trench or ditch to give runoff a path. The right approach depends on the slope, ground, and where the water needs to go.', href: '/drainage-installation-eugene-or' },
  { num: '05', title: 'Septic-Related Excavation', desc: "Some septic projects require excavation for tanks, lines, or other parts of the system. D&D's role is the digging; septic design and related work are separate.", href: '/septic-installation-lane-county-or' },
  { num: '06', title: 'Residential Trenching', desc: "Homeowners may need trenching for several types of property work. If you're not sure what kind of trench you need, we can look at the project and explain the excavation involved.", href: '/contact' },
];

const problems = [
  { num: '01', title: 'Underground Lines', desc: 'A trench can give a water line, conduit, or other underground service a place to run. Its route depends on the project and property.', link: 'Utility Trenching', href: '/utility-trenching-eugene-or' },
  { num: '02', title: 'Moving Water', desc: 'A ditch can give rain and runoff a path to move away from an area. The slope and ground conditions help determine where the water can go.', link: 'Drainage', href: '/drainage-installation-eugene-or' },
  { num: '03', title: 'Shape and Size', desc: 'Trenches and ditches can vary in width, depth, and shape. The work depends on what the digging needs to accomplish.', link: 'Contact', href: '/contact' },
  { num: '04', title: 'Ground Conditions', desc: 'Soil, wet ground, slope, and access can affect the digging. These conditions can also affect where the trench or ditch can go.', link: 'Contact', href: '/contact' },
  { num: '05', title: 'Utility Routes', desc: 'A utility trench follows the planned route for an underground line. Existing utilities should be located before excavation begins.', link: 'Oregon 811', href: '/contact' },
  { num: '06', title: 'Choosing the Right One', desc: 'Not sure whether your project needs a trench or ditch? We can look at the property and explain what type of excavation may fit your project.', link: 'Contact', href: '/contact' },
];

const costItems = [
  { title: 'Utility Trenching', desc: 'A water line, sewer line, or electrical conduit may need a trench. We handle the digging while the proper utility or trade contractor handles installation and connections.' },
  { title: 'Irrigation Trenching', desc: 'Irrigation lines may need trenches across a yard or property. We can prepare the trench based on the planned route, ground conditions, and access.' },
  { title: 'Drainage and Ditch Digging', desc: 'Some water problems may need a trench or ditch to give runoff a path. The right approach depends on the slope, ground, and where the water needs to go.' },
  { title: 'Residential Trenching', desc: 'Home projects can need trenches for water, irrigation, drainage, or other underground work. We can look at the area and explain what the excavation may involve.' },
  { title: 'Septic-Related Excavation', desc: 'Some septic projects require digging for tanks, lines, or other parts of the system. D&D handles the excavation, while septic design and related system work remain separate.' },
  { title: 'Other Excavation Work', desc: 'Some trenching jobs are part of a larger excavation project. If your project needs more than trench digging, we can look at the site and explain what excavation may be needed.' },
];

const processSteps = [
  { num: '1', title: 'Confirm the Trench Route', desc: 'First, decide where the trench needs to run. The route should match the project and leave room around existing structures and other site features.', accent: true },
  { num: '2', title: 'Locate Underground Utilities', desc: 'Before digging, existing underground utilities should be located. This helps identify lines that may be near the planned trench.' },
  { num: '3', title: 'Check the Ground', desc: 'Look at the soil, slope, wet areas, and ground conditions. These can affect how the excavation is done and where equipment can work.' },
  { num: '4', title: 'Check Access', desc: 'Make sure there is a workable path to the digging area. Driveways, buildings, fences, and tight spaces can affect equipment access.' },
];

const faqs = [
  {
    question: 'How deep do irrigation lines need to be buried in Lane County, Oregon?',
    answer: 'Irrigation depth depends on the line, property, and project requirements. Mainlines and lateral lines may need different depths. The site conditions and planned irrigation system should guide the trench depth.',
  },
  {
    question: "What's the difference between a sprinkler mainline trench and a lateral trench?",
    answer: 'A mainline carries water to different parts of the irrigation system. Lateral lines branch off to serve sprinkler areas. Because they have different jobs, their trench requirements can also differ.',
  },
  {
    question: 'How much does trenching cost in Eugene, Oregon?',
    answer: 'Trenching cost depends on the length, depth, soil, access, slope, and site conditions. Hard ground or difficult access can add work. D&D Land Works can look at your property and provide a free estimate.',
  },
  {
    question: 'How much does it cost to trench 100 feet for irrigation?',
    answer: 'There is no single price for 100 feet of irrigation trenching. Soil, access, depth, and whether the trench crosses an existing surface can change the work. A site estimate gives you a more useful number.',
  },
  {
    question: 'Do I need to call Oregon 811 before digging an irrigation trench?',
    answer: 'Underground utilities should be located before excavation begins. Oregon 811 can help identify marked utility lines before digging. Check the current requirements for your project before work starts.',
  },
];

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'GeneralContractor',
      '@id': 'https://www.ddlandworks.com/#business',
      name: 'D&D Land Works',
      url: 'https://www.ddlandworks.com/',
      telephone: '+15414018726',
      email: 'david@ddlandworks.com',
      description: 'Full-service excavation, grading, and site preparation contractor serving Eugene, Springfield, and Lane County, Oregon. Licensed and bonded CCB #261742, DEQ Certified.',
      priceRange: '$$',
      areaServed: [
        { '@type': 'City', name: 'Eugene', sameAs: 'https://www.wikidata.org/wiki/Q49330' },
        { '@type': 'City', name: 'Springfield', sameAs: 'https://www.wikidata.org/wiki/Q49431' },
        { '@type': 'AdministrativeArea', name: 'Lane County, Oregon' },
      ],
      knowsAbout: ['Trenching', 'Utility Trenching', 'Irrigation Trenching', 'Drainage Excavation', 'Site Preparation', 'Septic Installation'],
      hasCredential: [
        { '@type': 'EducationalOccupationalCredential', credentialCategory: 'License', name: 'Oregon CCB License #261742' },
        { '@type': 'EducationalOccupationalCredential', credentialCategory: 'Certification', name: 'Oregon DEQ Certification — Septic Install & Repair' },
      ],
      sameAs: ['https://search.ccb.state.or.us/search/'],
    },
    {
      '@type': 'Service',
      '@id': 'https://www.ddlandworks.com/trenching-services-eugene-or/#service',
      name: 'Trenching Services in Eugene, Oregon',
      serviceType: 'Trenching',
      description: 'Trenching services in Eugene, Oregon for utilities, irrigation, drainage, and residential projects. D&D Land Works handles the excavation — licensed CCB #261742.',
      url: 'https://www.ddlandworks.com/trenching-services-eugene-or/',
      provider: { '@id': 'https://www.ddlandworks.com/#business' },
      areaServed: ['Eugene, Oregon', 'Springfield, Oregon', 'Lane County, Oregon'],
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.question,
        acceptedAnswer: { '@type': 'Answer', text: faq.answer },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.ddlandworks.com/' },
        { '@type': 'ListItem', position: 2, name: 'Services', item: 'https://www.ddlandworks.com/services/' },
        { '@type': 'ListItem', position: 3, name: 'Trenching', item: 'https://www.ddlandworks.com/trenching-services-eugene-or/' },
      ],
    },
  ],
};
---

<ServicePageTemplate
  pageTitle="Trenching Services in Eugene, Oregon | D&D Land Works"
  pageDescription="Trenching contractor in Eugene, Oregon. Utility trenching, irrigation trenching, drainage trenching, and residential trenching across Lane County. Licensed CCB #261742. Free estimates — 541-401-8726."
  schema={schema}
  heroEyebrow="Eugene, Oregon"
  heroH1Light="Trenching Services in"
  heroH1Bold="Eugene, Oregon"
  heroSub="Need a trench for a water line, utility, irrigation, drainage, or another project? We dig trenches for Eugene-area properties and work around the ground, slope, access, and existing site conditions. We'll look at what you need dug and explain the work before it starts."
  heroImage="/service-utility-trenching.webp"
  heroScopeLabel="Typical scope"
  heroScopeTags={['Utility Lines', 'Irrigation', 'Drainage Trenches', 'Septic Excavation', 'Residential']}
  ctxEyebrow="What to know"
  ctxH2Light="What Is"
  ctxH2Bold="Trenching?"
  ctxIntro="Trenching means digging a narrow path into the ground. The trench gives a pipe, conduit, drainage line, or other underground service a place to go. The work starts with the ground and soil on your property. The trench route, size, and depth depend on what the trench is for and the conditions around it. For larger digging needs, trenching may be part of a wider excavation project. Contact D&D Land Works to discuss what needs to be dug and how your property may affect the work."
  ctxLeft={{
    label: 'Trench',
    title: 'For Underground Lines',
    tagline: 'A trench is often made for something that needs to run underground — a pipe, conduit, or utility line from one point to another.',
    bullets: [
      'Gives a water line, conduit, or underground service a place to run',
      'Route depends on the project and the property layout',
      'Follows the planned route for an underground line',
      'Existing utilities should be located before excavation begins',
      'Width and depth depend on what the digging needs to accomplish',
    ],
  }}
  ctxRight={{
    label: 'Ditch',
    title: 'For Moving Water',
    tagline: 'A ditch is often used to move water — giving rain and runoff a path away from an area based on slope and ground conditions.',
    bullets: [
      'Gives rain and runoff a path to move away from an area',
      'Slope and ground conditions determine where the water can go',
      'Shape and size vary based on what the digging needs to accomplish',
      'Soil, wet ground, and slope can affect where the ditch goes',
      'Not sure which you need? We can look at the property and explain',
    ],
  }}
  ctxBanner="D&D Land Works handles both trenching and area excavation — often on the same project."
  inclEyebrow="What we trench"
  inclH2Light="What Kind of Project"
  inclH2Bold="Needs a Trench?"
  inclIntro="A trench can be used for many types of work. The purpose of the trench depends on what needs to go underground and where it needs to run on your property."
  inclItems={inclItems}
  probH2Light="What Is the Difference Between"
  probH2Bold="a Trench and a Ditch?"
  probIntro="A trench and a ditch are both dug into the ground, but they serve different purposes. A trench is often made for something that needs to run underground, while a ditch is often used to move water."
  probImage="/service-utility-trenching.webp"
  problems={problems}
  procH2Light="What Happens Before"
  procH2Bold="the Trench Is Dug?"
  processSteps={processSteps}
  costH2Light="What Kind of Trenching Can"
  costH2Bold="D&D Land Works Handle?"
  costIntro="On Eugene-area properties, trenching can mean different things. You may need a line across a yard, a ditch for water, or excavation for a rural property project. D&D Land Works can help with the digging and ground work needed for these projects."
  costItems={costItems}
  costClosing="Free estimates, always. David comes out, walks the property, and tells you what the job takes. No charge for the visit and no pressure after it."
  faqH2Light="Frequently Asked"
  faqH2Bold="Questions"
  faqs={faqs}
  ctaH2Light="Need a Trench Dug on Your"
  ctaH2Bold="Eugene-Area Property?"
  ctaSub="If you need a trench for water, utilities, irrigation, drainage, or another project, D&D Land Works can look at the digging involved. Call 541-401-8726 to discuss your project and get a free estimate."
/>

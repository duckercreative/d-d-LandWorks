---
import BaseLayout from '../layouts/BaseLayout.astro';

const otherAreas = [
  { label: 'Cottage Grove', href: '/excavation-contractor-cottage-grove-oregon' },
  { label: 'Junction City', href: '/excavation-contractor-junction-city-oregon' },
  { label: 'Creswell', href: '/excavation-contractor-creswell-oregon' },
  { label: 'Veneta', href: '/excavation-contractor-veneta-oregon' },
  { label: 'Florence', href: '/excavation-contractor-florence-oregon' },
  { label: 'Oakridge', href: '/locations/oakridge' },
  { label: 'Coburg', href: '/excavation-contractor-coburg-oregon' },
  { label: 'Lowell', href: '/excavation-contractor-lowell-oregon' },
];
---

<BaseLayout
  title="Service Areas | Lane County, OR Excavation Contractor | D&D Land Works"
  description="D&D Land Works provides excavation, grading, trenching, drainage, and related site work across Eugene and surrounding Lane County communities."
>
  <!-- Service Areas Section (from homepage) -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-6xl px-4 pb-20 md:pb-28">

      <div class="mb-12 md:mb-14 text-center">
        <p class="font-display font-semibold uppercase tracking-widest text-sm text-brand-blue">Our Service Area</p>
        <h1 class="mt-2 font-display font-black uppercase tracking-tight text-3xl text-ink md:text-5xl">
          Excavation Services Throughout<br class="hidden sm:block" /> Lane County, Oregon
        </h1>
        <p class="mt-5 text-slate-600 max-w-2xl mx-auto leading-relaxed">
          D&amp;D Land Works provides excavation, grading, and site preparation for residential and commercial properties across Lane County, including Eugene, Springfield, Cottage Grove, Junction City, Creswell, Veneta, Florence, Oakridge, Coburg, and Lowell.
        </p>
      </div>

      <div class="grid gap-6 lg:grid-cols-2 lg:gap-8 items-stretch">

        <!-- Dark location list -->
        <div class="overflow-hidden rounded-(--radius-brand-card) bg-ink shadow-lg">
          <a href="/excavation-contractor-eugene-oregon" class="flex items-center gap-3 bg-brand-blue px-6 py-4 text-white transition-opacity hover:opacity-90">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 21c4.4-3.4 7-7 7-10.5A7 7 0 0 0 5 10.5C5 14 7.6 17.6 12 21Z" />
              <circle cx="12" cy="10.5" r="2" fill="currentColor" stroke="none" />
            </svg>
            <span class="font-display font-bold uppercase tracking-wide text-sm">Eugene, OR</span>
          </a>
          <a href="/excavation-contractor-springfield-oregon" class="flex items-center gap-3 border-t border-white/10 px-6 py-4 text-white/70 transition-colors hover:bg-white/5 hover:text-white">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0 text-white/40" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 21c4.4-3.4 7-7 7-10.5A7 7 0 0 0 5 10.5C5 14 7.6 17.6 12 21Z" />
              <circle cx="12" cy="10.5" r="2" fill="currentColor" stroke="none" />
            </svg>
            <span class="font-display font-bold uppercase tracking-wide text-sm">Springfield, OR</span>
          </a>
          {otherAreas.map((area) => (
            <a href={area.href} class="flex items-center gap-3 border-t border-white/10 px-6 py-4 text-white/70 transition-colors hover:bg-white/5 hover:text-white">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0 text-white/40" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 21c4.4-3.4 7-7 7-10.5A7 7 0 0 0 5 10.5C5 14 7.6 17.6 12 21Z" />
                <circle cx="12" cy="10.5" r="2" fill="currentColor" stroke="none" />
              </svg>
              <span class="font-display font-bold uppercase tracking-wide text-sm">{area.label}, OR</span>
            </a>
          ))}
        </div>

        <!-- Google Map -->
        <div class="overflow-hidden rounded-(--radius-brand-card) border border-slate-200 shadow-md min-h-[400px]">
          <iframe
            title="D&D Land Works service area map, Lane County, Oregon"
            src="https://maps.google.com/maps?q=Lane+County,+Oregon&z=9&output=embed"
            width="100%"
            height="100%"
            style="border:0; display:block;"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
        </div>

      </div>

    </div>
  </section>
</BaseLayout>

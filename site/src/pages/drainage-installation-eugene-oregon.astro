---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ServiceCard from '../components/ServiceCard.astro';
import FAQ from '../components/FAQ.astro';
import CTABlock from '../components/CTABlock.astro';
import ProcessSteps from '../components/ProcessSteps.astro';

const propertyFactors = [
  { title: 'Slope', description: 'A yard that slopes toward the house sends rain straight toward the foundation. David checks the grade to understand where water is coming from and where it naturally wants to go.', href: '/contact', icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M3 20 9 8l4 6 2-3 6 9H3Z" />' },
  { title: 'Soil', description: 'Parts of Eugene have heavy clay that holds water instead of letting it drain. When David digs into the ground, he can tell pretty quickly whether the soil is part of the problem.', href: '/contact', icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M3 17h4l4-9 4 5 3-4h3M17 6h3v3" />' },
  { title: 'Low Spots', description: 'Low spots tend to collect water after rain and stay wet for days. David notes where the low areas are and whether water is pooling or just draining slowly.', href: '/contact', icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M12 3s6 7 6 11a6 6 0 1 1-12 0c0-4 6-11 6-11Z" />' },
  { title: 'Yard Layout', description: 'Driveways, patios, and walkways all change how water moves across a property. David looks at the full layout — not just the wet spot — to figure out where the water is coming from.', href: '/contact', icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M3 12l9-9 9 9M5 10v9a1 1 0 0 0 1 1h4v-5h4v5h4a1 1 0 0 0 1-1v-9" />' },
  { title: 'Existing Drainage', description: 'If your property already has ditches, pipes, or culverts, David checks whether they\'re still doing their job. Old or blocked drainage can push water in the wrong direction.', href: '/contact', icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M3 12h18M3 6h18M3 18h18" />' },
  { title: 'Site Access', description: 'Some drainage work needs equipment to get in. David checks how the machine can reach the work area and whether a tight driveway or nearby structures will affect the job.', href: '/contact', icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M9 3 5 21M15 3l4 18M12 8v2.5m0 4v2.5" />' },
];

const faqs = [
  {
    question: 'How much does French drain installation cost in Eugene, Oregon?',
    answer: 'French drain installation in Eugene averages $3,081 to $4,439 per project, based on aggregated quote data for the Eugene area (Homeyou, April 2026, 455 completed projects). The full range runs from $1,043 to $6,989 depending on system type, depth, length, and site conditions. In Willamette Valley clay, real project costs often run 2 to 3 times above national per-linear-foot baselines. Contact D&D for a free on-site estimate: 541-401-8726.',
  },
  {
    question: 'Do I need a permit to install a French drain in Eugene?',
    answer: 'For a standard residential French drain discharging to daylight or a dry well on your own property, no permit is typically required. French drains are exempt from Oregon\'s Underground Injection Control regulations per Oregon DEQ. If you want to connect the discharge to Eugene\'s city stormwater system, that tie-in requires a permit under Eugene Municipal Code Section 6.610, issued only to a property owner for their own residence, a licensed plumber, or a licensed septic installer.',
  },
  {
    question: 'What is the difference between a French drain and a curtain drain?',
    answer: 'A French drain is a buried perforated pipe in gravel, installed at 18 to 24 inches depth or deeper at a footing, designed to collect and carry groundwater to a discharge point. A curtain drain is a shallower variant, typically around 2 feet deep, that intercepts near-surface lateral water moving across the soil before it reaches a structure. Curtain drains cost less, roughly $10 to $25 per linear foot versus $45 to $85 or more per foot for a deeper French drain, and work well for lighter near-surface water problems.',
  },
  {
    question: 'Where does the water from a French drain actually go?',
    answer: 'Water from a French drain exits in one of three ways: a daylight discharge point where the pipe exits above ground at a lower elevation, a dry well that slowly infiltrates water back into the soil, or a permitted tie-in to the city\'s public stormwater system. In Eugene, the storm-system tie-in requires a permit under Municipal Code Section 6.610. The right option depends on your site\'s slope, soil conditions, and proximity to the city system.',
  },
  {
    question: 'Does Eugene\'s clay soil affect how a French drain is installed?',
    answer: 'Yes, significantly. Malpass clay in west Eugene has low permeability and high shrink-swell properties. Geotextile filter fabric is not optional in Eugene clay. Without it, fine clay particles migrate into the gravel and pipe over time, clogging the system faster than in sandy soil. Willamette Valley clay can push installation costs 2 to 3 times above national baselines due to dewatering requirements and slower excavation in saturated ground.',
  },
];

const serviceSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      '@id': 'https://www.ddlandworks.com/drainage-installation-eugene-oregon/#service',
      name: 'Drainage Installation',
      serviceType: 'Drainage Installation',
      description: 'Drainage installation services in Eugene, Springfield, and Lane County, Oregon. French drains, catch basins, swales, culverts, and surface grading to move water away from wet yards, foundations, and low spots. Licensed and bonded CCB #261742.',
      url: 'https://www.ddlandworks.com/drainage-installation-eugene-oregon/',
      provider: { '@id': 'https://www.ddlandworks.com/#business' },
      areaServed: ['Lane County, Oregon', 'Eugene, Oregon', 'Springfield, Oregon', 'Cottage Grove, Oregon', 'Junction City, Oregon', 'Creswell, Oregon', 'Veneta, Oregon', 'Florence, Oregon', 'Oakridge, Oregon', 'Coburg, Oregon', 'Lowell, Oregon'],
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.ddlandworks.com/' },
        { '@type': 'ListItem', position: 2, name: 'Services', item: 'https://www.ddlandworks.com/services/' },
        { '@type': 'ListItem', position: 3, name: 'Drainage Installation', item: 'https://www.ddlandworks.com/drainage-installation-eugene-oregon/' },
      ],
    },
  ],
};
---

<BaseLayout
  title="Drainage Installation in Eugene & Lane County, OR | D&D Land Works"
  description="French drain & drainage installation in Eugene, Springfield & Lane County, OR. Licensed, bonded, free estimates: 541-401-8726."
>
  <Hero
    eyebrow="When Water Won't Go Where You Want It"
    headline="Drainage Installation Services in Eugene, Oregon"
    subheadline="If rain leaves your yard soggy, water pools near your house, or runoff crosses your driveway, the problem may be with how water moves across your property. In Eugene, wet ground and changing site conditions can make each property different. D&D Land Works looks at the slope, soil, access, and existing drainage before planning the work."
    primaryCta={{ label: 'Call 541-401-8726', href: 'tel:5414018726' }}
    secondaryCta={{ label: 'Free Estimate', href: '/contact' }}
  />

  <!-- Why Is Water Collecting -->
  <section class="relative bg-white overflow-hidden">
    <div
      class="pointer-events-none absolute -right-32 -top-16 h-96 w-96 rounded-full bg-brand-blue-light/40 blur-3xl"
      aria-hidden="true"
    ></div>
    <div class="mx-auto max-w-6xl px-4 py-20 md:py-32">
      <div class="grid gap-12 lg:gap-20 lg:grid-cols-2 lg:items-center">
        <!-- Text column -->
        <div>
          <div class="mb-4 flex items-center gap-2">
            <img src="/logo.png" alt="" class="h-6 w-auto" aria-hidden="true" />
            <p class="font-display font-semibold uppercase tracking-widest text-sm text-brand-blue">
              Start With the Water Problem
            </p>
          </div>
          <h2 class="font-display font-black uppercase tracking-tight text-3xl text-ink md:text-4xl">
            Why Is Water Collecting on Your Property?
          </h2>
          <div class="mt-5 flex flex-col gap-4 text-slate-700 leading-relaxed">
            <p>A yard can collect water for a lot of different reasons. Sometimes a low spot holds rainwater with nowhere to go. Other times, the ground uphill is pushing water toward your house, driveway, or a corner of the yard that stays soggy for days.</p>
            <p>Soil plays a big part. In parts of Eugene, heavy clay holds water near the surface instead of letting it drain. Old ditches or pipes that are partly blocked can also change where water ends up.</p>
            <p>When David walks your property, he looks at the slope, the soil, and where the water is actually coming from — not just where it's sitting. That gives you a clearer picture of what kind of drainage work, if any, might help.</p>
          </div>
          <a href="/contact" class="btn-pill mt-8 inline-flex">
            Talk About Your Drainage
            <span class="btn-pill-icon">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M17 7H7M17 7V17" />
              </svg>
            </span>
          </a>
        </div>
        <!-- Image column -->
        <div class="relative pb-6">
          <img
            src="/before-lot.webp"
            alt="Drainage work on a Lane County, Oregon property"
            class="w-full rounded-(--radius-brand-card) object-cover aspect-4/3 shadow-xl"
            loading="lazy"
          />
          <div class="absolute bottom-10 left-4 sm:left-6 flex items-center gap-3 rounded-(--radius-brand-card) bg-brand-blue px-4 py-3 text-white shadow-lg">
            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-white/15">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 3l8 3v5c0 5.25-3.5 10.15-8 11.5C7.5 21.15 4 16.25 4 11V6l8-3Z" />
              </svg>
            </span>
            <div class="leading-tight">
              <p class="font-display font-bold text-sm">CCB #261742</p>
              <p class="font-body text-xs text-white/80">Licensed &amp; Bonded</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- What Can Cause a Drainage Problem -->
  <section id="property-factors" class="relative">
    <div class="relative bg-ink overflow-hidden">
      <img src="/project-site-excavation.webp" alt="" aria-hidden="true" class="absolute inset-0 h-full w-full object-cover opacity-45" loading="lazy" />
      <div class="absolute inset-0 bg-linear-to-b from-ink/80 via-ink/70 to-ink"></div>
      <div class="relative mx-auto max-w-3xl px-4 pt-20 pb-40 text-center md:pt-28 md:pb-52">
        <p class="font-display font-semibold uppercase tracking-widest text-sm text-brand-blue-light">What Your Property Tells Us</p>
        <h2 class="mt-2 font-display font-black uppercase tracking-tight text-3xl text-white md:text-5xl">
          What Can Cause a Drainage Problem?
        </h2>
        <p class="mt-5 text-slate-300 leading-relaxed">
          Every property moves water in its own way. Slope, soil, low spots, existing drainage, and access can all affect where water collects and how it can be moved.
        </p>
      </div>
    </div>
    <div class="relative mx-auto max-w-6xl px-4 -mt-32 pb-6 md:-mt-40">
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {propertyFactors.map((item) => <ServiceCard {...item} />)}
      </div>
    </div>
    <div class="mx-auto max-w-3xl px-4 pt-4 pb-20 md:pb-24 text-center flex flex-wrap justify-center gap-4">
      <a href="/contact" class="btn btn-cta inline-flex">Talk Through Your Project</a>
      <a href="/contact" class="btn btn-outline inline-flex">Request a Free Estimate</a>
    </div>
  </section>

  <!-- Which Drainage System -->
  <section class="bg-slate-50 border-y border-slate-200">
    <div class="mx-auto max-w-6xl px-4 py-20 md:py-28">
      <div class="mb-12 md:mb-14 text-center">
        <p class="font-display font-semibold uppercase tracking-widest text-sm text-brand-blue">Finding the Right Way to Move Water</p>
        <h2 class="mt-2 font-display font-black uppercase tracking-tight text-3xl text-ink md:text-4xl">
          Which Drainage System Might Fit Your Property?
        </h2>
        <p class="mt-4 text-slate-700 max-w-2xl mx-auto leading-relaxed">
          The right drainage approach depends on where water starts, where it collects, and where it needs to go. Your slope, soil, yard layout, and existing drainage all matter.
        </p>
      </div>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {[
          { title: 'French Drain', description: 'A French drain is a buried drain that gives water a path to move away. It may help with wet areas where water needs to be collected below the surface.', href: '/contact', linkLabel: 'Talk to David' },
          { title: 'Catch Basin', description: 'A catch basin collects water at the surface, such as water pooling in a low part of a yard. It can help when surface runoff needs a clear place to enter.', href: '/contact', linkLabel: 'Talk to David' },
          { title: 'Swale', description: 'A swale is a shallow, shaped area that helps guide surface water. It may work well when the land has enough space to direct runoff along a planned path.', href: '/contact', linkLabel: 'Talk to David' },
          { title: 'Culvert', description: 'A culvert carries water under a driveway or access area. On some rural properties, it may help keep a ditch or drainage path open where vehicles need to cross.', href: '/contact', linkLabel: 'Talk to David' },
          { title: 'Surface Grading', description: 'Changing the surface grade can help guide water away from areas where it collects. This may be useful when the shape of the ground is part of the drainage problem.', href: '/land-grading-services-eugene-oregon', linkLabel: 'Grading Services' },
          { title: 'Stormwater Drainage', description: 'Stormwater drainage helps collect and move rainwater across a property. The right approach depends on the amount of runoff, property layout, and where the water can safely go.', href: '/contact', linkLabel: 'Talk to David' },
        ].map((card) => (
          <div class="card flex flex-col gap-3">
            <h3 class="font-display font-bold uppercase tracking-wide text-base text-ink">{card.title}</h3>
            <p class="text-sm text-slate-600 leading-relaxed flex-1">{card.description}</p>
            <a href={card.href} class="inline-flex items-center gap-1 text-sm font-semibold text-brand-blue hover:underline">
              {card.linkLabel}
              <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M17 7H7M17 7V17" />
              </svg>
            </a>
          </div>
        ))}
      </div>
      <div class="mt-12 text-center">
        <a href="/contact" class="btn-pill inline-flex">
          Talk About Your Property
          <span class="btn-pill-icon">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M17 7H7M17 7V17" />
            </svg>
          </span>
        </a>
      </div>
    </div>
  </section>

  <!-- Local Ground Conditions -->
  <section class="relative bg-ink text-white overflow-hidden">
    <div
      class="pointer-events-none absolute right-0 top-0 h-[480px] w-[480px] rounded-full bg-brand-blue/10 blur-3xl"
      aria-hidden="true"
    ></div>
    <div class="relative mx-auto max-w-6xl px-4 py-20 md:py-28">
      <div class="mb-12 md:mb-16 text-center">
        <p class="font-display font-semibold uppercase tracking-widest text-sm text-brand-blue-light">Local Ground Conditions</p>
        <h2 class="mt-2 font-display font-bold uppercase tracking-tight text-3xl text-white md:text-4xl">
          What Makes Drainage Installation Different in Eugene's Soil?
        </h2>
        <p class="mt-4 text-slate-300 max-w-2xl mx-auto leading-relaxed">
          Eugene-area properties can have different soil, slopes, and wet-season conditions. These local factors can affect how water moves and what type of drainage work may fit your property.
        </p>
      </div>
      <div class="grid gap-4 sm:grid-cols-2 sm:gap-6">
        {[
          { title: 'Clay Soil', detail: 'Some areas of Eugene have clay soil that does not let water move through quickly. This can leave parts of a yard wet after rain.' },
          { title: 'Wet Low Areas', detail: 'Low parts of a property may stay wet during the rainy season. In these areas, changing the surface grade may not solve the whole drainage problem.' },
          { title: 'Hillside Runoff', detail: 'Sloped properties can send water downhill toward a house, driveway, or other part of the yard. The slope helps show where that water is coming from.' },
          { title: 'Seasonal Ground Conditions', detail: 'Wet weather can change how the ground handles drainage work. Very wet soil can also make excavation harder, so the timing and site conditions matter.' },
        ].map((item) => (
          <div class="rounded-(--radius-brand-card) bg-white/5 border border-white/10 p-6 sm:p-7">
            <p class="font-display font-bold uppercase tracking-wide text-sm text-white">{item.title}</p>
            <p class="mt-3 text-sm text-slate-300 leading-relaxed">{item.detail}</p>
          </div>
        ))}
      </div>
      <div class="mt-10 flex flex-wrap justify-center gap-4">
        <a href="/contact" class="btn btn-cta">Get a Free Estimate</a>
        <a href="tel:5414018726" class="btn btn-outline border-white/30 text-white hover:bg-white/10">Call 541-401-8726</a>
      </div>
    </div>
  </section>

  <!-- Where the Water Goes -->
  <section class="bg-white border-b border-slate-100">
    <div class="mx-auto max-w-6xl px-4 py-20 md:py-28">
      <div class="grid gap-12 lg:gap-20 lg:grid-cols-2 lg:items-center">
        <div>
          <p class="font-display font-semibold uppercase tracking-widest text-sm text-brand-blue mb-4">Where the Water Goes</p>
          <h2 class="font-display font-black uppercase tracking-tight text-3xl text-ink md:text-4xl">
            Where Does the Water From a French Drain Go?
          </h2>
          <p class="mt-5 text-slate-600 leading-relaxed">
            A French drain needs a clear place for collected water to go. The outlet depends on your property's slope, soil, drainage layout, and any local requirements that apply to the project.
          </p>
          <ul class="mt-10 flex flex-col gap-7">
            {[
              { title: 'Daylight Discharge', description: 'Water can sometimes leave the pipe at a lower point on the property. This only works when the site has enough slope to let water flow away from the drainage area.', icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M3 20 9 8l4 6 2-3 6 9H3Z" />' },
              { title: 'Dry Well', description: 'A dry well can give collected water a place to soak into the surrounding ground. Whether this approach fits depends on the soil and conditions at your property.', icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M12 3s6 7 6 11a6 6 0 1 1-12 0c0-4 6-11 6-11Z" />' },
              { title: 'Stormwater Connection', description: 'Some projects may connect to a public stormwater system when allowed. Any required local approval or permit should be confirmed before making that connection.', icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M3 12h18M3 6h18M3 18h18" />' },
            ].map((item) => (
              <li class="flex items-start gap-4">
                <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-brand-blue-light text-brand-blue mt-0.5">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" set:html={item.icon} />
                </span>
                <div>
                  <p class="font-display font-bold text-ink">{item.title}</p>
                  <p class="mt-1 text-sm text-slate-600 leading-relaxed">{item.description}</p>
                </div>
              </li>
            ))}
          </ul>
          <a href="/contact" class="btn-pill mt-10 inline-flex">
            Talk About Your Property
            <span class="btn-pill-icon">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M17 7H7M17 7V17" />
              </svg>
            </span>
          </a>
        </div>
        <div class="relative">
          <img
            src="/service-drainage-excavation.webp"
            alt="Drainage installation work on a Lane County, Oregon property"
            class="w-full rounded-(--radius-brand-card) object-cover aspect-3/4 shadow-xl"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Service Areas -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-6xl px-4 py-20 md:py-28">
      <div class="mb-12 md:mb-14 text-center">
        <p class="font-display font-semibold uppercase tracking-widest text-sm text-brand-blue">Local Service Area</p>
        <h2 class="mt-2 font-display font-black uppercase tracking-tight text-3xl text-ink md:text-5xl">
          Planning Drainage Work Around Eugene and Lane County
        </h2>
        <p class="mt-5 text-slate-600 max-w-2xl mx-auto leading-relaxed">
          Properties around Eugene, Springfield, and Lane County can have very different drainage problems. A sloped yard, wet low spot, driveway ditch, or rural property may need a different approach. David looks at the property and how water moves before recommending the work.
        </p>
      </div>
      <div class="grid gap-6 lg:grid-cols-2 lg:gap-8 items-stretch">
        <div class="overflow-hidden rounded-(--radius-brand-card) bg-ink shadow-lg">
          <a href="/locations/eugene" class="flex items-center gap-3 bg-brand-blue px-6 py-4 text-white transition-opacity hover:opacity-90">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 21c4.4-3.4 7-7 7-10.5A7 7 0 0 0 5 10.5C5 14 7.6 17.6 12 21Z" />
              <circle cx="12" cy="10.5" r="2" fill="currentColor" stroke="none" />
            </svg>
            <span class="font-display font-bold uppercase tracking-wide text-sm">Eugene, OR</span>
          </a>
          {[
            { label: 'Springfield', href: '/locations/springfield' },
            { label: 'Cottage Grove', href: '/locations/cottage-grove' },
            { label: 'Junction City', href: '/locations/junction-city' },
            { label: 'Creswell', href: '/locations/creswell' },
            { label: 'Veneta', href: '/locations/veneta' },
            { label: 'Florence', href: '/locations/florence' },
            { label: 'Oakridge', href: '/locations/oakridge' },
            { label: 'Coburg', href: '/locations/coburg' },
            { label: 'Lowell', href: '/locations/lowell' },
          ].map((area) => (
            <a href={area.href} class="flex items-center gap-3 border-t border-white/10 px-6 py-4 text-white/70 transition-colors hover:bg-white/5 hover:text-white">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0 text-white/40" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 21c4.4-3.4 7-7 7-10.5A7 7 0 0 0 5 10.5C5 14 7.6 17.6 12 21Z" />
                <circle cx="12" cy="10.5" r="2" fill="currentColor" stroke="none" />
              </svg>
              <span class="font-display font-bold uppercase tracking-wide text-sm">{area.label}, OR</span>
            </a>
          ))}
        </div>
        <div class="overflow-hidden rounded-(--radius-brand-card) border border-slate-200 shadow-md min-h-[400px]">
          <iframe
            title="D&D Land Works service area map, Lane County, Oregon"
            src="https://maps.google.com/maps?q=Lane+County,+Oregon&z=9&output=embed"
            width="100%"
            height="100%"
            style="border:0; display:block;"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
        </div>
      </div>
    </div>
  </section>

  <FAQ heading="Drainage Installation FAQs in Eugene, Oregon" items={faqs} />

  <!-- Related Services -->
  <section class="bg-white border-t border-slate-100">
    <div class="mx-auto max-w-6xl px-4 py-20 md:py-24">
      <h2 class="font-display font-black uppercase tracking-tight text-2xl text-ink text-center mb-12 md:text-3xl">
        Related Services
      </h2>
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {[
          { title: 'Site Preparation', description: 'Clearing, grading, and prepping your lot before a build starts.', href: '/services/site-preparation' },
          { title: 'Land Clearing', description: 'Removing brush and overgrowth from your property before site prep can begin.', href: '/land-clearing-services-eugene-oregon' },
          { title: 'Grading & Leveling', description: 'Rough and finish grading for building pads, yards, and drainage slope.', href: '/land-grading-services-eugene-oregon' },

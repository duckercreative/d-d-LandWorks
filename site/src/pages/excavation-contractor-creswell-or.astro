---
import LocationPageTemplate from '../layouts/LocationPageTemplate.astro';

const factsBar = [
  { label: 'Based in', value: 'Springfield, OR' },
  { label: 'Serving', value: 'Creswell & south Lane County' },
  { label: 'Licensed & bonded', value: 'CCB #261742' },
  { label: 'Septic work', value: 'DEQ certified' },
];

const services = [
  { num: '01', title: 'Site Preparation', desc: 'Getting the ground ready for a build or project. May include clearing, digging, grading, or moving soil.', href: '/site-preparation-contractor-eugene-or' },
  { num: '02', title: 'Land Grading', desc: 'Changing the shape and slope of the ground for a building area, driveway, drainage, or other planned use.', href: '/land-grading-services-eugene-or' },
  { num: '03', title: 'Land Clearing', desc: 'Removing brush, trees, debris, and overgrowth before excavation or site work can begin.', href: '/land-clearing-services-eugene-or' },
  { num: '04', title: 'Septic Excavation', desc: 'D&D handles the digging and ground work portion of septic projects. Design, permits, and evaluation are separate.', href: '/septic-installation-lane-county-or' },
  { num: '05', title: 'Drainage Work', desc: 'When water collects where it should not, excavation or grading may create a better path for it to move.', href: '/drainage-installation-eugene-or' },
  { num: '06', title: 'Trenching', desc: 'Narrow runs for utility work, drainage, or other planned underground work on your property.', href: '/trenching-services-eugene-or' },
];

const checklistItems = [
  { title: 'Before construction begins', desc: 'A building site may need clearing, grading or excavation before any other work can start.', href: '/contact' },
  { title: 'When the ground is uneven', desc: 'Areas that are too high, too low or uneven for the planned use get regraded to fit the project.', href: '/contact' },
  { title: 'When water is collecting', desc: 'Standing water around home, driveway or yard is a drainage problem with a dig-able fix.', href: '/contact' },
  { title: 'When land needs clearing', desc: 'Brush, trees and overgrowth need to be removed before excavation or grading can begin.', href: '/contact' },
  { title: 'For a septic project', desc: 'Septic systems may require excavation for the components that go into the ground.', href: '/contact' },
  { title: 'For general site work', desc: 'Access, ground conditions, depth and existing structures can change what a Creswell project involves.', href: '/contact' },
];

const processSteps = [
  { num: '1', title: 'Tell us what you need', desc: 'What you want to build, repair, clear or dig on your Creswell property.' },
  { num: '2', title: 'Discuss the property', desc: 'Location, access, slope, drainage, structures and utilities that affect the job.' },
  { num: '3', title: 'Understand the scope', desc: 'The excavation and site work explained in plain terms.' },
  { num: '4', title: 'Get your estimate', desc: 'A free estimate once the property and project are understood.', dark: true },
];

const bentoFeatures = [
  { title: 'Free estimates', desc: 'Property, access, soil and scope reviewed on site. No phone quotes off satellite photos.', dark: false },
  { title: 'Foundation excavation', desc: 'New homes, ADUs and commercial builds. One crew for clearing, grading and the foundation.', dark: true },
  { title: 'Utility & trench work', desc: 'Water service, sewer lateral, conduit and drains, with 811 locates on every trench job.', dark: true },
  { title: 'DEQ certified septic', desc: 'Tank, distribution box and drainfield excavation on south Lane County lots.', dark: false },
];

const areaLinks = [
  { label: 'Eugene', href: '/excavation-contractor-eugene-or' },
  { label: 'Springfield', href: '/excavation-contractor-springfield-or' },
  { label: 'Cottage Grove', href: '/excavation-contractor-cottage-grove-or' },
  { label: 'Lowell', href: '/excavation-contractor-lowell-or' },
  { label: 'Junction City', href: '/excavation-contractor-junction-city-or' },
  { label: 'Veneta', href: '/excavation-contractor-veneta-or' },
  { label: 'Coburg', href: '/excavation-contractor-coburg-or' },
  { label: 'Florence', href: '/excavation-contractor-florence-or' },
];

const faqs = [
  { question: 'Do you serve Creswell?', answer: 'Yes. Creswell is part of the D&D Land Works service area in south Lane County. Call 541-401-8726 with your property location and project details.' },
  { question: 'What does excavation involve?', answer: 'Excavation involves digging and moving soil to prepare land for a project. The work may also include grading, clearing, or other ground preparation depending on the property.' },
  { question: 'Can you prepare my property?', answer: 'Site preparation may include clearing, digging, grading, and moving soil. The exact work depends on what you plan to do with the property and what is already on the ground.' },
  { question: 'Can you excavate for septic?', answer: 'If your project includes septic-related excavation, D&D handles the digging and ground work portion. Septic design, permits, site evaluation, and other system requirements are separate.' },
  { question: 'What affects excavation cost in Creswell?', answer: 'Project size, ground conditions, property access, digging depth, clearing needs, existing structures, utilities, and weather can all affect cost and timeline.' },
];

const relatedServices = [
  { title: 'Site Preparation', desc: 'Clearing, grading and compaction for raw lots.', href: '/site-preparation-contractor-eugene-or' },
  { title: 'Grading & Leveling', desc: 'The right slope for drainage and a level pad.', href: '/land-grading-services-eugene-or' },
  { title: 'Foundation Excavation', desc: 'Footprints, footings, crawl spaces and basements.', href: '/foundation-excavation-eugene-or' },
  { title: 'Drainage Excavation', desc: 'French drains, swales and catch basins.', href: '/drainage-installation-eugene-or' },
];

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'GeneralContractor',
      '@id': 'https://www.ddlandworks.com/#business',
      name: 'D&D Land Works',
      url: 'https://www.ddlandworks.com/',
      telephone: '+15414018726',
      email: 'david@ddlandworks.com',
      priceRange: '$$',
      areaServed: [
        { '@type': 'City', name: 'Creswell', sameAs: 'https://www.wikidata.org/wiki/Q2102049' },
        { '@type': 'AdministrativeArea', name: 'Lane County, Oregon' },
      ],
      hasCredential: [
        { '@type': 'EducationalOccupationalCredential', credentialCategory: 'License', name: 'Oregon CCB License #261742' },
        { '@type': 'EducationalOccupationalCredential', credentialCategory: 'Certification', name: 'Oregon DEQ Certification, Septic Install & Repair' },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.question,
        acceptedAnswer: { '@type': 'Answer', text: faq.answer },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.ddlandworks.com/' },
        { '@type': 'ListItem', position: 2, name: 'Service Areas', item: 'https://www.ddlandworks.com/service-area/' },
        { '@type': 'ListItem', position: 3, name: 'Creswell', item: 'https://www.ddlandworks.com/excavation-contractor-creswell-or/' },
      ],
    },
  ],
};
---

<LocationPageTemplate
  pageTitle="Excavation Contractor in Creswell, OR | D&D Land Works"
  pageDescription="D&D Land Works provides excavation, site preparation, land clearing, grading, drainage, and septic work in Creswell, OR. CCB #261742. Free estimates, call 541-401-8726."
  schema={schema}
  cityState="Creswell, Oregon"
  heroH1Light="Excavation contractor"
  heroH1Bold="in Creswell, Oregon"
  heroSub="Creswell is roughly 15 minutes south of Eugene on I-5. D&D Land Works covers south Lane County as part of the regular service area — same schedule, same crew."
  heroImage="/service-site-preparation.webp"
  factsBar={factsBar}
  breadcrumbLabel="Creswell"
  introEyebrow="Creswell's excavation contractor"
  introH2Light="Excavation and site work"
  introH2Bold="in Creswell, Oregon"
  davidQuote="I walk every site in person before I quote it."
  introPara1="A building site may need clearing, grading, or excavation before construction can begin. The scope depends on what the property looks like and what you plan to do with it."
  introPara2="Creswell and the surrounding south Lane County area are part of the regular D&D service area. Ground conditions, access, slope, and existing structures are all looked at before quoting."
  introImage="/project-excavation-bucket.webp"
  servicesEyebrow="Our services"
  servicesH2Light="What does excavation"
  servicesH2Bold="include in Creswell?"
  servicesDesc="The scope depends on foundation depth, utility runs, drainage needs and what your ground requires before anything is built."
  services={services}
  whenEyebrow="Creswell excavation"
  whenH2Light="When does your"
  whenH2Bold="property need it?"
  whenDesc="Check off what sounds like your property. If any of these fit, a free site walk is the next step."
  checklistItems={checklistItems}
  processEyebrow="Getting started"
  processH2Light="How your Creswell"
  processH2Bold="project gets started"
  processDesc="You don't need to know the name of the service before you call. Just explain what you're trying to do and what's happening on the property."
  processSteps={processSteps}
  whyH2Light="Why Creswell calls"
  whyH2Bold="D&D Land Works"
  bentoImage="/project-grading-driveway.webp"
  bentoImageAlt="Grading and excavation work on a south Lane County property"
  bentoFeatures={bentoFeatures}
  areaEyebrow="Our service area"
  areaH2Light="Excavation in Creswell"
  areaH2Bold="and south Lane County"
  areaDesc="Based in Springfield and working south through Creswell and the surrounding rural parcels. Nearby areas we also serve:"
  areaLinks={areaLinks}
  faqH2Light="Excavation in Creswell:"
  faqH2Bold="common questions"
  faqs={faqs}
  relatedEyebrow="Related services in Creswell"
  relatedServices={relatedServices}
  ctaEyebrow="Talk with David"
  ctaH2Light="Need excavation work"
  ctaH2Bold="in Creswell?"
  ctaSub="Not sure what kind of excavation you need? Tell David what you want to do, where the work is and what problem you're solving. Free estimates, no obligation."
  ctaImage="/service-site-preparation.webp"
/>

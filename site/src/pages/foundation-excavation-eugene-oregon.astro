---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ServiceCard from '../components/ServiceCard.astro';
import FAQ from '../components/FAQ.astro';
import CTABlock from '../components/CTABlock.astro';
import ProcessSteps from '../components/ProcessSteps.astro';

const preDigItems = [
  { title: 'Foundation Layout', description: 'David uses the building plans to understand where the foundation will sit, how deep it needs to be, and where the excavation area will be.', href: '/contact', icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M9 20H4a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1h5M9 20h6M9 20V4m6 16h5a1 1 0 0 0 1-1V5a1 1 0 0 0-1-1h-5m0 16V4M9 4h6" />' },
  { title: 'Excavation Depth', description: 'The plans tell us how deep the foundation needs to go. David follows the project requirements for your property instead of using one standard depth.', href: '/contact', icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m0 0-4-4m4 4 4-4M4 8h16" />' },
  { title: 'Site Access', description: 'Equipment needs a clear path to reach the foundation area. David looks at driveways, lot width, slope, and nearby structures before the work is planned.', href: '/contact', icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M9 3 5 21M15 3l4 18M12 8v2.5m0 4v2.5" />' },
  { title: 'Existing Ground', description: 'The shape of the land affects how the excavation is approached. David looks at slope and elevation before the dig so the work fits what your property allows.', href: '/contact', icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M3 17h4l4-9 4 5 3-4h3M17 6h3v3" />' },
  { title: 'Underground Utilities', description: 'Underground utility lines need to be located before digging starts. Oregon law requires an 811 locate at least two business days before excavation begins.', href: '/contact', icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M3 12h18M3 6h18M3 18h18" />' },
  { title: 'Site Boundaries', description: 'The excavation needs to stay within the planned foundation footprint. David marks the area before digging so the work stays focused on the space your foundation requires.', href: '/contact', icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M3 3h18v18H3zM3 9h18M3 15h18M9 3v18M15 3v18" />' },
];

const faqs = [
  {
    question: 'How deep do footings need to be in Eugene, Oregon?',
    answer: 'In Lane County, exterior footings must be placed at least 12 inches below finished grade on undisturbed soil, per Oregon Residential Specialty Code R403.1.4. Lane County\'s elevation sits in the 12-inch frost protection band per ORSC Table R301.2(1). This makes 12 inches the number that governs both the code minimum and the frost protection requirement for most Eugene-area projects. Saturated Willamette Valley clay at the 12-inch depth may require over-excavation to reach firm bearing soil; a site assessment before work begins accounts for this.',
  },
  {
    question: 'What type of foundation is most common in Eugene?',
    answer: 'Crawl space foundations are the most common type in Eugene and Lane County, particularly in homes built before 2000, based on local Lane County real estate data. Slab-on-grade has become standard for newer construction and ADU projects. Full basements are the least common: Oregon\'s mild winters reduce the seasonal demand for basement space, and west Eugene\'s high winter water table complicates deep excavation and foundation drainage requirements.',
  },
  {
    question: 'How much does foundation excavation cost in Eugene, Oregon?',
    answer: 'Foundation excavation in Eugene typically ranges from $2,300 to $4,100 for a standard residential job (crawl space or slab, approximately 1 to 1.5 days of work) and $3,900 to $6,800 for full basement excavation. Hourly rates with excavator and operator run $190 to $340 per hour in Lane County. These are general market estimates based on HomeBlue data for the Eugene area. Call D&D Land Works at 541-401-8726 for a free on-site estimate.',
  },
  {
    question: 'Is there bedrock in Eugene, Oregon?',
    answer: 'No. The Willamette Valley floor has no significant bedrock. Unlike Central Oregon, where volcanic basalt sits near the surface and rock ripping or blasting is a real cost line, Lane County\'s subsurface is Willamette Valley clay and alluvial soils deposited by the Missoula Floods. The primary excavation challenge in Eugene is clay behavior during wet season, not rock. National content that includes rock cost premiums does not reflect Lane County conditions.',
  },
  {
    question: 'What is Malpass clay and does it affect foundation excavation?',
    answer: 'Malpass clay is a soil series found throughout west Eugene, documented in BLM Technical Note 447. It has high shrink-swell properties and very low permeability. In wet season (October through May), saturated Malpass clay at the 12-inch code-minimum footing depth can be too soft to support footing loads adequately, requiring over-excavation to reach firm bearing soil. D&D assesses site soil conditions before finalizing any foundation excavation quote.',
  },
  {
    question: 'How do I schedule a footing inspection in Lane County?',
    answer: 'For City of Eugene permits, schedule through the eBuild system at pdd.eugene-or.gov/ebuild or call 541-682-5283 before 7 a.m. for same-day inspection. For unincorporated Lane County, call Lane County Building Safety at 541-682-4651 with at least 48 hours of advance notice. The inspection happens after excavation, forms, and rebar are in place, and before concrete is placed. D&D coordinates the inspection timing with the GC and building department.',
  },
  {
    question: 'What does foundation excavation include for a new home?',
    answer: 'Foundation excavation for a new home covers: Oregon 811 utility locate (at least 2 business days before digging), organic topsoil stripping, excavation to footing depth (12-inch minimum per ORSC R403.1.4; deeper if soil conditions require it), over-dig working space for foundation forms and waterproofing, haul-off of excavated material, and rough perimeter grading to ORSC R401.3 grade-fall requirements. D&D coordinates the footing inspection schedule so concrete pour stays on the builder\'s timeline.',
  },
  {
    question: 'How does foundation excavation work for an ADU in Eugene?',
    answer: 'ADU foundation excavation follows the same ORSC frost-depth requirements as primary dwelling construction (12-inch minimum, R403.1.4). Foundation drainage under ORSC R405 applies to ADU basements and enclosed crawlspaces in Lane County clay soils. When excavating adjacent to an existing structure, OSHA 1926.652(b) requires underpinning or shoring. D&D coordinates the full sequence: excavation, inspection scheduling, and handoff to the GC for forming and pour.',
  },
  {
    question: 'Can you excavate for a foundation during Oregon\'s rainy season?',
    answer: 'Yes. D&D excavates year-round in Eugene and Lane County. Wet-season work (October through May) adds erosion control measures required for disturbed sites over 500 square feet under Lane County LMD rules and may require dewatering in west Eugene clay areas and low-lying valley floor sites. Wet clay haul-off runs heavier per load than dry material. If the project timeline is flexible, the dry window from May through September is the preferred scheduling window. If it is not flexible, D&D plans accordingly.',
  },
  {
    question: 'Does D&D Land Works call 811 before every foundation dig?',
    answer: 'Yes. Oregon law requires at least 2 business days of advance notice to Oregon 811 (digsafelyoregon.com) before any excavation begins. D&D submits the locate request on every job, without exception. If an unmarked utility is encountered despite a proper locate, D&D stops work and contacts the utility owner directly. Oregon 811 locate requests are free.',
  },
];

const serviceSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'GeneralContractor',
      '@id': 'https://www.ddlandworks.com/#business',
      name: 'D&D Land Works',
      url: 'https://www.ddlandworks.com/',
      telephone: '+15414018726',
      email: 'david@ddlandworks.com',
      description: 'Full-service excavation, grading, and site preparation contractor serving Eugene, Springfield, and Lane County, Oregon. Licensed and bonded CCB #261742, DEQ Certified.',
      priceRange: '$$',
      areaServed: [
        { '@type': 'City', name: 'Eugene', sameAs: 'https://www.wikidata.org/wiki/Q49330' },
        { '@type': 'City', name: 'Springfield', sameAs: 'https://www.wikidata.org/wiki/Q49431' },
        { '@type': 'AdministrativeArea', name: 'Lane County, Oregon' },
      ],
      knowsAbout: ['Foundation Excavation', 'Land Clearing', 'Site Preparation', 'Grading', 'Septic Installation'],
      hasCredential: [
        { '@type': 'EducationalOccupationalCredential', credentialCategory: 'License', name: 'Oregon CCB License #261742' },
        { '@type': 'EducationalOccupationalCredential', credentialCategory: 'Certification', name: 'Oregon DEQ Certification — Septic Install & Repair' },
      ],
      sameAs: ['https://search.ccb.state.or.us/search/'],
    },
    {
      '@type': 'Service',
      '@id': 'https://www.ddlandworks.com/foundation-excavation-eugene-oregon/#service',
      name: 'Foundation Excavation Services in Eugene, Oregon',
      serviceType: 'Foundation Excavation',
      description: 'Foundation excavation for new home construction in Eugene and Lane County, Oregon. D&D Land Works excavates to the depth and dimensions your plans call for, with footing trenching, soil haul-off, and rough grading.',
      url: 'https://www.ddlandworks.com/foundation-excavation-eugene-oregon/',
      provider: { '@id': 'https://www.ddlandworks.com/#business' },
      areaServed: ['Eugene, Oregon', 'Springfield, Oregon', 'Lane County, Oregon'],
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.question,
        acceptedAnswer: { '@type': 'Answer', text: faq.answer },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.ddlandworks.com/' },
        { '@type': 'ListItem', position: 2, name: 'Foundation Excavation', item: 'https://www.ddlandworks.com/foundation-excavation-eugene-oregon/' },
      ],
    },
  ],
};
---

<BaseLayout
  title="Foundation Excavation Services in Eugene, Oregon | D&D Land Works"
  description="Foundation excavation contractor in Eugene & Lane County, OR (CCB #261742). Basement, crawlspace & slab excavation, footing trenching, and soil haul-off. Free estimates — call 541-401-8726."
>
  <Hero
    eyebrow="Eugene, Oregon"
    headline="Foundation Excavation Services in Eugene, Oregon"
    subheadline="Building a home starts with getting the ground ready. In Eugene and around Lane County, every property can be a little different. David looks at the plans, access, slope, and ground conditions before digging so the foundation excavation fits your property."
    primaryCta={{ label: 'Call 541-401-8726', href: 'tel:5414018726' }}
    secondaryCta={{ label: 'Free Estimate', href: '/contact' }}
  />

  <!-- What Is Foundation Excavation -->
  <section class="relative bg-white overflow-hidden">
    <div
      class="pointer-events-none absolute -right-32 -top-16 h-96 w-96 rounded-full bg-brand-blue-light/40 blur-3xl"
      aria-hidden="true"
    ></div>
    <div class="mx-auto max-w-6xl px-4 py-20 md:py-32">
      <div class="grid gap-12 lg:gap-20 lg:grid-cols-2 lg:items-center">
        <!-- Text column -->
        <div>
          <div class="mb-4 flex items-center gap-2">
            <img src="/logo.png" alt="" class="h-6 w-auto" aria-hidden="true" />
            <p class="font-display font-semibold uppercase tracking-widest text-sm text-brand-blue">
              Foundation Excavation in Lane County, OR
            </p>
          </div>
          <h2 class="font-display font-black uppercase tracking-tight text-3xl text-ink md:text-4xl">
            What Is Foundation Excavation?
          </h2>
          <div class="mt-5 flex flex-col gap-4 text-slate-700 leading-relaxed">
            <p>Foundation excavation means digging the ground where a new home or other building foundation will go. The plans show where the foundation needs to go and how deep the excavation needs to be.</p>
            <p>In Eugene and Lane County, every lot is a little different. The slope, soil, and access can change how the excavation is approached. A crawl-space foundation may need a different depth and footprint than a slab or basement.</p>
            <p>David looks at the plans, the ground conditions, and site access before anything is quoted. The goal is to leave the foundation area ready for the next step of your build.</p>
          </div>
          <a href="/excavation-contractor-eugene-oregon" class="btn-pill mt-8 inline-flex">
            Excavation Contractor Eugene
            <span class="btn-pill-icon">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M17 7H7M17 7V17" />
              </svg>
            </span>
          </a>
        </div>
        <!-- Image column -->
        <div class="relative pb-6">
          <img
            src="/before-lot.webp"
            alt="Foundation excavation site preparation in Lane County, Oregon"
            class="w-full rounded-(--radius-brand-card) object-cover aspect-4/3 shadow-xl"
            loading="lazy"
          />
          <div class="absolute bottom-10 left-4 sm:left-6 flex items-center gap-3 rounded-(--radius-brand-card) bg-brand-blue px-4 py-3 text-white shadow-lg">
            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-white/15">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 3l8 3v5c0 5.25-3.5 10.15-8 11.5C7.5 21.15 4 16.25 4 11V6l8-3Z" />
              </svg>
            </span>
            <div class="leading-tight">
              <p class="font-display font-bold text-sm">CCB #261742</p>
              <p class="font-body text-xs text-white/80">Licensed &amp; Bonded</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Before We Dig -->
  <section id="before-we-dig" class="relative">
    <div class="relative bg-ink overflow-hidden">
      <img src="/project-site-excavation.webp" alt="" aria-hidden="true" class="absolute inset-0 h-full w-full object-cover opacity-45" loading="lazy" />
      <div class="absolute inset-0 bg-linear-to-b from-ink/80 via-ink/70 to-ink"></div>
      <div class="relative mx-auto max-w-3xl px-4 pt-20 pb-40 text-center md:pt-28 md:pb-52">
        <p class="font-display font-semibold uppercase tracking-widest text-sm text-brand-blue-light">Before We Dig</p>
        <h2 class="mt-2 font-display font-black uppercase tracking-tight text-3xl text-white md:text-5xl">
          What Needs to Happen Before the Foundation Is Dug?
        </h2>
        <p class="mt-5 text-slate-300 leading-relaxed">
          Every Eugene property is different. Soil, slope, wet ground, and site access can change how the work is planned. Before digging, we look at the plans and the actual property so the excavation fits the job.
        </p>
      </div>
    </div>
    <div class="relative mx-auto max-w-6xl px-4 -mt-32 pb-6 md:-mt-40">
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {preDigItems.map((item) => <ServiceCard {...item} />)}
      </div>
    </div>
    <div class="mx-auto max-w-3xl px-4 pt-4 pb-20 md:pb-24 text-center flex flex-wrap justify-center gap-4">
      <a href="/contact" class="btn btn-cta inline-flex">Talk Through Your Project</a>
      <a href="/contact" class="btn btn-outline inline-flex">Request a Free Estimate</a>
    </div>
  </section>

  <!-- Site Conditions That Matter -->
  <section class="bg-slate-50 border-y border-slate-200">
    <div class="mx-auto max-w-6xl px-4 py-20 md:py-28">
      <div class="mb-12 md:mb-14 text-center">
        <p class="font-display font-semibold uppercase tracking-widest text-sm text-brand-blue">Site Conditions That Matter</p>
        <h2 class="mt-2 font-display font-black uppercase tracking-tight text-3xl text-ink md:text-4xl">
          How Do Soil, Slope, and Wet Ground Affect Foundation Excavation?
        </h2>
        <p class="mt-4 text-slate-700 max-w-2xl mx-auto leading-relaxed">
          Eugene-area properties can look very different from one lot to the next. David looks at the slope, soil, access, and wet ground conditions before digging because those details can change how your excavation needs to be done.
        </p>
      </div>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {[
          { title: 'Soil', description: 'In the Willamette Valley, clay-heavy soils behave differently than looser or drier ground. The soil on your lot can affect how equipment works and how the excavation is approached.', href: '/contact', linkLabel: 'Talk to David' },
          { title: 'Slope', description: 'A sloped lot can have different elevations across the foundation area. David looks at the existing grade to understand how the excavation needs to follow your foundation plans.', href: '/land-grading-services-eugene-oregon', linkLabel: 'Grading & Leveling' },
          { title: 'Elevation', description: 'An uneven lot may require more soil to be removed in some areas than others. The plans and existing grade guide where the excavation goes and how much needs to come out.', href: '/contact', linkLabel: 'Talk to David' },
          { title: 'Wet Ground', description: "Eugene's rainy season runs October through May. Saturated ground can affect equipment access and may change the timing of the work. David checks conditions before the dig starts.", href: '/drainage-installation-eugene-oregon', linkLabel: 'Drainage Solutions' },
          { title: 'Site Access', description: 'Equipment needs a clear path to the foundation area. Tight driveways, fencing, neighboring structures, or a narrow lot can all affect how the work is planned.', href: '/contact', linkLabel: 'Talk to David' },
          { title: 'Existing Structures', description: 'Excavating near a building already on the property requires extra care. David looks at where the new foundation sits relative to any existing structures before work begins.', href: '/contact', linkLabel: 'Talk to David' },
        ].map((card) => (
          <div class="card flex flex-col gap-3">
            <h3 class="font-display font-bold uppercase tracking-wide text-base text-ink">{card.title}</h3>
            <p class="text-sm text-slate-600 leading-relaxed flex-1">{card.description}</p>
            <a href={card.href} class="inline-flex items-center gap-1 text-sm font-semibold text-brand-blue hover:underline">
              {card.linkLabel}
              <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M17 7H7M17 7V17" />
              </svg>
            </a>
          </div>
        ))}
      </div>
      <div class="mt-12 text-center">
        <a href="/contact" class="btn-pill inline-flex">
          Talk About Your Property
          <span class="btn-pill-icon">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M17 7H7M17 7V17" />
            </svg>
          </span>
        </a>
      </div>
    </div>
  </section>

  <!-- How Does a Foundation Excavation Work -->
  <section class="relative bg-ink text-white overflow-hidden">
    <div
      class="pointer-events-none absolute right-0 top-0 h-[480px] w-[480px] rounded-full bg-brand-blue/10 blur-3xl"
      aria-hidden="true"
    ></div>
    <div class="relative mx-auto max-w-6xl px-4 py-20 md:py-28">
      <div class="mb-12 md:mb-16 text-center">
        <h2 class="font-display font-bold uppercase tracking-tight text-3xl text-white md:text-4xl">
          How Does a Foundation Excavation Work?
        </h2>
        <p class="mt-4 text-slate-300 max-w-2xl mx-auto leading-relaxed">
          Every foundation dig is a little different. In Eugene and Lane County, the plans tell us what needs to be built, while the actual ground conditions on your lot tell us what the excavation will be like.
        </p>
      </div>
      <div class="grid gap-4 sm:grid-cols-2 sm:gap-6">
        {[
          { title: 'Marking the Foundation Area', detail: 'The foundation area is marked before digging starts. This shows where the excavation needs to go and keeps the work in line with the plans.' },
          { title: 'Digging to the Required Depth', detail: 'Soil is removed until the planned depth is reached. The depth depends on the foundation plans and the conditions found on the property.' },
          { title: 'Moving the Excavated Soil', detail: 'Digging leaves soil that needs to be managed. Depending on the property and project, some soil may stay on site or need to be moved elsewhere.' },
          { title: 'Checking the Finished Grade', detail: 'The excavation is checked against the planned depth and ground levels. This helps leave the foundation area ready for the next stage of construction.' },
        ].map((item) => (
          <div class="rounded-(--radius-brand-card) bg-white/5 border border-white/10 p-6 sm:p-7">
            <p class="font-display font-bold uppercase tracking-wide text-sm text-white">{item.title}</p>
            <p class="mt-3 text-sm text-slate-300 leading-relaxed">{item.detail}</p>
          </div>
        ))}
      </div>
      <div class="mt-10 flex flex-wrap justify-center gap-4">
        <a href="/contact" class="btn btn-cta">Get a Free Estimate</a>
        <a href="tel:5414018726" class="btn btn-outline border-white/30 text-white hover:bg-white/10">Call 541-401-8726</a>
      </div>
    </div>
  </section>

  <!-- What Can Make the Dig Harder -->
  <section class="bg-white border-b border-slate-100">
    <div class="mx-auto max-w-6xl px-4 py-20 md:py-28">
      <div class="grid gap-12 lg:gap-20 lg:grid-cols-2 lg:items-center">
        <div>
          <p class="font-display font-semibold uppercase tracking-widest text-sm text-brand-blue mb-4">What Can Make the Dig Harder?</p>
          <h2 class="font-display font-black uppercase tracking-tight text-3xl text-ink md:text-4xl">
            How Does Foundation Excavation Work on Your Property?
          </h2>
          <p class="mt-5 text-slate-600 leading-relaxed">
            Every foundation dig is different. Rain, soil, slope, access, nearby buildings, and excavation depth can change how the work is planned and carried out.
          </p>
          <ul class="mt-10 flex flex-col gap-7">
            {[
              { title: 'Rain and Wet Ground', description: 'Wet ground can make equipment access harder and may affect when excavation can safely move forward. Weather can also change the work schedule.', icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M12 3s6 7 6 11a6 6 0 1 1-12 0c0-4 6-11 6-11Z" />' },
              { title: 'Clay and Soft Soil', description: 'Soil conditions can vary from one property to another. Clay or soft ground may affect digging conditions and how equipment moves around the site.', icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M3 17h4l4-9 4 5 3-4h3M17 6h3v3" />' },
              { title: 'Sloped Lots', description: 'A sloped lot can have different elevations across the foundation area. The plans and existing grade guide how the excavation is approached.', icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M3 20 9 8l4 6 2-3 6 9H3Z" />' },
              { title: 'Tight Lots and Hard-to-Reach Spots', description: 'Limited access can make it harder to bring equipment into the foundation area. Nearby fences, driveways, or structures may also limit working space.', icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M9 3 5 21M15 3l4 18M12 8v2.5m0 4v2.5" />' },
              { title: 'Digging Close to an Existing Building', description: 'Excavation near an existing building requires careful planning. The available space, ground conditions, and location of the new foundation all matter.', icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M3 12l9-9 9 9M5 10v9a1 1 0 0 0 1 1h4v-5h4v5h4a1 1 0 0 0 1-1v-9" />' },
              { title: 'Deeper Digs Need Extra Care', description: 'Deeper excavations require more planning than a shallow foundation dig. The depth, soil, access, and site conditions all affect how the work is handled.', icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m0 0-4-4m4 4 4-4" />' },
            ].map((item) => (
              <li class="flex items-start gap-4">
                <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-brand-blue-light text-brand-blue mt-0.5">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" set:html={item.icon} />
                </span>
                <div>
                  <p class="font-display font-bold text-ink">{item.title}</p>
                  <p class="mt-1 text-sm text-slate-600 leading-relaxed">{item.description}</p>
                </div>
              </li>
            ))}
          </ul>
          <a href="/contact" class="btn-pill mt-10 inline-flex">
            Talk About Your Property
            <span class="btn-pill-icon">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M17 7H7M17 7V17" />
              </svg>
            </span>
          </a>
        </div>
        <div class="relative">
          <img
            src="/service-land-clearing.webp"
            alt="Excavator digging a foundation on a Lane County, Oregon property"
            class="w-full rounded-(--radius-brand-card) object-cover aspect-3/4 shadow-xl"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Service Areas -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-6xl px-4 py-20 md:py-28">
      <div class="mb-12 md:mb-14 text-center">
        <p class="font-display font-semibold uppercase tracking-widest text-sm text-brand-blue">Serving Eugene and Lane County</p>

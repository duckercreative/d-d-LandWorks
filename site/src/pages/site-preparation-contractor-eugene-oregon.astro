---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ServiceCard from '../components/ServiceCard.astro';
import FAQ from '../components/FAQ.astro';
import CTABlock from '../components/CTABlock.astro';

const sitePrepItems = [
  { title: 'Land Clearing', description: 'Land clearing removes brush, plants, debris, and other things that get in the way. This opens the work area so the ground can be graded and prepared.', href: '/land-clearing-services-eugene-oregon', icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M12 2 8 9h2l-3 6h3v6h4v-6h3l-3-6h2L12 2Z" />' },
  { title: 'Topsoil Stripping', description: 'Topsoil stripping removes the loose soil at the surface before deeper ground work begins. Usable topsoil can sometimes be saved for later use on the property.', href: '/site-preparation-contractor-eugene-oregon', icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M9 20 4 18V4l5 2 6-2 5 2v14l-5-2-6 2Z M9 4v14M15 6v14" />' },
  { title: 'Cut and Fill', description: 'Cut and fill means moving soil from one part of the property to another. This can help create the ground shape and height needed for the planned construction.', href: '/land-grading-services-eugene-oregon', icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M3 17h4l4-9 4 5 3-4h3M17 6h3v3" />' },
  { title: 'Grading', description: 'Grading shapes the ground to the needed slope and level. It can help prepare building areas and guide water where it needs to go.', href: '/land-grading-services-eugene-oregon', icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M3 20 9 8l4 6 2-3 6 9H3Z" />' },
  { title: 'Compaction', description: 'Compaction firms up prepared ground before the next stage of construction. The amount of work needed depends on the soil, ground conditions, and what will be built on the site.', href: '/site-preparation-contractor-eugene-oregon', icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 10h16M4 14h16M4 18h16" />' },
];

const problemCards = [
  {
    title: 'Raw or Undeveloped Land',
    description: 'Raw land may have brush, debris, uneven ground, or loose surface soil. Clearing and grading can open the area and prepare it for construction.',
    icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M3 20 9 8l4 6 2-3 6 9H3Z" />',
    href: '/site-preparation-contractor-eugene-oregon',
    linkLabel: 'Site Preparation',
  },
  {
    title: 'Poor Grading',
    description: 'Uneven or poorly shaped ground can make construction harder and affect how water moves across the property. Grading can reshape the area to match the needs of the project.',
    icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M3 17h4l4-9 4 5 3-4h3M17 6h3v3" />',
    href: '/land-grading-services-eugene-oregon',
    linkLabel: 'Grading & Leveling',
  },
  {
    title: 'Drainage and Surface Water',
    description: 'Water that collects on the property can create problems for construction and future use. Grading and excavation may help improve how surface water moves across the site.',
    icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M12 3s6 7 6 11a6 6 0 1 1-12 0c0-4 6-11 6-11Z" />',
    href: '/drainage-installation-eugene-oregon',
    linkLabel: 'Drainage Excavation',
  },
  {
    title: 'Difficult Site Access',
    description: 'A narrow, rough, or damaged access route can make it harder to bring equipment and materials onto the property. We can address site access where it is part of the planned work.',
    icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M9 3 5 21M15 3l4 18M12 8v2.5m0 4v2.5" />',
    href: '/services/driveway-repair',
    linkLabel: 'Driveway Repair',
  },
];

const howItWorksSteps = [
  { step: '1', title: 'Look at the Property', detail: 'We look at the work area, ground, drainage, access, and other conditions that may affect the job. This helps us understand what preparation is needed.' },
  { step: '2', title: 'Clear the Site', detail: 'We remove brush, vegetation, debris, and other obstacles from the work area so there is room to complete the planned site work.' },
  { step: '3', title: 'Shape the Ground', detail: 'We move and shape soil where needed to create the grades and levels required for the project. This may include cutting, filling, grading, or leveling.' },
  { step: '4', title: 'Prepare the Ground', detail: 'After the earthwork is complete, the ground may need to be compacted before the next stage of construction. The amount of work depends on the soil and project needs.' },
];

const whySitePrepItems = [
  {
    title: 'Licensed and Bonded',
    description: 'D&D Land Works is licensed and bonded in Oregon under CCB #261742. You can verify the license through the Oregon Construction Contractors Board.',
    icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M12 3l8 3v5c0 5.25-3.5 10.15-8 11.5C7.5 21.15 4 16.25 4 11V6l8-3Z" />',
    link: { label: 'Verify CCB License', href: 'https://search.ccb.state.or.us/search/' },
  },
  {
    title: 'Free Estimates',
    description: 'We provide free estimates for site preparation work. We can look at the property, access, ground conditions, and planned work before the scope is set.',
    icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M9 3h6a1 1 0 0 1 1 1v1H8V4a1 1 0 0 1 1-1Z M7 6h10v14a1 1 0 0 1-1 1H8a1 1 0 0 1-1-1V6Z M9 12.5l2 2 4-4.5" />',
  },
  {
    title: 'Residential Projects',
    description: 'We prepare residential properties for construction and other improvements in Eugene, Springfield, and nearby Lane County communities.',
    icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M5 21V7l7-4 7 4v14M3 21h18M9 21v-4h6v4" />',
  },
  {
    title: 'Commercial Projects',
    description: 'We also handle site preparation for commercial properties and construction projects. The work depends on the property and what needs to be prepared.',
    icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M3 21V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v16M9 21v-6h6v6M3 21h18" />',
  },
  {
    title: 'DEQ Certified for Septic Work',
    description: 'D&D Land Works is DEQ certified for relevant septic installation and repair work, including excavation connected with applicable septic projects.',
    icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M6 7c0-1.7 2.7-3 6-3s6 1.3 6 3v10c0 1.7-2.7 3-6 3s-6-1.3-6-3V7Z M6 7c0 1.7 2.7 3 6 3s6-1.3 6-3" />',
  },
];

const faqs = [
  {
    question: 'Do I Need Site Preparation Before Building?',
    answer: 'Most construction sites need some level of site preparation before building. The required work depends on existing ground conditions, vegetation, elevations, access, drainage, and the planned construction. A cleared, level property may require less preparation than a raw lot.',
  },
  {
    question: 'What Does Site Preparation Include?',
    answer: "Site preparation can include land clearing, topsoil stripping, cut and fill, grading, leveling, and subgrade compaction. The exact scope depends on the property's existing conditions and construction requirements, including planned elevations, access, drainage, and the type of project.",
  },
  {
    question: 'Does Site Preparation Require a Permit?',
    answer: 'Permit requirements depend on the project, location, and type of site work involved. Lane County requirements may apply to grading, fill, erosion prevention, or access work, while larger disturbances may also involve Oregon DEQ stormwater requirements.',
  },
  {
    question: 'How Do Soil Conditions Affect Site Preparation Cost?',
    answer: 'Soil conditions can change the amount and type of site preparation required. Rock, heavy clay, poor ground, or buried materials may require additional excavation, equipment, hauling, or preparation. These conditions can increase project complexity and affect the overall cost.',
  },
  {
    question: 'Does Rain Affect Site Preparation Work?',
    answer: 'Rain can affect site preparation when ground becomes wet or difficult to work. Wet soil may influence grading, compaction, access, and drainage work. Project timing can therefore depend on weather, existing soil conditions, site access, and the amount of earthwork required.',
  },
];

const pageSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'GeneralContractor',
      '@id': 'https://www.ddlandworks.com/#business',
      name: 'D&D Land Works',
      url: 'https://www.ddlandworks.com/',
      telephone: '+15414018726',
      email: 'david@ddlandworks.com',
      description: 'Full-service excavation, grading, and site preparation contractor serving Eugene, Springfield, and Lane County, Oregon. Licensed and bonded CCB #261742, DEQ Certified.',
      priceRange: '$$',
      areaServed: [
        { '@type': 'City', name: 'Eugene' },
        { '@type': 'City', name: 'Springfield', sameAs: 'https://www.wikidata.org/wiki/Q49431' },
        { '@type': 'AdministrativeArea', name: 'Lane County, Oregon' },
      ],
      knowsAbout: ['Site Preparation', 'Land Clearing', 'Grading', 'Excavation', 'Septic Installation', 'Drainage Excavation'],
      hasCredential: [
        { '@type': 'EducationalOccupationalCredential', credentialCategory: 'License', name: 'Oregon CCB License #261742' },
        { '@type': 'EducationalOccupationalCredential', credentialCategory: 'Certification', name: 'Oregon DEQ Certification — Septic Install & Repair' },
      ],
      sameAs: ['https://search.ccb.state.or.us/search/'],
    },
    {
      '@type': 'Service',
      '@id': 'https://www.ddlandworks.com/site-preparation-contractor-eugene-oregon/#service',
      name: 'Site Preparation Contractor in Eugene, Oregon',
      serviceType: 'Site Preparation',
      description: 'Land clearing, grading, compacting, and construction-ready lot preparation for residential and commercial projects in Eugene and Lane County, Oregon.',
      url: 'https://www.ddlandworks.com/site-preparation-contractor-eugene-oregon/',
      provider: { '@id': 'https://www.ddlandworks.com/#business' },
      areaServed: ['Eugene, Oregon', 'Springfield, Oregon', 'Lane County, Oregon'],
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.question,
        acceptedAnswer: { '@type': 'Answer', text: faq.answer },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.ddlandworks.com/' },
        { '@type': 'ListItem', position: 2, name: 'Services', item: 'https://www.ddlandworks.com/services/' },
        { '@type': 'ListItem', position: 3, name: 'Site Preparation', item: 'https://www.ddlandworks.com/site-preparation-contractor-eugene-oregon/' },
      ],
    },
  ],
};
---

<BaseLayout
  title="Site Preparation Contractor in Eugene, Oregon | D&D Land Works"
  description="Site preparation contractor in Eugene, Oregon. Land clearing, grading, compacting, and construction-ready lot prep. Licensed and bonded. CCB #261742. Get a free estimate from D&D Land Works."
>
  <Hero
    eyebrow="Eugene, Oregon"
    headline="Site Preparation Contractor in Eugene, Oregon"
    subheadline="Getting a property ready to build can mean clearing brush, moving soil, grading the ground, or fixing access and drainage problems. D&D Land Works looks at your property and the work you need done, then helps prepare the ground for the next step. We serve Eugene and surrounding Lane County communities."
    primaryCta={{ label: 'Call 541-401-8726', href: 'tel:5414018726' }}
    secondaryCta={{ label: 'Free Estimate', href: '/contact' }}
  />

  <!-- Site Prep vs Excavation -->
  <section class="relative bg-white overflow-hidden">
    <div
      class="pointer-events-none absolute -right-32 -top-16 h-96 w-96 rounded-full bg-brand-blue-light/40 blur-3xl"
      aria-hidden="true"
    ></div>
    <div class="mx-auto max-w-6xl px-4 py-20 md:py-32">
      <div class="grid gap-12 lg:gap-20 lg:grid-cols-2 lg:items-center">
        <div>
          <div class="mb-4 flex items-center gap-2">
            <img src="/logo.png" alt="" class="h-6 w-auto" aria-hidden="true" />
            <p class="font-display font-semibold uppercase tracking-widest text-sm text-brand-blue">
              Site Preparation vs. Excavation
            </p>
          </div>
          <h2 class="font-display font-black uppercase tracking-tight text-3xl text-ink md:text-4xl">
            What's the Difference Between Site Preparation and Excavation?
          </h2>
          <div class="mt-5 flex flex-col gap-4 text-slate-700 leading-relaxed">
            <p>Site preparation is the work that gets your property ready for construction. It may include clearing brush, removing soil, grading the ground, leveling areas, or improving access.</p>
            <p>Excavation is more focused on digging. It can include digging for foundations, utilities, drainage, or other parts of a project.</p>
            <p>A project may need both. Site preparation gets the property ready, while excavation digs the areas needed for the next step. The work depends on your property, plans, ground conditions, access, and drainage.</p>
          </div>
          <a href="/about" class="btn-pill mt-8 inline-flex">
            Learn More About D&amp;D Land Works
            <span class="btn-pill-icon">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M17 7H7M17 7V17" />
              </svg>
            </span>
          </a>
        </div>
        <div class="relative pb-6">
          <img
            src="/project-excavation-bucket.webp"
            alt="D&D Land Works excavation contractor working in Lane County, Oregon"
            class="w-full rounded-(--radius-brand-card) object-cover aspect-4/3 shadow-xl"
            loading="lazy"
          />
          <div class="absolute bottom-10 left-4 sm:left-6 flex items-center gap-3 rounded-(--radius-brand-card) bg-brand-blue px-4 py-3 text-white shadow-lg">
            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-white/15">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 3l8 3v5c0 5.25-3.5 10.15-8 11.5C7.5 21.15 4 16.25 4 11V6l8-3Z" />
              </svg>
            </span>
            <div class="leading-tight">
              <p class="font-display font-bold text-sm">CCB #261742</p>
              <p class="font-body text-xs text-white/80">Licensed &amp; Bonded</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- What Does Site Preparation Include -->
  <section id="services" class="relative">
    <div class="relative bg-ink overflow-hidden">
      <img src="/project-site-excavation.webp" alt="" aria-hidden="true" class="absolute inset-0 h-full w-full object-cover opacity-45" loading="lazy" />
      <div class="absolute inset-0 bg-linear-to-b from-ink/80 via-ink/70 to-ink"></div>
      <div class="relative mx-auto max-w-3xl px-4 pt-20 pb-40 text-center md:pt-28 md:pb-52">
        <p class="font-display font-semibold uppercase tracking-widest text-sm text-brand-blue-light">Our Services</p>
        <h2 class="mt-2 font-display font-black uppercase tracking-tight text-3xl text-white md:text-5xl">
          What Does Site Preparation Include?
        </h2>
        <p class="mt-5 text-slate-300 leading-relaxed">
          Site preparation is the work that gets your property ready for construction. The work may include clearing, removing soil, moving dirt, grading, and preparing the ground. What is needed depends on your property and the planned project.
        </p>
      </div>
    </div>
    <div class="relative mx-auto max-w-6xl px-4 -mt-32 pb-6 md:-mt-40">
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {sitePrepItems.map((item) => <ServiceCard {...item} />)}
      </div>
    </div>
    <div class="mx-auto max-w-3xl px-4 pt-4 pb-20 md:pb-24 text-center flex flex-wrap justify-center gap-4">
      <a href="/services" class="btn btn-cta inline-flex">Explore Our Services</a>
      <a href="/contact" class="btn btn-outline inline-flex">Request a Free Estimate</a>
    </div>
  </section>

  <!-- Common Property Problems -->
  <section class="bg-slate-50 border-y border-slate-200">
    <div class="mx-auto max-w-6xl px-4 py-20 md:py-28">
      <div class="mb-12 md:mb-14 text-center">
        <p class="font-display font-semibold uppercase tracking-widest text-sm text-brand-blue">We Can Help</p>
        <h2 class="mt-2 font-display font-black uppercase tracking-tight text-3xl text-ink md:text-4xl">
          Site Preparation Problems We Help Address
        </h2>
        <p class="mt-4 text-slate-700 max-w-2xl mx-auto leading-relaxed">
          Your property may need some work before construction can begin. Brush, uneven ground, standing water, or poor access can all make a site harder to use. We look at the existing conditions and help prepare the property for the next step.
        </p>
      </div>
      <div class="grid gap-6 sm:grid-cols-2">
        {problemCards.map((card) => (
          <div class="card flex gap-5 items-start">
            <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-brand-blue-light text-brand-blue">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" set:html={card.icon} />
            </span>
            <div>
              <h3 class="font-display font-bold uppercase tracking-wide text-base text-ink">{card.title}</h3>
              <p class="mt-2 text-sm text-slate-600 leading-relaxed">{card.description}</p>
              {card.href && (
                <a href={card.href} class="mt-3 inline-flex items-center gap-1 text-sm font-semibold text-brand-blue hover:underline">
                  {card.linkLabel}
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M17 7H7M17 7V17" />
                  </svg>
                </a>
              )}
            </div>
          </div>
        ))}
      </div>
      <div class="mt-12 text-center">
        <a href="/contact" class="btn-pill inline-flex">
          Discuss Your Excavation Project
          <span class="btn-pill-icon">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M17 7H7M17 7V17" />
            </svg>
          </span>
        </a>
      </div>
    </div>
  </section>

  <!-- How It Works -->
  <section class="relative bg-ink text-white overflow-hidden">
    <div
      class="pointer-events-none absolute right-0 top-0 h-[480px] w-[480px] rounded-full bg-brand-blue/10 blur-3xl"
      aria-hidden="true"
    ></div>
    <div class="relative mx-auto max-w-6xl px-4 py-20 md:py-28">
      <div class="mb-12 md:mb-16 text-center">
        <p class="font-display font-semibold uppercase tracking-widest text-sm text-brand-blue-light">How It Works</p>
        <h2 class="mt-2 font-display font-bold uppercase tracking-tight text-3xl text-white md:text-4xl">
          How the Site Preparation Process Works
        </h2>
        <p class="mt-4 text-slate-300 max-w-2xl mx-auto leading-relaxed">
          Every property is different. We first look at the site and what you plan to build. Then we clear, shape, and prepare the ground based on what the property needs.
        </p>
      </div>
      <div class="grid gap-4 sm:grid-cols-2 sm:gap-6 lg:grid-cols-4">
        {howItWorksSteps.map((item) => (
          <div class="rounded-(--radius-brand-card) bg-white/5 border border-white/10 p-6 sm:p-7">
            <span class="flex h-10 w-10 items-center justify-center rounded-full bg-safety-orange font-display font-bold text-white text-sm">
              {item.step}
            </span>
            <p class="mt-4 font-display font-bold uppercase tracking-wide text-sm text-white">{item.title}</p>
            <p class="mt-2 text-sm text-slate-300 leading-relaxed">{item.detail}</p>
          </div>
        ))}
      </div>
      <div class="mt-12 text-center">
        <a href="/contact" class="btn btn-cta">Discuss Your Project</a>
      </div>
    </div>
  </section>

  <!-- Why Choose D&D Land Works -->
  <section class="bg-white border-b border-slate-100">
    <div class="mx-auto max-w-6xl px-4 py-20 md:py-28">
      <div class="grid gap-12 lg:gap-20 lg:grid-cols-2 lg:items-center">
        <div>
          <h2 class="font-display font-black uppercase tracking-tight text-3xl text-ink md:text-4xl">
            Why Choose <span class="text-brand-blue">D&amp;D Land Works</span> for Site Preparation?
          </h2>
          <p class="mt-5 text-slate-600 leading-relaxed">
            Site preparation can look different from one property to another. D&amp;D Land Works works with homeowners, builders, and property owners in Eugene and Lane County to prepare the ground for the next stage of their project.
          </p>
          <ul class="mt-10 flex flex-col gap-7">
            {whySitePrepItems.map((item) => (
              <li class="flex items-start gap-4">
                <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-brand-blue-light text-brand-blue mt-0.5">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" set:html={item.icon} />
                </span>
                <div>
                  <p class="font-display font-bold text-ink">{item.title}</p>
                  <p class="mt-1 text-sm text-slate-600 leading-relaxed">{item.description}</p>
                  {item.link && (
                    <a
                      href={item.link.href}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="mt-1 inline-block text-sm font-semibold text-brand-blue hover:underline"
                    >
                      {item.link.label}
                    </a>
                  )}
                </div>
              </li>
            ))}
          </ul>
          <a href="/contact" class="btn-pill mt-10 inline-flex">
            Request a Free Estimate
            <span class="btn-pill-icon">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M17 7H7M17 7V17" />
              </svg>
            </span>
          </a>
        </div>
        <div class="relative">
          <img
            src="/project-grading-driveway.webp"
            alt="D&D Land Works site preparation work in Lane County, Oregon"
            class="w-full rounded-(--radius-brand-card) object-cover aspect-3/4 shadow-xl"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Service Areas -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-6xl px-4 py-20 md:py-28">
      <div class="mb-12 md:mb-14 text-center">
        <p class="font-display font-semibold uppercase tracking-widest text-sm text-brand-blue">Our Service Area</p>
        <h2 class="mt-2 font-display font-black uppercase tracking-tight text-3xl text-ink md:text-5xl">
          Site Preparation Services in Eugene and Lane County
        </h2>
        <p class="mt-5 text-slate-600 max-w-2xl mx-auto leading-relaxed">
          D&amp;D Land Works provides site preparation for properties in Eugene and nearby Lane County communities. We also serve Springfield, Cottage Grove, Junction City, Creswell, Veneta, Florence, Oakridge, Coburg, and Lowell, depending on the project and location.
        </p>
      </div>
      <div class="grid gap-6 lg:grid-cols-2 lg:gap-8 items-stretch">
        <div class="overflow-hidden rounded-(--radius-brand-card) bg-ink shadow-lg">
          <a href="/locations/eugene" class="flex items-center gap-3 bg-brand-blue px-6 py-4 text-white transition-opacity hover:opacity-90">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 21c4.4-3.4 7-7 7-10.5A7 7 0 0 0 5 10.5C5 14 7.6 17.6 12 21Z" />
              <circle cx="12" cy="10.5" r="2" fill="currentColor" stroke="none" />
            </svg>
            <span class="font-display font-bold uppercase tracking-wide text-sm">Eugene, OR</span>
          </a>
          {[
            { label: 'Springfield', href: '/locations/springfield' },
            { label: 'Cottage Grove', href: '/locations/cottage-grove' },
            { label: 'Junction City', href: '/locations/junction-city' },

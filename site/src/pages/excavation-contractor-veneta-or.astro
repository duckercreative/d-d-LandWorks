---
import LocationPageTemplate from '../layouts/LocationPageTemplate.astro';

const factsBar = [
  { label: 'Based in', value: 'Springfield, OR' },
  { label: 'Serving', value: 'Veneta — call to confirm' },
  { label: 'Licensed & bonded', value: 'CCB #261742' },
  { label: 'Septic work', value: 'DEQ certified' },
];

const services = [
  { num: '01', title: 'Site Preparation', desc: 'Getting the ground ready for a build or project. May include clearing, digging, grading, or moving soil.', href: '/site-preparation-contractor-eugene-or' },
  { num: '02', title: 'Land Grading', desc: 'Changing the shape of the ground to level an area or create a different slope for the planned use.', href: '/land-grading-services-eugene-or' },
  { num: '03', title: 'Land Clearing', desc: 'Removing brush, trees, debris, or overgrown material before excavation can begin.', href: '/land-clearing-services-eugene-or' },
  { num: '04', title: 'Septic Excavation', desc: 'If septic excavation is part of your project, D&D can discuss the excavation portion where the service area is confirmed.', href: '/septic-installation-lane-county-or' },

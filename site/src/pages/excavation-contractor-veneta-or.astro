  { title: 'When the ground is uneven', desc: 'Areas that are too high, too low or uneven for the planned use get regraded to fit the project.', href: '/contact' },
  { title: 'When water is collecting', desc: 'Standing water around home, driveway or yard is a drainage problem with a dig-able fix.', href: '/contact' },
  { title: 'When land needs clearing', desc: 'Brush, trees and overgrowth need to be removed before excavation or grading can begin.', href: '/contact' },
  { title: 'For a septic project', desc: 'Septic systems may require excavation for the components that go into the ground. Confirm service area first.', href: '/contact' },
  { title: 'For general site work', desc: 'Access, ground conditions, depth and size of the project all change what a west Lane County job involves.', href: '/contact' },
];

const processSteps = [
  { num: '1', title: 'Tell us what you need', desc: 'What you want to build, repair, clear or dig on your Veneta-area property.' },
  { num: '2', title: 'Confirm service area', desc: 'West Lane County coverage is confirmed case by case — call with your property location before scheduling.' },
  { num: '3', title: 'Understand the scope', desc: 'The excavation and site work explained in plain terms once coverage is confirmed.' },
  { num: '4', title: 'Get your estimate', desc: 'A free estimate once the property and project are understood.', dark: true },
];

const bentoFeatures = [
  { title: 'Call to confirm', desc: 'West Lane County coverage is confirmed case by case. Call 541-401-8726 with your property location before planning work.', dark: false },
  { title: 'Foundation excavation', desc: 'New homes, ADUs and rural builds. One crew for clearing, grading and the foundation once coverage is confirmed.', dark: true },
  { title: 'Utility & trench work', desc: 'Water service, sewer lateral, conduit and drains, with 811 locates on every trench job.', dark: true },
  { title: 'DEQ certified septic', desc: 'Tank, distribution box and drainfield excavation for applicable Lane County properties.', dark: false },
];

const areaLinks = [
  { label: 'Eugene', href: '/excavation-contractor-eugene-or' },
  { label: 'Springfield', href: '/excavation-contractor-springfield-or' },
  { label: 'Junction City', href: '/excavation-contractor-junction-city-or' },
  { label: 'Cottage Grove', href: '/excavation-contractor-cottage-grove-or' },
  { label: 'Creswell', href: '/excavation-contractor-creswell-or' },
  { label: 'Coburg', href: '/excavation-contractor-coburg-or' },
  { label: 'Lowell', href: '/excavation-contractor-lowell-or' },
  { label: 'Florence', href: '/excavation-contractor-florence-or' },
];

const faqs = [
  { question: 'Do you serve the Veneta area?', answer: 'If you have a project near Veneta, contact D&D Land Works at 541-401-8726 to confirm service availability for your property. West Lane County coverage is confirmed based on the project and location.' },
  { question: 'What does excavation involve?', answer: 'Excavation can include digging, moving soil, clearing an area, and preparing the ground for a project. The work depends on the property and what you are trying to accomplish.' },
  { question: 'Can you prepare my property?', answer: 'Site preparation may include clearing, digging, grading, and moving soil, depending on what your project needs. Call to discuss the property and confirm whether it is within the service area.' },
  { question: 'Can you help with septic excavation?', answer: 'If septic excavation is part of your project and the property is within the service area, D&D can discuss the excavation work involved. Septic design, engineering, permits, and approvals are separate.' },
  { question: 'What affects excavation cost near Veneta?', answer: 'Project size, digging depth, ground conditions, property access, existing structures, utilities, clearing needs, and weather can all affect cost and timeline.' },
];

const relatedServices = [
  { title: 'Site Preparation', desc: 'Clearing, grading and compaction for raw lots.', href: '/site-preparation-contractor-eugene-or' },
  { title: 'Grading & Leveling', desc: 'The right slope for drainage and a level pad.', href: '/land-grading-services-eugene-or' },
  { title: 'Foundation Excavation', desc: 'Footprints, footings, crawl spaces and basements.', href: '/foundation-excavation-eugene-or' },
  { title: 'Drainage Excavation', desc: 'French drains, swales and catch basins.', href: '/drainage-installation-eugene-or' },
];

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'GeneralContractor',
      '@id': 'https://www.ddlandworks.com/#business',
      name: 'D&D Land Works',
      url: 'https://www.ddlandworks.com/',
      telephone: '+15414018726',
      email: 'david@ddlandworks.com',
      priceRange: '$$',
      areaServed: [
        { '@type': 'City', name: 'Veneta', sameAs: 'https://www.wikidata.org/wiki/Q1023742' },
        { '@type': 'AdministrativeArea', name: 'Lane County, Oregon' },
      ],
      hasCredential: [
        { '@type': 'EducationalOccupationalCredential', credentialCategory: 'License', name: 'Oregon CCB License #261742' },
        { '@type': 'EducationalOccupationalCredential', credentialCategory: 'Certification', name: 'Oregon DEQ Certification, Septic Install & Repair' },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.question,
        acceptedAnswer: { '@type': 'Answer', text: faq.answer },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.ddlandworks.com/' },
        { '@type': 'ListItem', position: 2, name: 'Service Areas', item: 'https://www.ddlandworks.com/service-area/' },
        { '@type': 'ListItem', position: 3, name: 'Veneta', item: 'https://www.ddlandworks.com/excavation-contractor-veneta-or/' },
      ],
    },
  ],
};

---
import LocationPageTemplate from '../layouts/LocationPageTemplate.astro';

const factsBar = [
  { label: 'Based in', value: 'Springfield, OR' },
  { label: 'Serving', value: 'Florence — call to confirm' },
  { label: 'Licensed & bonded', value: 'CCB #261742' },
  { label: 'Septic work', value: 'DEQ certified' },
];

const services = [
  { num: '01', title: 'Site Preparation', desc: 'Getting land ready for a building or project. May include clearing, digging, and grading to create a workable area.', href: '/site-preparation-contractor-eugene-or' },
  { num: '02', title: 'Land Clearing', desc: 'If a property has brush, trees, or debris in the way, clearing may be needed before excavation or construction can begin.', href: '/land-clearing-services-eugene-or' },
  { num: '03', title: 'Grading', desc: 'Shaping the ground when the land is uneven or needs a different slope for the planned use.', href: '/land-grading-services-eugene-or' },
  { num: '04', title: 'Drainage Excavation', desc: 'If water collects where it should not, excavation can create a path to move water in a better direction.', href: '/drainage-installation-eugene-or' },
  { num: '05', title: 'Septic Excavation', desc: 'A septic project may need excavation for the tank area or drain field. Call to confirm service area first.', href: '/septic-installation-lane-county-or' },
  { num: '06', title: 'Trenching', desc: 'Digging a narrow path for water lines, conduit, irrigation, drainage, or other underground work.', href: '/trenching-services-eugene-or' },
];

const checklistItems = [
  { title: 'Before construction begins', desc: 'A building site may need clearing, grading or excavation before any other work can start.', href: '/contact' },
  { title: 'When the ground needs reshaping', desc: 'Areas that are uneven, too high or too low get regraded to fit the project.', href: '/contact' },
  { title: 'When water is collecting', desc: 'Standing water around home, driveway or yard is usually a drainage problem with a dig-able fix.', href: '/contact' },
  { title: 'Before underground work', desc: 'Utility lines, irrigation and drains need a trench sized and placed for what goes in it.', href: '/contact' },
  { title: 'For septic projects', desc: 'New systems and repairs need excavation. Confirm service area before planning septic work near Florence.', href: '/contact' },
  { title: 'When the driveway needs work', desc: 'Ruts, washouts and uneven gravel get regraded and the surface restored.', href: '/driveway-excavation-grading-eugene-or' },
];

const processSteps = [
  { num: '1', title: 'Tell us what you need', desc: 'What you want to build, repair, clear or dig on your Florence-area property.' },
  { num: '2', title: 'Confirm service area', desc: 'Florence is farther from the Springfield base. Call with your property location to confirm availability before planning work.' },
  { num: '3', title: 'Understand the scope', desc: 'The excavation and site work explained in plain terms once coverage is confirmed.' },
  { num: '4', title: 'Get your estimate', desc: 'A free estimate once the property and project are understood.', dark: true },
];

const bentoFeatures = [
  { title: 'Call to confirm', desc: 'Florence is farther from the Springfield base. Call 541-401-8726 with your property location to confirm service availability before planning.', dark: false },
  { title: 'Foundation excavation', desc: 'New homes, ADUs and rural builds. One crew for clearing, grading and the foundation once coverage is confirmed.', dark: true },
  { title: 'Utility & trench work', desc: 'Water service, sewer lateral, conduit and drains, with 811 locates on every trench job.', dark: true },
  { title: 'DEQ certified septic', desc: 'Tank, distribution box and drainfield excavation for applicable Lane County and coastal properties.', dark: false },
];

const areaLinks = [
  { label: 'Eugene', href: '/excavation-contractor-eugene-or' },
  { label: 'Springfield', href: '/excavation-contractor-springfield-or' },
  { label: 'Cottage Grove', href: '/excavation-contractor-cottage-grove-or' },
  { label: 'Creswell', href: '/excavation-contractor-creswell-or' },
  { label: 'Veneta', href: '/excavation-contractor-veneta-or' },
  { label: 'Junction City', href: '/excavation-contractor-junction-city-or' },
  { label: 'Coburg', href: '/excavation-contractor-coburg-or' },
  { label: 'Lowell', href: '/excavation-contractor-lowell-or' },
];

const faqs = [
  { question: 'Do you serve Florence?', answer: 'Florence service coverage should be confirmed before scheduling work. Call 541-401-8726 and provide the property location — we will confirm whether it is within the current service area.' },
  { question: 'What kind of site work do you do near Florence?', answer: 'D&D Land Works provides excavation, land clearing, grading, drainage-related excavation, septic-related excavation, and trenching for applicable projects.' },
  { question: 'Can you help with drainage near Florence?', answer: 'Excavation can be part of drainage work. The right approach depends on where water is coming from, where it needs to go, and how the ground is shaped.' },
  { question: 'Do you provide free estimates?', answer: 'Yes. D&D Land Works provides free estimates for applicable excavation and site work projects once the service area is confirmed.' },
  { question: 'What can affect excavation cost near Florence?', answer: 'Project size, digging depth, ground conditions, slope, access, clearing, grading, drainage, material movement, and site complexity can all affect cost.' },
];

const relatedServices = [
  { title: 'Site Preparation', desc: 'Clearing, grading and compaction for raw lots.', href: '/site-preparation-contractor-eugene-or' },
  { title: 'Grading & Leveling', desc: 'The right slope for drainage and a level pad.', href: '/land-grading-services-eugene-or' },
  { title: 'Foundation Excavation', desc: 'Footprints, footings, crawl spaces and basements.', href: '/foundation-excavation-eugene-or' },
  { title: 'Drainage Excavation', desc: 'French drains, swales and catch basins.', href: '/drainage-installation-eugene-or' },
];

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'GeneralContractor',
      '@id': 'https://www.ddlandworks.com/#business',
      name: 'D&D Land Works',
      url: 'https://www.ddlandworks.com/',
      telephone: '+15414018726',
      email: 'david@ddlandworks.com',
      priceRange: '$$',
      areaServed: [
        { '@type': 'City', name: 'Florence', sameAs: 'https://www.wikidata.org/wiki/Q1427265' },
        { '@type': 'AdministrativeArea', name: 'Lane County, Oregon' },
      ],
      hasCredential: [
        { '@type': 'EducationalOccupationalCredential', credentialCategory: 'License', name: 'Oregon CCB License #261742' },
        { '@type': 'EducationalOccupationalCredential', credentialCategory: 'Certification', name: 'Oregon DEQ Certification, Septic Install & Repair' },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.question,
        acceptedAnswer: { '@type': 'Answer', text: faq.answer },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.ddlandworks.com/' },
        { '@type': 'ListItem', position: 2, name: 'Service Areas', item: 'https://www.ddlandworks.com/service-area/' },
        { '@type': 'ListItem', position: 3, name: 'Florence', item: 'https://www.ddlandworks.com/excavation-contractor-florence-or/' },
      ],
    },
  ],
};
---

<LocationPageTemplate

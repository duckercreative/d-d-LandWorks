  faqs={faqs}
  relatedEyebrow="Related services"
  relatedServices={relatedServices}
  ctaEyebrow="Talk with David"
  ctaH2Light="Need excavation work"
  ctaH2Bold="near Florence?"
  ctaSub="Call first to confirm your property is within the current service area. Free estimates for confirmed locations, no obligation."
  ctaImage="/service-site-preparation.webp"
/>

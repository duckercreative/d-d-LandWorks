const fixes = [
  'Yards that slope toward the house instead of away from it',
  'Low spots and standing water that never drain, even weeks after rain',
  'Uneven or lumpy lawns that were never finish-graded right in the first place',
  'Surface erosion from years of runoff cutting across an uncorrected slope',
  'Drainage grading: shaping swales and berms so surface water moves where it needs to go',
  'Cut-and-fill balancing within an existing yard, moving a high spot to fill a low one instead of trucking material off site',
];

const costRows = [
  { type: 'Small lawn leveling / minor regrade', range: '$500–$1,000', affects: 'Square footage, depth of correction, site access' },
  { type: 'Full backyard regrade', range: '$1,000–$5,000+', affects: 'Volume of material moved, slope severity, equipment access' },
  { type: 'Drainage-focused regrade (swales/berms)', range: 'Varies by scope', affects: 'Whether swales or berms are shaped, how much material moves on-site' },
];

const faqs = [
  { question: 'Is this a landscaping job or an excavation job?', answer: 'It’s a real, definable job with its own name, grading and leveling, that sits between the two. The distinction comes down to job size, equipment, and permanence, not which kind of company happens to answer the phone. A landscaper handles cosmetic fixes with hand tools; an excavation contractor digs new space with heavy equipment. Grading and leveling reshapes an existing surface with a skid steer or excavator and a grading attachment, with nothing new being dug.' },
  { question: 'What is a positive drainage slope, and how much slope does my yard actually need?', answer: 'Oregon’s adopted residential code (ORSC §R401.3) sets the actual figure: a minimum 6-inch fall over the first 10 feet from your foundation, roughly a 5% slope, tapering to a 2% minimum for hard surfaces near the building and generally beyond it. That’s not a rule of thumb, it’s the code standard D&D grades to on every job.' },
  { question: 'How much does it cost to level or regrade a yard in Lane County?', answer: 'General ranges run about $500–$1,000 for a small lawn-leveling job and $1,000–$5,000-plus for a full backyard regrade, depending on square footage, slope severity, and how much material has to move. No Lane-County-specific figure exists yet for yard-scale grading, so these are general national ranges, not a quote, a free on-site estimate is the only way to price your actual yard.' },
  { question: 'Do I need a permit just to regrade my lawn in Lane County?', answer: 'Usually not, for an ordinary yard regrade. Lane County’s Grading and Fill Permit is generally triggered by moving more than 50 cubic yards of earth or a cut/fill slope steeper than 2:1, a threshold most yard-sized jobs stay well under. A large, deep full-property regrade could approach that threshold, so it’s worth confirming directly with Lane County’s Land Management Division for a bigger job.' },
  { question: 'How do I know if my yard needs a full regrade versus just topdressing?', answer: 'If topdressing or sand-leveling doesn’t hold, or a depression is deeper than about an inch, that’s a sign the underlying grade needs correcting, not just topping off again. Minor cosmetic unevenness with no standing water is often a lawn-care fix; an actual slope or drainage problem is an earthwork job. We’ll tell you honestly which one your yard needs before quoting anything.' },
  { question: 'What’s the difference between a swale and a French drain?', answer: 'A swale is a shallow, graded surface channel that moves water by shaping the ground itself, that’s grading work, and it’s D&D’s territory. A French drain is a buried, perforated-pipe-and-gravel subsurface system, a genuinely different remedy. If a French drain is specifically what your property needs, confirm that scope with us directly rather than assuming it’s included.' },
  { question: 'Does D&D take on small residential yard-grading jobs, or mostly bigger projects?', answer: 'Yes. A yard-sized regrading job gets the same scoping attention and process as a larger excavation or site-prep project, a real site visit, a written estimate, and a crew that shows up ready for the scope actually in front of it.' },
  { question: 'Will regrading damage my existing lawn or landscaping?', answer: 'Some disturbance to the lawn surface is normal, and reseeding or re-sodding the regraded area afterward is common. Established beds, sprinkler lines, and hardscape near the work area get walked and flagged before anything moves, not discovered mid-job. Mention any underground sprinklers or drip lines up front so they get mapped first.' },
  { question: 'What’s the best time of year to regrade a yard in Oregon’s rainy climate?', answer: 'May through October is generally the preferred dry window, since Willamette Valley’s clay soil grades and compacts more predictably dry than during Eugene’s wettest months (November through January). A yard-sized job is far more schedule-flexible than a full excavation project, though, and can often be done outside that window if timing requires it.' },
];

const related = [
  { title: 'Excavation', description: 'Cut-and-fill, backfill, and new digging for foundations, ponds, and utility trenches.', href: '/services/excavation' },
  { title: 'Site Preparation', description: 'Clearing, stripping topsoil, and grading a raw lot before a new build.', href: '/services/site-preparation' },
  { title: 'Driveway Repair', description: 'Regrading a driveway or access road that’s washed out or settled.', href: '/services/driveway-repair' },
  { title: 'Slope Stabilization', description: 'Hillside erosion control and structural slope work, beyond ordinary surface regrading.', href: '/services/slope-stabilization' },
];

const demoReviews = [
  { name: 'Jordan M.', initial: 'JM', date: 'Aug 2026', stars: 5, text: 'David and his crew graded our lot fast and cleaned up everything before they left. Would hire again for any excavation work.' },
  { name: 'Casey R.', initial: 'CR', date: 'Jul 2026', stars: 5, text: 'Called about a drainage issue and had someone out within the week. Fixed the standing water problem for good.' },
  { name: 'Taylor B.', initial: 'TB', date: 'Jul 2026', stars: 4, text: 'Good work on our driveway repair, just took a little longer than expected to schedule.' },
  { name: 'Morgan K.', initial: 'MK', date: 'Jun 2026', stars: 5, text: 'Septic install went smoothly start to finish. Appreciated that David walked us through the whole process.' },
  { name: 'Riley S.', initial: 'RS', date: 'Jun 2026', stars: 5, text: 'Cleared almost an acre of brush for us ahead of a build. On time, fair price, no surprises.' },
  { name: 'Alex D.', initial: 'AD', date: 'May 2026', stars: 5, text: 'Foundation excavation was done right and on schedule. Highly recommend for any site prep work.' },
];

const anchorAreas = [
  { label: 'Eugene', href: '/locations/eugene' },
  { label: 'Springfield', href: '/locations/springfield' },
];
const otherAreas = [
  { label: 'Cottage Grove', href: '/locations/cottage-grove' },
  { label: 'Junction City', href: '/locations/junction-city' },
  { label: 'Creswell', href: '/locations/creswell' },
  { label: 'Veneta', href: '/locations/veneta' },
  { label: 'Florence', href: '/locations/florence' },
  { label: 'Oakridge', href: '/locations/oakridge' },
  { label: 'Coburg', href: '/locations/coburg' },
  { label: 'Lowell', href: '/locations/lowell' },
];

const serviceSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      '@id': 'https://www.ddlandworks.com/services/grading-leveling/#service',
      name: 'Grading and Leveling',
      serviceType: 'Grading and Leveling',
      description: 'Grading and leveling corrects an existing yard\'s surface: re-sloping a lawn, fixing a low spot that collects water, or restoring a positive drainage slope away from a foundation, without digging a new excavation. D&D Land Works provides grading and leveling for residential and commercial properties throughout Eugene, Springfield, and Lane County, Oregon.',
      url: 'https://www.ddlandworks.com/services/grading-leveling/',
      provider: { '@id': 'https://www.ddlandworks.com/#business' },
      areaServed: ['Lane County, Oregon', 'Eugene, Oregon', 'Springfield, Oregon', 'Cottage Grove, Oregon', 'Junction City, Oregon', 'Creswell, Oregon', 'Veneta, Oregon', 'Florence, Oregon', 'Oakridge, Oregon', 'Coburg, Oregon', 'Lowell, Oregon'],
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.ddlandworks.com/' },
        { '@type': 'ListItem', position: 2, name: 'Services', item: 'https://www.ddlandworks.com/services/' },
        { '@type': 'ListItem', position: 3, name: 'Grading & Leveling', item: 'https://www.ddlandworks.com/services/grading-leveling/' },

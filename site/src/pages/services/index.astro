---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import CTABlock from '../../components/CTABlock.astro';

const services = [
  { title: 'Site Preparation', description: 'Clearing, grading, and prepping your lot before the build starts.', href: '/site-preparation-contractor-eugene-or' },
  { title: 'Excavation', description: 'Cut-and-fill earthmoving, access roads, and rock removal.', href: '/excavation-contractor-eugene-or' },
  { title: 'Land Clearing', description: 'Removing brush, trees, and debris to open up usable land.', href: '/land-clearing-services-eugene-or' },
  { title: 'Brush Clearing', description: 'Cutting back overgrowth for defensible space or usable acreage.', href: '/brush-clearing-eugene-or' },
  { title: 'Foundation Excavation', description: 'Digging and leveling for footings and foundations.', href: '/foundation-excavation-eugene-or' },
  { title: 'Driveway Repair', description: 'Regrading and repairing driveways and access roads.', href: '/driveway-excavation-grading-eugene-or' },
  { title: 'Grading & Leveling', description: 'Shaping land to the right slope for drainage and building.', href: '/land-grading-services-eugene-or' },
  { title: 'Drainage Excavation', description: 'Cutting swales and trenches to move water where it needs to go.', href: '/drainage-installation-eugene-or' },
  { title: 'Utility Excavation', description: 'Trenching for water, sewer, power, and other utility lines.', href: '/utility-trenching-eugene-or' },
  { title: 'Trenching & Backfill', description: 'Opening trenches for utility or drainage work, then backfilling and compacting.', href: '/trenching-services-eugene-or' },
  { title: 'Septic Install & Repairs', description: 'Septic system installation and repair excavation. DEQ certification in progress.', href: '/septic-installation-lane-county-or' },
  { title: 'Slope Stabilization', description: 'Stabilizing unstable or eroding slopes.', href: '/slope-stabilization-eugene-or' },
];
---

<BaseLayout
	title="Excavation Services | D&D Land Works | Lane County, OR"
	description="Site prep, land clearing, grading, drainage, utility excavation, and septic excavation. CCB #261742. Licensed and bonded, serving Lane County, OR."
>
	<Hero
		eyebrow="What We Do"
		headline="Full-Service Excavation"
		subheadline="Twelve services, one contractor. From the first cut to the last inspection, D&D Land Works handles site prep, grading, drainage, utility work, and septic excavation."
		primaryCta={{ label: 'Call 541-401-8726', href: 'tel:5414018726' }}
	/>
	<section class="mx-auto max-w-6xl px-4 py-16">
		<div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
			{services.map((service) => <ServiceCard {...service} />)}
		</div>
	</section>
	<CTABlock
		headline="Not Sure Which Service You Need?"
		subheadline="Describe the project and David will tell you what it actually takes."
	/>
</BaseLayout>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import AboutSection from '../../components/AboutSection.astro';
import PhotoContentBlock from '../../components/PhotoContentBlock.astro';
import WhyChooseUs from '../../components/WhyChooseUs.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import CTABlock from '../../components/CTABlock.astro';
import Gallery from '../../components/Gallery.astro';
import Testimonials from '../../components/Testimonials.astro';

const demoReviews = [
  { name: 'Jordan M.', initial: 'JM', date: 'Aug 2026', stars: 5, text: 'David and his crew graded our lot fast and cleaned up everything before they left. Would hire again for any excavation work.' },
  { name: 'Casey R.', initial: 'CR', date: 'Jul 2026', stars: 5, text: 'Called about a drainage issue and had someone out within the week. Fixed the standing water problem for good.' },
  { name: 'Taylor B.', initial: 'TB', date: 'Jul 2026', stars: 4, text: 'Good work on our driveway repair, just took a little longer than expected to schedule.' },
  { name: 'Morgan K.', initial: 'MK', date: 'Jun 2026', stars: 5, text: 'Septic install went smoothly start to finish. Appreciated that David walked us through the whole process.' },
  { name: 'Riley S.', initial: 'RS', date: 'Jun 2026', stars: 5, text: 'Cleared almost an acre of brush for us ahead of a build. On time, fair price, no surprises.' },
  { name: 'Alex D.', initial: 'AD', date: 'May 2026', stars: 5, text: 'Foundation excavation was done right and on schedule. Highly recommend for any site prep work.' },
];

const anchorAreas = [
  { label: 'Eugene', href: '/locations/eugene' },
  { label: 'Springfield', href: '/locations/springfield' },
];
const otherAreas = [
  { label: 'Cottage Grove', href: '/locations/cottage-grove' },
  { label: 'Junction City', href: '/locations/junction-city' },
  { label: 'Creswell', href: '/locations/creswell' },
  { label: 'Veneta', href: '/locations/veneta' },
  { label: 'Florence', href: '/locations/florence' },
  { label: 'Oakridge', href: '/locations/oakridge' },
  { label: 'Coburg', href: '/locations/coburg' },
  { label: 'Lowell', href: '/locations/lowell' },
];

const scope = [
  'Trenching for utility lines, drainage pipe, and footings',
  'Setting proper trench width and depth for the pipe or conduit involved',
  'Bedding pipe in sand or gravel per spec before backfilling',
  'Backfilling in compacted lifts rather than a single pass',
  'Compaction testing on jobs where the spec requires it',
  'Restoring surface grade to match surrounding ground',
];

const related = [
  { title: 'Utility Excavation', description: 'Trenching for water, sewer, power, and other utility lines.', href: '/services/utility-excavation' },
  { title: 'Septic Install & Repairs', description: 'DEQ certified installation and repair of septic systems.', href: '/services/septic-install-repairs' },
  { title: 'Foundation Excavation', description: 'Digging and leveling for footings and foundations.', href: '/services/foundation-excavation' },
];
---

<BaseLayout
	title="Trenching & Backfill | Eugene & Lane County, OR — D&D Land Works"
	description="Trenching and compacted backfill for utility, drainage, and foundation work in Eugene, Springfield, and Lane County, OR. Licensed and bonded."
>
	<Hero
		eyebrow="Service"
		headline="Trenching & Backfill"
		subheadline="Cutting the trench is the easy half. Backfilling it right, in compacted lifts instead of one dumped pile, is what keeps a driveway or yard from sinking a year later along the pipe run."
		primaryCta={{ label: 'Call 541-401-8726', href: 'tel:5414018726' }}
		secondaryCta={{ label: 'Free Estimate', href: '/contact' }}
	/>
	<!-- About -->
	<AboutSection
		ctaLabel="Get a Free Estimate"
		ctaHref="/contact"
		eyebrow="Trenching & Backfill in Lane County, OR"
		headlineHtml="Professional <span class='text-brand-blue'>Trenching &amp; Backfill</span> in Eugene, Springfield &amp; Lane County"
		descriptionHtml="<p>Walk any older neighborhood and you&rsquo;ll find a shallow dip running across a lawn or driveway right where a utility trench was cut years back. That&rsquo;s backfill that got dumped in and never compacted properly, settling under its own weight over time.</p><p>D&amp;D Land Works backfills in lifts, compacting each layer before the next one goes on, so the surface stays flat. Licensed and bonded under Oregon <strong class='font-semibold text-ink'>CCB #261742</strong>, serving Eugene, Springfield, and the rest of Lane County.</p>"
	/>
	<!-- What it covers -->
	<section class="bg-slate-50 border-y border-slate-200">
		<div class="mx-auto max-w-6xl px-4 py-16">
			<h2 class="font-display font-bold uppercase tracking-tight text-3xl text-ink text-center">
				What Does Trenching &amp; Backfill Include?
			</h2>
			<div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
				{scope.map((item) => (
					<div class="card flex items-start gap-3">
						<span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-brand-blue-light text-brand-blue">
							<svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
								<path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
							</svg>
						</span>
						<p class="text-sm text-slate-600">{item}</p>
					</div>
				))}
			</div>
		</div>
	</section>
	<!-- Equipment -->
	<PhotoContentBlock
		eyebrow="Equipment"
		headline="What Equipment Shows Up on the Job?"
		image="/hero-bg-2.webp"
		imageAlt="Plate compactor working backfill in lifts along a Lane County trench"
		imageSide="left"
		badgeValue="2 Tools"
		badgeLabel="Trencher + Plate Compactor"
		ctaLabel="Get a Free Estimate"
		ctaHref="/contact"
		bodyHtml="<p>A trencher or mini excavator opens the cut. A plate compactor or jumping jack tamper works the backfill down in stages, layer by layer, instead of relying on a single pass to settle everything at once.</p>"
	/>
	<!-- Residential and commercial -->
	<PhotoContentBlock
		eyebrow="Residential & Commercial"
		headline="Do the Backfill Standards Change for Commercial Jobs?"
		image="/hero-bg-3.webp"
		imageAlt="Restored surface grade over a backfilled trench in Lane County"
		imageSide="right"
		badgeValue="Compacted Lifts"
		badgeLabel="Not a Single Dumped Pass"
		ctaLabel="Get a Free Estimate"
		ctaHref="/contact"
		bodyHtml="<p>Backfill standards don&rsquo;t change much between a homeowner&rsquo;s new water line and a commercial utility run: compact it right or deal with settling later.</p><p>Licensed and bonded under CCB #261742, serving Eugene, Springfield, and the rest of <a href='/service-area' class='text-brand-blue underline underline-offset-2 hover:text-brand-blue-dark'>Lane County</a>.</p>"
	/>
	<PhotoContentBlock
		eyebrow="Trenching & Backfill in Lane County, OR"
		headline="Why Do Lane County Homeowners Trust D&D Land Works for Trenching &amp; Backfill?"
		image="/hero-bg-4.webp"
		imageAlt="D&D Land Works trenching and compacting backfill in Lane County, Oregon"
		imageSide="left"
		badgeValue="CCB #261742"
		badgeLabel="Licensed & Bonded"
		ctaLabel="Get a Free Estimate"
		ctaHref="/contact"
		bodyHtml="<p>D&amp;D Land Works is licensed and bonded under Oregon CCB #261742 &mdash; a credential you can verify yourself at the CCB&rsquo;s own license lookup before you ever pick up the phone. Every trench gets backfilled in compacted lifts, not dumped in a single pass, so the surface doesn&rsquo;t settle a year later.</p><p>David Deggelman scopes every job in person before quoting. If you&rsquo;re running a utility line, drainage pipe, or footing anywhere in Eugene, Springfield, or the rest of Lane County, <a href='/contact' class='text-brand-blue underline underline-offset-2 hover:text-brand-blue-dark'>contact D&amp;D Land Works</a> to schedule your free, on-site estimate.</p>"
	/>
	<WhyChooseUs
		descriptionHtml="Every trench gets backfilled in compacted lifts, not dumped in a single pass, so the surface stays flat and doesn't settle along the pipe run a year later."
	/>
	<!-- Service areas -->
	<section class="bg-slate-50 border-b border-slate-200">
		<div class="mx-auto max-w-6xl px-4 py-16">
			<h2 class="font-display font-bold uppercase tracking-tight text-3xl text-ink text-center">
				What Areas of Lane County Does D&amp;D Land Works Serve?
			</h2>
			<p class="mt-4 text-center text-slate-700 max-w-2xl mx-auto leading-relaxed">
				D&amp;D Land Works is <strong class="text-brand-blue">based near Eugene, Oregon</strong>, and serves homeowners, builders, and developers across Lane County. From Eugene and Springfield to Cottage Grove, Junction City, Creswell, and Veneta, we handle licensed and bonded excavation, grading, and DEQ certified septic work.
			</p>
			<div class="mt-10 grid gap-8 lg:grid-cols-2 items-start">
				<div class="aspect-4/3 overflow-hidden rounded-(--radius-brand-card) border border-slate-200 shadow-sm">
					<iframe
						title="D&D Land Works service area map, Lane County, Oregon"
						src="https://maps.google.com/maps?q=Lane+County,+Oregon&z=9&output=embed"
						width="100%"
						height="100%"
						style="border:0;"
						loading="lazy"
						referrerpolicy="no-referrer-when-downgrade"
					></iframe>
				</div>
				<div class="flex flex-col gap-6">
					<div class="card">
						<p class="font-display font-bold uppercase tracking-wide text-sm text-ink mb-3">
							Our Service Area Includes
						</p>
						<p class="leading-relaxed">
							{anchorAreas.map((area, i) => (
								<>
									<a href={area.href} class="font-semibold text-brand-blue hover:text-brand-blue-dark underline underline-offset-2">{area.label}</a>
									{i < anchorAreas.length - 1 && <span class="text-slate-400"> &middot; </span>}
								</>
							))}
							<span class="text-slate-400"> &middot; </span>
							{otherAreas.map((area, i) => (
								<>
									<a href={area.href} class="text-slate-700 hover:text-brand-blue">{area.label}</a>
									{i < otherAreas.length - 1 && <span class="text-slate-400"> &middot; </span>}
								</>
							))}
						</p>
					</div>
					<p class="text-slate-700 leading-relaxed">
						David walks every site in person before quoting, so pricing accounts for the actual
						soil, slope, and access on your property, not a regional average. Licensed and bonded
						under CCB #261742, DEQ certified for septic install and repair, with equipment and
						crew already local to Lane County.
					</p>
					<a href="/service-area" class="btn btn-cta self-start">View All Service Areas &rarr;</a>
				</div>
			</div>
			<p class="mt-6 text-center text-sm text-slate-600">
				Don&rsquo;t see your town? Call <a href="tel:5414018726" class="font-semibold text-brand-blue">541-401-8726</a> &mdash; the list above isn&rsquo;t exhaustive of every address D&amp;D Land Works will drive to.
			</p>
		</div>
	</section>
	<Gallery />
	<Testimonials
		businessName="D&D Land Works"
		rating={4.83}
		reviewCount={demoReviews.length}
		reviews={demoReviews}
	/>
	<section class="mx-auto max-w-6xl px-4 pb-16">
		<h2 class="font-display font-bold uppercase tracking-tight text-2xl text-ink text-center">
			Related Services
		</h2>
		<div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
			{related.map((service) => <ServiceCard {...service} />)}
		</div>
	</section>
	<CTABlock
		headline="Trench It Right the First Time"
		subheadline="Free estimate for trenching and backfill anywhere in Lane County."
	/>
</BaseLayout>

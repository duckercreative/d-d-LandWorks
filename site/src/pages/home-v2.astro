---
/*
  Homepage v2 — content updated from D&D Land Works Complete Homepage brief.
  Copy of index.astro; compare against it before promoting to production.
*/
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import AboutSection from '../components/AboutSection.astro';
import ServiceCard from '../components/ServiceCard.astro';
import FAQ from '../components/FAQ.astro';
import CTABlock from '../components/CTABlock.astro';

const services = [
  { title: 'Site Preparation', description: 'Clearing, rough grading, and access preparation can prepare a property for construction or other planned improvements.', href: '/services/site-preparation', icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M9 20 4 18V4l5 2 6-2 5 2v14l-5-2-6 2Z M9 4v14M15 6v14" />' },
  { title: 'Excavation', description: 'General earthwork supports new construction, additions, property improvements, and other excavation requirements.', href: '/services/excavation', icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M4 21V10l8-6 8 6v11M4 21h16M9 21v-6h6v6" />' },
  { title: 'Land & Brush Clearing', description: 'Land and brush clearing prepares raw or overgrown areas for subsequent excavation, grading, or property improvements.', href: '/services/land-clearing', icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M12 2 8 9h2l-3 6h3v6h4v-6h3l-3-6h2L12 2Z" />' },
  { title: 'Foundation Excavation', description: 'Foundation excavation prepares areas for homes, shops, barns, ADUs, and other applicable building projects.', href: '/services/foundation-excavation', icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M9 3h6a1 1 0 0 1 1 1v1H8V4a1 1 0 0 1 1-1Z M7 6h10v14a1 1 0 0 1-1 1H8a1 1 0 0 1-1-1V6Z" />' },
  { title: 'Grading & Leveling', description: 'Grading and leveling shape the property surface for construction, access, drainage, and finished site conditions.', href: '/services/grading-leveling', icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M3 17h4l4-9 4 5 3-4h3M17 6h3v3" />' },
  { title: 'Drainage Excavation', description: 'Drainage excavation creates or modifies excavated paths needed for applicable water-management improvements.', href: '/services/drainage-excavation', icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M12 3s6 7 6 11a6 6 0 1 1-12 0c0-4 6-11 6-11Z" />' },
  { title: 'Utility Excavation & Trenching', description: 'Utility excavation and trenching provide excavated pathways for applicable underground utility installations.', href: '/services/utility-excavation', icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M14.7 6.3a4 4 0 0 1-5.6 5.6L4 17l3 3 5.1-5.1a4 4 0 0 1 5.6-5.6L21 6l-3-3-3.3 3.3Z" />' },
  { title: 'Septic Installation & Repair', description: 'Septic installation and repair address applicable onsite wastewater projects within the company&rsquo;s service scope.', href: '/services/septic-install-repairs', icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M6 7c0-1.7 2.7-3 6-3s6 1.3 6 3v10c0 1.7-2.7 3-6 3s-6-1.3-6-3V7Z M6 7c0 1.7 2.7 3 6 3s6-1.3 6-3" />' },
  { title: 'Driveway Repair & Grading', description: 'Driveway repair and grading improve gravel driveways and property access areas where grading or surface correction is required.', href: '/services/driveway-repair', icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M9 3 5 21M15 3l4 18M12 8v2.5m0 4v2.5" />' },
  { title: 'Slope Stabilization', description: 'Slope stabilization involves applicable excavation and site work for properties where slope conditions require stabilization measures.', href: '/services/slope-stabilization', icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M3 20 9 8l4 6 2-3 6 9H3Z" />' },
];

const processSteps = [
  { step: '1', title: 'Request a Free Estimate', detail: 'Provide the property location and describe the excavation or site preparation work you need.' },
  { step: '2', title: 'Review the Project Scope', detail: 'The required work is defined according to the property, planned improvements, access, site conditions, and applicable services.' },
  { step: '3', title: 'Plan the Site Work', detail: 'The excavation and related site work are organized according to the defined project requirements.' },
  { step: '4', title: 'Complete the Excavation Work', detail: 'Applicable excavation, clearing, grading, trenching, drainage, foundation, driveway, or septic work is completed according to the project scope.' },
  { step: '5', title: 'Complete Final Site Work', detail: 'Final grading, backfill, access work, or cleanup can be completed when included in the project scope.' },
];

const faqs = [
  { question: 'What services does D&D Land Works provide?', answer: 'D&D Land Works provides site preparation, excavation, land and brush clearing, foundation excavation, grading and leveling, drainage excavation, utility excavation and trenching, septic installation and repair, driveway repair and grading, and slope stabilization. These services support residential and commercial construction, property improvements, access, drainage, utility, foundation, and septic projects.' },
  { question: 'Is D&D Land Works licensed and bonded?', answer: 'Yes, D&D Land Works operates under Oregon Construction Contractors Board license #261742 and maintains the applicable licensing and bonding requirements for its excavation work. Customers can verify the contractor\'s license through the Oregon Construction Contractors Board before hiring. The CCB license provides a direct way to check the contractor\'s licensing record.' },
  { question: 'Does D&D Land Works serve Eugene and Springfield?', answer: 'Yes, D&D Land Works serves Eugene, Springfield, and surrounding communities within Lane County, Oregon. The service area includes residential and commercial excavation projects involving site preparation, grading, land and brush clearing, drainage excavation, utility trenching, foundation excavation, driveway work, septic services, and other applicable site work within the company\'s service scope.' },
  { question: 'How do I get an excavation estimate?', answer: 'To request an excavation estimate, contact D&D Land Works at 541-401-8726 or david@ddlandworks.com and provide the property location and a description of the planned work. The project can then be discussed according to the required excavation, site preparation, grading, drainage, trenching, foundation, driveway, or septic services.' },
  { question: 'Does D&D Land Works install and repair septic systems?', answer: 'Yes, septic installation and repair are included within D&D Land Works\' stated service scope. Qualifying projects receive applicable onsite wastewater excavation and related septic work. Specific requirements depend on the property and project, so site conditions, regulatory requirements, and scope should be reviewed before work begins.' },
];

const anchorAreas = [
  { label: 'Eugene', href: '/locations/eugene' },
  { label: 'Springfield', href: '/locations/springfield' },
];
const otherAreas = [
  { label: 'Cottage Grove', href: '/locations/cottage-grove' },
  { label: 'Junction City', href: '/locations/junction-city' },
  { label: 'Creswell', href: '/locations/creswell' },
  { label: 'Veneta', href: '/locations/veneta' },
  { label: 'Florence', href: '/locations/florence' },
  { label: 'Oakridge', href: '/locations/oakridge' },
  { label: 'Coburg', href: '/locations/coburg' },
  { label: 'Lowell', href: '/locations/lowell' },
];

const businessSchema = {
  '@context': 'https://schema.org',
  '@type': 'GeneralContractor',
  additionalType: 'https://schema.org/HomeAndConstructionBusiness',
  '@id': 'https://www.ddlandworks.com/#business',
  name: 'D&D Land Works',
  url: 'https://www.ddlandworks.com/',
  telephone: '+1-541-401-8726',
  email: 'david@ddlandworks.com',
  founder: { '@type': 'Person', name: 'David Deggelman' },
  identifier: { '@type': 'PropertyValue', propertyID: 'Oregon CCB License', value: '261742' },
  hasCredential: {
    '@type': 'EducationalOccupationalCredential',
    credentialCategory: 'certification',
    name: 'DEQ Certified',
    recognizedBy: { '@type': 'GovernmentOrganization', name: 'Oregon Department of Environmental Quality' },
  },
  address: { '@type': 'PostalAddress', addressRegion: 'OR', addressCountry: 'US' },
  areaServed: ['Lane County, Oregon', 'Eugene, Oregon', 'Springfield, Oregon', 'Cottage Grove, Oregon', 'Junction City, Oregon', 'Creswell, Oregon', 'Veneta, Oregon', 'Florence, Oregon', 'Oakridge, Oregon', 'Coburg, Oregon', 'Lowell, Oregon'],
};
---

<BaseLayout
	title="Licensed Excavation Contractor in Lane County, OR | D&D Land Works"
	description="Licensed, bonded excavation & site prep contractor serving Lane County, OR. Site prep, grading, septic & more. Free estimates: 541-401-8726."
>
	<Hero
		eyebrow="Lane County, OR"
		headline="Licensed Excavation Contractor in Lane County, Oregon"
		subheadline="D&D Land Works is a licensed and bonded excavation contractor serving Lane County, Oregon. We provide site preparation, excavation, grading, land clearing, drainage, utility trenching, foundation excavation, and septic installation and repair for residential and commercial projects."
		primaryCta={{ label: 'Get a Free Estimate', href: '/contact' }}
		secondaryCta={{ label: 'Our Services', href: '#services' }}
		backgroundImages={['/project-excavation-bucket.webp', '/project-grading-driveway.webp', '/project-finished-grading.webp']}
	/>
	<!-- About Our Excavation Company -->
	<section class="bg-white border-b border-slate-200">
		<div class="mx-auto max-w-6xl px-4 py-16 md:py-24">
			<div class="grid gap-12 lg:grid-cols-2 lg:items-center">
				<div>
					<h2 class="font-display font-black uppercase tracking-tight text-3xl text-ink md:text-4xl">
						About D&amp;D Land Works
					</h2>
					<p class="mt-5 max-w-md text-slate-700 leading-relaxed">
						D&amp;D Land Works is a licensed and bonded excavation contractor serving residential and commercial properties throughout Lane County, Oregon. Site preparation, excavation, grading, land and brush clearing, foundation excavation, drainage, utility trenching, driveway grading, septic installation and repair, and slope stabilization form part of its defined service scope.
					</p>
					<a href="/about" class="btn-pill mt-8 inline-flex">
						Learn More About D&amp;D Land Works
						<span class="btn-pill-icon">
							<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
								<path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M17 7H7M17 7V17" />
							</svg>
						</span>
					</a>
				</div>
				<div class="relative">
					<img
						src="/project-excavation-bucket.webp"
						alt="D&D Land Works excavation contractor working in Lane County, Oregon"
						class="w-full rounded-(--radius-brand-card) object-cover aspect-4/3 shadow-xl"
						loading="lazy"
					/>
				</div>
			</div>
		</div>
	</section>
	<!-- Why Choose: dense fact paragraph — services, license, DEQ cert, area, contact -->
	<AboutSection
		eyebrow="Why Choose D&D Land Works"
		headlineHtml='Why Choose D&D Land Works <span class="text-brand-blue">for Excavation?</span>'
		descriptionHtml="<p>Choosing an excavation contractor involves more than the type of equipment used. Project scope, site access, related excavation services, licensing, and communication can all affect how the work is organized. D&amp;D Land Works provides excavation and site preparation services within a defined scope for residential and commercial properties throughout Lane County.</p><p>Oregon CCB license <strong class='font-semibold text-ink'>#261742</strong> establishes the contractor&rsquo;s licensing and bonding status. Free estimates are available for applicable excavation projects. Septic installation and repair for qualifying onsite wastewater work is also within scope.</p>"
		ctaLabel="Talk to an Excavation Contractor"
		ctaHref="/contact"
	/>
	<section id="services" class="relative">
		<div class="relative bg-ink overflow-hidden">
			<img src="/project-site-excavation.webp" alt="" aria-hidden="true" class="absolute inset-0 h-full w-full object-cover opacity-45" loading="lazy" />
			<div class="absolute inset-0 bg-linear-to-b from-ink/80 via-ink/70 to-ink"></div>
			<div class="relative mx-auto max-w-3xl px-4 pt-20 pb-36 text-center md:pt-24 md:pb-44">
				<p class="font-display font-semibold uppercase tracking-widest text-sm text-brand-blue-light">Services</p>
				<h2 class="mt-2 font-display font-black uppercase tracking-tight text-3xl text-white md:text-5xl">
					Full-Service Excavation Services <span class="text-brand-blue-light">in Lane County, Oregon</span>
				</h2>
				<p class="mt-4 text-slate-300 leading-relaxed">
					Excavation and site preparation can involve several connected types of site work. The available services cover land preparation, earthwork, grading, access, drainage, utilities, foundations, and septic work according to the requirements of each property and project.
				</p>
			</div>
		</div>
		<div class="relative mx-auto max-w-6xl px-4 -mt-28 pb-8 md:-mt-32">
			<div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
				{services.map((service) => <ServiceCard {...service} />)}
			</div>
		</div>
		<div class="mx-auto max-w-3xl px-4 pb-16 text-center">
			<a href="/services" class="btn btn-cta mt-6 inline-flex">Explore Excavation Services</a>
		</div>
	</section>
	<!-- Service areas -->
	<section class="bg-slate-50 border-b border-slate-200">
		<div class="mx-auto max-w-6xl px-4 py-16">
			<h2 class="font-display font-bold uppercase tracking-tight text-3xl text-ink text-center">
				Local Excavation Services Across Lane County
			</h2>
			<p class="mt-4 text-center text-slate-700 max-w-2xl mx-auto leading-relaxed">
				Excavation and site preparation services are available throughout Lane County, Oregon, including <strong class="text-brand-blue">Eugene, Springfield</strong>, and surrounding communities. Residential and commercial projects can include excavation, grading, land clearing, drainage, trenching, foundation excavation, driveway work, and septic services.
			</p>
			<div class="mt-10 grid gap-8 lg:grid-cols-2 items-start">
				<div class="aspect-4/3 overflow-hidden rounded-(--radius-brand-card) border border-slate-200 shadow-sm">
					<iframe
						title="D&D Land Works service area map, Lane County, Oregon"
						src="https://maps.google.com/maps?q=Lane+County,+Oregon&z=9&output=embed"
						width="100%"
						height="100%"
						style="border:0;"
						loading="lazy"
						referrerpolicy="no-referrer-when-downgrade"
					></iframe>
				</div>
				<div class="flex flex-col gap-6">
					<div class="card">
						<p class="font-display font-bold uppercase tracking-wide text-sm text-ink mb-3">
							Our Service Area Includes
						</p>
						<p class="leading-relaxed">
							{anchorAreas.map((area, i) => (
								<>
									<a href={area.href} class="font-semibold text-brand-blue hover:text-brand-blue-dark underline underline-offset-2">{area.label}</a>
									{i < anchorAreas.length - 1 && <span class="text-slate-400"> &middot; </span>}
								</>
							))}
							<span class="text-slate-400"> &middot; </span>
							{otherAreas.map((area, i) => (
								<>
									<a href={area.href} class="text-slate-700 hover:text-brand-blue">{area.label}</a>
									{i < otherAreas.length - 1 && <span class="text-slate-400"> &middot; </span>}
								</>
							))}
						</p>
					</div>
					<p class="text-slate-700 leading-relaxed">
						Lane County is the primary service area. Individual communities within it are covered in depth through dedicated location pages.
					</p>
					<a href="/service-area" class="btn btn-cta self-start">Find Excavation Services Near You &rarr;</a>
				</div>
			</div>
			<p class="mt-6 text-center text-sm text-slate-600">
				Don&rsquo;t see your town? Call <a href="tel:5414018726" class="font-semibold text-brand-blue">541-401-8726</a> &mdash; the list above isn&rsquo;t exhaustive of every address D&amp;D Land Works will drive to.
			</p>
		</div>
	</section>
	<!-- Process / What to Expect -->
	<section class="bg-ink text-white">
		<div class="mx-auto max-w-6xl px-4 py-16 md:py-20">
			<h2 class="font-display font-bold uppercase tracking-tight text-3xl text-white text-center">
				What to Expect During an Excavation Project
			</h2>
			<p class="mt-4 text-center text-slate-300 max-w-2xl mx-auto leading-relaxed">
				An excavation project starts with the property, planned work, site conditions, and required project scope. The work can then be organized around the excavation, grading, clearing, drainage, trenching, foundation, driveway, or septic services needed for the property.
			</p>
			<div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
				{processSteps.map((item) => (
					<div class="rounded-(--radius-brand-card) bg-white/5 border border-white/10 p-6">
						<span class="flex h-9 w-9 items-center justify-center rounded-full bg-safety-orange font-display font-bold text-white">
							{item.step}
						</span>
						<p class="mt-4 font-display font-bold uppercase tracking-wide text-sm text-white">{item.title}</p>
						<p class="mt-2 text-sm text-slate-300 leading-relaxed">{item.detail}</p>
					</div>
				))}
			</div>
			<div class="mt-10 text-center">
				<a href="/contact" class="btn btn-cta">Start Your Project Estimate</a>
			</div>
		</div>
	</section>
	<FAQ items={faqs} />
	<div class="bg-white border-b border-slate-200 py-10 text-center">
		<a href="/contact" class="btn btn-cta inline-flex">Ask About Your Excavation Project</a>
	</div>
	<CTABlock
		headline="Get a Free Estimate From D&D Land Works"
		subheadline="Planning excavation, site preparation, grading, land clearing, drainage, trenching, foundation excavation, driveway work, or septic services in Lane County? Contact D&D Land Works to discuss your property and project requirements. Call 541-401-8726 or email david@ddlandworks.com."
		ctaLabel="Request Your Free Estimate"
		ctaHref="/contact"
	/>
</BaseLayout>
<script type="application/ld+json" set:html={JSON.stringify(businessSchema)} />

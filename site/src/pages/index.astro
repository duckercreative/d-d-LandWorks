---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import FAQ from '../components/FAQ.astro';

const services = [
  { num: '01', title: 'Site Preparation', desc: 'Clearing, cut and fill, and pad prep so your builder starts on solid, level ground.', href: '/site-preparation-contractor-eugene-or' },
  { num: '02', title: 'Land & Brush Clearing', desc: 'Blackberry, Scotch broom, stumps and overgrowth cleared back to usable ground.', href: '/land-clearing-services-eugene-or' },
  { num: '03', title: 'Grading & Leveling', desc: 'Uneven ground reshaped so water drains away and the area is usable again.', href: '/land-grading-services-eugene-or' },
  { num: '04', title: 'Foundation Excavation', desc: 'Footings, basements and shop pads dug to plan and ready for forms.', href: '/foundation-excavation-eugene-or' },
  { num: '05', title: 'Drainage Excavation', desc: 'Channels and trenches that move winter water away from homes and driveways.', href: '/drainage-installation-eugene-or' },
  { num: '06', title: 'Utility Excavation', desc: 'Trenches dug for water, sewer, power and other underground lines.', href: '/utility-trenching-eugene-or' },
  { num: '07', title: 'Trenching & Backfill', desc: 'Trenches dug to depth, then backfilled and compacted once the work is in.', href: '/utility-trenching-eugene-or' },
  { num: '08', title: 'Septic Installation & Repair', desc: 'DEQ certified excavation for new systems, repairs and drainfield work.', href: '/septic-installation-lane-county-or' },
  { num: '09', title: 'Driveway Repair', desc: 'Potholes, ruts and washouts regraded and crowned so the drive sheds water.', href: '/driveway-excavation-grading-eugene-or' },
  { num: '10', title: 'Slope Stabilization', desc: 'Banks and hillsides reshaped and regraded where soil moves after heavy rain.', href: '/slope-stabilization-eugene-or' },
];

const problems = [
  {
    tag: 'CLEARING & PREP',
    title: 'Land That Needs Clearing or Preparation',
    desc: 'If your property is covered with brush or has uneven ground, it may need some work before you can build or improve it. We can clear the area, excavate where needed, and prepare the ground for the next step.',
    link: 'Site Preparation',
    href: '/site-preparation-contractor-eugene-or',
  },
  {
    tag: 'STANDING WATER',
    title: 'Standing Water and Poor Grading',
    desc: 'Water that collects around your home, driveway, or yard can make the ground muddy and hard to use. We can reshape the ground and improve the way water moves across the property.',
    link: 'Grading & Leveling',
    href: '/land-grading-services-eugene-or',
  },
  {
    tag: 'SLOPES & RUNOFF',
    title: 'Drainage, Erosion, and Slopes',
    desc: 'Rain and runoff can move soil, damage slopes, and create wet areas. We can excavate, reshape, and regrade problem areas based on the ground and water conditions on your property.',
    link: 'Drainage Excavation',
    href: '/drainage-installation-eugene-or',
  },
  {
    tag: 'DRIVEWAYS',
    title: 'Damaged Driveways and Site Access',
    desc: 'Ruts, washouts, and uneven ground make it hard to reach your property. We regrade and repair driveways and access roads so they drain properly and hold up through the wet season.',
    link: 'Driveway Repair',
    href: '/driveway-excavation-grading-eugene-or',
  },
];

const processSteps = [
  { num: '01', title: 'Talk About the Project', detail: 'We start by talking with you about your property and what you need done. We\'ll discuss the area, access, and the type of excavation or site work you have in mind.' },
  { num: '02', title: 'Look at the Property', detail: 'We look at the ground, slope, drainage, soil, access, and nearby structures or utilities. These conditions can change how the work needs to be done.' },
  { num: '03', title: 'Do the Site Work', detail: 'Once we know what the property needs, we complete the planned clearing, excavation, grading, trenching, drainage, or related work.' },
  { num: '04', title: 'Check the Finished Work', detail: 'When the work is done, we look over the area with the planned work in mind. We make sure the completed work matches what was discussed for the project.' },
];

const reviews = [
  {
    name: 'Matt H.',
    location: 'Eugene, OR',
    text: 'David came out the same week I called. He walked the whole slope with me, explained what was causing the erosion, and gave me a clear quote. Work was done in two days, exactly as described. Would hire again without hesitation.',
    stars: 5,
  },
  {
    name: 'Linda T.',
    location: 'Cottage Grove, OR',
    text: 'We needed a septic system replaced on a tight lot with poor access. D&D figured it out. David was straightforward about what he could and couldn\'t do and stayed within the estimate. Great work.',
    stars: 5,
  },
  {
    name: 'Jason R.',
    location: 'Veneta, OR',
    text: 'Driveway had been washing out every winter for three years. One afternoon of regrading and proper crowning and we\'ve had zero issues through two wet seasons. Should have called sooner.',
    stars: 5,
  },
];

const serviceAreas = [
  { label: 'Eugene', href: '/excavation-contractor-eugene-or' },
  { label: 'Springfield', href: '/excavation-contractor-springfield-or' },
  { label: 'Cottage Grove', href: '/excavation-contractor-cottage-grove-or' },
  { label: 'Junction City', href: '/excavation-contractor-junction-city-or' },
  { label: 'Creswell', href: '/excavation-contractor-creswell-or' },
  { label: 'Veneta', href: '/excavation-contractor-veneta-or' },
  { label: 'Florence', href: '/excavation-contractor-florence-or' },
  { label: 'Oakridge', href: '/locations/oakridge' },
  { label: 'Coburg', href: '/excavation-contractor-coburg-or' },
  { label: 'Lowell', href: '/excavation-contractor-lowell-or' },
];

const faqs = [
  { question: 'What Does an Excavation Contractor Do?', answer: 'An excavation contractor prepares and changes ground for construction, drainage, utilities, foundations, access, septic work, and other property projects. D&D Land Works handles excavation, clearing, grading, trenching, driveway repair, septic work, and related site preparation throughout Lane County.' },
  { question: 'Does D&D Land Works Handle Septic Excavation?', answer: 'Yes. D&D Land Works handles septic installation and repair and is DEQ certified for applicable septic work. Excavation is part of most septic projects, including system installation, repair, and access work. The scope depends on the property, existing system conditions, site access, and applicable DEQ requirements.' },
  { question: 'What Should I Have Ready Before Requesting an Estimate?', answer: 'It helps to know the property location, the type of work you need — site preparation, grading, foundation excavation, drainage, utility trenching, driveway repair, septic, or slope work — existing access conditions, and any project timing you\'re working around. If you have plans or project documents, those can help clarify the scope, but you can start by telling us about the property and the work you need.' },
  { question: 'Is D&D Land Works Licensed and Bonded?', answer: 'Yes. D&D Land Works is licensed and bonded in Oregon under Construction Contractors Board license #261742. Customers can verify Oregon contractor licensing through the Oregon CCB\'s official license lookup before hiring an excavation contractor for their project.' },
  { question: 'Does D&D Land Works Provide Free Estimates?', answer: 'Yes. D&D Land Works provides free estimates for excavation and site preparation projects. The estimate can be based on the property\'s existing conditions, access, planned work, excavation requirements, drainage, utilities, and other factors affecting the project scope.' },
];

const recentWork = [
  { src: '/before-lot.webp', alt: 'Before: overgrown lot', label: 'Before' },
  { src: '/after-lot.webp', alt: 'After: cleared and graded lot', label: 'After' },
  { src: '/before-driveway.webp', alt: 'Before: rutted gravel driveway', label: 'Before' },
  { src: '/after-driveway.webp', alt: 'After: regraded gravel driveway', label: 'After' },
  { src: '/project-finished-grading.webp', alt: 'Finished grading project', label: 'Grading' },
  { src: '/project-grading-driveway.webp', alt: 'Gravel driveway repair', label: 'Driveway' },
];

const businessSchema = {
  '@context': 'https://schema.org',
  '@type': 'GeneralContractor',
  additionalType: 'https://schema.org/HomeAndConstructionBusiness',
  '@id': 'https://www.ddlandworks.com/#business',
  name: 'D&D Land Works',
  url: 'https://www.ddlandworks.com/',
  telephone: '+1-541-401-8726',
  email: 'david@ddlandworks.com',
  founder: { '@type': 'Person', name: 'David Deggelman' },
  identifier: { '@type': 'PropertyValue', propertyID: 'Oregon CCB License', value: '261742' },
  hasCredential: {
    '@type': 'EducationalOccupationalCredential',
    credentialCategory: 'certification',
    name: 'DEQ Certified',
    recognizedBy: { '@type': 'GovernmentOrganization', name: 'Oregon Department of Environmental Quality' },
  },
  address: { '@type': 'PostalAddress', addressRegion: 'OR', addressCountry: 'US' },
  areaServed: ['Lane County, Oregon', 'Eugene, Oregon', 'Springfield, Oregon', 'Cottage Grove, Oregon', 'Junction City, Oregon', 'Creswell, Oregon', 'Veneta, Oregon', 'Florence, Oregon', 'Oakridge, Oregon', 'Coburg, Oregon', 'Lowell, Oregon'],
};
---

<BaseLayout
  title="D&D Land Works | Excavation Contractor in Lane County, Oregon"
  description="D&D Land Works is a licensed excavation contractor serving Lane County, Oregon. Site prep, grading, land clearing, septic, and drainage. CCB #261742. DEQ Certified. Call 541-401-8726 for a free estimate."
>

  <!-- ─── HERO ──────────────────────────────────────────────────────────── -->
  <Hero
    eyebrow="Lane County, OR"
    headline="Licensed Excavation Contractor"
    headlineAccent="in Lane County, Oregon"
    subheadline="D&D Land Works is a licensed excavation contractor serving Eugene and Lane County, Oregon. We handle site preparation, grading, land clearing, foundation excavation, drainage, utility excavation, trenching, septic work, driveway repair, and slope stabilization for residential and commercial properties."
    primaryCta={{ label: 'Request a Free Estimate', href: '/contact' }}
    secondaryCta={{ label: 'Our Services', href: '#services' }}
    backgroundImages={['/project-excavation-bucket.webp']}
    fullBleed={true}
    trustItems={[
      { label: 'CCB #261742', sub: 'Licensed & Bonded' },
      { label: 'DEQ Certified', sub: 'Septic Systems' },
      { label: 'Free Estimates', sub: 'On-site, no obligation' },
      { label: 'Residential & Commercial', sub: 'Lane County, OR' },
    ]}
  />

  <!-- ─── ABOUT / OWNER ──────────────────────────────────────────────────── -->
  <section class="bg-cream">
    <div class="mx-auto max-w-6xl px-6 sm:px-10 py-20 md:py-28 grid gap-14 lg:grid-cols-2 lg:items-center">

      <!-- Text -->
      <div>
        <p class="section-label text-accent-dark mb-6">About D&amp;D Land Works</p>
        <h2 class="font-display leading-[1.05] text-[clamp(2.2rem,5vw,3.5rem)] text-ink">
          <span class="block font-light">Owner-Operated Excavation</span>
          <span class="block font-semibold">Contractor Serving Lane County</span>
        </h2>
        <div class="mt-6 flex flex-col gap-4 text-ink/70 leading-relaxed">
          <p>David Deggelman works directly with property owners to understand what needs to be done. Every property is different. The ground, access, drainage, slope, and existing work can all change the job. We look at those conditions before deciding what work is needed.</p>
          <p>D&D Land Works helps with excavation and site work across Lane County. This includes site preparation, brush clearing, grading, foundation excavation, drainage excavation, utility excavation, trenching, septic work, driveway repair, and slope stabilization.</p>
          <p>We work with homeowners, property owners, builders, and commercial customers in Eugene, Springfield, Cottage Grove, Junction City, Creswell, Veneta, Florence, Oakridge, Coburg, Lowell, and nearby Lane County communities. If you are not sure what your property needs, we can look at the site and talk through the work with you.</p>
        </div>
        <ul class="mt-7 flex flex-col gap-3">
          {[
            'Licensed &amp; Bonded — CCB #261742',
            'DEQ Certified for septic installation &amp; repair',
            'Serving Eugene, Springfield, and all of Lane County',
          ].map((item) => (
            <li class="flex items-start gap-3 text-sm text-ink/70">
              <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full border-2 border-accent text-accent mt-0.5">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
              </span>
              <span set:html={item} />
            </li>
          ))}
        </ul>
        <a href="/about" class="btn btn-cta mt-8 inline-flex">Learn More About D&amp;D Land Works</a>
      </div>

      <!-- Image -->
      <div class="relative">
        <img
          src="/project-site-excavation.webp"
          alt="David Deggelman, owner of D&D Land Works, operating excavation equipment in Lane County Oregon"
          class="w-full rounded-(--radius-brand-card) object-cover aspect-4/3"
          loading="lazy"
        />
        <div class="absolute bottom-6 left-4 sm:left-6 flex items-center gap-3 rounded-(--radius-brand) bg-ink px-4 py-3 text-white shadow-lg">
          <div class="leading-tight">
            <p class="font-display font-semibold text-sm">CCB #261742</p>
            <p class="font-body text-xs text-white/60">Licensed &amp; Bonded · Oregon</p>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- ─── SERVICES ──────────────────────────────────────────────────────── -->
  <section id="services" class="bg-ink text-white">
    <div class="mx-auto max-w-6xl px-6 sm:px-10 py-20 md:py-28 flex flex-col gap-16 md:gap-20">

      <!-- Top: Image + Heading -->
      <div class="grid gap-10 lg:grid-cols-2 lg:items-center">
        <img
          src="/project-grading-driveway.webp"
          alt="Excavation and grading work on a Lane County Oregon property"
          class="w-full rounded-(--radius-brand-card) object-cover aspect-video lg:aspect-[4/3]"
          loading="lazy"
        />
        <div class="flex flex-col gap-5">
          <p class="section-label text-accent-light">Our Services</p>
          <h2 class="font-display leading-[1.05] text-[clamp(2.2rem,5vw,3.5rem)] text-white">
            <span class="block font-light">Complete Excavation &amp;</span>
            <span class="block font-semibold">Site Preparation Services</span>
          </h2>
          <p class="text-white/60 text-base leading-relaxed max-w-md">
            Every property has different ground, access and drainage. D&D Land Works handles excavation and site work at any scale — from a single trench to full-site clearing, grading and foundation work.
          </p>
        </div>
      </div>

      <!-- Services 2-col grid: 01–05 left, 06–10 right -->
      <div class="grid sm:grid-cols-2 border-b border-white/[0.14]" style="grid-template-rows: repeat(5, auto); grid-auto-flow: column;">
        {services.map((service) => (
          <a
            href={service.href}
            class="group grid items-start gap-5 py-7 border-t border-white/[0.14] hover:bg-white/5 px-2 -mx-2 transition-colors"
            style="grid-template-columns: 52px 1fr 22px;"
          >
            <span class="font-display font-light text-[1.75rem] leading-none text-white/40 group-hover:text-accent-light transition-colors">
              {service.num}
            </span>
            <span class="flex flex-col gap-2">
              <span class="font-display font-semibold uppercase tracking-[0.06em] text-[1.05rem] leading-tight text-white group-hover:text-accent-light transition-colors">
                {service.title}
              </span>
              <span class="text-sm leading-relaxed text-white/55">{service.desc}</span>
            </span>
            <svg xmlns="http://www.w3.org/2000/svg" class="mt-0.5 opacity-50 group-hover:opacity-100 transition-opacity shrink-0" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M8 7h9v9" />
            </svg>
          </a>
        ))}
      </div>

      <!-- CTA -->
      <div class="flex justify-center">
        <a href="/contact" class="btn btn-cta">Get a Free Estimate</a>
      </div>

    </div>
  </section>

  <!-- ─── PROBLEMS WE FIX ───────────────────────────────────────────────── -->
  <section class="bg-white border-b border-slate-100">
    <div class="mx-auto max-w-6xl px-6 sm:px-10 py-20 md:py-28">

      <div class="flex flex-col lg:flex-row lg:justify-between lg:items-end gap-6 mb-14">
        <div class="max-w-2xl">
          <p class="section-label text-accent-dark mb-6">Common Property Problems</p>
          <h2 class="font-display leading-[1.05] text-[clamp(2rem,4.5vw,3rem)] text-ink">
            <span class="block font-light">Problems we help</span>
            <span class="block font-semibold">property owners solve.</span>
          </h2>
        </div>
        <p class="text-base text-slate-600 leading-relaxed max-w-xs lg:max-w-[320px] lg:text-right">Every property is different. If your situation doesn't fit these, call David and he'll come take a look.</p>
      </div>

      <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
        {problems.map((card) => (
          <div class="flex flex-col gap-4 pt-7 border-t-[3px] border-ink">
            <span class="font-display font-semibold uppercase tracking-[0.14em] text-sm text-accent-dark">{card.tag}</span>
            <h3 class="font-display font-semibold text-[1.75rem] leading-[1.1] text-ink">{card.title}</h3>
            <p class="text-base leading-relaxed text-slate-600 flex-1">{card.desc}</p>
            <a href={card.href} class="font-display font-semibold uppercase tracking-[0.1em] text-sm text-ink border-b-2 border-accent self-start pb-1 hover:text-accent transition-colors">
              {card.link}
            </a>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- ─── RECENT WORK ───────────────────────────────────────────────────── -->
  <section class="bg-cream">
    <div class="mx-auto max-w-6xl px-6 sm:px-10 py-20 md:py-28">

      <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-6 mb-10">
        <div>
          <p class="section-label text-accent-dark mb-5">Our Work</p>
          <h2 class="font-display leading-[1.05] text-[clamp(2rem,4.5vw,3rem)] text-ink">
            <span class="block font-light">Excavation &amp; Site Work</span>
            <span class="block font-semibold">Projects in Lane County</span>
          </h2>
        </div>
        <a href="/contact" class="shrink-0 btn btn-outline">Get a Free Estimate</a>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 sm:gap-4">
        {recentWork.map((item) => (
          <div class="group relative overflow-hidden rounded-(--radius-brand-card) aspect-square">
            <img
              src={item.src}
              alt={item.alt}
              class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-ink/70 to-transparent"></div>
            <p class="absolute bottom-3 left-3 font-display font-semibold uppercase tracking-[0.12em] text-xs text-white">{item.label}</p>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- ─── PROCESS ───────────────────────────────────────────────────────── -->
  <section class="bg-white border-b border-slate-100">
    <div class="mx-auto max-w-6xl px-6 sm:px-10 py-20 md:py-28">

      <div class="text-center mb-16">
        <p class="section-label text-accent-dark mb-6">How It Works</p>
        <h2 class="font-display leading-[1.05] text-[clamp(2rem,4.5vw,3rem)] text-ink">
          <span class="block font-light">How Your Excavation</span>
          <span class="block font-semibold">Project Gets Started</span>
        </h2>
      </div>

      <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
        {processSteps.map((step) => (
          <div>
            <span class="font-display font-light text-[5.5rem] leading-none text-accent/25 block">{step.num}</span>
            <hr class="border-t border-slate-200 mt-3 mb-5" />
            <p class="font-display font-semibold uppercase tracking-[0.08em] text-sm text-ink mb-3">{step.title}</p>
            <p class="text-sm text-slate-600 leading-relaxed">{step.detail}</p>
          </div>
        ))}
      </div>

      <div class="mt-14 flex justify-center">
        <a href="/contact" class="btn btn-cta">Start the Conversation</a>
      </div>

    </div>
  </section>

  <!-- ─── REVIEWS ───────────────────────────────────────────────────────── -->
  <section class="bg-ink text-white">
    <div class="mx-auto max-w-6xl px-6 sm:px-10 py-20 md:py-28">

      <div class="max-w-2xl mb-14">
        <p class="section-label text-accent-light mb-6">What They Say</p>
        <h2 class="font-display leading-[1.05] text-[clamp(2rem,4.5vw,3rem)] text-white">
          <span class="block font-light">What customers</span>
          <span class="block font-semibold">say about D&amp;D Land Works.</span>
        </h2>
      </div>

      <div class="grid gap-5 sm:grid-cols-3">
        {reviews.map((review) => (
          <div class="bg-[#212528] rounded-(--radius-brand-card) p-7 flex flex-col gap-5">
            <span class="font-display font-bold text-[3.5rem] leading-none text-accent-light/80 select-none">&ldquo;</span>
            <p class="text-white/70 text-sm leading-relaxed flex-1 -mt-3">{review.text}</p>
            <div class="pt-4 border-t border-white/10">
              <p class="font-display font-semibold text-sm text-white">{review.name}</p>
              <p class="font-body text-xs text-white/40 mt-0.5">{review.location}</p>
            </div>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- ─── SERVICE AREA ──────────────────────────────────────────────────── -->
  <section class="bg-cream">
    <div class="mx-auto max-w-6xl px-6 sm:px-10 py-20 md:py-28">

      <div class="grid gap-14 lg:grid-cols-2 lg:items-start">

        <div>
          <p class="section-label text-accent-dark mb-6">Our Service Area</p>
          <h2 class="font-display leading-[1.05] text-[clamp(2rem,4.5vw,3rem)] text-ink mb-6">
            <span class="block font-light">Excavation Services</span>
            <span class="block font-semibold">Throughout Lane County, Oregon</span>
          </h2>
          <p class="text-ink/60 text-sm leading-relaxed mb-8 max-w-sm">
            D&D Land Works provides excavation, grading, and site preparation for residential and commercial properties across Lane County, including Eugene, Springfield, Cottage Grove, Junction City, Creswell, Veneta, Florence, Oakridge, Coburg, and Lowell.
          </p>
          <div class="flex flex-wrap gap-2 mb-8">
            {serviceAreas.map((area) => (
              <a
                href={area.href}
                class="inline-flex items-center px-4 py-2 rounded-full border border-cream-border bg-white text-sm font-display font-semibold text-ink hover:border-accent hover:text-accent transition-colors"
              >
                {area.label}
              </a>
            ))}
          </div>
          <a href="/service-area" class="btn btn-cta">View Full Service Area</a>
        </div>

        <div class="overflow-hidden rounded-(--radius-brand-card) border border-cream-border shadow-sm min-h-[400px]">
          <iframe
            title="D&D Land Works service area — Lane County, Oregon"
            src="https://maps.google.com/maps?q=Lane+County,+Oregon&z=9&output=embed"
            width="100%"
            height="100%"
            style="border:0; display:block; min-height:400px;"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
        </div>

      </div>

    </div>
  </section>

  <!-- ─── FAQ ───────────────────────────────────────────────────────────── -->
  <section class="bg-white border-b border-slate-100">
    <div class="mx-auto max-w-6xl px-6 sm:px-10 py-20 md:py-28">

      <div class="grid gap-14 lg:grid-cols-[5fr_7fr] lg:items-start">

        <!-- Left: heading + call info -->
        <div class="lg:sticky lg:top-10">
          <p class="section-label text-accent-dark mb-6">Common Questions</p>
          <h2 class="font-display leading-[1.05] text-[clamp(2rem,4.5vw,3rem)] text-ink mb-8">
            <span class="block font-light">Common Questions About</span>
            <span class="block font-semibold">Excavation Services</span>
          </h2>
          <p class="text-sm text-slate-600 leading-relaxed mb-8">Have a question not listed here? Call David directly — he's happy to talk through your project.</p>

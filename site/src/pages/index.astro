---
/*
  Homepage — promoted from home-v2.astro (2026-09-22).
*/
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ServiceCard from '../components/ServiceCard.astro';
import FAQ from '../components/FAQ.astro';
import CTABlock from '../components/CTABlock.astro';

const services = [
  { title: 'Site Preparation', description: 'Before construction starts, the property may need clearing, digging, grading, or other ground work. We prepare the area based on what your project and property require.', href: '/services/site-preparation', icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M9 20 4 18V4l5 2 6-2 5 2v14l-5-2-6 2Z M9 4v14M15 6v14" />' },
  { title: 'Land & Brush Clearing', description: 'Brush, overgrowth, and unwanted vegetation can make it hard to use or work on a property. We clear areas so there is open ground for excavation, grading, or construction.', href: '/land-clearing-services-eugene-oregon', icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M12 2 8 9h2l-3 6h3v6h4v-6h3l-3-6h2L12 2Z" />' },
  { title: 'Grading & Leveling', description: 'Uneven ground can cause water to collect or make an area hard to use. We shape the ground to improve the surface and help water move where it should.', href: '/land-grading-services-eugene-oregon', icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M3 17h4l4-9 4 5 3-4h3M17 6h3v3" />' },
  { title: 'Foundation Excavation', description: 'A building project may need an area dug out before the foundation work begins. We excavate the foundation area based on the plans and site conditions.', href: '/foundation-excavation-eugene-oregon', icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M9 3h6a1 1 0 0 1 1 1v1H8V4a1 1 0 0 1 1-1Z M7 6h10v14a1 1 0 0 1-1 1H8a1 1 0 0 1-1-1V6Z" />' },
  { title: 'Drainage Excavation', description: 'Water can cause problems around buildings, driveways, and other parts of a property. We dig channels and trenches where needed to help move water away from problem areas.', href: '/drainage-installation-eugene-oregon', icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M12 3s6 7 6 11a6 6 0 1 1-12 0c0-4 6-11 6-11Z" />' },
  { title: 'Utility Excavation', description: 'Water, sewer, electrical, and other underground lines may need a trench before installation. We excavate the path needed for the utility work.', href: '/utility-trenching-eugene-oregon', icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M14.7 6.3a4 4 0 0 1-5.6 5.6L4 17l3 3 5.1-5.1a4 4 0 0 1 5.6-5.6L21 6l-3-3-3.3 3.3Z" />' },
  { title: 'Trenching & Backfill', description: 'A trench gives underground lines and other systems a place to go. We dig the trench and can backfill the area after the work is completed, based on the project scope.', href: '/trenching-services-eugene-oregon', icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M9 3 5 21M15 3l4 18M12 8v2.5m0 4v2.5" />' },
  { title: 'Septic Installation & Repair', description: 'Septic work can require excavation around the existing system or new system area. The work depends on the property, existing system, site conditions, and applicable requirements.', href: '/septic-installation-lane-county-oregon', icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M6 7c0-1.7 2.7-3 6-3s6 1.3 6 3v10c0 1.7-2.7 3-6 3s-6-1.3-6-3V7Z M6 7c0 1.7 2.7 3 6 3s6-1.3 6-3" />' },
  { title: 'Driveway Repair', description: 'Gravel driveways can develop potholes, ruts, washouts, and uneven areas. We can regrade and repair problem areas based on the condition of the driveway and ground.', href: '/services/driveway-repair', icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M4 21V10l8-6 8 6v11M4 21h16M9 21v-6h6v6" />' },
  { title: 'Slope Stabilization', description: 'Slopes can change when soil moves or water causes erosion. We can excavate, reshape, and regrade areas where ground movement needs to be addressed.', href: '/slope-stabilization-eugene-oregon', icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M3 20 9 8l4 6 2-3 6 9H3Z" />' },
];

const problemCards = [
  {
    title: 'Land That Needs Clearing or Preparation',
    description: 'If your property is covered with brush or has uneven ground, it may need some work before you can build or improve it. We can clear the area, excavate where needed, and prepare the ground for the next step.',
    icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M3 20 9 8l4 6 2-3 6 9H3Z" />',
    href: '/services/site-preparation',
    linkLabel: 'Site Preparation',
  },
  {
    title: 'Standing Water and Poor Grading',
    description: 'Water that collects around your home, driveway, or yard can make the ground muddy and hard to use. We can reshape the ground and improve the way water moves across the property.',
    icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M12 3s6 7 6 11a6 6 0 1 1-12 0c0-4 6-11 6-11Z" />',
    href: '/land-grading-services-eugene-oregon',
    linkLabel: 'Grading & Leveling',
  },
  {
    title: 'Drainage, Erosion, and Slopes',
    description: 'Rain and runoff can move soil, damage slopes, and create wet areas. We can excavate, reshape, and regrade problem areas based on the ground and water conditions on your property.',
    icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M3 17h4l4-9 4 5 3-4h3M17 6h3v3" />',
    href: '/drainage-installation-eugene-oregon',
    linkLabel: 'Drainage Excavation',
  },
  {
    title: 'Damaged Driveways and Site Access',
    description: 'Ruts, washouts, uneven ground, or poor access can make it hard to use your property. We can repair gravel driveways, reshape access areas, and do the excavation needed to improve the site.',
    icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M9 3 5 21M15 3l4 18M12 8v2.5m0 4v2.5" />',
    href: '/driveway-excavation-grading-eugene-oregon',
    linkLabel: 'Driveway Repair',
  },
];

const whyItems = [
  {
    title: 'Licensed & Bonded',
    description: 'D&D Land Works is licensed and bonded in Oregon under CCB #261742. Customers can verify the license through the official Oregon Construction Contractors Board lookup.',
    icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M12 3l8 3v5c0 5.25-3.5 10.15-8 11.5C7.5 21.15 4 16.25 4 11V6l8-3Z" />',
    link: { label: 'Verify CCB License →', href: 'https://search.ccb.state.or.us/search/' },
  },
  {
    title: 'Free Estimates',
    description: 'We provide free estimates for excavation and site preparation projects. The scope can be discussed around the property, access, existing conditions, and work you need completed.',
    icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M9 3h6a1 1 0 0 1 1 1v1H8V4a1 1 0 0 1 1-1Z M7 6h10v14a1 1 0 0 1-1 1H8a1 1 0 0 1-1-1V6Z M9 12.5l2 2 4-4.5" />',
  },
  {
    title: 'Residential Excavation',
    description: 'We handle excavation and site preparation for homeowners and property owners throughout Eugene, Springfield, and surrounding Lane County communities.',
    icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M5 21V7l7-4 7 4v14M3 21h18M9 21v-4h6v4" />',
  },
  {
    title: 'Commercial Excavation',
    description: 'We also handle excavation and site preparation for commercial customers, builders, and other property projects based on the required scope and site conditions.',
    icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M3 21V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v16M9 21v-6h6v6M3 21h18" />',
  },
  {
    title: 'DEQ Certified for Septic Work',
    description: 'D&D Land Works is DEQ certified for relevant septic installation and repair work, including excavation associated with applicable septic projects.',
    icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M6 7c0-1.7 2.7-3 6-3s6 1.3 6 3v10c0 1.7-2.7 3-6 3s-6-1.3-6-3V7Z M6 7c0 1.7 2.7 3 6 3s6-1.3 6-3" />',
  },
];

const processSteps = [
  { step: '1', title: 'Talk About the Project', detail: 'We start by talking with you about your property and what you need done. We\'ll discuss the area, access, and the type of excavation or site work you have in mind.' },
  { step: '2', title: 'Look at the Property', detail: 'We look at the ground, slope, drainage, soil, access, and nearby structures or utilities. These conditions can change how the work needs to be done.' },
  { step: '3', title: 'Do the Site Work', detail: 'Once we know what the property needs, we complete the planned clearing, excavation, grading, trenching, drainage, or related work.' },
  { step: '4', title: 'Check the Finished Work', detail: 'When the work is done, we look over the area with the planned work in mind. We make sure the completed work matches what was discussed for the project.' },
];

const faqs = [
  { question: 'What Does an Excavation Contractor Do?', answer: 'An excavation contractor prepares and changes ground for construction, drainage, utilities, foundations, access, septic work, and other property projects. D&D Land Works handles excavation, clearing, grading, trenching, driveway repair, septic work, and related site preparation throughout Lane County.' },
  { question: 'Does D&D Land Works Handle Septic Excavation?', answer: 'Yes. D&D Land Works handles septic installation and repair and is DEQ certified for applicable septic work. Excavation is part of most septic projects, including system installation, repair, and access work. The scope depends on the property, existing system conditions, site access, and applicable DEQ requirements.' },
  { question: 'What Should I Have Ready Before Requesting an Excavation Estimate?', answer: 'It helps to know the property location, the type of work you need, site preparation, grading, foundation excavation, drainage, utility trenching, driveway repair, septic, or slope work, existing access conditions, and any project timing you\'re working around. If you have plans or project documents, those can help clarify the scope, but you can start by telling us about the property and the work you need.' },
  { question: 'Is D&D Land Works Licensed and Bonded?', answer: 'Yes. D&D Land Works is licensed and bonded in Oregon under Construction Contractors Board license #261742. Customers can verify Oregon contractor licensing through the Oregon CCB\'s official license lookup before hiring an excavation contractor for their project.' },
  { question: 'Does D&D Land Works Provide Free Estimates?', answer: 'Yes. D&D Land Works provides free estimates for excavation and site preparation projects. The estimate can be based on the property\'s existing conditions, access, planned work, excavation requirements, drainage, utilities, and other factors affecting the project scope.' },
];

const anchorAreas = [
  { label: 'Eugene', href: '/locations/eugene' },
  { label: 'Springfield', href: '/locations/springfield' },
];
const otherAreas = [
  { label: 'Cottage Grove', href: '/locations/cottage-grove' },
  { label: 'Junction City', href: '/locations/junction-city' },
  { label: 'Creswell', href: '/locations/creswell' },
  { label: 'Veneta', href: '/locations/veneta' },
  { label: 'Florence', href: '/locations/florence' },
  { label: 'Oakridge', href: '/locations/oakridge' },
  { label: 'Coburg', href: '/locations/coburg' },
  { label: 'Lowell', href: '/locations/lowell' },
];

const businessSchema = {
  '@context': 'https://schema.org',
  '@type': 'GeneralContractor',
  additionalType: 'https://schema.org/HomeAndConstructionBusiness',
  '@id': 'https://www.ddlandworks.com/#business',
  name: 'D&D Land Works',
  url: 'https://www.ddlandworks.com/',
  telephone: '+1-541-401-8726',
  email: 'david@ddlandworks.com',
  founder: { '@type': 'Person', name: 'David Deggelman' },
  identifier: { '@type': 'PropertyValue', propertyID: 'Oregon CCB License', value: '261742' },
  hasCredential: {
    '@type': 'EducationalOccupationalCredential',
    credentialCategory: 'certification',
    name: 'DEQ Certified',
    recognizedBy: { '@type': 'GovernmentOrganization', name: 'Oregon Department of Environmental Quality' },
  },
  address: { '@type': 'PostalAddress', addressRegion: 'OR', addressCountry: 'US' },
  areaServed: ['Lane County, Oregon', 'Eugene, Oregon', 'Springfield, Oregon', 'Cottage Grove, Oregon', 'Junction City, Oregon', 'Creswell, Oregon', 'Veneta, Oregon', 'Florence, Oregon', 'Oakridge, Oregon', 'Coburg, Oregon', 'Lowell, Oregon'],
};
---

<BaseLayout
	title="D&D Land Works | Excavation Contractor in Lane County, Oregon"
	description="D&D Land Works is a licensed excavation contractor serving Lane County, Oregon. Site prep, grading, land clearing, septic, and drainage. CCB #261742. DEQ Certified. Call 541-401-8726 for a free quote."
>
	<!-- ── Hero ─────────────────────────────────────────────────────────── -->
	<Hero
		eyebrow="Lane County, OR"
		headline="Licensed Excavation Contractor in Lane County, Oregon"
		subheadline="D&D Land Works is a licensed excavation contractor serving Eugene and Lane County, Oregon. We handle site preparation, grading, land clearing, foundation excavation, drainage, utility excavation, trenching, septic work, driveway repair, and slope stabilization for residential and commercial properties."
		primaryCta={{ label: 'Request a Free Estimate', href: '/contact' }}
		secondaryCta={{ label: 'Our Services', href: '#services' }}
		backgroundImages={['/project-excavation-bucket.webp', '/project-grading-driveway.webp', '/project-finished-grading.webp']}
	/>

	<!-- ── About: Owner-Operated ────────────────────────────────────────── -->
	<section class="relative bg-white overflow-hidden">
		<div
			class="pointer-events-none absolute -right-32 -top-16 h-96 w-96 rounded-full bg-brand-blue-light/40 blur-3xl"
			aria-hidden="true"
		></div>

		<div class="mx-auto max-w-6xl px-4 py-20 md:py-32">
			<div class="grid gap-12 lg:gap-20 lg:grid-cols-2 lg:items-center">

				<!-- Text column -->
				<div>
					<div class="mb-4 flex items-center gap-2">
						<img src="/logo.png" alt="" class="h-6 w-auto" aria-hidden="true" />
						<p class="font-display font-semibold uppercase tracking-widest text-sm text-brand-blue">
							About D&amp;D Land Works
						</p>
					</div>
					<h2 class="font-display font-black uppercase tracking-tight text-3xl text-ink md:text-4xl">
						Owner-Operated Excavation Contractor Serving Lane County, Oregon
					</h2>
					<div class="mt-5 flex flex-col gap-4 text-slate-700 leading-relaxed">
						<p>David Deggelman works directly with property owners to understand what needs to be done. Every property is different. The ground, access, drainage, slope, and existing work can all change the job. We look at those conditions before deciding what work is needed.</p>
						<p>D&amp;D Land Works helps with excavation and site work across Lane County. This includes site preparation, brush clearing, grading, foundation excavation, drainage excavation, utility excavation, trenching, septic work, driveway repair, and slope stabilization.</p>
						<p>We work with homeowners, property owners, builders, and commercial customers in Eugene, Springfield, Cottage Grove, Junction City, Creswell, Veneta, Florence, Oakridge, Coburg, Lowell, and nearby Lane County communities. If you are not sure what your property needs, we can look at the site and talk through the work with you.</p>
					</div>
					<a href="/about" class="btn-pill mt-8 inline-flex">
						Learn More About D&amp;D Land Works
						<span class="btn-pill-icon">
							<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
								<path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M17 7H7M17 7V17" />
							</svg>
						</span>
					</a>
				</div>

				<!-- Image column -->
				<div class="relative pb-6">
					<img
						src="/project-excavation-bucket.webp"
						alt="D&D Land Works excavation contractor working in Lane County, Oregon"
						class="w-full rounded-(--radius-brand-card) object-cover aspect-4/3 shadow-xl"
						loading="lazy"
					/>
					<div class="absolute bottom-10 left-4 sm:left-6 flex items-center gap-3 rounded-(--radius-brand-card) bg-brand-blue px-4 py-3 text-white shadow-lg">
						<span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-white/15">
							<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
								<path stroke-linecap="round" stroke-linejoin="round" d="M12 3l8 3v5c0 5.25-3.5 10.15-8 11.5C7.5 21.15 4 16.25 4 11V6l8-3Z" />
							</svg>
						</span>
						<div class="leading-tight">
							<p class="font-display font-bold text-sm">CCB #261742</p>
							<p class="font-body text-xs text-white/80">Licensed &amp; Bonded</p>
						</div>
					</div>
				</div>

			</div>
		</div>
	</section>

	<!-- ── Services ─────────────────────────────────────────────────────── -->
	<section id="services" class="relative">
		<div class="relative bg-ink overflow-hidden">
			<img src="/project-site-excavation.webp" alt="" aria-hidden="true" class="absolute inset-0 h-full w-full object-cover opacity-45" loading="lazy" />
			<div class="absolute inset-0 bg-linear-to-b from-ink/80 via-ink/70 to-ink"></div>
			<div class="relative mx-auto max-w-3xl px-4 pt-20 pb-40 text-center md:pt-28 md:pb-52">
				<p class="font-display font-semibold uppercase tracking-widest text-sm text-brand-blue-light">Our Services</p>
				<h2 class="mt-2 font-display font-black uppercase tracking-tight text-3xl text-white md:text-5xl">
					Complete Excavation &amp; Site Preparation Services
				</h2>
				<p class="mt-5 text-slate-300 leading-relaxed">
					Every property has different ground, access, drainage, and site needs. We help with the digging, clearing, grading, and other site work needed to move a project forward.
				</p>
			</div>
		</div>

		<div class="relative mx-auto max-w-6xl px-4 -mt-32 pb-6 md:-mt-40">
			<div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
				{services.map((service) => <ServiceCard {...service} />)}
			</div>
		</div>

		<div class="mx-auto max-w-3xl px-4 pt-4 pb-20 md:pb-24 text-center flex flex-wrap justify-center gap-4">
			<a href="/services" class="btn btn-cta inline-flex">Explore Our Services</a>
			<a href="/contact" class="btn btn-outline inline-flex">Request a Free Estimate</a>
		</div>
	</section>

	<!-- ── Common Property Problems ─────────────────────────────────────── -->
	<section class="bg-slate-50 border-y border-slate-200">
		<div class="mx-auto max-w-6xl px-4 py-20 md:py-28">

			<div class="mb-12 md:mb-14 text-center">
				<p class="font-display font-semibold uppercase tracking-widest text-sm text-brand-blue">Common Property Problems</p>
				<h2 class="mt-2 font-display font-black uppercase tracking-tight text-3xl text-ink md:text-4xl">
					Problems We Help Property Owners Solve
				</h2>
				<p class="mt-4 text-slate-600 max-w-2xl mx-auto leading-relaxed">Every property has its own challenges. You may need to clear land, fix standing water, repair a driveway, or prepare an area for construction. We look at the ground and the work needed before deciding what should be done.</p>
			</div>

			<div class="grid gap-6 sm:grid-cols-2">
				{problemCards.map((card) => (
					<div class="card flex gap-5 items-start">
						<span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-brand-blue-light text-brand-blue">
							<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" set:html={card.icon} />
						</span>
						<div>
							<h3 class="font-display font-bold uppercase tracking-wide text-base text-ink">{card.title}</h3>
							<p class="mt-2 text-sm text-slate-600 leading-relaxed">{card.description}</p>
							{card.href && (
								<a href={card.href} class="mt-3 inline-flex items-center gap-1 text-sm font-semibold text-brand-blue hover:underline">
									{card.linkLabel}
									<svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
										<path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M17 7H7M17 7V17" />
									</svg>
								</a>
							)}
						</div>
					</div>
				))}
			</div>

			<div class="mt-12 text-center">
				<a href="/contact" class="btn-pill inline-flex">
					Talk With Us About Your Property
					<span class="btn-pill-icon">
						<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
							<path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M17 7H7M17 7V17" />
						</svg>
					</span>
				</a>
			</div>

		</div>
	</section>

	<!-- ── What to Expect / Process ─────────────────────────────────────── -->
	<section class="relative bg-ink text-white overflow-hidden">
		<div
			class="pointer-events-none absolute right-0 top-0 h-[480px] w-[480px] rounded-full bg-brand-blue/10 blur-3xl"
			aria-hidden="true"
		></div>

		<div class="relative mx-auto max-w-6xl px-4 py-20 md:py-28">

			<div class="mb-12 md:mb-16 text-center">
				<p class="font-display font-semibold uppercase tracking-widest text-sm text-brand-blue-light">How It Works</p>
				<h2 class="mt-2 font-display font-bold uppercase tracking-tight text-3xl text-white md:text-4xl">
					How Your Excavation Project Gets Started
				</h2>
				<p class="mt-4 text-slate-300 max-w-2xl mx-auto leading-relaxed">
					Every property is different. We start by talking with you, looking at the site, and understanding what needs to be done. Then we plan the work around the ground, access, drainage, and other site conditions.
				</p>
			</div>

			<div class="grid gap-4 sm:grid-cols-2 sm:gap-6 lg:grid-cols-4">
				{processSteps.map((item) => (
					<div class="rounded-(--radius-brand-card) bg-white/5 border border-white/10 p-6 sm:p-7">
						<span class="flex h-10 w-10 items-center justify-center rounded-full bg-safety-orange font-display font-bold text-white text-sm">
							{item.step}
						</span>
						<p class="mt-4 font-display font-bold uppercase tracking-wide text-sm text-white">{item.title}</p>
						<p class="mt-2 text-sm text-slate-300 leading-relaxed">{item.detail}</p>
					</div>
				))}
			</div>

			<div class="mt-12 text-center">
				<a href="/contact" class="btn btn-cta">Discuss Your Project</a>
			</div>
		</div>
	</section>

	<!-- ── Why Choose D&D Land Works ────────────────────────────────────── -->
	<section class="bg-white border-b border-slate-100">
		<div class="mx-auto max-w-6xl px-4 py-20 md:py-28">
			<div class="grid gap-12 lg:gap-20 lg:grid-cols-2 lg:items-center">

				<!-- Left: text + feature list -->
				<div>
					<h2 class="font-display font-black uppercase tracking-tight text-3xl text-ink md:text-4xl">
						Why Choose <span class="text-brand-blue">D&amp;D Land Works?</span>
					</h2>
					<p class="mt-5 text-slate-600 leading-relaxed">
						Every excavation project has different site conditions, access requirements, and work involved. D&amp;D Land Works keeps the scope clear and brings relevant excavation, grading, and site preparation services together for residential and commercial projects.
					</p>

					<ul class="mt-10 flex flex-col gap-7">
						{whyItems.map((item) => (
							<li class="flex items-start gap-4">
								<span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-brand-blue-light text-brand-blue mt-0.5">
									<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" set:html={item.icon} />
								</span>
								<div>
									<p class="font-display font-bold text-ink">{item.title}</p>
									<p class="mt-1 text-sm text-slate-600 leading-relaxed">{item.description}</p>
									{item.link && (
										<a
											href={item.link.href}
											target="_blank"
											rel="noopener noreferrer"

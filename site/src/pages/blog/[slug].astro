---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import CTABlock from '../../components/CTABlock.astro';
import FAQ from '../../components/FAQ.astro';
import { posts, images } from '../../data/blog-posts';
import type { BlogPost } from '../../data/blog-posts';

export function getStaticPaths() {
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props as { post: BlogPost };

const categories = [...new Set(posts.map((p) => p.category))];
const recentPosts = posts.filter((p) => p.slug !== post.slug).slice(0, 4);
const sameCategory = posts.filter((p) => p.slug !== post.slug && p.category === post.category);
const related = (sameCategory.length > 0 ? sameCategory : posts.filter((p) => p.slug !== post.slug)).slice(0, 3);

const shareUrl = new URL(Astro.url.pathname, Astro.site).href;
const shareText = encodeURIComponent(post.title);
---

<BaseLayout
	title={`${post.title} | D&D Land Works Blog`}
	description={post.excerpt}
>
	<Hero headline={post.title} backgroundImages={[post.image]} />
	<section class="mx-auto max-w-6xl px-4 py-16">
		<div class="grid gap-12 lg:grid-cols-3">
			<article class="lg:col-span-2">
				<div class="flex flex-wrap items-center gap-3">
					<span class="rounded-full bg-brand-blue-light px-3 py-1 font-display font-semibold uppercase tracking-wide text-xs text-brand-blue">
						{post.category}
					</span>
					<span class="text-sm text-slate-500">{post.date}</span>
				</div>
				<p class="mt-5 text-lg text-slate-700 leading-relaxed">
					{post.excerpt}
				</p>

				{post.body && post.body.length > 0 ? (
					<div class="mt-8 flex flex-col gap-8">
						{post.body.map((section) => (
							<div>
								<h2 class="font-display font-bold uppercase tracking-tight text-2xl text-ink">
									{section.heading}
								</h2>
								{section.paragraphs.map((paragraph) => (
									<p class="mt-3 text-slate-700 leading-relaxed">{paragraph}</p>
								))}
							</div>
						))}
					</div>
				) : (
					<p class="mt-8 text-slate-500 italic">
						Full article coming soon. Have a question about this topic in the meantime? <a href="/contact" class="text-brand-blue underline hover:text-brand-blue-dark">Ask David directly</a>.
					</p>
				)}

				{post.faqs && post.faqs.length > 0 && (
					<div class="mt-12">
						<FAQ heading="Frequently Asked Questions" items={post.faqs} />
					</div>
				)}

				<div class="mt-10 flex items-center gap-3 border-t border-slate-200 pt-6">
					<span class="font-display font-semibold uppercase tracking-wide text-sm text-ink">Share:</span>
					<a
						href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(shareUrl)}`}
						target="_blank"
						rel="noopener"
						aria-label="Share on Facebook"
						class="flex h-9 w-9 items-center justify-center rounded-full bg-slate-100 text-slate-600 hover:bg-brand-blue hover:text-white transition-colors"
					>
						<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="h-4 w-4 fill-current">
							<path d="M9.101 23.691v-7.98H6.627v-3.667h2.474v-2.796c0-4.339 2.784-6.706 6.593-6.706 1.815 0 3.375.135 3.828.196v4.361h-2.65c-1.756 0-2.087.834-2.087 2.057v2.696h4.155l-.606 3.667h-3.549v7.98H9.101z" />
						</svg>
					</a>
					<a
						href={`https://twitter.com/intent/tweet?url=${encodeURIComponent(shareUrl)}&text=${shareText}`}
						target="_blank"
						rel="noopener"
						aria-label="Share on X"
						class="flex h-9 w-9 items-center justify-center rounded-full bg-slate-100 text-slate-600 hover:bg-brand-blue hover:text-white transition-colors"
					>
						<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="h-4 w-4 fill-current">
							<path d="M18.9 2H22l-7.6 8.7L23 22h-6.9l-5.4-6.6L4.5 22H1.4l8.2-9.3L1 2h7l4.9 6.1L18.9 2Zm-1.2 18h1.9L7.4 4H5.4l12.3 16Z" />
						</svg>
					</a>
					<a
						href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(shareUrl)}`}
						target="_blank"
						rel="noopener"
						aria-label="Share on LinkedIn"
						class="flex h-9 w-9 items-center justify-center rounded-full bg-slate-100 text-slate-600 hover:bg-brand-blue hover:text-white transition-colors"
					>
						<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="h-4 w-4 fill-current">
							<path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.34V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.38-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.07 2.07 0 1 1 0-4.13 2.07 2.07 0 0 1 0 4.13ZM7.12 20.45H3.56V9h3.56v11.45Z" />
						</svg>
					</a>
				</div>
			</article>
			<aside class="flex flex-col gap-8">
				<div class="rounded-(--radius-brand-card) bg-brand-blue-light p-6">
					<p class="font-display font-black text-xl text-ink">Categories</p>
					<div class="mt-3 border-t border-brand-blue/20"></div>
					<ul class="mt-4 flex flex-col gap-3 text-sm">
						{categories.map((category) => (
							<li>
								<a href="/blog" class="font-medium text-slate-700 hover:text-brand-blue transition-colors">{category}</a>
							</li>
						))}
					</ul>
				</div>
				<div class="rounded-(--radius-brand-card) bg-brand-blue-light p-6">
					<p class="font-display font-black text-xl text-ink">Recent Posts</p>
					<div class="mt-3 border-t border-brand-blue/20"></div>
					<ul class="mt-4 flex flex-col gap-4">
						{recentPosts.map((recent) => (
							<li class="flex items-center gap-3">
								<img src={recent.image} alt="" class="h-12 w-12 shrink-0 rounded-(--radius-brand) object-cover" loading="lazy" />
								<a href={`/blog/${recent.slug}`} class="text-sm font-semibold leading-snug text-ink hover:text-brand-blue transition-colors">
									{recent.title}
								</a>
							</li>
						))}
					</ul>
				</div>
				<div class="rounded-(--radius-brand-card) bg-brand-blue-light p-6">
					<p class="font-display font-black text-xl text-ink">Photo Gallery</p>
					<div class="mt-3 border-t border-brand-blue/20"></div>
					<div class="mt-4 grid grid-cols-3 gap-2">
						{[...images, ...images].slice(0, 6).map((image) => (
							<img src={image} alt="" class="aspect-square w-full rounded-(--radius-brand) object-cover" loading="lazy" />
						))}
					</div>
				</div>
			</aside>
		</div>
	</section>
	<section class="border-t border-slate-200 bg-slate-50">
		<div class="mx-auto max-w-6xl px-4 py-16">
			<h2 class="font-display font-bold uppercase tracking-tight text-2xl text-ink">Related Posts</h2>
			<div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
				{related.map((relatedPost) => (
					<a href={`/blog/${relatedPost.slug}`} class="card overflow-hidden p-0 block hover:shadow-md hover:border-brand-blue transition-all group">
						<img src={relatedPost.image} alt="" class="h-40 w-full object-cover" loading="lazy" />
						<div class="p-4">
							<h3 class="font-display font-bold text-base text-brand-blue group-hover:text-brand-blue-dark transition-colors">
								{relatedPost.title}
							</h3>
							<span class="mt-2 inline-block text-xs font-display font-bold uppercase tracking-wide text-brand-blue">
								Read More &raquo;
							</span>
						</div>
					</a>
				))}
			</div>
		</div>
	</section>
	<CTABlock
		headline="Have a Question We Haven't Covered?"
		subheadline="Skip the search and ask David directly, it's faster than digging through articles."
	/>
</BaseLayout>

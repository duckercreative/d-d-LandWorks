---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ServiceCard from '../components/ServiceCard.astro';
import FAQ from '../components/FAQ.astro';
import CTABlock from '../components/CTABlock.astro';

const sitePrepItems = [
  { title: 'Foundation Excavation', description: 'Building a house, a shop, or an addition? We dig the hole to match your plans, so the ground under your foundation is solid and flat.', href: '/foundation-excavation-eugene-oregon', icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M3 20 9 8l4 6 2-3 6 9H3Z" />' },
  { title: 'Utility Excavation', description: 'We dig trenches for water, sewer, power, and gas lines. We get buried lines marked before we start, so nothing gets hit.', href: '/utility-trenching-eugene-oregon', icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M9 3 5 21M15 3l4 18M12 8v2.5m0 4v2.5" />' },
  { title: 'Drainage Excavation', description: 'Water pooling in your yard or getting into your crawl space? We dig for French drains and other fixes that carry water away from your home.', href: '/drainage-installation-eugene-oregon', icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M12 3s6 7 6 11a6 6 0 1 1-12 0c0-4 6-11 6-11Z" />' },
  { title: 'Septic Excavation', description: "We're DEQ certified for septic work. We dig for new septic systems and for repairs on the ones you already have.", href: '/septic-installation-lane-county-oregon', icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 10h16M4 14h16M4 18h16" />' },
  { title: 'Site Preparation', description: "Got raw land? We clear it, dig out what doesn't belong, and get the ground ready for the builder.", href: '/site-preparation-contractor-eugene-oregon', icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M12 2 8 9h2l-3 6h3v6h4v-6h3l-3-6h2L12 2Z" />' },
  { title: 'Trenching and Backfill', description: 'We dig the trench, the pipe or line goes in, and then we fill it back in and pack it down tight. Your yard won\'t sink later.', href: '/trenching-services-eugene-oregon', icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M3 17h4l4-9 4 5 3-4h3M17 6h3v3" />' },
];

const howItWorksSteps = [
  { step: '1', title: 'Talk About the Project', detail: "We start by talking with you about your property and what you need done. We'll discuss the area, access, and the type of excavation or site work you have in mind." },
  { step: '2', title: 'Look at the Property', detail: 'We look at the ground, slope, drainage, soil, access, and nearby structures or utilities. These conditions can change how the work needs to be done.' },
  { step: '3', title: 'Do the Site Work', detail: 'Once we know what the property needs, we complete the planned clearing, excavation, grading, trenching, drainage, or related work.' },
  { step: '4', title: 'Check the Finished Work', detail: 'When the work is done, we look over the area with the planned work in mind. We make sure the completed work matches what was discussed for the project.' },
];

const faqs = [
  {
    question: 'Does D&D Land Works handle residential excavation?',
    answer: 'Yes. D&D Land Works provides residential excavation for foundations, utilities, drainage, septic work, and other property preparation needs.',
  },
  {
    question: 'Does D&D Land Works handle commercial excavation?',
    answer: 'Yes. Commercial excavation can support construction, utilities, drainage, site preparation, and other project needs based on the property\'s conditions.',
  },
  {
    question: 'Can excavation include grading?',
    answer: 'Yes. Excavation and grading can work together when a project needs ground levels changed or prepared for the next stage of site work.',
  },
  {
    question: 'Can excavation include drainage work?',
    answer: "Yes. Excavation can create the space needed for drainage systems. The approach depends on the property's slope, soil, water flow, and existing conditions.",
  },
  {
    question: 'Can excavation be part of septic installation?',
    answer: 'Yes. Septic installation can require excavation for the planned system. D&D Land Works handles relevant septic excavation and repair work.',
  },
  {
    question: 'How does rain affect excavation in Eugene?',
    answer: 'Rain can change ground conditions and equipment access. Wet soil may affect scheduling and how excavation work is approached on a particular property.',
  },
];

const pageSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'GeneralContractor',
      '@id': 'https://www.ddlandworks.com/#business',
      name: 'D&D Land Works',
      url: 'https://www.ddlandworks.com/',
      telephone: '+15414018726',
      email: 'david@ddlandworks.com',
      description: 'Full-service excavation, grading, and site preparation contractor serving Eugene, Springfield, and Lane County, Oregon. Licensed and bonded CCB #261742, DEQ Certified.',
      priceRange: '$$',
      areaServed: [
        { '@type': 'City', name: 'Eugene', sameAs: 'https://www.wikidata.org/wiki/Q49330' },
        { '@type': 'City', name: 'Springfield', sameAs: 'https://www.wikidata.org/wiki/Q49431' },
        { '@type': 'AdministrativeArea', name: 'Lane County, Oregon' },
      ],
      knowsAbout: ['Land Clearing', 'Brush Clearing', 'Site Preparation', 'Grading', 'Excavation', 'Septic Installation'],
      hasCredential: [
        { '@type': 'EducationalOccupationalCredential', credentialCategory: 'License', name: 'Oregon CCB License #261742' },
        { '@type': 'EducationalOccupationalCredential', credentialCategory: 'Certification', name: 'Oregon DEQ Certification — Septic Install & Repair' },
      ],
      sameAs: ['https://search.ccb.state.or.us/search/'],
    },
    {
      '@type': 'Service',
      '@id': 'https://www.ddlandworks.com/excavation-contractor-eugene-oregon/#service',
      name: 'Excavation Contractor in Eugene, Oregon',
      serviceType: 'Excavation',
      description: 'Excavation contractor serving Eugene, Oregon. Foundation digging, utility trenching, drainage excavation, and septic excavation. Licensed and bonded, CCB #261742.',
      url: 'https://www.ddlandworks.com/excavation-contractor-eugene-oregon/',
      provider: { '@id': 'https://www.ddlandworks.com/#business' },
      areaServed: ['Eugene, Oregon', 'Springfield, Oregon', 'Lane County, Oregon'],
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.question,
        acceptedAnswer: { '@type': 'Answer', text: faq.answer },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.ddlandworks.com/' },
        { '@type': 'ListItem', position: 2, name: 'Excavation Contractor Eugene Oregon', item: 'https://www.ddlandworks.com/excavation-contractor-eugene-oregon/' },
      ],
    },
  ],
};
---

<BaseLayout
  title="Excavation Contractor in Eugene, Oregon | D&D Land Works"
  description="Excavation contractor in Eugene, Oregon. Foundation digging, utility trenching, drainage, and septic excavation. Licensed and bonded, CCB #261742. Free estimates — call 541-401-8726."
>
  <Hero
    eyebrow="Eugene, Oregon"
    headline="Excavation Contractor in Eugene, Oregon"
    subheadline="Need to prepare a property for building, utilities, drainage, or other site work? D&D Land Works provides excavation in Eugene, OR for residential and commercial properties, with work planned around your site and its ground conditions."
    primaryCta={{ label: 'Call 541-401-8726', href: 'tel:5414018726' }}
    secondaryCta={{ label: 'Free Estimate', href: '/contact' }}
  />

  <!-- What We Excavate For -->
  <section class="relative bg-white overflow-hidden">
    <div
      class="pointer-events-none absolute -right-32 -top-16 h-96 w-96 rounded-full bg-brand-blue-light/40 blur-3xl"
      aria-hidden="true"
    ></div>
    <div class="mx-auto max-w-6xl px-4 py-20 md:py-32">
      <div class="grid gap-12 lg:gap-20 lg:grid-cols-2 lg:items-center">
        <!-- Text column -->
        <div>
          <div class="mb-4 flex items-center gap-2">
            <img src="/logo.png" alt="D&D Land Works" class="h-6 w-auto" />
            <p class="font-display font-semibold uppercase tracking-widest text-sm text-brand-blue">
              What We Excavate For
            </p>
          </div>
          <h2 class="font-display font-black uppercase tracking-tight text-3xl text-ink md:text-4xl">
            What Does an Excavation Contractor Do?
          </h2>
          <div class="mt-5 flex flex-col gap-4 text-slate-700 leading-relaxed">
            <p>Excavation work gets the ground ready for what comes next. D&amp;D Land Works digs and moves soil for foundations, utilities, drainage, septic work, and other site needs in Eugene and Lane County.</p>
            <p>Your property may need a small trench or a larger area prepared for construction. We look at the space, access, soil, and ground conditions before the work begins. The goal is to prepare the right area for your project.</p>
            <p>Builders may need foundation areas ready for construction. Homeowners may need drainage or utility trenches. Rural properties may need excavation for septic work. Each job has its own needs, and the work is planned around your site.</p>
          </div>
          <a href="/contact" class="btn-pill mt-8 inline-flex">
            Talk About Your Excavation Project
            <span class="btn-pill-icon">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M17 7H7M17 7V17" />
              </svg>
            </span>
          </a>
        </div>
        <!-- Image column -->
        <div class="relative pb-6">
          <img
            src="/project-excavation-bucket.webp"
            alt="D&D Land Works excavation contractor working in Lane County, Oregon"
            class="w-full rounded-(--radius-brand-card) object-cover aspect-4/3 shadow-xl"
            loading="lazy"
          />
          <div class="absolute bottom-10 left-4 sm:left-6 flex items-center gap-3 rounded-(--radius-brand-card) bg-brand-blue px-4 py-3 text-white shadow-lg">
            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-white/15">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 3l8 3v5c0 5.25-3.5 10.15-8 11.5C7.5 21.15 4 16.25 4 11V6l8-3Z" />
              </svg>
            </span>
            <div class="leading-tight">
              <p class="font-display font-bold text-sm">CCB #261742</p>
              <p class="font-body text-xs text-white/80">Licensed &amp; Bonded</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Excavation Services -->
  <section id="services" class="relative">
    <div class="relative bg-ink overflow-hidden">
      <img src="/project-site-excavation.webp" alt="" aria-hidden="true" class="absolute inset-0 h-full w-full object-cover opacity-45" loading="lazy" />
      <div class="absolute inset-0 bg-linear-to-b from-ink/80 via-ink/70 to-ink"></div>
      <div class="relative mx-auto max-w-3xl px-4 pt-20 pb-40 text-center md:pt-28 md:pb-52">
        <p class="font-display font-semibold uppercase tracking-widest text-sm text-brand-blue-light">Our Services</p>
        <h2 class="mt-2 font-display font-black uppercase tracking-tight text-3xl text-white md:text-5xl">
          Excavation Services D&amp;D Land Works Provides
        </h2>
        <p class="mt-5 text-slate-300 leading-relaxed">
          D&amp;D Land Works handles excavation for foundations, utilities, drainage, septic systems, and site preparation. Each project is planned around your property, access, ground conditions, and needs.
        </p>
      </div>
    </div>
    <div class="relative mx-auto max-w-6xl px-4 -mt-32 pb-6 md:-mt-40">
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {sitePrepItems.map((item) => <ServiceCard {...item} />)}
      </div>
    </div>
    <div class="mx-auto max-w-3xl px-4 pt-4 pb-20 md:pb-24 text-center flex flex-wrap justify-center gap-4">
      <a href="/services" class="btn btn-cta inline-flex">Explore Our Services</a>
      <a href="/contact" class="btn btn-outline inline-flex">Request a Free Estimate</a>
    </div>
  </section>

  <!-- Who We Excavate For -->
  <section class="bg-slate-50 border-y border-slate-200">
    <div class="mx-auto max-w-6xl px-4 py-20 md:py-28">
      <div class="mb-12 md:mb-14 text-center">
        <p class="font-display font-semibold uppercase tracking-widest text-sm text-brand-blue">Who We Excavate For</p>
        <h2 class="mt-2 font-display font-black uppercase tracking-tight text-3xl text-ink md:text-4xl">
          Excavation Services from D&amp;D Land Works
        </h2>
        <p class="mt-4 text-slate-700 max-w-2xl mx-auto leading-relaxed">
          D&amp;D Land Works is a full-service excavation company. One company can clear the land, dig, trench, grade and fill it back in. You don&rsquo;t have to juggle three contractors for one project. We work on homes, rural land and business sites across Lane County.
        </p>
      </div>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {[
          { title: 'Residential Excavation for Homeowners', description: "You live there, so you care about your yard, your walls and your driveway. Maybe you're adding a room or running a new water line. We dig carefully near the house. Then we fill it back in and pack it tight so the ground doesn't sink next to your foundation.", href: '/contact', linkLabel: 'Get a Free Estimate' },
          { title: 'Residential Excavation for Property Owners', description: "Maybe you own a lot you haven't built on yet, or a rental that needs work. You're not there every day, and that's okay. We look at the site, tell you in plain words what it needs and get the ground ready for your next step.", href: '/contact', linkLabel: 'Get a Free Estimate' },
          { title: 'Residential Excavation for Rural Land', description: "Acreage comes with its own jobs. You might need a trench to run power out to the barn, or a septic system far from any sewer line. Before we give you a price, we check how the machines will get in. On rural land, access can change the whole plan.", href: '/contact', linkLabel: 'Get a Free Estimate' },
          { title: 'Small Excavation Jobs Around Eugene', description: "Not every project is a big one. Sometimes it's a short trench or a small pad for a shed. Small jobs get the same careful look as big ones. A mistake next to your house costs just as much either way.", href: '/contact', linkLabel: 'Get a Free Estimate' },
          { title: 'Commercial Excavation for Builders', description: "Builders need the dig to match the plans so the next trade can start on time. We dig building pads and foundations, cut trenches for water and sewer, and grade the site so water drains off. Tell us your start date. We'll tell you straight what the site needs.", href: '/contact', linkLabel: 'Get a Free Estimate' },
          { title: 'Commercial Excavation for Developers', description: "Bigger sites mean more moving parts. There may be several lots, longer utility runs and more paperwork, like county permits and inspections. We work from your engineered plans and do the dirt work in the right order. That way each phase is ready for the crew that comes next.", href: '/contact', linkLabel: 'Get a Free Estimate' },
        ].map((card) => (
          <div class="card flex flex-col gap-3">
            <h3 class="font-display font-bold uppercase tracking-wide text-base text-ink">{card.title}</h3>
            <p class="text-sm text-slate-600 leading-relaxed flex-1">{card.description}</p>
            <a href={card.href} class="inline-flex items-center gap-1 text-sm font-semibold text-brand-blue hover:underline">
              {card.linkLabel}
              <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M17 7H7M17 7V17" />
              </svg>
            </a>
          </div>
        ))}
      </div>
      <div class="mt-12 text-center">
        <a href="/contact" class="btn-pill inline-flex">
          Get a Free Estimate
          <span class="btn-pill-icon">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M17 7H7M17 7V17" />
            </svg>
          </span>
        </a>
      </div>
    </div>
  </section>

  <!-- Process - How It Works -->
  <section class="relative bg-ink text-white overflow-hidden">
    <div
      class="pointer-events-none absolute right-0 top-0 h-[480px] w-[480px] rounded-full bg-brand-blue/10 blur-3xl"
      aria-hidden="true"
    ></div>
    <div class="relative mx-auto max-w-6xl px-4 py-20 md:py-28">
      <div class="mb-12 md:mb-16 text-center">
        <p class="font-display font-semibold uppercase tracking-widest text-sm text-brand-blue-light">How It Works</p>
        <h2 class="mt-2 font-display font-bold uppercase tracking-tight text-3xl text-white md:text-4xl">
          How Your Excavation Project Gets Started
        </h2>
        <p class="mt-4 text-slate-300 max-w-2xl mx-auto leading-relaxed">
          Every property is different. We start by talking with you, looking at the site, and understanding what needs to be done. Then we plan the work around the ground, access, drainage, and other site conditions.
        </p>
      </div>
      <div class="grid gap-4 sm:grid-cols-2 sm:gap-6 lg:grid-cols-4">
        {howItWorksSteps.map((item) => (
          <div class="rounded-(--radius-brand-card) bg-white/5 border border-white/10 p-6 sm:p-7">
            <span class="flex h-10 w-10 items-center justify-center rounded-full bg-safety-orange font-display font-bold text-white text-sm">
              {item.step}
            </span>
            <p class="mt-4 font-display font-bold uppercase tracking-wide text-sm text-white">{item.title}</p>
            <p class="mt-2 text-sm text-slate-300 leading-relaxed">{item.detail}</p>
          </div>
        ))}
      </div>
      <div class="mt-12 text-center">
        <a href="/contact" class="btn btn-cta">Discuss Your Project</a>
      </div>
    </div>
  </section>

  <!-- Eugene Site Conditions -->
  <section class="bg-white border-b border-slate-100">
    <div class="mx-auto max-w-6xl px-4 py-20 md:py-28">
      <div class="grid gap-12 lg:gap-20 lg:grid-cols-2 lg:items-center">
        <div>
          <h2 class="font-display font-black uppercase tracking-tight text-3xl text-ink md:text-4xl">
            How Do Eugene Site Conditions Affect <span class="text-brand-blue">Excavation?</span>
          </h2>
          <p class="mt-5 text-slate-600 leading-relaxed">
            Eugene properties can have different soil, terrain, drainage, and access conditions. Wet weather can also change ground conditions, so excavation work needs to match the actual site.
          </p>
          <ul class="mt-10 flex flex-col gap-7">
            {[
              { title: 'Wet Ground', description: 'Wet ground can affect equipment access and how excavation work moves forward. Weather and drainage conditions should be considered when planning the project.', icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M12 3s6 7 6 11a6 6 0 1 1-12 0c0-4 6-11 6-11Z" />' },
              { title: 'Clay Soil', description: 'Clay soil can behave differently when wet. Soil conditions may affect excavation, equipment access, drainage, and the overall approach to the project.', icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M3 20 9 8l4 6 2-3 6 9H3Z" />' },
              { title: 'Sloped Terrain', description: 'Sloped properties can create different access and excavation needs. The slope, surrounding ground, and planned work help determine the appropriate project scope.', icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M3 17h4l4-9 4 5 3-4h3M17 6h3v3" />' },
              { title: 'Drainage Conditions', description: 'Existing drainage can affect excavation planning. Water flow, low areas, and ground conditions may need to be considered when excavation connects with drainage work.', icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M12 3s6 7 6 11a6 6 0 1 1-12 0c0-4 6-11 6-11Z" />' },
              { title: 'Site Access', description: 'Access affects where equipment can work and how materials can be handled. Tight or difficult areas may require additional planning before excavation begins.', icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M9 3 5 21M15 3l4 18M12 8v2.5m0 4v2.5" />' },
              { title: 'Willamette Valley Conditions', description: "Properties around the Willamette Valley can have different soil, drainage, and terrain conditions. Each excavation project should be planned around the property's actual site conditions.", icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 10h16M4 14h16M4 18h16" />' },
            ].map((item) => (
              <li class="flex items-start gap-4">
                <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-brand-blue-light text-brand-blue mt-0.5">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" set:html={item.icon} />
                </span>
                <div>
                  <p class="font-display font-bold text-ink">{item.title}</p>
                  <p class="mt-1 text-sm text-slate-600 leading-relaxed">{item.description}</p>
                </div>
              </li>
            ))}
          </ul>
          <a href="/contact" class="btn-pill mt-10 inline-flex">
            Discuss Your Project
            <span class="btn-pill-icon">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M17 7H7M17 7V17" />
              </svg>
            </span>
          </a>
        </div>
        <div class="relative">
          <img
            src="/project-grading-driveway.webp"
            alt="D&D Land Works excavation work in Lane County, Oregon"
            class="w-full rounded-(--radius-brand-card) object-cover aspect-3/4 shadow-xl"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Service Areas -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-6xl px-4 py-20 md:py-28">
      <div class="mb-12 md:mb-14 text-center">
        <p class="font-display font-semibold uppercase tracking-widest text-sm text-brand-blue">Our Service Area</p>
        <h2 class="mt-2 font-display font-black uppercase tracking-tight text-3xl text-ink md:text-5xl">
          Excavation Services Across Eugene and Lane County
        </h2>
        <p class="mt-5 text-slate-600 max-w-2xl mx-auto leading-relaxed">
          D&amp;D Land Works serves Eugene, Springfield, and surrounding Lane County communities. Excavation work is planned around your property's location, access, terrain, ground conditions, and project needs.
        </p>
      </div>
      <div class="grid gap-6 lg:grid-cols-2 lg:gap-8 items-stretch">
        <div class="overflow-hidden rounded-(--radius-brand-card) bg-ink shadow-lg">
          <a href="/locations/eugene" class="flex items-center gap-3 bg-brand-blue px-6 py-4 text-white transition-opacity hover:opacity-90">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 21c4.4-3.4 7-7 7-10.5A7 7 0 0 0 5 10.5C5 14 7.6 17.6 12 21Z" />
              <circle cx="12" cy="10.5" r="2" fill="currentColor" stroke="none" />
            </svg>
            <span class="font-display font-bold uppercase tracking-wide text-sm">Eugene, OR</span>
          </a>
          {[
            { label: 'Springfield', href: '/locations/springfield' },
            { label: 'Cottage Grove', href: '/locations/cottage-grove' },
            { label: 'Junction City', href: '/locations/junction-city' },
            { label: 'Creswell', href: '/locations/creswell' },
            { label: 'Veneta', href: '/locations/veneta' },
            { label: 'Florence', href: '/locations/florence' },
            { label: 'Oakridge', href: '/locations/oakridge' },
            { label: 'Coburg', href: '/locations/coburg' },
            { label: 'Lowell', href: '/locations/lowell' },
          ].map((area) => (
            <a href={area.href} class="flex items-center gap-3 border-t border-white/10 px-6 py-4 text-white/70 transition-colors hover:bg-white/5 hover:text-white">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0 text-white/40" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 21c4.4-3.4 7-7 7-10.5A7 7 0 0 0 5 10.5C5 14 7.6 17.6 12 21Z" />

  { title: 'When the ground is uneven', desc: 'Areas that are too high, too low or uneven for the planned use get regraded to fit the project.', href: '/contact' },
  { title: 'When water is collecting', desc: 'Standing water around home, driveway or yard is often a drainage problem. Excavation may create a path to move it.', href: '/contact' },
  { title: 'When land needs clearing', desc: 'Brush, trees and overgrowth need to be removed before excavation or grading can begin.', href: '/contact' },
  { title: 'For a septic project', desc: 'Septic systems may require excavation for the components that go into the ground.', href: '/contact' },
  { title: 'For general site work', desc: 'Access, ground conditions, depth of digging, and existing structures can all change what a Coburg project involves.', href: '/contact' },
];

const processSteps = [

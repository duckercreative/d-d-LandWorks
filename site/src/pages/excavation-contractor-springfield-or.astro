---
import LocationPageTemplate from '../layouts/LocationPageTemplate.astro';

const factsBar = [
  { label: 'Home base', value: 'Springfield, OR' },
  { label: 'Serving', value: 'Springfield & Lane County' },
  { label: 'Licensed & bonded', value: 'CCB #261742' },
  { label: 'Septic work', value: 'Coming soon' },
];

const services = [
  { num: '01', title: 'Building Site Preparation', desc: 'Clearing, excavation and grading to create a workable area before construction can begin on a Springfield lot.', href: '/site-preparation-contractor-springfield-or' },
  { num: '02', title: 'Grading & Ground Shaping', desc: 'Reshaping uneven ground, changing levels, or adding slope to fit the planned use of the property.', href: '/land-grading-services-eugene-or' },
  { num: '03', title: 'Land Clearing', desc: 'Brush, trees, vegetation and debris removed before grading or excavation begins.', href: '/land-clearing-services-eugene-or' },
  { num: '04', title: 'Trenching for Underground Work', desc: 'Water lines, conduit, irrigation, and drainage dug to the right size and depth for what goes in them.', href: '/trenching-services-eugene-or' },
  { num: '05', title: 'Drainage Excavation', desc: 'Channels and trenches to move water away from areas where it collects.', href: '/drainage-installation-eugene-or' },
  { num: '06', title: 'Septic Excavation', desc: 'working toward DEQ certification for septic work. Excavation for tanks, distribution boxes, and drainfields on Springfield properties.', href: '/septic-installation-lane-county-or' },
];

const checklistItems = [
  { title: 'Before construction begins', desc: 'A building site may need clearing, grading or excavation before any other work can start.', href: '/contact' },
  { title: 'When the ground needs reshaping', desc: 'Areas that are uneven, too high or too low get regraded to fit the project.', href: '/contact' },
  { title: 'When water is collecting', desc: 'Standing water around home, driveway or yard is a drainage problem with a dig-able fix.', href: '/contact' },
  { title: 'Before underground work', desc: 'Utility lines, irrigation and drains need a trench sized and placed for what goes in it.', href: '/contact' },
  { title: 'For septic projects', desc: 'New systems and repairs need excavation. D&D handles the digging for applicable septic work.', href: '/contact' },
  { title: 'When the driveway needs work', desc: 'Ruts, washouts and uneven gravel get regraded and the surface restored.', href: '/driveway-excavation-grading-eugene-or' },
];

const processSteps = [
  { num: '1', title: 'Tell us what you need', desc: 'What you want to build, repair, clear or dig on your Springfield property.' },
  { num: '2', title: 'Discuss the property', desc: 'Location, access, slope, drainage, structures and utilities — this is home base, we know the terrain.' },
  { num: '3', title: 'Understand the scope', desc: 'The excavation and site work explained in plain terms.' },
  { num: '4', title: 'Get your estimate', desc: 'A free estimate once the property and project are understood.', dark: true },
];

const bentoFeatures = [
  { title: 'Home base: Springfield', desc: 'Headquartered at 2741 33rd St., Springfield. Not a name on a service-area list — this is where we work from every day.', dark: false },
  { title: 'Foundation excavation', desc: 'New homes, ADUs and commercial builds. One crew for clearing, grading and the foundation.', dark: true },
  { title: 'Utility & trench work', desc: 'Water service, sewer lateral, conduit and drains, with 811 locates on every trench job.', dark: true },
  { title: 'DEQ septic — coming soon', desc: 'Tank, distribution box and drainfield excavation on Springfield and Lane County lots.', dark: false },
];

const areaLinks = [
  { label: 'Eugene', href: '/excavation-contractor-eugene-or' },
  { label: 'Cottage Grove', href: '/excavation-contractor-cottage-grove-or' },
  { label: 'Creswell', href: '/excavation-contractor-creswell-or' },
  { label: 'Lowell', href: '/excavation-contractor-lowell-or' },
  { label: 'Junction City', href: '/excavation-contractor-junction-city-or' },
  { label: 'Veneta', href: '/excavation-contractor-veneta-or' },
  { label: 'Coburg', href: '/excavation-contractor-coburg-or' },
  { label: 'Florence', href: '/excavation-contractor-florence-or' },
];

const faqs = [
  { question: 'What does an excavation contractor do?', answer: 'An excavation contractor digs, removes, moves, and shapes ground for projects such as building sites, drainage, utilities, septic work, and other property improvements.' },
  { question: 'Do you provide excavation in Springfield?', answer: 'Yes. D&D Land Works is headquartered in Springfield and provides excavation and related site work for local properties.' },
  { question: 'Do you do site preparation?', answer: 'Yes. Site preparation may include clearing, grading, leveling, and excavation needed to prepare a property for the next stage of work.' },
  { question: 'Can you grade my property?', answer: 'Grading can shape or level ground. The work depends on the property\'s existing grade and what you need the ground to do.' },
  { question: 'Do you provide land clearing?', answer: 'Yes. Land clearing can remove brush, trees, vegetation, and debris where clearing is part of the project.' },
  { question: 'Can you help with drainage excavation?', answer: 'Yes. Drainage work may require excavation for trenches, channels, or other areas used to move water.' },
  { question: 'Can you excavate for septic work?', answer: 'D&D Land Works handles excavation connected with applicable septic projects Septic design and approval are separate parts of the project.' },
  { question: 'Do you provide trenching?', answer: 'Yes. Trenching can be used for utilities, irrigation, drainage, and other underground work where excavation is needed.' },
  { question: 'Can you grade a driveway?', answer: 'Driveway work may include grading or excavation to reshape the ground or correct problem areas.' },
  { question: 'What affects excavation cost?', answer: 'Cost can depend on project size, digging depth, ground conditions, slope, access, clearing, material movement, drainage needs, septic work, and overall site complexity.' },
  { question: 'How long does excavation take?', answer: 'There is no fixed timeline. Size, ground conditions, access, weather, clearing, utilities, and the amount of work can all affect the schedule.' },
  { question: 'Do you provide free estimates?', answer: 'Yes. D&D Land Works provides free estimates for applicable excavation and site work projects in Springfield.' },
  { question: 'Where is D&D Land Works based?', answer: 'D&D Land Works is headquartered in Springfield, Oregon, at 2741 33rd St.' },
];

const relatedServices = [
  { title: 'Site Preparation Springfield', desc: 'Full lot prep from raw ground to builder-ready pad.', href: '/site-preparation-contractor-springfield-or' },
  { title: 'Grading & Leveling', desc: 'The right slope for drainage and a level pad.', href: '/land-grading-services-eugene-or' },
  { title: 'Foundation Excavation', desc: 'Footprints, footings, crawl spaces and basements.', href: '/foundation-excavation-eugene-or' },
  { title: 'Drainage Excavation', desc: 'French drains, swales and catch basins.', href: '/drainage-installation-eugene-or' },
];

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'GeneralContractor',
      '@id': 'https://www.ddlandworks.com/#business',
      name: 'D&D Land Works',
      url: 'https://www.ddlandworks.com/',
      telephone: '+15414018726',
      email: 'david@ddlandworks.com',
      priceRange: '$$',
      areaServed: [
        { '@type': 'City', name: 'Springfield', sameAs: 'https://www.wikidata.org/wiki/Q49431' },
        { '@type': 'AdministrativeArea', name: 'Lane County, Oregon' },
      ],
      hasCredential: [
        { '@type': 'EducationalOccupationalCredential', credentialCategory: 'License', name: 'Oregon CCB License #261742' },
        
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.question,
        acceptedAnswer: { '@type': 'Answer', text: faq.answer },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.ddlandworks.com/' },
        { '@type': 'ListItem', position: 2, name: 'Service Areas', item: 'https://www.ddlandworks.com/service-area/' },
        { '@type': 'ListItem', position: 3, name: 'Springfield Excavation', item: 'https://www.ddlandworks.com/excavation-contractor-springfield-or/' },
      ],
    },
  ],
};
---

<LocationPageTemplate
  pageTitle="Excavation Contractor in Springfield, Oregon | D&D Land Works"
  pageDescription="D&D Land Works is headquartered in Springfield, Oregon. Excavation, grading, site prep, clearing, drainage, trenching, and septic work for local properties. CCB #261742. Free estimates, 541-401-8726."
  schema={schema}
  cityState="Springfield, Oregon"
  heroH1Light="Excavation contractor"
  heroH1Bold="in Springfield, Oregon"
  heroSub="D&D Land Works is headquartered in Springfield. This is not a name on a coverage list — it is the base of operations for every job in the area."
  heroImage="/service-site-preparation.webp"
  factsBar={factsBar}
  breadcrumbLabel="Springfield"
  introEyebrow="Springfield's excavation contractor"
  introH2Light="Based in Springfield,"
  introH2Bold="working Springfield every day"
  davidQuote="I walk every site in person before I quote it."
  introPara1="D&D Land Works is headquartered in Springfield, Oregon. Excavation, site preparation, land clearing, grading, drainage, and septic work for residential and rural properties in the Springfield area."
  introPara2="Springfield's mix of flat valley lots, wooded infill parcels, and rural properties outside the city means every job is looked at based on what is actually on the ground. Drainage, soil conditions, and access all affect the scope."
  introImage="/project-excavation-bucket.webp"
  servicesEyebrow="Our services"
  servicesH2Light="What does excavation"
  servicesH2Bold="include in Springfield?"
  servicesDesc="The scope depends on lot size, drainage needs, utilities, and what the property requires before the next stage of work can begin."
  services={services}
  whenEyebrow="Springfield excavation"
  whenH2Light="When does your"
  whenH2Bold="property need it?"
  whenDesc="Check off what sounds like your property. If any of these fit, a free site walk is the next step."
  checklistItems={checklistItems}
  processEyebrow="Getting started"
  processH2Light="How your Springfield"
  processH2Bold="project gets started"
  processDesc="You don't need to know the name of the service before you call. Just explain what you're trying to do and what's happening on the property."
  processSteps={processSteps}
  whyH2Light="Why Springfield calls"
  whyH2Bold="D&D Land Works"
  bentoImage="/project-grading-driveway.webp"
  bentoImageAlt="Grading and excavation work on a Springfield, Oregon property"
  bentoFeatures={bentoFeatures}
  areaEyebrow="Our service area"
  areaH2Light="Excavation in Springfield"
  areaH2Bold="and Lane County"
  areaDesc="Home base is Springfield. We work throughout Lane County and into adjacent areas. Other locations we cover:"
  areaLinks={areaLinks}
  faqH2Light="Excavation in Springfield:"
  faqH2Bold="common questions"
  faqs={faqs}
  relatedEyebrow="Related services in Springfield"
  relatedServices={relatedServices}
  ctaEyebrow="Talk with David"
  ctaH2Light="Need excavation work"
  ctaH2Bold="in Springfield?"
  ctaSub="Not sure what kind of excavation you need? Tell David what you want to do, where the work is and what problem you're solving. Free estimates, no obligation."
  ctaImage="/service-site-preparation.webp"
/>

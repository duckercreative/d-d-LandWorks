---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import AboutSection from '../components/AboutSection.astro';
import PhotoContentBlock from '../components/PhotoContentBlock.astro';
import WhyChooseUs from '../components/WhyChooseUs.astro';
import ServiceCard from '../components/ServiceCard.astro';
import FAQ from '../components/FAQ.astro';
import CTABlock from '../components/CTABlock.astro';
import Gallery from '../components/Gallery.astro';
import Testimonials from '../components/Testimonials.astro';

const processSteps = [
  { step: '1', title: 'Utility locate (call 811)', detail: 'Required before any digging. Oregon law requires calling 811 and waiting for all underground utilities to be marked before equipment breaks ground. Allow several business days.' },
  { step: '2', title: 'Site walk and survey', detail: 'David walks the lot in person, establishes existing grades, drainage patterns, access constraints, and property lines before anything moves.' },
  { step: '3', title: 'Clear the build envelope', detail: 'Brush, volunteer trees, blackberry, and debris come out of the build zone. On Springfield\'s wooded infill lots and rural parcels, this is often the most time-intensive phase.' },
  { step: '4', title: 'Install erosion controls', detail: 'Silt fence, inlet protection, and other erosion controls go in before grading starts. Required by Lane County\'s EPSC permit and Oregon DEQ rules.' },
  { step: '5', title: 'Strip and stockpile topsoil', detail: 'Topsoil is separated from subgrade material and stockpiled on-site, available for landscaping later.' },
  { step: '6', title: 'Cut and fill to grade', detail: 'Material from high spots gets cut and moved into low spots to bring the pad to the design elevation.' },
  { step: '7', title: 'Compact the subgrade', detail: 'The exposed subgrade gets proof rolled and compacted to the bearing density a foundation, slab, or driveway actually needs. Clay-heavy subgrades sometimes need undercutting and base rock before this step holds.' },
  { step: '8', title: 'Stake corners and elevations', detail: 'Reference stakes go in so the foundation crew, surveyor, or county inspector can verify the pad matches the approved plan.' },
  { step: '9', title: 'Rough-grade for drainage', detail: 'The pad gets a final pitch so water moves away from the structure. Springfield\'s flat valley floor and high winter water tables make this step load-bearing, not cosmetic.' },
];

const permits = [
  {
    name: 'Lane County Grading and Fill Permit',
    trigger: 'Generally required when a project moves more than roughly 50 cubic yards of earth or creates a cut or fill slope steeper than approximately 2:1. Confirm the exact threshold with Lane County LMD (541-682-4651) or apply through the ePASS portal before assuming either way.',
    admin: 'Lane County Land Management Division — 3050 N. Delta Hwy, Eugene, OR 97408',
  },
  {
    name: 'Erosion Prevention and Sediment Control (EPSC) Permit',
    trigger: 'Lane County typically requires an EPSC permit for residential grading and soil disturbance, with Type I generally covering single-family scopes and Type II covering larger or more sensitive sites. Wet-season work (October through May) triggers additional erosion-control obligations.',
    admin: 'Lane County Land Management Division',
  },
  {
    name: 'Oregon DEQ 1200-C Construction Stormwater Permit',
    trigger: 'Required when a project disturbs 1 or more acres, or is part of a common plan of development totaling 1+ acres even if your individual lot is smaller. Application fee: $1,515 plus a $1,558 first-year annual fee. Must be submitted at least 30 days before breaking ground. Projects over 5 acres require a 14-day public notice period.',
    admin: 'Oregon DEQ — apply at oregon.gov/deq',
  },
];

const costRows = [
  { scope: 'Flat, cleared lot', range: '$10,000–$20,000', affects: 'Easiest scenario: minimal clearing, good access, well-drained soil' },
  { scope: 'Typical residential lot', range: '$15,000–$35,000', affects: 'Standard scope with some clearing, cut-and-fill grading, and compaction' },
  { scope: 'Wooded or sloped lot', range: '$40,000–$70,000+', affects: 'Rural Springfield parcels, steep approaches, or heavy blackberry and tree cover' },
  { scope: 'Land clearing (Oregon)', range: '$1,000–$40,000+ / acre', affects: 'Light brush on the low end; old growth timber on the high end' },
  { scope: 'Clay soil surcharge', range: '+25–50% above baseline', affects: 'Willamette Valley clay subgrades are slower to work and may need undercutting and base rock' },
];

const projectTypes = [
  { title: 'New Home Build', detail: 'The most common call: a raw Springfield lot that needs to go from vegetation to a compacted, builder-ready pad.' },
  { title: 'ADU (Accessory Dwelling Unit)', detail: 'ADU construction in Springfield requires its own site-prep scope and its own permit questions, separate from the primary residence, worth sorting out before grading starts.' },
  { title: 'Shop or Barn Pad', detail: 'Rural lots east of Springfield and along the McKenzie River corridor often need a level, compacted gravel pad before a metal building crew shows up.' },
  { title: 'Subdivision or Multi-Lot Development', detail: 'Multi-lot development triggers the DEQ 1200-C "common plan of development" rule even when individual lots are under an acre.' },
  { title: 'Commercial Pad', detail: 'Commercial grading volumes are larger and more likely to cross both the Lane County permit threshold and the Oregon DEQ 1-acre mark.' },
  { title: 'Lot Purchase — Pre-Construction Prep', detail: 'Some buyers close on a lot and immediately schedule a site walk before a builder is selected, to understand what the clearing and grading scope will cost before finalizing a build budget.' },
];

const faqs = [
  {
    question: 'What does a site preparation contractor actually do in Springfield?',
    answer: 'Site prep is the work that turns a raw or partially-cleared lot into a pad a foundation crew can actually build on. The 9-step sequence for Lane County lots: (1) call 811 for utility locates, (2) site walk and survey, (3) clear brush and trees, (4) install erosion controls, (5) strip and stockpile topsoil, (6) cut and fill to grade, (7) compact and proof-roll the subgrade, (8) stake corners and elevations, (9) rough-grade for drainage. In Springfield, the drainage grade gets particular attention because the flat valley floor and Willamette Valley soils hold water in ways sandy loam does not.',
  },
  {
    question: 'How much does site preparation cost in Springfield, Oregon?',
    answer: 'Cost ranges in the Springfield area: flat, already-cleared lots typically run $10,000–$20,000; a standard residential build lot runs $15,000–$35,000; wooded or rural lots frequently run $40,000–$70,000 or more. Land clearing alone in Oregon ranges from $1,000–$5,000 per acre for light brush up to $10,000–$40,000+ per acre for heavily forested ground. Clay-heavy soils can add 25–50% to grading cost compared to a well-drained site. A free on-site estimate is the only accurate number for your specific lot.',
  },
  {
    question: 'Do I need a permit for site prep in Springfield or Lane County?',
    answer: 'Almost certainly yes, depending on scope. Lane County\'s Grading and Fill Permit is generally required when a project moves roughly 50+ cubic yards of earth or creates cut/fill slopes steeper than about 2:1. An Erosion Prevention and Sediment Control (EPSC) permit is typically required for residential grading work. Oregon DEQ\'s 1200-C stormwater permit is required when a project disturbs 1 acre or more — the application fee is $1,515 plus a $1,558 first-year annual fee, and it must be submitted at least 30 days before breaking ground. Projects within Springfield city limits may also need City of Springfield Development & Public Works approval separately from Lane County. Contact Lane County LMD at 541-682-4651 or apply through the ePASS portal to confirm what applies to your project.',
  },
  {
    question: 'When is the best time to do site prep in the Springfield area?',
    answer: 'May through October is the optimal window. Lane County\'s wet season runs roughly October through May, during which Willamette Valley clay saturates quickly and becomes slow and expensive to work. Wet-season grading is possible but requires tighter erosion controls, moves more slowly, and carries a higher risk of soft-ground delays. Scheduling for the dry season typically shortens the job and lowers cost. If your timeline puts site prep in winter, factor in extra schedule and erosion-control budget.',
  },
  {
    question: 'Do you handle site prep for ADUs in Springfield?',
    answer: 'Yes. ADU (accessory dwelling unit) construction in Springfield has its own site prep scope and its own permit track — the ADU grading plan is separate from the primary residence, and the Lane County or City of Springfield permit thresholds apply to the ADU construction footprint independently. If you\'re building a backyard ADU or a detached garage conversion in Springfield, the site prep question is worth asking early, before design is finalized, since the pad location, driveway access, and any septic implications all affect the grading scope.',
  },
  {
    question: 'Should I get site prep done before or after hiring a builder?',
    answer: 'Site work typically starts once a builder is hired and the design and permitting process is already underway — the grading plan, foundation type, septic layout, and driveway alignment all shape what site prep needs to accomplish. That said, a lot owner in Springfield can schedule a free site walk from a contractor before selecting a builder to understand the rough clearing and grading scope for budgeting purposes.',
  },
  {
    question: 'Does the septic system placement affect when site prep can start?',
    answer: 'Yes, and this is one of the most common sequencing mistakes on rural Springfield-area lots. Lane County\'s On-Site Wastewater Program requires that a proposed drainfield area be evaluated and approved before any grading disturbs it. Cutting, filling, compacting, or paving over an approved drainfield area can void the county\'s septic approval outright. If your lot needs a septic system, confirm the drainfield is staked and approved before site-prep grading moves near it.',
  },
  {
    question: 'What areas of Springfield does D&D Land Works serve for site prep?',
    answer: 'D&D Land Works serves Springfield and the surrounding Lane County area, including Thurston, Hayden Bridge, Jasper, and east Springfield, as well as Eugene, Cottage Grove, Junction City, Creswell, Veneta, Florence, Oakridge, Coburg, and Lowell. Call 541-401-8726 to confirm coverage for a specific address.',
  },
];

const related = [
  { title: 'Land Clearing', description: 'Removing brush, trees, and debris to open up usable land.', href: '/land-clearing-services-eugene-oregon' },
  { title: 'Grading & Leveling', description: 'Shaping land to the right slope for drainage and building.', href: '/land-grading-services-eugene-oregon' },
  { title: 'Foundation Excavation', description: 'Digging and leveling for footings and foundations.', href: '/foundation-excavation-eugene-oregon' },
  { title: 'Drainage Excavation', description: 'Excavation and grading to correct standing water and poor drainage.', href: '/drainage-installation-eugene-oregon' },
];

const anchorAreas = [
  { label: 'Springfield', href: '/locations/springfield' },
  { label: 'Eugene', href: '/locations/eugene' },
];
const otherAreas = [
  { label: 'Cottage Grove', href: '/locations/cottage-grove' },
  { label: 'Junction City', href: '/locations/junction-city' },
  { label: 'Creswell', href: '/locations/creswell' },
  { label: 'Veneta', href: '/locations/veneta' },
  { label: 'Florence', href: '/locations/florence' },
  { label: 'Oakridge', href: '/locations/oakridge' },
  { label: 'Coburg', href: '/locations/coburg' },
  { label: 'Lowell', href: '/locations/lowell' },
];

const demoReviews = [
  { name: 'Jordan M.', initial: 'JM', date: 'Aug 2026', stars: 5, text: 'David and his crew graded our lot fast and cleaned up everything before they left. Would hire again for any excavation work.' },
  { name: 'Casey R.', initial: 'CR', date: 'Jul 2026', stars: 5, text: 'Called about a drainage issue and had someone out within the week. Fixed the standing water problem for good.' },
  { name: 'Taylor B.', initial: 'TB', date: 'Jul 2026', stars: 4, text: 'Good work on our driveway repair, just took a little longer than expected to schedule.' },
  { name: 'Morgan K.', initial: 'MK', date: 'Jun 2026', stars: 5, text: 'Septic install went smoothly start to finish. Appreciated that David walked us through the whole process.' },
  { name: 'Riley S.', initial: 'RS', date: 'Jun 2026', stars: 5, text: 'Cleared almost an acre of brush for us ahead of a build. On time, fair price, no surprises.' },
  { name: 'Alex D.', initial: 'AD', date: 'May 2026', stars: 5, text: 'Foundation excavation was done right and on schedule. Highly recommend for any site prep work.' },
];

const pageSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'GeneralContractor',
      '@id': 'https://www.ddlandworks.com/#business',
      name: 'D&D Land Works',
      url: 'https://www.ddlandworks.com/',
      telephone: '+15414018726',
      email: 'david@ddlandworks.com',
      description: 'Full-service excavation, grading, and site preparation contractor serving Eugene, Springfield, and Lane County, Oregon. Licensed and bonded CCB #261742, DEQ Certified.',
      priceRange: '$$',
      areaServed: [
        { '@type': 'City', name: 'Springfield', sameAs: 'https://www.wikidata.org/wiki/Q49431' },
        { '@type': 'City', name: 'Eugene' },
        { '@type': 'AdministrativeArea', name: 'Lane County, Oregon' },
      ],
      knowsAbout: ['Site Preparation', 'Land Clearing', 'Grading', 'Excavation', 'Septic Installation', 'Drainage Excavation'],
      hasCredential: [
        { '@type': 'EducationalOccupationalCredential', credentialCategory: 'License', name: 'Oregon CCB License #261742' },
        { '@type': 'EducationalOccupationalCredential', credentialCategory: 'Certification', name: 'Oregon DEQ Certification — Septic Install & Repair' },
      ],
      sameAs: ['https://search.ccb.state.or.us/search/'],
    },
    {
      '@type': 'Service',
      '@id': 'https://www.ddlandworks.com/site-preparation-contractor-springfield-oregon/#service',
      name: 'Site Preparation Contractor in Springfield, Oregon',
      serviceType: 'Site Preparation',
      description: 'Land clearing, grading, compacting, and construction-ready lot preparation for residential and commercial projects in Springfield and Lane County, Oregon. Includes cut-and-fill grading, topsoil stripping, subgrade compaction, staking, and rough drainage grading.',
      url: 'https://www.ddlandworks.com/site-preparation-contractor-springfield-oregon/',
      provider: { '@id': 'https://www.ddlandworks.com/#business' },
      areaServed: ['Springfield, Oregon', 'Eugene, Oregon', 'Lane County, Oregon'],
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.question,
        acceptedAnswer: { '@type': 'Answer', text: faq.answer },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.ddlandworks.com/' },
        { '@type': 'ListItem', position: 2, name: 'Site Preparation', item: 'https://www.ddlandworks.com/services/site-preparation/' },
        { '@type': 'ListItem', position: 3, name: 'Site Preparation Contractor Springfield, OR', item: 'https://www.ddlandworks.com/site-preparation-contractor-springfield-oregon/' },
      ],
    },
  ],
};
---

<BaseLayout
  title="Site Preparation Contractor in Springfield, Oregon | Land Prep for Construction"
  description="Site preparation contractor in Springfield, Oregon. Land clearing, grading, compacting, and construction-ready lot prep. Licensed and bonded. CCB #261742. Get a free estimate from D&D Land Works."
>
  <Hero
    eyebrow="Springfield, Oregon"
    headline="Site Preparation Contractor in Springfield, Oregon"
    subheadline="Land clearing, grading, and compaction from one licensed, bonded contractor. Springfield's valley-floor soils and short dry season make the sequence matter more here than people expect."
    primaryCta={{ label: 'Call 541-401-8726', href: 'tel:5414018726' }}
    secondaryCta={{ label: 'Free Estimate', href: '/contact' }}
  />

  <!-- About / entity-dense intro paragraph -->
  <AboutSection
    ctaLabel="Get a Free Estimate"
    ctaHref="/contact"
    eyebrow="Springfield, Oregon"
    headlineHtml="Site Prep for Springfield Lots, <span class='text-brand-blue'>Done by the Same Crew</span> That Scoped It"
    descriptionHtml="<p>D&amp;D Land Works provides site preparation for residential and commercial lots throughout Springfield and Lane County, Oregon, including new home builds, ADUs, commercial pads, and shop or barn pad construction. Site prep is the work that gets a raw or partially-cleared lot to a builder-ready state: brush removal and lot clearing, topsoil stripping and stockpiling, cut-and-fill grading to design elevation, subgrade compaction, corner staking, and rough drainage grading so water moves away from the structure&rsquo;s footprint.</p><p>Springfield-specific conditions shape how that work runs. The Willamette Valley&rsquo;s clay-heavy soils are slower to move and hold water differently than sandy loam, which affects both cost and timeline. Rural parcels east of Springfield and along the McKenzie River corridor require more upfront clearing before grading can start. The rainy season from October through May triggers stricter Lane County erosion-control permit requirements and limits dry-ground grading windows. D&amp;D Land Works is licensed and bonded under <strong class='font-semibold text-ink'>Oregon CCB #261742</strong> and DEQ certified for septic work.</p>"
  />

  <!-- What site prep includes — Springfield context -->
  <PhotoContentBlock
    eyebrow="Site Prep in Springfield, OR"
    headline="What Does Site Preparation Include for a Springfield Lot?"
    image="/project-site-staging.webp"
    imageAlt="Excavator grading a lot in Springfield, Oregon for new home construction"
    imageSide="left"
    badgeValue="CCB #261742"
    badgeLabel="Licensed & Bonded"
    ctaLabel="See Full Service Details"
    ctaHref="/services/site-preparation"
    bodyHtml="<p>Site prep covers everything that happens before a foundation crew shows up: clearing the build envelope, stripping and stockpiling topsoil, cutting and filling to the design grade, compacting the subgrade, staking corners and elevations, and pitching the finished pad for drainage. The scope changes lot to lot, but the order is consistent.</p><p>In Springfield, the drainage grade is often the most critical step because many lots on the valley floor have high winter water tables and flat natural grades that don't naturally move water away from a structure. Getting that drainage pitch right during grading prevents costly foundation issues down the road.</p>"
  />

  <!-- Process steps — dark section -->
  <section class="bg-ink text-white">
    <div class="mx-auto max-w-6xl px-4 py-16 md:py-20">
      <h2 class="font-display font-bold uppercase tracking-tight text-3xl text-white text-center">
        The Site Preparation Sequence for Springfield Lots
      </h2>
      <p class="mt-4 text-slate-300 leading-relaxed text-center max-w-2xl mx-auto">
        The scope changes lot to lot, but the sequence is consistent, from the initial site walk through the final drainage grade.
      </p>
      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {processSteps.map((item) => (
          <div class="rounded-(--radius-brand-card) bg-white/5 border border-white/10 p-6">
            <span class="flex h-9 w-9 items-center justify-center rounded-full bg-safety-orange font-display font-bold text-white">
              {item.step}
            </span>
            <p class="mt-4 font-display font-bold uppercase tracking-wide text-sm text-white">{item.title}</p>
            <p class="mt-2 text-sm text-slate-300 leading-relaxed">{item.detail}</p>
          </div>
        ))}
      </div>
      <p class="mt-8 text-sm text-slate-400 text-center">
        Steps 2 and 5 are covered in detail on the <a href="/land-clearing-services-eugene-oregon" class="text-brand-blue-light underline underline-offset-2">land clearing</a> and <a href="/land-grading-services-eugene-oregon" class="text-brand-blue-light underline underline-offset-2">grading &amp; leveling</a> service pages when a lot needs dedicated work in those areas.
      </p>
    </div>
  </section>

  <!-- Springfield soil / season context -->
  <section class="bg-white border-b border-slate-200">
    <div class="mx-auto max-w-5xl px-4 py-16">
      <h2 class="font-display font-bold uppercase tracking-tight text-3xl text-ink">
        Why Springfield Soil and Season Affect Site Prep Cost and Timeline
      </h2>
      <div class="mt-8 grid gap-8 lg:grid-cols-2">
        <div>
          <p class="font-display font-bold uppercase tracking-wide text-sm text-brand-blue mb-3">Willamette Valley Clay Soils</p>
          <p class="text-slate-700 leading-relaxed">
            Springfield sits on the Willamette Valley floor, where deep silty loam and clay soils deposited by Ice Age Missoula Floods create high winter water tables and slow drainage. These soils swell when wet and contract when dry, making compaction harder and sometimes requiring undercutting soft spots and replacing them with structural fill before a subgrade will compact properly. Springfield lots in low-lying areas can add 25&ndash;50% to grading cost compared to a well-drained site.
          </p>
        </div>
        <div>
          <p class="font-display font-bold uppercase tracking-wide text-sm text-brand-blue mb-3">Oregon's Wet Season (Oct–May)</p>
          <p class="text-slate-700 leading-relaxed">
            Lane County&rsquo;s rainy season runs roughly October through May. Grading in heavy clay soil during wet weather is slower, harder on equipment, and requires tighter erosion-control measures under Lane County&rsquo;s EPSC permit requirements. Scheduling site prep for Springfield&rsquo;s dry season, roughly May through October, shortens the job window and typically reduces cost. If your project timeline puts grading in the wet season, that&rsquo;s not a dealbreaker, but it&rsquo;s worth building extra schedule and erosion-control cost into the budget.
          </p>
        </div>
        <div>
          <p class="font-display font-bold uppercase tracking-wide text-sm text-brand-blue mb-3">East Springfield and Rural Parcels</p>
          <p class="text-slate-700 leading-relaxed">
            Rural lots east of Springfield and into the Thurston and Jasper areas often have more tree cover and brush than valley-floor lots, requiring substantial clearing before grading can start. These lots frequently add time and cost that a flat, already-open lot wouldn&rsquo;t require. A site walk before quoting is how that scope gets priced accurately rather than estimated over the phone.
          </p>
        </div>
        <div>
          <p class="font-display font-bold uppercase tracking-wide text-sm text-brand-blue mb-3">Valley Floor Drainage Considerations</p>
          <p class="text-slate-700 leading-relaxed">
            Flat lots on Springfield&rsquo;s valley floor have fewer clearing challenges but more drainage considerations. Poor lot-to-lot drainage and high water tables mean that grading for proper drainage away from a structure&rsquo;s footprint matters more, not less, on these sites. A drainage plan built into the grading scope from the start avoids the common problem of fixing drainage issues after a foundation is already in.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Permits -->
  <section class="bg-slate-50 border-b border-slate-200">
    <div class="mx-auto max-w-6xl px-4 py-16">
      <h2 class="font-display font-bold uppercase tracking-tight text-3xl text-ink text-center">
        Do I Need a Permit for Site Prep in Springfield or Lane County?
      </h2>
      <p class="mt-4 text-center text-slate-700 max-w-2xl mx-auto leading-relaxed">
        There isn&rsquo;t one universal answer, but three specific permits are the ones to know about for Lane County grading and site-prep work.
      </p>
      <div class="mt-10 grid gap-6 lg:grid-cols-3">
        {permits.map((permit) => (
          <div class="card">
            <p class="font-display font-bold uppercase tracking-wide text-sm text-brand-blue">{permit.name}</p>
            <p class="mt-3 text-sm text-slate-600 leading-relaxed">{permit.trigger}</p>
            <p class="mt-3 text-xs text-slate-500">Administered by: {permit.admin}</p>
          </div>
        ))}
      </div>
      <p class="mt-8 text-sm text-slate-600 leading-relaxed max-w-3xl mx-auto text-center">
        Projects within Springfield city limits may also require City of Springfield Development &amp; Public Works approval in addition to county permits. Foundation excavation done under an active building permit is generally exempt from a separate grading permit, but driveway and landscape grading usually aren&rsquo;t. Confirm with <a href="https://www.lanecounty.org/government/county_departments/public_works/land_management_division" class="text-brand-blue underline underline-offset-2 hover:text-brand-blue-dark">Lane County LMD</a> before work begins.
      </p>
    </div>
  </section>

  <!-- Project types -->
  <section class="bg-white border-b border-slate-200">
    <div class="mx-auto max-w-6xl px-4 py-16">
      <h2 class="font-display font-bold uppercase tracking-tight text-3xl text-ink text-center">
        What Kind of Project Is This For?
      </h2>
      <p class="mt-4 text-center text-slate-700 max-w-2xl mx-auto leading-relaxed">
        Site preparation in Springfield covers more than new single-family home builds, even though that&rsquo;s the default most contractor websites describe.
      </p>
      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {projectTypes.map((p) => (
          <div class="card">
            <p class="font-display font-bold uppercase tracking-wide text-sm text-ink">{p.title}</p>
            <p class="mt-2 text-sm text-slate-600">{p.detail}</p>
          </div>
        ))}
      </div>
      <div class="mt-10 text-center">
        <a href="/contact" class="btn btn-cta">Get a Free Estimate</a>
      </div>
    </div>
  </section>

  <!-- Cost -->
  <section class="bg-slate-50 border-b border-slate-200">
    <div class="mx-auto max-w-4xl px-4 py-16">
      <h2 class="font-display font-bold uppercase tracking-tight text-3xl text-ink text-center">
        How Much Does Site Preparation Cost in Springfield, Oregon?
      </h2>
      <p class="mt-4 text-center text-slate-700 leading-relaxed">
        There&rsquo;s no Springfield-specific published figure because scope, soil, and access vary too much lot to lot. The ranges below are general industry benchmarks, not a quote for your project.
      </p>
      <div class="mt-8 overflow-x-auto">
        <table class="w-full text-sm border-collapse">
          <thead>
            <tr class="border-b border-slate-300 text-left">
              <th class="py-2 pr-4 font-display font-bold uppercase tracking-wide text-ink">Scope</th>
              <th class="py-2 pr-4 font-display font-bold uppercase tracking-wide text-ink">Typical Range</th>
              <th class="py-2 font-display font-bold uppercase tracking-wide text-ink">What Affects Price</th>
            </tr>
          </thead>
          <tbody>
            {costRows.map((row) => (
              <tr class="border-b border-slate-200">
                <td class="py-3 pr-4 font-semibold text-ink whitespace-nowrap">{row.scope}</td>
                <td class="py-3 pr-4 text-brand-blue font-semibold whitespace-nowrap">{row.range}</td>
                <td class="py-3 text-slate-600">{row.affects}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="mt-6 text-sm text-slate-600 text-center">
        These are general, national and Oregon-wide ranges. A free on-site estimate is the only accurate way to price a specific Springfield lot.
      </p>
      <div class="mt-6 text-center">
        <a href="/contact" class="btn btn-cta">Request a Free Estimate</a>
      </div>
    </div>
  </section>

  <!-- Septic sequencing — relevant for Springfield-area rural lots -->
  <PhotoContentBlock
    eyebrow="Septic Sequencing"
    headline="Site Prep Timing and Septic Systems on Springfield-Area Lots"
    image="/service-septic-install.webp"
    imageAlt="Septic system installation on a Springfield-area lot prepared for construction"
    imageSide="left"

---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ServiceCard from '../components/ServiceCard.astro';
import FAQ from '../components/FAQ.astro';
import CTABlock from '../components/CTABlock.astro';

const propertyFactors = [
  { title: 'Utility and Water Lines', description: 'Water lines and other underground utilities may need a trench to reach the right location. The digging is separate from the plumbing or utility work that follows.', href: '/contact', icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m0 0-4-4m4 4 4-4M4 8h16" />' },
  { title: 'Electrical Conduit', description: 'Electrical conduit can run underground inside a trench. D&D can handle the excavation, while the electrical work is handled by the proper electrical professional.', href: '/contact', icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />' },
  { title: 'Irrigation Lines', description: 'Irrigation lines may need a narrow trench across part of a property. The route can depend on the layout of the yard, ground conditions, and access.', href: '/contact', icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M12 3s6 7 6 11a6 6 0 1 1-12 0c0-4 6-11 6-11Z" />' },
  { title: 'Drainage and Ditches', description: 'Water problems may call for a trench or ditch to give runoff a path. The right approach depends on the slope, ground, and where the water needs to go.', href: '/contact', icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M3 17h4l4-9 4 5 3-4h3M17 6h3v3" />' },
  { title: 'Septic-Related Excavation', description: 'Some septic projects require excavation for tanks, lines, or other parts of the system. D\'s role is the digging; septic design and related work are separate.', href: '/contact', icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M3 12h18M3 6h18M3 18h18" />' },
  { title: 'Residential Trenching', description: 'Homeowners may need trenching for several types of property work. If you\'re not sure what kind of trench you need, we can look at the project and explain the excavation involved.', href: '/contact', icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M3 20 9 8l4 6 2-3 6 9H3Z" />' },
];

const faqs = [
  {
    question: 'How deep do irrigation lines need to be buried in Lane County, Oregon?',
    answer: 'Irrigation depth depends on the line, property, and project requirements. Mainlines and lateral lines may need different depths. The site conditions and planned irrigation system should guide the trench depth.',
  },
  {
    question: 'What\'s the difference between a sprinkler mainline trench and a lateral trench?',
    answer: 'A mainline carries water to different parts of the irrigation system. Lateral lines branch off to serve sprinkler areas. Because they have different jobs, their trench requirements can also differ.',
  },
  {
    question: 'How much does trenching cost in Eugene, Oregon?',
    answer: 'Trenching cost depends on the length, depth, soil, access, slope, and site conditions. Hard ground or difficult access can add work. D&D Land Works can look at your property and provide a free estimate.',
  },
  {
    question: 'How much does it cost to trench 100 feet for irrigation?',
    answer: 'There is no single price for 100 feet of irrigation trenching. Soil, access, depth, and whether the trench crosses an existing surface can change the work. A site estimate gives you a more useful number.',
  },
  {
    question: 'Do I need to call Oregon 811 before digging an irrigation trench?',
    answer: 'Underground utilities should be located before excavation begins. Oregon 811 can help identify marked utility lines before digging. Check the current requirements for your project before work starts.',
  },
  {
    question: 'Do I need a permit to dig an irrigation trench in Lane County?',
    answer: 'Permit needs can depend on where the trench is located and what the project involves. Work near a road or right-of-way may have different requirements. D&D can discuss the project with you before digging begins.',
  },
];

const serviceSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'GeneralContractor',
      '@id': 'https://www.ddlandworks.com/#business',
      name: 'D&D Land Works',
      url: 'https://www.ddlandworks.com/',
      telephone: '+15414018726',
      email: 'david@ddlandworks.com',
      description: 'Full-service excavation, grading, and site preparation contractor serving Eugene, Springfield, and Lane County, Oregon. Licensed and bonded CCB #261742, DEQ Certified.',
      priceRange: '$$',
      areaServed: [
        { '@type': 'City', name: 'Eugene', sameAs: 'https://www.wikidata.org/wiki/Q49330' },
        { '@type': 'City', name: 'Springfield', sameAs: 'https://www.wikidata.org/wiki/Q49431' },
        { '@type': 'AdministrativeArea', name: 'Lane County, Oregon' },
      ],
      knowsAbout: ['Trenching', 'Utility Trenching', 'Irrigation Trenching', 'Drainage Excavation', 'Site Preparation', 'Septic Installation'],
      hasCredential: [
        { '@type': 'EducationalOccupationalCredential', credentialCategory: 'License', name: 'Oregon CCB License #261742' },
        { '@type': 'EducationalOccupationalCredential', credentialCategory: 'Certification', name: 'Oregon DEQ Certification — Septic Install & Repair' },
      ],
      sameAs: ['https://search.ccb.state.or.us/search/'],
    },
    {
      '@type': 'Service',
      '@id': 'https://www.ddlandworks.com/trenching-services-eugene-oregon/#service',
      name: 'Trenching Services in Eugene, Oregon',
      serviceType: 'Trenching and Backfill',
      description: 'Trenching services in Eugene, Springfield, and Lane County, Oregon. Utility trenching, irrigation trenching, drainage ditches, and septic excavation. Free estimates — 541-401-8726.',
      url: 'https://www.ddlandworks.com/trenching-services-eugene-oregon/',
      provider: { '@id': 'https://www.ddlandworks.com/#business' },
      areaServed: ['Eugene, Oregon', 'Springfield, Oregon', 'Lane County, Oregon'],
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.question,
        acceptedAnswer: { '@type': 'Answer', text: faq.answer },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.ddlandworks.com/' },
        { '@type': 'ListItem', position: 2, name: 'Trenching Services', item: 'https://www.ddlandworks.com/trenching-services-eugene-oregon/' },
      ],
    },
  ],
};
---

<BaseLayout
  title="Trenching Services in Eugene, Oregon | D&D Land Works"
  description="Trenching services in Eugene, Springfield, and Lane County, Oregon. Utility trenching, irrigation trenching, drainage ditches, and septic excavation. Free estimates — 541-401-8726."
>
  <Hero
    eyebrow="Trenching Services in Eugene, Oregon"
    headline="Trenching Services in Eugene, Oregon"
    subheadline="Need a trench for a water line, utility, irrigation, drainage, or another project? We dig trenches for Eugene-area properties and work around the ground, slope, access, and existing site conditions. We'll look at what you need dug and explain the work before it starts."
    primaryCta={{ label: 'Call 541-401-8726', href: 'tel:5414018726' }}
    secondaryCta={{ label: 'Free Estimate', href: '/contact' }}
  />

  <!-- What Is Trenching -->
  <section class="relative bg-white overflow-hidden">
    <div
      class="pointer-events-none absolute -right-32 -top-16 h-96 w-96 rounded-full bg-brand-blue-light/40 blur-3xl"
      aria-hidden="true"
    ></div>
    <div class="mx-auto max-w-6xl px-4 py-20 md:py-32">
      <div class="grid gap-12 lg:gap-20 lg:grid-cols-2 lg:items-center">
        <!-- Text column -->
        <div>
          <div class="mb-4 flex items-center gap-2">
            <img src="/logo.png" alt="" class="h-6 w-auto" aria-hidden="true" />
            <p class="font-display font-semibold uppercase tracking-widest text-sm text-brand-blue">
              What Is Trenching?
            </p>
          </div>
          <h2 class="font-display font-black uppercase tracking-tight text-3xl text-ink md:text-4xl">
            What Is Trenching?
          </h2>
          <div class="mt-5 flex flex-col gap-4 text-slate-700 leading-relaxed">
            <p>Trenching means digging a narrow path into the ground. The trench gives a pipe, conduit, drainage line, or other underground service a place to go.</p>
            <p>The work starts with the ground and soil on your property. The trench route, size, and depth depend on what the trench is for and the conditions around it.</p>
            <p>For larger digging needs, trenching may be part of a wider excavation project. Contact D&D Land Works to discuss what needs to be dug and how your property may affect the work.</p>
          </div>
          <a href="/contact" class="btn-pill mt-8 inline-flex">
            Talk About Your Project
            <span class="btn-pill-icon">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M17 7H7M17 7V17" />
              </svg>
            </span>
          </a>
        </div>
        <!-- Image column -->
        <div class="relative pb-6">
          <img
            src="/before-lot.webp"
            alt="Trenching work on a Lane County, Oregon property"
            class="w-full rounded-(--radius-brand-card) object-cover aspect-4/3 shadow-xl"
            loading="lazy"
          />
          <div class="absolute bottom-10 left-4 sm:left-6 flex items-center gap-3 rounded-(--radius-brand-card) bg-brand-blue px-4 py-3 text-white shadow-lg">
            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-white/15">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 3l8 3v5c0 5.25-3.5 10.15-8 11.5C7.5 21.15 4 16.25 4 11V6l8-3Z" />
              </svg>
            </span>
            <div class="leading-tight">
              <p class="font-display font-bold text-sm">CCB #261742</p>
              <p class="font-body text-xs text-white/80">Licensed &amp; Bonded</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- What Kind of Project -->
  <section id="before-we-dig" class="relative">
    <div class="relative bg-ink overflow-hidden">
      <img src="/project-site-excavation.webp" alt="" aria-hidden="true" class="absolute inset-0 h-full w-full object-cover opacity-45" loading="lazy" />
      <div class="absolute inset-0 bg-linear-to-b from-ink/80 via-ink/70 to-ink"></div>
      <div class="relative mx-auto max-w-3xl px-4 pt-20 pb-40 text-center md:pt-28 md:pb-52">
        <p class="font-display font-semibold uppercase tracking-widest text-sm text-brand-blue-light">Trenching Projects</p>
        <h2 class="mt-2 font-display font-black uppercase tracking-tight text-3xl text-white md:text-5xl">
          What Kind of Project Needs a Trench?
        </h2>
        <p class="mt-5 text-slate-300 leading-relaxed">
          A trench can be used for many types of work. The purpose of the trench depends on what needs to go underground and where it needs to run on your property.
        </p>
      </div>
    </div>
    <div class="relative mx-auto max-w-6xl px-4 -mt-32 pb-6 md:-mt-40">
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {propertyFactors.map((item) => <ServiceCard {...item} />)}
      </div>
    </div>
    <div class="mx-auto max-w-3xl px-4 pt-4 pb-20 md:pb-24 text-center flex flex-wrap justify-center gap-4">
      <a href="/contact" class="btn btn-cta inline-flex">Talk Through Your Project</a>
      <a href="/contact" class="btn btn-outline inline-flex">Request a Free Estimate</a>
    </div>
  </section>

  <!-- Trench vs Ditch -->
  <section class="bg-slate-50 border-y border-slate-200">
    <div class="mx-auto max-w-6xl px-4 py-20 md:py-28">
      <div class="mb-12 md:mb-14 text-center">
        <p class="font-display font-semibold uppercase tracking-widest text-sm text-brand-blue">Trenching vs. Ditching</p>
        <h2 class="mt-2 font-display font-black uppercase tracking-tight text-3xl text-ink md:text-4xl">
          What Is the Difference Between a Trench and a Ditch?
        </h2>
        <p class="mt-4 text-slate-700 max-w-2xl mx-auto leading-relaxed">
          A trench and a ditch are both dug into the ground, but they serve different purposes. A trench is often made for something that needs to run underground, while a ditch is often used to move water.
        </p>
      </div>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {[
          { title: 'Underground Lines', description: 'A trench can give a water line, conduit, or other underground service a place to run. Its route depends on the project and property.', href: '/contact', linkLabel: 'Get an Estimate' },
          { title: 'Moving Water', description: 'A ditch can give rain and runoff a path to move away from an area. The slope and ground conditions help determine where the water can go.', href: '/contact', linkLabel: 'Get an Estimate' },
          { title: 'Shape and Size', description: 'Trenches and ditches can vary in width, depth, and shape. The work depends on what the digging needs to accomplish.', href: '/contact', linkLabel: 'Get an Estimate' },
          { title: 'Ground Conditions', description: 'Soil, wet ground, slope, and access can affect the digging. These conditions can also affect where the trench or ditch can go.', href: '/contact', linkLabel: 'Get an Estimate' },
          { title: 'Utility Routes', description: 'A utility trench follows the planned route for an underground line. Existing utilities should be located before excavation begins.', href: '/contact', linkLabel: 'Get an Estimate' },
          { title: 'Choosing the Right One', description: 'Not sure whether your project needs a trench or ditch? We can look at the property and explain what type of excavation may fit your project.', href: '/contact', linkLabel: 'Get an Estimate' },
        ].map((card) => (
          <div class="card flex flex-col gap-3">
            <h3 class="font-display font-bold uppercase tracking-wide text-base text-ink">{card.title}</h3>
            <p class="text-sm text-slate-600 leading-relaxed flex-1">{card.description}</p>
            <a href={card.href} class="inline-flex items-center gap-1 text-sm font-semibold text-brand-blue hover:underline">
              {card.linkLabel}
              <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M17 7H7M17 7V17" />
              </svg>
            </a>
          </div>
        ))}
      </div>
      <div class="mt-12 text-center">
        <a href="/contact" class="btn-pill inline-flex">
          Talk About Your Property
          <span class="btn-pill-icon">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M17 7H7M17 7V17" />
            </svg>
          </span>
        </a>
      </div>
    </div>
  </section>

  <!-- Before We Dig -->
  <section class="relative bg-ink text-white overflow-hidden">
    <div
      class="pointer-events-none absolute right-0 top-0 h-[480px] w-[480px] rounded-full bg-brand-blue/10 blur-3xl"
      aria-hidden="true"
    ></div>
    <div class="relative mx-auto max-w-6xl px-4 py-20 md:py-28">
      <div class="mb-12 md:mb-16 text-center">
        <p class="font-display font-semibold uppercase tracking-widest text-sm text-brand-blue-light">Before We Dig</p>
        <h2 class="mt-2 font-display font-bold uppercase tracking-tight text-3xl text-white md:text-4xl">
          What Happens Before the Trench Is Dug?
        </h2>
        <p class="mt-4 text-slate-300 max-w-2xl mx-auto leading-relaxed">
          Before digging starts, we look at what the trench is for, where it needs to go, and what is around it. This helps avoid problems during the work.
        </p>
      </div>
      <div class="grid gap-4 sm:grid-cols-2 sm:gap-6">
        {[
          { title: 'Confirm the Trench Route', detail: 'First, decide where the trench needs to run. The route should match the project and leave room around existing structures and other site features.' },
          { title: 'Locate Underground Utilities', detail: 'Before digging, existing underground utilities should be located. This helps identify lines that may be near the planned trench.' },
          { title: 'Check the Ground', detail: 'Look at the soil, slope, wet areas, and ground conditions. These can affect how the excavation is done and where equipment can work.' },
          { title: 'Check Access', detail: 'Make sure there is a workable path to the digging area. Driveways, buildings, fences, and tight spaces can affect equipment access.' },
        ].map((item) => (
          <div class="rounded-(--radius-brand-card) bg-white/5 border border-white/10 p-6 sm:p-7">
            <p class="font-display font-bold uppercase tracking-wide text-sm text-white">{item.title}</p>
            <p class="mt-3 text-sm text-slate-300 leading-relaxed">{item.detail}</p>
          </div>
        ))}
      </div>
      <div class="mt-10 flex flex-wrap justify-center gap-4">
        <a href="/contact" class="btn btn-cta">Get a Free Estimate</a>
        <a href="tel:5414018726" class="btn btn-outline border-white/30 text-white hover:bg-white/10">Call 541-401-8726</a>
      </div>
    </div>
  </section>

  <!-- What D&D Can Handle -->
  <section class="bg-white border-b border-slate-100">
    <div class="mx-auto max-w-6xl px-4 py-20 md:py-28">
      <div class="grid gap-12 lg:gap-20 lg:grid-cols-2 lg:items-center">
        <div>
          <p class="font-display font-semibold uppercase tracking-widest text-sm text-brand-blue mb-4">Trenching Services</p>
          <h2 class="font-display font-black uppercase tracking-tight text-3xl text-ink md:text-4xl">
            What Kind of Trenching Can D&D Land Works Handle?
          </h2>
          <p class="mt-5 text-slate-600 leading-relaxed">
            On Eugene-area properties, trenching can mean different things. You may need a line across a yard, a ditch for water, or excavation for a rural property project. D&D Land Works can help with the digging and ground work needed for these projects.
          </p>
          <ul class="mt-10 flex flex-col gap-7">
            {[
              { title: 'Utility Trenching', description: 'A water line, sewer line, or electrical conduit may need a trench. We handle the digging while the proper utility or trade contractor handles installation and connections.', icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m0 0-4-4m4 4 4-4M4 8h16" />' },
              { title: 'Irrigation Trenching', description: 'Irrigation lines may need trenches across a yard or property. We can prepare the trench based on the planned route, ground conditions, and access.', icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M12 3s6 7 6 11a6 6 0 1 1-12 0c0-4 6-11 6-11Z" />' },
              { title: 'Drainage and Ditch Digging', description: 'Some water problems may need a trench or ditch to give runoff a path. The right approach depends on the slope, ground, and where the water needs to go.', icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M3 17h4l4-9 4 5 3-4h3M17 6h3v3" />' },
              { title: 'Residential Trenching', description: 'Home projects can need trenches for water, irrigation, drainage, or other underground work. We can look at the area and explain what the excavation may involve.', icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M3 20 9 8l4 6 2-3 6 9H3Z" />' },
              { title: 'Septic-Related Excavation', description: 'Some septic projects require digging for tanks, lines, or other parts of the system. D&D handles the excavation, while septic design and related system work remain separate.', icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M3 12h18M3 6h18M3 18h18" />' },
              { title: 'Other Excavation Work', description: 'Some trenching jobs are part of a larger excavation project. If your project needs more than trench digging, we can look at the site and explain what excavation may be needed.', icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M11.42 15.17 17.25 21A2.652 2.652 0 0 0 21 17.25l-5.877-5.877M11.42 15.17l2.496-3.03c.317-.384.74-.626 1.208-.766M11.42 15.17l-4.655 5.653a2.548 2.548 0 1 1-3.586-3.586l5.653-4.655m5.833-4.329c.266.088.556.149.858.159a3.752 3.752 0 0 0 3.520-5.039 3 3 0 0 1-.857 1.078m-5.521 4-4.654-4.654" />' },
            ].map((item) => (
              <li class="flex items-start gap-4">
                <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-brand-blue-light text-brand-blue mt-0.5">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" set:html={item.icon} />
                </span>
                <div>
                  <p class="font-display font-bold text-ink">{item.title}</p>
                  <p class="mt-1 text-sm text-slate-600 leading-relaxed">{item.description}</p>
                </div>
              </li>
            ))}
          </ul>
          <a href="/contact" class="btn-pill mt-10 inline-flex">
            Talk About Your Property
            <span class="btn-pill-icon">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M17 7H7M17 7V17" />
              </svg>
            </span>
          </a>
        </div>
        <div class="relative">
          <img
            src="/service-land-clearing.webp"
            alt="Trenching and excavation work on a Lane County, Oregon property"
            class="w-full rounded-(--radius-brand-card) object-cover aspect-3/4 shadow-xl"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Service Areas -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-6xl px-4 py-20 md:py-28">
      <div class="mb-12 md:mb-14 text-center">
        <p class="font-display font-semibold uppercase tracking-widest text-sm text-brand-blue">Serving Local Properties</p>
        <h2 class="mt-2 font-display font-black uppercase tracking-tight text-3xl text-ink md:text-5xl">
          Trenching Services in Eugene, Springfield, and Lane County
        </h2>
        <div class="mt-5 text-slate-600 max-w-2xl mx-auto leading-relaxed flex flex-col gap-3">
          <p>D&D Land Works provides trench excavation for property owners in Eugene, Springfield, and nearby parts of Lane County. We can look at your property, access, and ground conditions to help determine what the trenching work may involve.</p>
        </div>
      </div>
      <div class="grid gap-6 lg:grid-cols-2 lg:gap-8 items-stretch">
        <div class="overflow-hidden rounded-(--radius-brand-card) bg-ink shadow-lg">
          <a href="/locations/eugene" class="flex items-center gap-3 bg-brand-blue px-6 py-4 text-white transition-opacity hover:opacity-90">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 21c4.4-3.4 7-7 7-10.5A7 7 0 0 0 5 10.5C5 14 7.6 17.6 12 21Z" />
              <circle cx="12" cy="10.5" r="2" fill="currentColor" stroke="none" />
            </svg>
            <span class="font-display font-bold uppercase tracking-wide text-sm">Eugene, OR</span>
          </a>
          {[
            { label: 'Springfield', href: '/locations/springfield' },
            { label: 'Cottage Grove', href: '/locations/cottage-grove' },
            { label: 'Junction City', href: '/locations/junction-city' },
            { label: 'Creswell', href: '/locations/creswell' },
            { label: 'Veneta', href: '/locations/veneta' },
            { label: 'Florence', href: '/locations/florence' },
            { label: 'Oakridge', href: '/locations/oakridge' },
            { label: 'Coburg', href: '/locations/coburg' },
            { label: 'Lowell', href: '/locations/lowell' },
          ].map((area) => (
            <a href={area.href} class="flex items-center gap-3 border-t border-white/10 px-6 py-4 text-white/70 transition-colors hover:bg-white/5 hover:text-white">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0 text-white/40" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 21c4.4-3.4 7-7 7-10.5A7 7 0 0 0 5 10.5C5 14 7.6 17.6 12 21Z" />
                <circle cx="12" cy="10.5" r="2" fill="currentColor" stroke="none" />
              </svg>

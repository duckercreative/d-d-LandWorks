---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ServiceCard from '../components/ServiceCard.astro';
import FAQ from '../components/FAQ.astro';
import CTABlock from '../components/CTABlock.astro';

const sitePrepItems = [
  { title: 'Brush Clearing', description: 'Blackberry, scrub, and thick brush take over fast around here. We cut it back and clear it off the work area, so you can walk your own land again.', href: '/brush-clearing-eugene-oregon', icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M12 2 8 9h2l-3 6h3v6h4v-6h3l-3-6h2L12 2Z" />' },
  { title: 'Vegetation Clearing', description: 'Grass, vines, weeds, and low growth all come off the spot you plan to use. That opens the ground up so you can finally see the dirt underneath.', href: '/land-clearing-services-eugene-oregon', icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m8-9h1M3 12H2m15.5-6.5-.7.7M6.2 17.8l-.7.7m12 0-.7-.7M6.2 6.2l-.7-.7M12 7a5 5 0 1 0 0 10A5 5 0 0 0 12 7Z" />' },
  { title: 'Wooded Lot Clearing', description: 'Some lots sit untouched for years and fill in on their own. We clear the heavy growth off the part you want, and leave it open for what comes next.', href: '/land-clearing-services-eugene-oregon', icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M9 20 4 18V4l5 2 6-2 5 2v14l-5-2-6 2Z M9 4v14M15 6v14" />' },
  { title: 'Access Area Clearing', description: 'A machine has to reach the job first. We open the path in, plus room for trucks to park and drop material close to where you need it.', href: '/services/driveway-repair', icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M9 3 5 21M15 3l4 18M12 8v2.5m0 4v2.5" />' },
  { title: 'Construction Area Clearing', description: 'Building something means the work area has to be clear. We take the growth off that footprint so the next crew can stake it out and get going.', href: '/services/site-preparation', icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M3 20 9 8l4 6 2-3 6 9H3Z" />' },
  { title: 'Rough Site Clearing', description: 'Once the clearing is done, the ground sits open and ready. Grading, site prep, or excavation can start from there when those are part of your project.', href: '/land-grading-services-eugene-oregon', icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M3 17h4l4-9 4 5 3-4h3M17 6h3v3" />' },
];

const faqs = [
  {
    question: 'What Does Land Clearing Include?',
    answer: 'Brush, vegetation, vines, and low growth come off the area you plan to use. We open the way in too, if the path is grown over. Standing trees and stumps are a tree service\'s job, not ours, and we\'ll say so up front.',
  },
  {
    question: 'Is Land Clearing the Same as Site Preparation?',
    answer: 'No. Clearing takes off what\'s growing. Site preparation changes the ground itself through grading, leveling, and moving dirt. Most projects need both, in that order, since you can\'t grade a pad through four feet of blackberry.',
  },
  {
    question: 'Can Land Clearing Prepare a Property for Construction?',
    answer: 'Yes, it\'s usually the first step. Once the growth is off you can see the ground, stake out a building spot, and start grading or digging. Raw land almost always gets cleared before a crew sets foot on it.',
  },
  {
    question: 'What Affects Land Clearing Cost?',
    answer: 'Size of the area, how thick the growth is, how hard it is to reach, and the time of year. Valley clay in winter slows everything down. David walks the property and gives you a real number instead of a phone guess.',
  },
  {
    question: 'How Long Does Land Clearing Take?',
    answer: 'A small brush job can be a day. A few acres of heavy growth runs longer, and wet ground can push the date. You get a window before work starts, and a call from us if weather moves it.',
  },
  {
    question: 'Does D&D Land Works Serve Springfield?',
    answer: 'Yes. Springfield is close to home, so those jobs schedule easy. We also clear land in Cottage Grove, Junction City, Creswell, Veneta, and out to Florence, Oakridge, Coburg, and Lowell across Lane County.',
  },
];

const pageSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'GeneralContractor',
      '@id': 'https://www.ddlandworks.com/#business',
      name: 'D&D Land Works',
      url: 'https://www.ddlandworks.com/',
      telephone: '+15414018726',
      email: 'david@ddlandworks.com',
      description: 'Full-service excavation, grading, and site preparation contractor serving Eugene, Springfield, and Lane County, Oregon. Licensed and bonded CCB #261742, DEQ Certified.',
      priceRange: '$$',
      areaServed: [
        { '@type': 'City', name: 'Eugene', sameAs: 'https://www.wikidata.org/wiki/Q49330' },
        { '@type': 'City', name: 'Springfield', sameAs: 'https://www.wikidata.org/wiki/Q49431' },
        { '@type': 'AdministrativeArea', name: 'Lane County, Oregon' },
      ],
      knowsAbout: ['Land Clearing', 'Brush Clearing', 'Site Preparation', 'Grading', 'Excavation', 'Septic Installation'],
      hasCredential: [
        { '@type': 'EducationalOccupationalCredential', credentialCategory: 'License', name: 'Oregon CCB License #261742' },
        { '@type': 'EducationalOccupationalCredential', credentialCategory: 'Certification', name: 'Oregon DEQ Certification — Septic Install & Repair' },
      ],
      sameAs: ['https://search.ccb.state.or.us/search/'],
    },
    {
      '@type': 'Service',
      '@id': 'https://www.ddlandworks.com/land-clearing-services-eugene-oregon/#service',
      name: 'Land Clearing Services in Eugene, Oregon',
      serviceType: 'Land Clearing',
      description: 'Land clearing services in Eugene, Oregon including brush clearing, vegetation removal, wooded lot clearing, and construction area clearing. Licensed and bonded, CCB #261742.',
      url: 'https://www.ddlandworks.com/land-clearing-services-eugene-oregon/',
      provider: { '@id': 'https://www.ddlandworks.com/#business' },
      areaServed: ['Eugene, Oregon', 'Springfield, Oregon', 'Lane County, Oregon'],
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.question,
        acceptedAnswer: { '@type': 'Answer', text: faq.answer },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.ddlandworks.com/' },
        { '@type': 'ListItem', position: 2, name: 'Land Clearing', item: 'https://www.ddlandworks.com/land-clearing-services-eugene-oregon/' },
        { '@type': 'ListItem', position: 3, name: 'Land Clearing Services Eugene OR', item: 'https://www.ddlandworks.com/land-clearing-services-eugene-oregon/' },
      ],
    },
  ],
};
---

<BaseLayout
  title="Land Clearing Services in Eugene, Oregon | Brush, Trees & Stumps Removed"
  description="Land clearing services in Eugene, Oregon. Brush clearing, tree removal, stump grinding, and debris hauling. CCB licensed contractor. Free quotes from D&D Land Works — 541-401-8726."
>
  <Hero
    eyebrow="Eugene, Oregon"
    headline="Land Clearing Services in Eugene, Oregon"
    subheadline="D&D Land Works clears overgrown land and heavy brush across Eugene, Springfield, and Lane County. Blackberry, undergrowth, raw lots nobody has touched in years. We come look at the property first, then tell you what it actually takes."
    primaryCta={{ label: 'Call 541-401-8726', href: 'tel:5414018726' }}
    secondaryCta={{ label: 'Free Estimate', href: '/contact' }}
  />

  <!-- Who We Clear For -->
  <section class="relative bg-white overflow-hidden">
    <div
      class="pointer-events-none absolute -right-32 -top-16 h-96 w-96 rounded-full bg-brand-blue-light/40 blur-3xl"
      aria-hidden="true"
    ></div>
    <div class="mx-auto max-w-6xl px-4 py-20 md:py-32">
      <div class="grid gap-12 lg:gap-20 lg:grid-cols-2 lg:items-center">
        <!-- Text column -->
        <div>
          <div class="mb-4 flex items-center gap-2">
            <img src="/logo.png" alt="" class="h-6 w-auto" aria-hidden="true" />
            <p class="font-display font-semibold uppercase tracking-widest text-sm text-brand-blue">
              Who We Clear For
            </p>
          </div>
          <h2 class="font-display font-black uppercase tracking-tight text-3xl text-ink md:text-4xl">
            Land Clearing for Homes and Businesses in Eugene
          </h2>
          <div class="mt-5 flex flex-col gap-4 text-slate-700 leading-relaxed">
            <p>Most property jobs start the same way. The brush has to come off before anything else can happen. D&amp;D Land Works clears land for homeowners and businesses in Eugene, Springfield, and all over Lane County. No two jobs look the same.</p>
            <p>A lot of calls start like this. You have a back acre you can&rsquo;t walk into anymore. The blackberry took it over. Or you bought a wooded lot a few years back and never got to it. Sometimes it&rsquo;s smaller than that. You want a spot for a shop or a shed, and the brush is in the way. We clear it out. You get ground you can stand on and plan around.</p>
            <p>Builders call with a date and a set of plans. The whole work area has to be open. So do the paths the trucks and machines use to get in and out. Raw land in Lane County hides things. Wet spots. Soft ground. Better to find that now than after the foundation crew shows up.</p>
          </div>
          <a href="/about" class="btn-pill mt-8 inline-flex">
            Learn More About D&amp;D Land Works
            <span class="btn-pill-icon">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M17 7H7M17 7V17" />
              </svg>
            </span>
          </a>
        </div>
        <!-- Image column -->
        <div class="relative pb-6">
          <img
            src="/project-excavation-bucket.webp"
            alt="D&D Land Works excavation contractor working in Lane County, Oregon"
            class="w-full rounded-(--radius-brand-card) object-cover aspect-4/3 shadow-xl"
            loading="lazy"
          />
          <div class="absolute bottom-10 left-4 sm:left-6 flex items-center gap-3 rounded-(--radius-brand-card) bg-brand-blue px-4 py-3 text-white shadow-lg">
            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-white/15">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 3l8 3v5c0 5.25-3.5 10.15-8 11.5C7.5 21.15 4 16.25 4 11V6l8-3Z" />
              </svg>
            </span>
            <div class="leading-tight">
              <p class="font-display font-bold text-sm">CCB #261742</p>
              <p class="font-body text-xs text-white/80">Licensed &amp; Bonded</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- What Does Land Clearing Include -->
  <section id="services" class="relative">
    <div class="relative bg-ink overflow-hidden">
      <img src="/project-site-excavation.webp" alt="" aria-hidden="true" class="absolute inset-0 h-full w-full object-cover opacity-45" loading="lazy" />
      <div class="absolute inset-0 bg-linear-to-b from-ink/80 via-ink/70 to-ink"></div>
      <div class="relative mx-auto max-w-3xl px-4 pt-20 pb-40 text-center md:pt-28 md:pb-52">
        <p class="font-display font-semibold uppercase tracking-widest text-sm text-brand-blue-light">Our Services</p>
        <h2 class="mt-2 font-display font-black uppercase tracking-tight text-3xl text-white md:text-5xl">
          What Does Land Clearing Include?
        </h2>
        <p class="mt-5 text-slate-300 leading-relaxed">
          Land clearing covers the work that gets growth off a property. What it takes depends on how thick the brush is, how the land sits, and what you plan to do with it after.
        </p>
      </div>
    </div>
    <div class="relative mx-auto max-w-6xl px-4 -mt-32 pb-6 md:-mt-40">
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {sitePrepItems.map((item) => <ServiceCard {...item} />)}
      </div>
    </div>
    <div class="mx-auto max-w-3xl px-4 pt-4 pb-20 md:pb-24 text-center flex flex-wrap justify-center gap-4">
      <a href="/services" class="btn btn-cta inline-flex">Explore Our Services</a>
      <a href="/contact" class="btn btn-outline inline-flex">Request a Free Estimate</a>
    </div>
  </section>

  <!-- Land Clearing for Different Property Conditions -->
  <section class="bg-slate-50 border-y border-slate-200">
    <div class="mx-auto max-w-6xl px-4 py-20 md:py-28">
      <div class="mb-12 md:mb-14 text-center">
        <p class="font-display font-semibold uppercase tracking-widest text-sm text-brand-blue">Every Property Is Different</p>
        <h2 class="mt-2 font-display font-black uppercase tracking-tight text-3xl text-ink md:text-4xl">
          Land Clearing for Different Property Conditions
        </h2>
        <p class="mt-4 text-slate-700 max-w-2xl mx-auto leading-relaxed">
          No two lots in Eugene clear the same way. How thick the brush is, how the land sits, how wet the ground gets, and whether a machine can even reach the spot all change the job.
        </p>
      </div>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {[
          { title: 'Overgrown Lots', description: 'Blackberry and brush spread fast around here. Give it a few seasons and a usable lot turns into a wall. We cut that growth back and open the space up again.', href: '/brush-clearing-eugene-oregon', linkLabel: 'Brush Clearing' },
          { title: 'Wooded Properties', description: 'Some lots fill in on their own after sitting for years. We clear the brush and low growth off the part you want to use. Standing timber is a separate job for a tree crew.', href: '/services/site-preparation', linkLabel: 'Site Preparation' },
          { title: 'Uneven Ground', description: 'Rutted, bumpy ground changes how a machine works a site. Dips and old fill can hide under the growth. We walk it first so the plan fits the ground instead of fighting it.', href: '/land-grading-services-eugene-oregon', linkLabel: 'Grading & Leveling' },
          { title: 'Sloped Property', description: 'Hillsides need a closer look. Slope decides where equipment can safely go, and it changes what happens to the soil once the growth comes off. Grading or stabilizing often follows the clearing.', href: '/contact', linkLabel: 'Slope Stabilization' },
          { title: 'Tight Access', description: "The work area might be fine while the way in isn't. Narrow drives, gates, fences, nowhere to turn a truck around. We check the route in before anything gets scheduled.", href: '/services/driveway-repair', linkLabel: 'Driveway Repair' },
          { title: 'Wet Ground', description: 'Winter here is wet and valley clay holds water for weeks. Soft ground limits what a machine can do without tearing up the site. Sometimes waiting for it to dry out is the better call.', href: '/drainage-installation-eugene-oregon', linkLabel: 'Drainage Excavation' },
        ].map((card) => (
          <div class="card flex flex-col gap-3">
            <h3 class="font-display font-bold uppercase tracking-wide text-base text-ink">{card.title}</h3>
            <p class="text-sm text-slate-600 leading-relaxed flex-1">{card.description}</p>
            <a href={card.href} class="inline-flex items-center gap-1 text-sm font-semibold text-brand-blue hover:underline">
              {card.linkLabel}
              <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M17 7H7M17 7V17" />
              </svg>
            </a>
          </div>
        ))}
      </div>
      <div class="mt-12 text-center">
        <a href="/contact" class="btn-pill inline-flex">
          Talk About Your Property
          <span class="btn-pill-icon">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M17 7H7M17 7V17" />
            </svg>
          </span>
        </a>
      </div>
    </div>
  </section>

  <!-- How Much Does Land Clearing Cost in Eugene -->
  <section class="relative bg-ink text-white overflow-hidden">
    <div
      class="pointer-events-none absolute right-0 top-0 h-[480px] w-[480px] rounded-full bg-brand-blue/10 blur-3xl"
      aria-hidden="true"
    ></div>
    <div class="relative mx-auto max-w-6xl px-4 py-20 md:py-28">
      <div class="mb-12 md:mb-16 text-center">
        <p class="font-display font-semibold uppercase tracking-widest text-sm text-brand-blue-light">What It Costs</p>
        <h2 class="mt-2 font-display font-bold uppercase tracking-tight text-3xl text-white md:text-4xl">
          How Much Does Land Clearing Cost in Eugene?
        </h2>
        <p class="mt-4 text-slate-300 max-w-2xl mx-auto leading-relaxed">
          Nobody can quote land clearing over the phone, and you should be careful with anyone who does. Price comes down to how big the area is, what's growing on it, and how hard it is to reach. Here's what moves the number.
        </p>
      </div>
      <div class="grid gap-4 sm:grid-cols-2 sm:gap-6">
        {[
          { title: 'How Big the Area Is', detail: "More ground takes more hours. But it's the part you actually want cleared that counts, not the whole deed. Plenty of folks only need an acre of a five acre lot opened up." },
          { title: "What's Growing on It", detail: 'Light brush clears quick. Ten years of blackberry is a different animal, and so is heavy growth with vines woven through it. Thickness matters more here than the size of the lot does.' },
          { title: 'How We Get In and How It Sits', detail: 'A machine has to reach the work. Narrow gates, tight drives, and nowhere to turn a truck all add time. Slopes and rutted ground slow things down the same way.' },
          { title: 'Time of Year', detail: "Valley clay holds water for weeks after a wet stretch. Working soft ground takes longer and tears up the site. A summer job and a February job on the same lot don't cost the same." },
        ].map((item) => (
          <div class="rounded-(--radius-brand-card) bg-white/5 border border-white/10 p-6 sm:p-7">
            <p class="font-display font-bold uppercase tracking-wide text-sm text-white">{item.title}</p>
            <p class="mt-3 text-sm text-slate-300 leading-relaxed">{item.detail}</p>
          </div>
        ))}
      </div>
      <p class="mt-10 text-center text-slate-300 max-w-xl mx-auto leading-relaxed">
        Free estimates, always. David comes out, walks the property, and tells you what the job takes. No charge for the visit and no pressure after it.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <a href="/contact" class="btn btn-cta">Get a Free Estimate</a>
        <a href="tel:5414018726" class="btn btn-outline border-white/30 text-white hover:bg-white/10">Call 541-401-8726</a>
      </div>
    </div>
  </section>

  <!-- What Can Affect the Timeline for Land Clearing -->
  <section class="bg-white border-b border-slate-100">
    <div class="mx-auto max-w-6xl px-4 py-20 md:py-28">
      <div class="grid gap-12 lg:gap-20 lg:grid-cols-2 lg:items-center">
        <div>
          <h2 class="font-display font-black uppercase tracking-tight text-3xl text-ink md:text-4xl">
            What Can Affect the <span class="text-brand-blue">Timeline</span> for Land Clearing?
          </h2>
          <p class="mt-5 text-slate-600 leading-relaxed">
            A small brush job can be done in a day. A few acres of heavy growth takes longer, and Eugene weather has a say in it. Here's what sets the schedule on most jobs.
          </p>
          <ul class="mt-10 flex flex-col gap-7">
            {[
              { title: 'Property Size', description: "Bigger areas take more hours. What matters is the part you want cleared, not the whole lot, so a five acre parcel isn't a five acre job.", icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M3 20 9 8l4 6 2-3 6 9H3Z" />' },
              { title: 'Amount of Vegetation', description: 'Light brush moves fast. Ten years of blackberry with vines woven through it moves slow. Thickness usually drives the schedule more than acreage does.', icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M12 2 8 9h2l-3 6h3v6h4v-6h3l-3-6h2L12 2Z" />' },
              { title: 'Site Access', description: 'If a machine drives straight in, clearing starts that morning. Narrow gates and tight drives mean opening the way first, and that adds time.', icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M9 3 5 21M15 3l4 18M12 8v2.5m0 4v2.5" />' },
              { title: 'Terrain', description: 'Flat ground works fastest. Slopes and rutted areas slow a machine down and limit where it can safely go, which stretches the job.', icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M3 17h4l4-9 4 5 3-4h3M17 6h3v3" />' },
              { title: 'Weather and Ground Conditions', description: 'Valley clay holds water for weeks. Soft ground slows the work and tears up a site, so a wet job sometimes waits for the next dry stretch.', icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M12 3s6 7 6 11a6 6 0 1 1-12 0c0-4 6-11 6-11Z" />' },
              { title: 'Related Site Work', description: "Clearing alone is the short version. Add grading, a driveway, or excavation and you're on site longer, though one crew doing it all beats scheduling three.", icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 10h16M4 14h16M4 18h16" />' },
            ].map((item) => (
              <li class="flex items-start gap-4">
                <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-brand-blue-light text-brand-blue mt-0.5">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" set:html={item.icon} />
                </span>
                <div>
                  <p class="font-display font-bold text-ink">{item.title}</p>
                  <p class="mt-1 text-sm text-slate-600 leading-relaxed">{item.description}</p>
                </div>
              </li>
            ))}
          </ul>
          <a href="/contact" class="btn-pill mt-10 inline-flex">
            Talk About Your Timeline
            <span class="btn-pill-icon">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M17 7H7M17 7V17" />
              </svg>
            </span>
          </a>
        </div>
        <div class="relative">
          <img
            src="/project-grading-driveway.webp"
            alt="D&D Land Works land clearing work in Lane County, Oregon"
            class="w-full rounded-(--radius-brand-card) object-cover aspect-3/4 shadow-xl"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Service Areas -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-6xl px-4 py-20 md:py-28">
      <div class="mb-12 md:mb-14 text-center">
        <p class="font-display font-semibold uppercase tracking-widest text-sm text-brand-blue">Our Service Area</p>
        <h2 class="mt-2 font-display font-black uppercase tracking-tight text-3xl text-ink md:text-5xl">
          Land Clearing in Eugene and Across Lane County
        </h2>
        <p class="mt-5 text-slate-600 max-w-2xl mx-auto leading-relaxed">
          D&amp;D Land Works clears land all over Lane County. Eugene and Springfield are close to home, so those jobs are easy to schedule. We also run out to Cottage Grove, Junction City, Creswell, Veneta, Florence, Oakridge, Coburg, and Lowell. Not sure if you're in range? Call and ask. If it's a drive, we'll tell you straight.
        </p>
      </div>
      <div class="grid gap-6 lg:grid-cols-2 lg:gap-8 items-stretch">
        <div class="overflow-hidden rounded-(--radius-brand-card) bg-ink shadow-lg">
          <a href="/locations/eugene" class="flex items-center gap-3 bg-brand-blue px-6 py-4 text-white transition-opacity hover:opacity-90">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 21c4.4-3.4 7-7 7-10.5A7 7 0 0 0 5 10.5C5 14 7.6 17.6 12 21Z" />
              <circle cx="12" cy="10.5" r="2" fill="currentColor" stroke="none" />
            </svg>
            <span class="font-display font-bold uppercase tracking-wide text-sm">Eugene, OR</span>
          </a>
          {[
            { label: 'Springfield', href: '/locations/springfield' },

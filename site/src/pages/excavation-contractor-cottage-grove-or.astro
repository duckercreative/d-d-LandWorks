---
import LocationPageTemplate from '../layouts/LocationPageTemplate.astro';

const factsBar = [
  { label: 'Based in', value: 'Springfield, OR' },
  { label: 'Serving', value: 'Cottage Grove & south Lane County' },
  { label: 'Licensed & bonded', value: 'CCB #261742' },
  { label: 'Septic work', value: 'DEQ certified' },
];

const services = [
  { num: '01', title: 'Site Preparation', desc: 'Clearing, excavation and grading to create a workable area for the next stage.', href: '/site-preparation-contractor-eugene-or' },
  { num: '02', title: 'Land Grading', desc: 'Reshaping uneven ground or adding slope to fit the planned use.', href: '/land-grading-services-eugene-or' },
  { num: '03', title: 'Land Clearing', desc: 'Brush, trees and debris removed so the ground can be prepared.', href: '/land-clearing-services-eugene-or' },
  { num: '04', title: 'Drainage Excavation', desc: 'A path for water, planned around your ground, slope and runoff.', href: '/drainage-installation-eugene-or' },
  { num: '05', title: 'Septic Excavation', desc: 'DEQ certified digging for septic installs and repairs.', href: '/septic-installation-lane-county-or' },
  { num: '06', title: 'Trenching', desc: 'Narrow runs for water, sewer, conduit, irrigation and drainage.', href: '/trenching-services-eugene-or' },
];

const checklistItems = [
  {
    title: 'Before construction begins',
    desc: 'A building site may need clearing, grading or excavation before any other work can start.',
    href: '/contact',
  },
  {
    title: 'When the ground needs reshaping',
    desc: 'Areas that are uneven, too high or too low get regraded to fit the project.',
    href: '/contact',
  },
  {
    title: 'When water is collecting',
    desc: 'Standing water by the house, drive or yard is usually a drainage problem with a dig-able fix.',
    href: '/contact',
  },
  {
    title: 'Before underground work',
    desc: 'Utility lines, irrigation and drains need a trench sized and placed for what goes in it.',
    href: '/contact',
  },
  {
    title: 'For septic projects',
    desc: 'New systems and repairs need excavation. D&D handles the digging for applicable septic work.',
    href: '/contact',
  },
  {
    title: 'When the driveway needs work',
    desc: 'Ruts, washouts and uneven gravel get regraded and the surface restored.',
    href: '/driveway-excavation-grading-eugene-or',
  },
];

const processSteps = [
  {
    num: '1',
    title: 'Tell us what you need',
    desc: 'What you want to build, repair, clear or dig on your Cottage Grove property.',
  },
  {
    num: '2',
    title: 'Discuss the property',
    desc: 'Location, access, slope, drainage, structures and utilities that affect the job.',
  },
  {
    num: '3',
    title: 'Understand the scope',
    desc: 'The excavation and site work explained in plain terms.',
  },
  {
    num: '4',
    title: 'Get your estimate',
    desc: 'A free estimate once the property and project are understood.',
    dark: true,
  },
];

const bentoFeatures = [
  {
    title: 'Free estimates',
    desc: 'Property, access, soil and scope reviewed on site. No phone quotes off satellite photos.',
    dark: false,
  },
  {
    title: 'Foundation excavation',
    desc: 'New homes, ADUs and commercial builds. One crew for clearing, grading and the foundation.',
    dark: true,
  },
  {
    title: 'Utility & trench work',
    desc: 'Water service, sewer lateral, conduit and drains, with 811 locates on every trench job.',
    dark: true,
  },
  {
    title: 'DEQ certified septic',
    desc: 'Tank, distribution box and drainfield excavation on rural Lane County lots.',
    dark: false,
  },
];

const areaLinks = [
  { label: 'Eugene', href: '/excavation-contractor-eugene-or' },
  { label: 'Springfield', href: '/site-preparation-contractor-springfield-or' },
  { label: 'Creswell', href: '/excavation-contractor-creswell-or' },
  { label: 'Lowell', href: '/excavation-contractor-lowell-or' },
  { label: 'Oakridge', href: '/excavation-contractor-oakridge-or' },
  { label: 'Veneta', href: '/excavation-contractor-veneta-or' },
  { label: 'Junction City', href: '/excavation-contractor-junction-city-or' },
  { label: 'Coburg', href: '/excavation-contractor-coburg-or' },
  { label: 'Florence', href: '/excavation-contractor-florence-or' },
];

const faqs = [
  {
    question: 'Do you provide excavation in Cottage Grove?',
    answer: 'Yes. D&D Land Works provides excavation and related site work across Cottage Grove and the surrounding area, from our base in nearby Springfield.',
  },
  {
    question: 'What affects excavation cost?',
    answer: 'Project size, digging depth, ground conditions, slope, access, clearing, hauling, drainage needs, septic work and overall site complexity.',
  },
  {
    question: 'Can you excavate for septic work?',
    answer: 'Yes. D&D is DEQ certified and handles excavation for applicable septic projects. Septic design and approval are separate parts of the project.',
  },
  {
    question: 'Do you provide free estimates?',
    answer: 'Yes. Free estimates for excavation and site work projects in Cottage Grove, based on an on-site look at the property.',
  },
  {
    question: 'Where is D&D Land Works based?',
    answer: 'Springfield, Oregon, about 20 minutes north of Cottage Grove on I-5. We work throughout Lane County.',
  },
];

const relatedServices = [
  {
    title: 'Site Preparation',
    desc: 'Clearing, grading and compaction for raw lots.',
    href: '/site-preparation-contractor-eugene-or',
  },
  {
    title: 'Grading & Leveling',
    desc: 'The right slope for drainage and a level pad.',
    href: '/land-grading-services-eugene-or',
  },
  {
    title: 'Foundation Excavation',
    desc: 'Footprints, footings, crawl spaces and basements.',
    href: '/foundation-excavation-eugene-or',
  },
  {
    title: 'Drainage Excavation',
    desc: 'French drains, swales and catch basins.',
    href: '/drainage-installation-eugene-or',
  },
];

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'GeneralContractor',
      '@id': 'https://www.ddlandworks.com/#business',
      name: 'D&D Land Works',
      url: 'https://www.ddlandworks.com/',
      telephone: '+15414018726',
      email: 'david@ddlandworks.com',
      priceRange: '$$',
      areaServed: [
        { '@type': 'City', name: 'Cottage Grove', sameAs: 'https://www.wikidata.org/wiki/Q1130720' },
        { '@type': 'AdministrativeArea', name: 'Lane County, Oregon' },
      ],
      hasCredential: [
        { '@type': 'EducationalOccupationalCredential', credentialCategory: 'License', name: 'Oregon CCB License #261742' },
        { '@type': 'EducationalOccupationalCredential', credentialCategory: 'Certification', name: 'Oregon DEQ Certification, Septic Install & Repair' },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.question,
        acceptedAnswer: { '@type': 'Answer', text: faq.answer },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.ddlandworks.com/' },
        { '@type': 'ListItem', position: 2, name: 'Service Area', item: 'https://www.ddlandworks.com/service-area/' },
        { '@type': 'ListItem', position: 3, name: 'Cottage Grove', item: 'https://www.ddlandworks.com/excavation-contractor-cottage-grove-or/' },
      ],
    },
  ],
};
---

<LocationPageTemplate
  pageTitle="Excavation Contractor in Cottage Grove, OR | D&D Land Works"
  pageDescription="D&D Land Works provides excavation, land clearing, grading, drainage, and septic-related site work in Cottage Grove, OR. CCB #261742. Free estimates, call 541-401-8726."
  schema={schema}
  cityState="Cottage Grove, Oregon"
  heroH1Light="Excavation contractor"
  heroH1Bold="in Cottage Grove, Oregon"
  heroSub="Foundation digging, trenching, utility, drainage and septic excavation from one licensed, bonded contractor. David walks every Cottage Grove site before quoting."
  heroImage="/service-site-preparation.webp"
  factsBar={factsBar}
  breadcrumbLabel="Cottage Grove"
  introEyebrow="Cottage Grove's excavation contractor"
  introH2Light="Excavation for homes and"
  introH2Bold="businesses in Cottage Grove"
  davidQuote="I walk every site in person before I quote it."
  introPara1="Most building and land projects in Cottage Grove start with an excavation call. D&D Land Works handles the digging, trenching and earth-moving that comes before a foundation gets poured, a utility gets connected or a drainage problem gets fixed."
  introPara2="Some jobs are a foundation footprint on a lot that's already cleared. Others start with brush on raw ground. Some are small: a water line trench, a French drain beside a crawl space, or a drainfield dig on a rural parcel outside municipal sewer."
  introImage="/project-excavation-bucket.webp"
  servicesEyebrow="Our services"
  servicesH2Light="What does excavation"
  servicesH2Bold="include in Cottage Grove?"
  servicesDesc="The scope depends on foundation depth, utility runs, drainage needs and what your ground requires before anything is built."
  services={services}
  whenEyebrow="Cottage Grove excavation"
  whenH2Light="When does your"
  whenH2Bold="property need it?"
  whenDesc="Check off what sounds like your property. If any of these fit, a free site walk is the next step."
  checklistItems={checklistItems}
  processEyebrow="Getting started"
  processH2Light="How your Cottage Grove"
  processH2Bold="project gets started"
  processDesc="You don't need to know the name of the service before you call. Just explain what you're trying to do and what's happening on the property."
  processSteps={processSteps}
  whyH2Light="Why Cottage Grove calls"
  whyH2Bold="D&D Land Works"
  bentoImage="/project-grading-driveway.webp"
  bentoImageAlt="Finished grading and gravel work at a Lane County home"
  bentoFeatures={bentoFeatures}
  areaEyebrow="Our service area"
  areaH2Light="Excavation in Cottage Grove"
  areaH2Bold="and Lane County"
  areaDesc="Based in Springfield and working south down I-5 into Cottage Grove and the surrounding rural parcels. Nearby areas we also serve:"
  areaLinks={areaLinks}
  faqH2Light="Excavation in Cottage Grove:"
  faqH2Bold="common questions"
  faqs={faqs}
  relatedEyebrow="Related services in Cottage Grove"
  relatedServices={relatedServices}
  ctaEyebrow="Talk with David"
  ctaH2Light="Need excavation work"
  ctaH2Bold="in Cottage Grove?"
  ctaSub="Not sure what kind of excavation you need? Tell David what you want to do, where the work is and what problem you're solving. Free estimates, no obligation."
  ctaImage="/service-site-preparation.webp"
/>

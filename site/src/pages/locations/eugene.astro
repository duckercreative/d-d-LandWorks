---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Excavation Contractor in Eugene, OR | D&D Land Works" description="D&D Land Works — excavation, site prep, land clearing, grading, drainage, and septic work in Eugene, Oregon. CCB #261742. DEQ Certified.">
  <section class="mx-auto max-w-3xl px-4 py-24 text-center">
    <h1 class="font-display font-black uppercase tracking-tight text-4xl text-ink">Eugene, Oregon</h1>
    <p class="mt-6 text-slate-600 leading-relaxed max-w-xl mx-auto">D&D Land Works serves Eugene from its Springfield base — excavation, site preparation, land clearing, grading, drainage, and septic work for residential and rural properties in the Eugene metro area.</p>
    <a href="/contact" class="mt-8 inline-block rounded-full bg-brand-blue px-8 py-3 font-display font-bold uppercase tracking-wide text-sm text-white hover:bg-brand-blue-dark transition-colors">Get a Free Estimate</a>
  </section>

  <section class="border-t border-slate-200 py-16">
    <div class="mx-auto max-w-4xl px-4">
      <h2 class="font-display font-black uppercase tracking-tight text-2xl text-ink text-center mb-10">Eugene Service Pages</h2>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        <a href="/locations/eugene/excavation" class="rounded-xl border border-slate-200 p-6 hover:border-brand-blue hover:shadow-sm transition-all">
          <div class="font-display font-bold text-ink">Excavation</div>
          <div class="mt-1 text-sm text-slate-500">Site excavation &amp; earthwork</div>
        </a>
        <a href="/locations/eugene/land-clearing" class="rounded-xl border border-slate-200 p-6 hover:border-brand-blue hover:shadow-sm transition-all">
          <div class="font-display font-bold text-ink">Land Clearing</div>
          <div class="mt-1 text-sm text-slate-500">Tree removal, brush, stumps</div>
        </a>
        <a href="/locations/eugene/grading" class="rounded-xl border border-slate-200 p-6 hover:border-brand-blue hover:shadow-sm transition-all">
          <div class="font-display font-bold text-ink">Grading</div>
          <div class="mt-1 text-sm text-slate-500">Land grading &amp; site leveling</div>
        </a>
        <a href="/locations/eugene/drainage" class="rounded-xl border border-slate-200 p-6 hover:border-brand-blue hover:shadow-sm transition-all">
          <div class="font-display font-bold text-ink">Drainage</div>
          <div class="mt-1 text-sm text-slate-500">French drains &amp; stormwater</div>
        </a>
        <a href="/locations/eugene/septic" class="rounded-xl border border-slate-200 p-6 hover:border-brand-blue hover:shadow-sm transition-all">
          <div class="font-display font-bold text-ink">Septic</div>
          <div class="mt-1 text-sm text-slate-500">DEQ-certified septic work</div>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

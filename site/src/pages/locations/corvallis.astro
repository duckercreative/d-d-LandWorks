---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import FAQ from '../../components/FAQ.astro';
import CTABlock from '../../components/CTABlock.astro';

const excavationTypes = [
  { title: 'Site Preparation', description: 'Getting the ground ready for the next part of a project. Depending on the property, this may include clearing, digging, grading, or moving soil before work can begin.', href: '/site-preparation-contractor-eugene-oregon', icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M5 21V7l7-4 7 4v14M3 21h18M9 21v-4h6v4" />' },
  { title: 'Land Grading', description: 'Changing the shape and slope of the ground for a building area, driveway, drainage, or other planned use. Slope, ground conditions, and access can all affect the work.', href: '/land-grading-services-eugene-oregon', icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M3 17h4l4-9 4 5 3-4h3M17 6h3v3" />' },
  { title: 'Land Clearing', description: 'Removing brush, trees, debris, and overgrown areas from a property before excavation or other site work can begin. The amount of clearing needed can affect the rest of the project.', href: '/land-clearing-services-eugene-oregon', icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M3 20 9 8l4 6 2-3 6 9H3Z" />' },
  { title: 'Trenching', description: 'Digging a narrow path in the ground for underground lines, drainage, or other planned work. The depth, route, and purpose of the trench affect what the excavation involves.', href: '/trenching-services-eugene-oregon', icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M3 20h18M6 20V9l6-6 6 6v11M9 20v-6h6v6" />' },
  { title: 'Drainage Work', description: 'When water collects where it should not, excavation or grading may create a better path for it to move. The right approach depends on the property and where the water is coming from.', href: '/drainage-installation-eugene-oregon', icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M12 3s6 7 6 11a6 6 0 1 1-12 0c0-4 6-11 6-11Z" />' },
  { title: 'Residential Excavation', description: 'Excavation can be part of many home property projects — building-site preparation, grading, trenching, drainage, or other digging work depending on what the site needs.', href: '/excavation-contractor-eugene-oregon', icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M3 10.5L12 3l9 7.5V20a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V10.5Z M9 21V12h6v9" />' },
];

const whenCards = [
  { title: 'Before Construction Begins', description: 'A building site may need clearing, grading, or excavation before any other work can start. The scope depends on the current state of the property.', href: '/contact', linkLabel: 'Get an Estimate' },
  { title: 'When the Ground Is Uneven', description: 'If an area is too high, too low, or uneven for its planned use, grading or excavation can reshape it to fit the project.', href: '/contact', linkLabel: 'Get an Estimate' },
  { title: 'When Water Is Collecting', description: 'Standing water around a home, driveway, or yard is often a drainage issue. Excavation or grading may create a path to move water where it needs to go.', href: '/contact', linkLabel: 'Get an Estimate' },
  { title: 'When Land Needs Clearing', description: 'Brush, trees, and overgrowth need to be removed before excavation or grading can begin. The amount of clearing affects the overall scope of the project.', href: '/contact', linkLabel: 'Get an Estimate' },
  { title: 'When Trenching Is Needed', description: 'If your project requires a path below ground for utilities, drainage, or other purposes, trenching is the type of excavation used to dig that path.', href: '/contact', linkLabel: 'Get an Estimate' },
  { title: 'For a Residential Property Project', description: 'Home properties can need excavation for many reasons — access improvements, drainage fixes, building prep, or other site work. Start by describing what you want to accomplish.', href: '/contact', linkLabel: 'Get an Estimate' },
];

const whyItems = [
  { title: 'Call to Confirm Service Area', description: 'D&D Land Works is based in Springfield, not Corvallis. Call 541-401-8726 with your project location so we can confirm whether it fits the current service area before scheduling any work.', icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.338c0-.53.313-.988.741-1.212l8.25-4.125a1.5 1.5 0 0 1 1.518 0l8.25 4.125c.428.224.741.682.741 1.212v10.324c0 .53-.313.988-.741 1.212l-8.25 4.125a1.5 1.5 0 0 1-1.518 0l-8.25-4.125A1.365 1.365 0 0 1 2.25 16.662V6.338Z" />' },
  { title: 'Licensed and Bonded', description: 'D&D Land Works is licensed and bonded in Oregon under CCB #261742. You can verify the license through the Oregon Construction Contractors Board before hiring.', icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M12 3l8 3v5c0 5.25-3.5 10.15-8 11.5C7.5 21.15 4 16.25 4 11V6l8-3Z" />', link: { label: 'Verify CCB License →', href: 'https://search.ccb.state.or.us/search/' } },
  { title: 'DEQ Certified for Septic Work', description: 'D&D Land Works is DEQ certified for applicable septic installation and repair, including excavation associated with septic projects where the service area applies.', icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M6 7c0-1.7 2.7-3 6-3s6 1.3 6 3v10c0 1.7-2.7 3-6 3s-6-1.3-6-3V7Z M6 7c0 1.7 2.7 3 6 3s6-1.3 6-3" />' },
  { title: 'Free Estimates', description: 'D&D Land Works provides free estimates for applicable excavation and site preparation projects. David walks the property before quoting — pricing reflects actual site conditions.', icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M9 3h6a1 1 0 0 1 1 1v1H8V4a1 1 0 0 1 1-1Z M7 6h10v14a1 1 0 0 1-1 1H8a1 1 0 0 1-1-1V6Z M9 12.5l2 2 4-4.5" />' },
  { title: 'No Fixed Timeline — Real Scope', description: 'We do not promise the same timeline for every job. Property size, ground conditions, access, clearing, and complexity can all affect how long a project takes.', icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />' },
];

const faqs = [
  { question: 'Do you serve the Corvallis area?', answer: 'D&D Land Works is based in Springfield, Oregon. If your property is near Corvallis, call 541-401-8726 with the project location so we can confirm whether it fits the current service area.' },
  { question: 'What does an excavation contractor do?', answer: 'An excavation contractor digs, moves, and shapes soil to prepare a property for a project. The work may include site preparation, grading, clearing, trenching, drainage work, and other excavation tasks.' },
  { question: 'Can you prepare my property near Corvallis?', answer: 'Site preparation may include clearing, digging, grading, or moving soil, depending on the property. Call to discuss the project and confirm whether your location is within the service area.' },
  { question: 'Do you provide free estimates?', answer: 'Yes. D&D Land Works provides free estimates for applicable excavation and site work projects where the property is within the service area.' },
  { question: 'What affects excavation cost near Corvallis?', answer: 'Size, depth, ground conditions, access, clearing, grading, drainage, material movement, and project complexity can all affect cost. The best way to discuss cost is to explain what you want done and share the basic details of the project.' },
];

const serviceSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'GeneralContractor',
      '@id': 'https://www.ddlandworks.com/#business',
      name: 'D&D Land Works',
      url: 'https://www.ddlandworks.com/',
      telephone: '+15414018726',
      email: 'david@ddlandworks.com',
      priceRange: '$$',
      areaServed: [
        { '@type': 'City', name: 'Corvallis', sameAs: 'https://www.wikidata.org/wiki/Q188748' },
        { '@type': 'AdministrativeArea', name: 'Lane County, Oregon' },
      ],
      hasCredential: [
        { '@type': 'EducationalOccupationalCredential', credentialCategory: 'License', name: 'Oregon CCB License #261742' },
        { '@type': 'EducationalOccupationalCredential', credentialCategory: 'Certification', name: 'Oregon DEQ Certification — Septic Install & Repair' },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.question,
        acceptedAnswer: { '@type': 'Answer', text: faq.answer },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.ddlandworks.com/' },
        { '@type': 'ListItem', position: 2, name: 'Service Areas', item: 'https://www.ddlandworks.com/service-area/' },
        { '@type': 'ListItem', position: 3, name: 'Corvallis Area', item: 'https://www.ddlandworks.com/locations/corvallis/' },
      ],
    },
  ],
};
---

<BaseLayout
  title="Excavation Contractor near Corvallis, OR | D&D Land Works"
  description="D&D Land Works provides excavation, land clearing, grading, trenching, and drainage work near Corvallis, OR. Based in Springfield — call to confirm service area. CCB #261742. Free estimates — 541-401-8726."
>

  <Hero
    eyebrow="Excavation Contractor near Corvallis, Oregon"
    headline="Excavation Contractor near Corvallis, Oregon"
    subheadline="D&D Land Works provides excavation and related site work for property projects. If your property is in or near the Corvallis area, call to discuss the work you need and confirm whether the project fits the current service area."
    primaryCta={{ label: 'Call 541-401-8726', href: 'tel:5414018726' }}
    secondaryCta={{ label: 'Free Estimate', href: '/contact' }}
  />

  <!-- Local intro -->
  <section class="relative bg-white overflow-hidden">
    <div class="pointer-events-none absolute -right-32 -top-16 h-96 w-96 rounded-full bg-brand-blue-light/40 blur-3xl" aria-hidden="true"></div>
    <div class="mx-auto max-w-6xl px-4 py-20 md:py-32">
      <div class="grid gap-12 lg:gap-20 lg:grid-cols-2 lg:items-center">
        <div>
          <div class="mb-4 flex items-center gap-2">
            <img src="/logo.png" alt="" class="h-6 w-auto" aria-hidden="true" />
            <p class="font-display font-semibold uppercase tracking-widest text-sm text-brand-blue">
              Excavation Work near Corvallis
            </p>
          </div>
          <h2 class="font-display font-black uppercase tracking-tight text-3xl text-ink md:text-4xl">
            Excavation and Site Work near Corvallis
          </h2>
          <div class="mt-5 flex flex-col gap-4 text-slate-700 leading-relaxed">
            <p>Excavation means digging and moving earth to prepare a property for the next part of a project. You may need it before building, to shape land, clear an area, improve drainage, or run a trench for underground work.</p>
            <p>Every property is different. The ground, access, size of the job, and type of work can all change what a project needs. A small area may need only a little digging; a larger property may need clearing, grading, or more site preparation before work can begin.</p>
            <p>D&D Land Works is licensed and bonded under <strong class="font-semibold text-ink">CCB #261742</strong>. We are based in Springfield — call to confirm whether your Corvallis-area property is within the current service area.</p>
          </div>
          <a href="tel:5414018726" class="btn-pill mt-8 inline-flex">
            Call to Confirm Service Area
            <span class="btn-pill-icon">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M17 7H7M17 7V17" />
              </svg>
            </span>
          </a>
        </div>
        <div class="relative pb-6">
          <img
            src="/project-excavation-bucket.webp"
            alt="D&D Land Works excavation contractor serving the Corvallis, Oregon area"
            class="w-full rounded-(--radius-brand-card) object-cover aspect-4/3 shadow-xl"
            loading="lazy"
          />
          <div class="absolute bottom-10 left-4 sm:left-6 flex items-center gap-3 rounded-(--radius-brand-card) bg-brand-blue px-4 py-3 text-white shadow-lg">
            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-white/15">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 3l8 3v5c0 5.25-3.5 10.15-8 11.5C7.5 21.15 4 16.25 4 11V6l8-3Z" />
              </svg>
            </span>
            <div class="leading-tight">
              <p class="font-display font-bold text-sm">CCB #261742</p>
              <p class="font-body text-xs text-white/80">Licensed &amp; Bonded</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- What kind of work -->
  <section class="relative">
    <div class="relative bg-ink overflow-hidden">
      <img src="/project-site-excavation.webp" alt="" aria-hidden="true" class="absolute inset-0 h-full w-full object-cover opacity-45" loading="lazy" />
      <div class="absolute inset-0 bg-linear-to-b from-ink/80 via-ink/70 to-ink"></div>
      <div class="relative mx-auto max-w-3xl px-4 pt-20 pb-40 text-center md:pt-28 md:pb-52">
        <p class="font-display font-semibold uppercase tracking-widest text-sm text-brand-blue-light">Corvallis-Area Properties</p>
        <h2 class="mt-2 font-display font-black uppercase tracking-tight text-3xl text-white md:text-5xl">
          What Kind of Work Does Your Property Need?
        </h2>
        <p class="mt-5 text-slate-300 leading-relaxed">
          You may not know the exact name for the work your property needs — that is okay. Start by explaining the problem you are trying to solve and what you want the land to do.
        </p>
      </div>
    </div>
    <div class="relative mx-auto max-w-6xl px-4 -mt-32 pb-6 md:-mt-40">
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {excavationTypes.map((item) => <ServiceCard {...item} />)}
      </div>
    </div>
    <div class="mx-auto max-w-3xl px-4 pt-4 pb-20 md:pb-24 text-center flex flex-wrap justify-center gap-4">
      <a href="tel:5414018726" class="btn btn-cta inline-flex">Call to Confirm Service Area</a>
      <a href="/contact" class="btn btn-outline inline-flex">Request a Free Estimate</a>
    </div>
  </section>

  <!-- When does a Corvallis property need excavation -->
  <section class="bg-slate-50 border-y border-slate-200">
    <div class="mx-auto max-w-6xl px-4 py-20 md:py-28">
      <div class="mb-12 md:mb-14 text-center">
        <p class="font-display font-semibold uppercase tracking-widest text-sm text-brand-blue">Corvallis-Area Excavation</p>
        <h2 class="mt-2 font-display font-black uppercase tracking-tight text-3xl text-ink md:text-4xl">
          When Does a Property Near Corvallis Need Excavation?
        </h2>
        <p class="mt-4 text-slate-700 max-w-2xl mx-auto leading-relaxed">
          You may need excavation when the existing ground does not fit the work you want to do. The reason depends on the property and what you are trying to build, fix, or improve.
        </p>
      </div>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {whenCards.map((card) => (
          <div class="card flex flex-col gap-3">
            <h3 class="font-display font-bold uppercase tracking-wide text-base text-ink">{card.title}</h3>
            <p class="text-sm text-slate-600 leading-relaxed flex-1">{card.description}</p>
            <a href={card.href} class="inline-flex items-center gap-1 text-sm font-semibold text-brand-blue hover:underline">
              {card.linkLabel}
              <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M17 7H7M17 7V17" />
              </svg>
            </a>
          </div>
        ))}
      </div>
      <div class="mt-12 text-center">
        <a href="/contact" class="btn-pill inline-flex">
          Talk About Your Property
          <span class="btn-pill-icon">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M17 7H7M17 7V17" />
            </svg>
          </span>
        </a>
      </div>
    </div>
  </section>

  <!-- How it gets started — process steps -->
  <section class="relative bg-ink text-white overflow-hidden">
    <div class="pointer-events-none absolute right-0 top-0 h-[480px] w-[480px] rounded-full bg-brand-blue/10 blur-3xl" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-6xl px-4 py-20 md:py-28">
      <div class="mb-12 md:mb-16 text-center">
        <p class="font-display font-semibold uppercase tracking-widest text-sm text-brand-blue-light">Getting Started</p>
        <h2 class="mt-2 font-display font-bold uppercase tracking-tight text-3xl text-white md:text-4xl">
          How Your Corvallis-Area Project Gets Started
        </h2>
        <p class="mt-4 text-slate-300 max-w-2xl mx-auto leading-relaxed">
          You do not need to know the exact name of the work before you call. Start with what you want to do and where the property is located.
        </p>
      </div>
      <div class="grid gap-4 sm:grid-cols-2 sm:gap-6 lg:grid-cols-4">
        {[
          { step: '1', title: 'Tell Us What You Need', detail: 'Tell us what you want to build, clear, grade, trench, or dig on your property near Corvallis. If you are not sure of the exact work, describe the problem you are trying to solve.' },
          { step: '2', title: 'Confirm Service Area', detail: 'We confirm whether your property is within the current service area before scheduling any work. D&D Land Works is based in Springfield — Corvallis-area projects are confirmed case by case.' },
          { step: '3', title: 'Understand the Scope', detail: 'Once the property and project are understood, the required excavation or related site work can be discussed in plain terms based on actual site conditions.' },
          { step: '4', title: 'Get an Estimate', detail: 'D&D Land Works provides free estimates for applicable excavation and site work projects where the property falls within the service area.' },
        ].map((item) => (
          <div class="rounded-(--radius-brand-card) bg-white/5 border border-white/10 p-6 sm:p-7">
            <span class="flex h-10 w-10 items-center justify-center rounded-full bg-safety-orange font-display font-bold text-white text-sm">
              {item.step}
            </span>
            <p class="mt-4 font-display font-bold uppercase tracking-wide text-sm text-white">{item.title}</p>
            <p class="mt-2 text-sm text-slate-300 leading-relaxed">{item.detail}</p>
          </div>
        ))}
      </div>
      <div class="mt-10 flex flex-wrap justify-center gap-4">
        <a href="tel:5414018726" class="btn btn-cta">Call 541-401-8726</a>
        <a href="/contact" class="btn btn-outline border-white/30 text-white hover:bg-white/10">Request a Free Estimate</a>
      </div>
    </div>
  </section>

  <!-- What can D&D help with -->
  <section class="bg-white border-b border-slate-100">
    <div class="mx-auto max-w-6xl px-4 py-20 md:py-28">
      <div class="grid gap-12 lg:gap-20 lg:grid-cols-2 lg:items-center">
        <div>
          <p class="font-display font-semibold uppercase tracking-widest text-sm text-brand-blue mb-4">Excavation Services</p>
          <h2 class="font-display font-black uppercase tracking-tight text-3xl text-ink md:text-4xl">
            What Can D&D Land Works Help With?
          </h2>
          <p class="mt-5 text-slate-600 leading-relaxed">
            D&D Land Works handles excavation and related site work for property projects. We look at the property itself and what it needs rather than assuming every site is the same.
          </p>
          <ul class="mt-10 flex flex-col gap-7">
            {whyItems.map((item) => (
              <li class="flex items-start gap-4">
                <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-brand-blue-light text-brand-blue mt-0.5">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" set:html={item.icon} />
                </span>
                <div>
                  <p class="font-display font-bold text-ink">{item.title}</p>
                  <p class="mt-1 text-sm text-slate-600 leading-relaxed">{item.description}</p>
                  {item.link && (
                    <a href={item.link.href} target="_blank" rel="noopener noreferrer" class="mt-1 inline-block text-sm font-semibold text-brand-blue hover:underline">
                      {item.link.label}
                    </a>
                  )}
                </div>
              </li>
            ))}
          </ul>
          <a href="tel:5414018726" class="btn-pill mt-10 inline-flex">
            Call to Confirm Service Area
            <span class="btn-pill-icon">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M17 7H7M17 7V17" />
              </svg>
            </span>
          </a>
        </div>
        <div class="relative">
          <img
            src="/project-grading-driveway.webp"
            alt="D&D Land Works excavation and site work near Corvallis, Oregon"
            class="w-full rounded-(--radius-brand-card) object-cover aspect-3/4 shadow-xl"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Service Areas -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-6xl px-4 py-20 md:py-28">
      <div class="mb-12 md:mb-14 text-center">
        <p class="font-display font-semibold uppercase tracking-widest text-sm text-brand-blue">Primary Service Area</p>
        <h2 class="mt-2 font-display font-black uppercase tracking-tight text-3xl text-ink md:text-5xl">
          Based in Springfield — Serving Lane County
        </h2>
        <div class="mt-5 text-slate-600 max-w-2xl mx-auto leading-relaxed flex flex-col gap-3">
          <p>D&D Land Works is headquartered in Springfield and regularly serves Lane County communities. Corvallis is outside the primary service area — call to confirm whether your property can be included.</p>
          <p>If your project is within the regular service area, contact us directly for a free estimate.</p>
        </div>
      </div>
      <div class="grid gap-6 lg:grid-cols-2 lg:gap-8 items-stretch">
        <div class="overflow-hidden rounded-(--radius-brand-card) bg-ink shadow-lg">
          <a href="/locations/corvallis" class="flex items-center gap-3 bg-brand-blue px-6 py-4 text-white transition-opacity hover:opacity-90">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 21c4.4-3.4 7-7 7-10.5A7 7 0 0 0 5 10.5C5 14 7.6 17.6 12 21Z" />
              <circle cx="12" cy="10.5" r="2" fill="currentColor" stroke="none" />
            </svg>
            <span class="font-display font-bold uppercase tracking-wide text-sm">Corvallis Area (Call to Confirm)</span>
          </a>
          {[
            { label: 'Eugene', href: '/locations/eugene' },
            { label: 'Springfield', href: '/locations/springfield' },
            { label: 'Junction City', href: '/locations/junction-city' },
            { label: 'Cottage Grove', href: '/locations/cottage-grove' },
            { label: 'Creswell', href: '/locations/creswell' },
            { label: 'Veneta', href: '/locations/veneta' },
            { label: 'Florence', href: '/locations/florence' },
            { label: 'Oakridge', href: '/locations/oakridge' },
            { label: 'Coburg', href: '/locations/coburg' },
            { label: 'Lowell', href: '/excavation-contractor-lowell-oregon' },
          ].map((area) => (
            <a href={area.href} class="flex items-center gap-3 border-t border-white/10 px-6 py-4 text-white/70 transition-colors hover:bg-white/5 hover:text-white">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0 text-white/40" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 21c4.4-3.4 7-7 7-10.5A7 7 0 0 0 5 10.5C5 14 7.6 17.6 12 21Z" />

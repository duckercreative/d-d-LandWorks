---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import FAQ from '../../components/FAQ.astro';
import CTABlock from '../../components/CTABlock.astro';

const excavationTypes = [
  { title: 'Building Site Preparation', description: 'A property may need clearing, grading, or excavation before construction can begin. The amount of work depends on what is already on the site.', href: '/contact', icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M5 21V7l7-4 7 4v14M3 21h18M9 21v-4h6v4" />' },
  { title: 'Grading and Ground Shaping', description: 'If part of your property is too high, too low, or uneven, excavation and grading can change the ground level for the use you have planned.', href: '/contact', icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M3 17h4l4-9 4 5 3-4h3M17 6h3v3" />' },
  { title: 'Land Clearing', description: 'Brush, trees, vegetation, and debris can make an area hard to reach or use. Clearing opens the work area before grading or excavation begins.', href: '/contact', icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M3 20 9 8l4 6 2-3 6 9H3Z" />' },
  { title: 'Trenching for Underground Work', description: 'Water lines, conduit, irrigation, and drainage may need a trench. The size and depth depend on the work that will be installed below ground.', href: '/contact', icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M9 3 5 21M15 3l4 18M12 8v2.5m0 4v2.5" />' },
  { title: 'Drainage Excavation', description: 'Water that collects where it should not may need excavation for channels or trenches to move it across or away from the problem area.', href: '/contact', icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M12 3s6 7 6 11a6 6 0 1 1-12 0c0-4 6-11 6-11Z" />' },
  { title: 'Septic-Related Excavation', description: 'Some Springfield properties rely on septic systems. Septic projects may require excavation for parts of the system. Design and approval are handled separately.', href: '/contact', icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M6 7c0-1.7 2.7-3 6-3s6 1.3 6 3v10c0 1.7-2.7 3-6 3s-6-1.3-6-3V7Z M6 7c0 1.7 2.7 3 6 3s6-1.3 6-3" />' },
];

const whenCards = [
  { title: 'Before Construction Begins', description: 'A building site may need clearing, grading, or excavation before any other work can start. The scope depends on what the property currently looks like.', href: '/contact', linkLabel: 'Get an Estimate' },
  { title: 'When the Ground Needs Reshaping', description: 'If an area is uneven, too high, or too low for the planned use, grading or excavation can reshape it to fit the project.', href: '/contact', linkLabel: 'Get an Estimate' },
  { title: 'When Water Is Collecting', description: 'Standing water around a home, driveway, or yard is often a drainage problem. Excavation can create a path to move water where it needs to go.', href: '/contact', linkLabel: 'Get an Estimate' },
  { title: 'Before Underground Work', description: 'Utility lines, irrigation, and drainage systems need a trench. The trench is sized and placed based on what will be installed and where.', href: '/contact', linkLabel: 'Get an Estimate' },
  { title: 'For Septic Projects', description: 'New septic systems and repairs may require excavation. D&D Land Works handles the digging connected with applicable septic work.', href: '/contact', linkLabel: 'Get an Estimate' },
  { title: 'When the Driveway Needs Work', description: 'Gravel driveways develop ruts, washouts, and uneven areas. Grading and excavation can reshape the ground and restore the surface.', href: '/contact', linkLabel: 'Get an Estimate' },
];

const whyItems = [
  { title: 'Headquartered in Springfield', description: 'D&D Land Works is based at 2741 33rd St., Springfield, Oregon. Springfield is home base — not just a name on a service-area list.', icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M5 21V7l7-4 7 4v14M3 21h18M9 21v-4h6v4" />' },
  { title: 'Licensed and Bonded', description: 'D&D Land Works is licensed and bonded in Oregon under CCB #261742. You can verify the license through the Oregon Construction Contractors Board before hiring.', icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M12 3l8 3v5c0 5.25-3.5 10.15-8 11.5C7.5 21.15 4 16.25 4 11V6l8-3Z" />', link: { label: 'Verify CCB License →', href: 'https://search.ccb.state.or.us/search/' } },
  { title: 'DEQ Certified for Septic Work', description: 'D&D Land Works is DEQ certified for applicable septic installation and repair, including excavation associated with septic projects in Springfield and Lane County.', icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M6 7c0-1.7 2.7-3 6-3s6 1.3 6 3v10c0 1.7-2.7 3-6 3s-6-1.3-6-3V7Z M6 7c0 1.7 2.7 3 6 3s6-1.3 6-3" />' },
  { title: 'Free Estimates', description: 'We provide free estimates for excavation and site preparation projects in Springfield. David walks the property in person before quoting — pricing reflects actual site conditions.', icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M9 3h6a1 1 0 0 1 1 1v1H8V4a1 1 0 0 1 1-1Z M7 6h10v14a1 1 0 0 1-1 1H8a1 1 0 0 1-1-1V6Z M9 12.5l2 2 4-4.5" />' },
  { title: 'No Fixed Timeline — Real Scope', description: 'We do not promise the same timeline for every job. Size, ground conditions, access, weather, and the amount of work can all affect the schedule on a Springfield property.', icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />' },
];

const faqs = [
  { question: 'What does an excavation contractor do?', answer: 'An excavation contractor digs, removes, moves, and shapes ground for projects such as building sites, drainage, utilities, septic work, and other property improvements.' },
  { question: 'Do you provide excavation in Springfield?', answer: 'Yes. D&D Land Works is headquartered in Springfield and provides excavation and related site work for local properties.' },
  { question: 'Do you do site preparation?', answer: 'Yes. Site preparation may include clearing, grading, leveling, and excavation needed to prepare a property for the next stage of work.' },
  { question: 'Can you grade my property?', answer: 'Grading can shape or level ground. The work depends on the property\'s existing grade and what you need the ground to do.' },
  { question: 'Do you provide land clearing?', answer: 'Yes. Land clearing can remove brush, trees, vegetation, and debris where clearing is part of the project.' },
  { question: 'Can you help with drainage excavation?', answer: 'Yes. Drainage work may require excavation for trenches, channels, or other areas used to move water.' },
  { question: 'Can you excavate for septic work?', answer: 'D&D Land Works handles excavation connected with applicable septic projects. Septic design and approval are separate parts of the project.' },
  { question: 'Do you provide trenching?', answer: 'Yes. Trenching can be used for utilities, irrigation, drainage, and other underground work where excavation is needed.' },
  { question: 'Can you grade a driveway?', answer: 'Driveway work may include grading or excavation to reshape the ground or correct problem areas.' },
  { question: 'What affects excavation cost?', answer: 'Cost can depend on project size, digging, ground conditions, slope, access, clearing, material movement, drainage needs, septic-related excavation, driveway work, and overall site complexity.' },
  { question: 'How long does excavation take?', answer: 'There is no fixed timeline for every project. Size, ground conditions, access, weather, clearing, utilities, and the amount of work can all affect the schedule.' },
  { question: 'Do you provide free estimates?', answer: 'Yes. D&D Land Works provides free estimates for applicable excavation and site work projects.' },
  { question: 'Where is D&D Land Works based?', answer: 'D&D Land Works is headquartered in Springfield, Oregon, at 2741 33rd St.' },
];

const serviceSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'GeneralContractor',
      '@id': 'https://www.ddlandworks.com/#business',
      name: 'D&D Land Works',
      url: 'https://www.ddlandworks.com/',
      telephone: '+15414018726',
      email: 'david@ddlandworks.com',
      priceRange: '$$',
      areaServed: [
        { '@type': 'City', name: 'Springfield', sameAs: 'https://www.wikidata.org/wiki/Q49431' },
        { '@type': 'AdministrativeArea', name: 'Lane County, Oregon' },
      ],
      hasCredential: [
        { '@type': 'EducationalOccupationalCredential', credentialCategory: 'License', name: 'Oregon CCB License #261742' },
        { '@type': 'EducationalOccupationalCredential', credentialCategory: 'Certification', name: 'Oregon DEQ Certification — Septic Install & Repair' },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.question,
        acceptedAnswer: { '@type': 'Answer', text: faq.answer },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.ddlandworks.com/' },
        { '@type': 'ListItem', position: 2, name: 'Service Areas', item: 'https://www.ddlandworks.com/service-area/' },
        { '@type': 'ListItem', position: 3, name: 'Springfield', item: 'https://www.ddlandworks.com/locations/springfield/' },
      ],
    },
  ],
};
---

<BaseLayout
  title="Excavation Contractor in Springfield, Oregon | D&D Land Works"
  description="D&D Land Works is headquartered in Springfield, OR. Excavation, grading, site prep, drainage, trenching, land clearing, and septic-related excavation. CCB #261742. Free estimates — call 541-401-8726."
>

  <Hero
    eyebrow="Excavation Contractor in Springfield, Oregon"
    headline="Excavation Contractor in Springfield, Oregon"
    subheadline="D&D Land Works is based right here in Springfield. David Deggelman works with Springfield property owners on excavation and related site work. We look at what your property needs and plan the work around the ground, access, and the project."
    primaryCta={{ label: 'Call 541-401-8726', href: 'tel:5414018726' }}
    secondaryCta={{ label: 'Free Estimate', href: '/contact' }}
  />

  <!-- What Is Excavation Contracting -->
  <section class="relative bg-white overflow-hidden">
    <div class="pointer-events-none absolute -right-32 -top-16 h-96 w-96 rounded-full bg-brand-blue-light/40 blur-3xl" aria-hidden="true"></div>
    <div class="mx-auto max-w-6xl px-4 py-20 md:py-32">
      <div class="grid gap-12 lg:gap-20 lg:grid-cols-2 lg:items-center">
        <div>
          <div class="mb-4 flex items-center gap-2">
            <img src="/logo.png" alt="" class="h-6 w-auto" aria-hidden="true" />
            <p class="font-display font-semibold uppercase tracking-widest text-sm text-brand-blue">
              Local Excavation Work in Springfield
            </p>
          </div>
          <h2 class="font-display font-black uppercase tracking-tight text-3xl text-ink md:text-4xl">
            Local Excavation Work in Springfield
          </h2>
          <div class="mt-5 flex flex-col gap-4 text-slate-700 leading-relaxed">
            <p>D&D Land Works is headquartered in Springfield, Oregon. That means Springfield is not just a service-area name on a page — it is home base for the business.</p>
            <p>David works with local property owners on the ground work their property needs. One Springfield property may need a building area prepared. Another may need grading, clearing, a trench, drainage excavation, or driveway work.</p>
            <p>Existing homes, outbuildings, driveways, slopes, drainage paths, and underground utilities can all affect how work is done. We look at those conditions before the work is planned.</p>
          </div>
          <a href="/contact" class="btn-pill mt-8 inline-flex">
            Talk About Your Property
            <span class="btn-pill-icon">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M17 7H7M17 7V17" />
              </svg>
            </span>
          </a>
        </div>
        <div class="relative pb-6">
          <img
            src="/project-excavation-bucket.webp"
            alt="D&D Land Works excavation contractor working in Springfield, Oregon"
            class="w-full rounded-(--radius-brand-card) object-cover aspect-4/3 shadow-xl"
            loading="lazy"
          />
          <div class="absolute bottom-10 left-4 sm:left-6 flex items-center gap-3 rounded-(--radius-brand-card) bg-brand-blue px-4 py-3 text-white shadow-lg">
            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-white/15">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 3l8 3v5c0 5.25-3.5 10.15-8 11.5C7.5 21.15 4 16.25 4 11V6l8-3Z" />
              </svg>
            </span>
            <div class="leading-tight">
              <p class="font-display font-bold text-sm">CCB #261742</p>
              <p class="font-body text-xs text-white/80">Licensed &amp; Bonded</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- What kind of excavation work -->
  <section class="relative">
    <div class="relative bg-ink overflow-hidden">
      <img src="/project-site-excavation.webp" alt="" aria-hidden="true" class="absolute inset-0 h-full w-full object-cover opacity-45" loading="lazy" />
      <div class="absolute inset-0 bg-linear-to-b from-ink/80 via-ink/70 to-ink"></div>
      <div class="relative mx-auto max-w-3xl px-4 pt-20 pb-40 text-center md:pt-28 md:pb-52">
        <p class="font-display font-semibold uppercase tracking-widest text-sm text-brand-blue-light">Springfield Properties</p>
        <h2 class="mt-2 font-display font-black uppercase tracking-tight text-3xl text-white md:text-5xl">
          What Kind of Excavation Work Do You Need?
        </h2>
        <p class="mt-5 text-slate-300 leading-relaxed">
          If you own property in Springfield, you may already know the problem but not the name of the work you need. The type of work depends on what is happening on your property.
        </p>
      </div>
    </div>
    <div class="relative mx-auto max-w-6xl px-4 -mt-32 pb-6 md:-mt-40">
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {excavationTypes.map((item) => <ServiceCard {...item} />)}
      </div>
    </div>
    <div class="mx-auto max-w-3xl px-4 pt-4 pb-20 md:pb-24 text-center flex flex-wrap justify-center gap-4">
      <a href="/contact" class="btn btn-cta inline-flex">Talk Through Your Project</a>
      <a href="/contact" class="btn btn-outline inline-flex">Request a Free Estimate</a>
    </div>
  </section>

  <!-- When does your property need excavation -->
  <section class="bg-slate-50 border-y border-slate-200">
    <div class="mx-auto max-w-6xl px-4 py-20 md:py-28">
      <div class="mb-12 md:mb-14 text-center">
        <p class="font-display font-semibold uppercase tracking-widest text-sm text-brand-blue">Springfield Excavation</p>
        <h2 class="mt-2 font-display font-black uppercase tracking-tight text-3xl text-ink md:text-4xl">
          When Does a Springfield Property Need Excavation?
        </h2>
        <p class="mt-4 text-slate-700 max-w-2xl mx-auto leading-relaxed">
          You may need excavation when the existing ground does not fit the work you want to do. The reason depends on the property and what you are trying to build, fix, or improve.
        </p>
      </div>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {whenCards.map((card) => (
          <div class="card flex flex-col gap-3">
            <h3 class="font-display font-bold uppercase tracking-wide text-base text-ink">{card.title}</h3>
            <p class="text-sm text-slate-600 leading-relaxed flex-1">{card.description}</p>
            <a href={card.href} class="inline-flex items-center gap-1 text-sm font-semibold text-brand-blue hover:underline">
              {card.linkLabel}
              <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M17 7H7M17 7V17" />
              </svg>
            </a>
          </div>
        ))}
      </div>
      <div class="mt-12 text-center">
        <a href="/contact" class="btn-pill inline-flex">
          Talk About Your Property
          <span class="btn-pill-icon">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M17 7H7M17 7V17" />
            </svg>
          </span>
        </a>
      </div>
    </div>
  </section>

  <!-- How it gets started — process steps -->
  <section class="relative bg-ink text-white overflow-hidden">
    <div class="pointer-events-none absolute right-0 top-0 h-[480px] w-[480px] rounded-full bg-brand-blue/10 blur-3xl" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-6xl px-4 py-20 md:py-28">
      <div class="mb-12 md:mb-16 text-center">
        <p class="font-display font-semibold uppercase tracking-widest text-sm text-brand-blue-light">Getting Started</p>
        <h2 class="mt-2 font-display font-bold uppercase tracking-tight text-3xl text-white md:text-4xl">
          How Your Springfield Excavation Project Gets Started
        </h2>
        <p class="mt-4 text-slate-300 max-w-2xl mx-auto leading-relaxed">
          You do not need to know the exact name of the excavation service before you call. Start by explaining what you are trying to do and what is happening on your property.
        </p>
      </div>
      <div class="grid gap-4 sm:grid-cols-2 sm:gap-6">
        {[
          { step: '1', title: 'Tell Us What You Need', detail: 'Tell us what you want to build, repair, clear, dig, or change on your Springfield property.' },
          { step: '2', title: 'Discuss the Property', detail: 'We can talk about where the work is, what the property looks like, access, slope, drainage, existing structures, and utilities that may affect the job.' },
          { step: '3', title: 'Understand the Scope', detail: 'Once the property and project are understood, the required excavation or related site work can be discussed in plain terms.' },
          { step: '4', title: 'Get an Estimate', detail: 'D&D Land Works provides free estimates for applicable excavation and site work projects in Springfield and Lane County.' },
        ].map((item) => (
          <div class="rounded-(--radius-brand-card) bg-white/5 border border-white/10 p-6 sm:p-7">
            <span class="flex h-10 w-10 items-center justify-center rounded-full bg-safety-orange font-display font-bold text-white text-sm">
              {item.step}
            </span>
            <p class="mt-4 font-display font-bold uppercase tracking-wide text-sm text-white">{item.title}</p>
            <p class="mt-2 text-sm text-slate-300 leading-relaxed">{item.detail}</p>
          </div>
        ))}
      </div>
      <div class="mt-10 flex flex-wrap justify-center gap-4">
        <a href="/contact" class="btn btn-cta">Get a Free Estimate</a>
        <a href="tel:5414018726" class="btn btn-outline border-white/30 text-white hover:bg-white/10">Call 541-401-8726</a>
      </div>
    </div>
  </section>

  <!-- What can D&D help with -->
  <section class="bg-white border-b border-slate-100">
    <div class="mx-auto max-w-6xl px-4 py-20 md:py-28">
      <div class="grid gap-12 lg:gap-20 lg:grid-cols-2 lg:items-center">
        <div>
          <p class="font-display font-semibold uppercase tracking-widest text-sm text-brand-blue mb-4">Excavation Services</p>
          <h2 class="font-display font-black uppercase tracking-tight text-3xl text-ink md:text-4xl">
            What Can D&D Land Works Help With?
          </h2>
          <p class="mt-5 text-slate-600 leading-relaxed">
            D&D Land Works handles excavation and related site work for property owners in and around Springfield. We focus on the excavation and site work the project calls for.
          </p>
          <ul class="mt-10 flex flex-col gap-7">
            {whyItems.map((item) => (
              <li class="flex items-start gap-4">
                <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-brand-blue-light text-brand-blue mt-0.5">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" set:html={item.icon} />
                </span>
                <div>
                  <p class="font-display font-bold text-ink">{item.title}</p>
                  <p class="mt-1 text-sm text-slate-600 leading-relaxed">{item.description}</p>
                  {item.link && (
                    <a href={item.link.href} target="_blank" rel="noopener noreferrer" class="mt-1 inline-block text-sm font-semibold text-brand-blue hover:underline">
                      {item.link.label}
                    </a>
                  )}
                </div>
              </li>
            ))}
          </ul>
          <a href="/contact" class="btn-pill mt-10 inline-flex">
            Talk About Your Property
            <span class="btn-pill-icon">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M17 7H7M17 7V17" />
              </svg>
            </span>
          </a>
        </div>
        <div class="relative">
          <img
            src="/project-grading-driveway.webp"
            alt="D&D Land Works excavation and site work in Springfield, Oregon"
            class="w-full rounded-(--radius-brand-card) object-cover aspect-3/4 shadow-xl"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Service Areas -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-6xl px-4 py-20 md:py-28">
      <div class="mb-12 md:mb-14 text-center">
        <p class="font-display font-semibold uppercase tracking-widest text-sm text-brand-blue">Serving Local Properties</p>
        <h2 class="mt-2 font-display font-black uppercase tracking-tight text-3xl text-ink md:text-5xl">
          Excavation in Springfield and Lane County
        </h2>
        <div class="mt-5 text-slate-600 max-w-2xl mx-auto leading-relaxed flex flex-col gap-3">
          <p>D&D Land Works is headquartered in Springfield and works with property owners in Springfield and surrounding Lane County communities.</p>
          <p>Springfield remains our home base. If your property is outside Springfield, you can still contact us and explain what you need. We can discuss the project and whether it fits our service area.</p>
        </div>
      </div>
      <div class="grid gap-6 lg:grid-cols-2 lg:gap-8 items-stretch">
        <div class="overflow-hidden rounded-(--radius-brand-card) bg-ink shadow-lg">
          <a href="/locations/springfield" class="flex items-center gap-3 bg-brand-blue px-6 py-4 text-white transition-opacity hover:opacity-90">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 21c4.4-3.4 7-7 7-10.5A7 7 0 0 0 5 10.5C5 14 7.6 17.6 12 21Z" />
              <circle cx="12" cy="10.5" r="2" fill="currentColor" stroke="none" />
            </svg>
            <span class="font-display font-bold uppercase tracking-wide text-sm">Springfield, OR</span>
          </a>
          {[
            { label: 'Eugene', href: '/locations/eugene' },
            { label: 'Cottage Grove', href: '/locations/cottage-grove' },
            { label: 'Junction City', href: '/locations/junction-city' },
            { label: 'Creswell', href: '/locations/creswell' },
            { label: 'Veneta', href: '/locations/veneta' },
            { label: 'Florence', href: '/locations/florence' },
            { label: 'Oakridge', href: '/locations/oakridge' },
            { label: 'Coburg', href: '/locations/coburg' },
            { label: 'Lowell', href: '/excavation-contractor-lowell-oregon' },
          ].map((area) => (
            <a href={area.href} class="flex items-center gap-3 border-t border-white/10 px-6 py-4 text-white/70 transition-colors hover:bg-white/5 hover:text-white">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0 text-white/40" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 21c4.4-3.4 7-7 7-10.5A7 7 0 0 0 5 10.5C5 14 7.6 17.6 12 21Z" />
                <circle cx="12" cy="10.5" r="2" fill="currentColor" stroke="none" />
              </svg>
              <span class="font-display font-bold uppercase tracking-wide text-sm">{area.label}, OR</span>
            </a>
          ))}
        </div>

---
import LocationPageTemplate from '../layouts/LocationPageTemplate.astro';

const factsBar = [
  { label: 'Based in', value: 'Springfield, OR' },
  { label: 'Serving', value: 'Corvallis — call to confirm' },
  { label: 'Licensed & bonded', value: 'CCB #261742' },
  { label: 'Septic work', value: 'Coming soon' },
];

const services = [
  { num: '01', title: 'Site Preparation', desc: 'Getting the ground ready for the next part of a project. May include clearing, digging, grading, or moving soil before work can begin.', href: '/site-preparation-contractor-eugene-or' },
  { num: '02', title: 'Land Grading', desc: 'Changing the shape and slope of the ground for a building area, driveway, drainage, or other planned use.', href: '/land-grading-services-eugene-or' },
  { num: '03', title: 'Land Clearing', desc: 'Removing brush, trees, debris, and overgrown areas from a property before excavation or other site work can begin.', href: '/land-clearing-services-eugene-or' },
  { num: '04', title: 'Trenching', desc: 'Digging a narrow path for underground lines, drainage, or other planned work. Depth, route, and purpose affect the excavation scope.', href: '/trenching-services-eugene-or' },
  { num: '05', title: 'Drainage Work', desc: 'When water collects where it should not, excavation or grading may create a better path for it to move.', href: '/drainage-installation-eugene-or' },
  { num: '06', title: 'Residential Excavation', desc: 'Excavation can be part of many home property projects — building prep, grading, trenching, drainage, or other site work.', href: '/excavation-contractor-eugene-or' },
];

const checklistItems = [
  { title: 'Before construction begins', desc: 'A building site may need clearing, grading or excavation before any other work can start.', href: '/contact' },
  { title: 'When the ground is uneven', desc: 'Areas that are too high, too low or uneven for the planned use get regraded to fit the project.', href: '/contact' },
  { title: 'When water is collecting', desc: 'Standing water around home, driveway or yard is often a drainage issue. Excavation may create a path to move water.', href: '/contact' },
  { title: 'When land needs clearing', desc: 'Brush, trees and overgrowth need to be removed before excavation or grading can begin.', href: '/contact' },
  { title: 'When trenching is needed', desc: 'If your project requires a path below ground for utilities, drainage, or other purposes, trenching is the excavation type used.', href: '/contact' },
  { title: 'For a residential property project', desc: 'Home properties can need excavation for many reasons — access, drainage, building prep, or other site work.', href: '/contact' },
];

const processSteps = [
  { num: '1', title: 'Tell us what you need', desc: 'What you want to build, repair, clear or dig on your Corvallis-area property.' },
  { num: '2', title: 'Confirm service area', desc: 'D&D Land Works is based in Springfield, not Corvallis. Call with your property location to confirm whether the project fits.' },
  { num: '3', title: 'Understand the scope', desc: 'The excavation and site work explained in plain terms once coverage is confirmed.' },
  { num: '4', title: 'Get your estimate', desc: 'A free estimate once the property and project are understood.', dark: true },
];

const bentoFeatures = [
  { title: 'Call to confirm', desc: 'D&D Land Works is based in Springfield. Call 541-401-8726 with your Corvallis-area property location to confirm service coverage before scheduling.', dark: false },
  { title: 'Foundation excavation', desc: 'New homes, ADUs and commercial builds. One crew for clearing, grading and the foundation once coverage is confirmed.', dark: true },
  { title: 'Utility & trench work', desc: 'Water service, sewer lateral, conduit and drains, with 811 locates on every trench job.', dark: true },
  { title: 'DEQ septic — coming soon', desc: 'Tank, distribution box and drainfield excavation for applicable properties in the service area.', dark: false },
];

const areaLinks = [
  { label: 'Albany', href: '/excavation-contractor-albany-or' },
  { label: 'Eugene', href: '/excavation-contractor-eugene-or' },
  { label: 'Springfield', href: '/excavation-contractor-springfield-or' },
  { label: 'Junction City', href: '/excavation-contractor-junction-city-or' },
  { label: 'Coburg', href: '/excavation-contractor-coburg-or' },
  { label: 'Cottage Grove', href: '/excavation-contractor-cottage-grove-or' },
  { label: 'Creswell', href: '/excavation-contractor-creswell-or' },
  { label: 'Florence', href: '/excavation-contractor-florence-or' },
];

const faqs = [
  { question: 'Do you serve the Corvallis area?', answer: 'D&D Land Works is based in Springfield, Oregon. If your property is near Corvallis, call 541-401-8726 with the project location so we can confirm whether it fits the current service area.' },
  { question: 'What does an excavation contractor do?', answer: 'An excavation contractor digs, moves, and shapes soil to prepare a property for a project. The work may include site preparation, grading, clearing, trenching, drainage work, and other excavation tasks.' },
  { question: 'Can you prepare my property near Corvallis?', answer: 'Site preparation may include clearing, digging, grading, or moving soil, depending on the property. Call to discuss the project and confirm whether your location is within the service area.' },
  { question: 'Do you provide free estimates?', answer: 'Yes. D&D Land Works provides free estimates for applicable excavation and site work projects where the property is within the service area.' },
  { question: 'What affects excavation cost near Corvallis?', answer: 'Size, depth, ground conditions, access, clearing, grading, drainage, material movement, and project complexity can all affect cost.' },
];

const relatedServices = [
  { title: 'Site Preparation', desc: 'Clearing, grading and compaction for raw lots.', href: '/site-preparation-contractor-eugene-or' },
  { title: 'Grading & Leveling', desc: 'The right slope for drainage and a level pad.', href: '/land-grading-services-eugene-or' },
  { title: 'Foundation Excavation', desc: 'Footprints, footings, crawl spaces and basements.', href: '/foundation-excavation-eugene-or' },
  { title: 'Drainage Excavation', desc: 'French drains, swales and catch basins.', href: '/drainage-installation-eugene-or' },
];

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'GeneralContractor',
      '@id': 'https://www.ddlandworks.com/#business',
      name: 'D&D Land Works',
      url: 'https://www.ddlandworks.com/',
      telephone: '+15414018726',
      email: 'david@ddlandworks.com',
      priceRange: '$$',
      areaServed: [
        { '@type': 'City', name: 'Corvallis', sameAs: 'https://www.wikidata.org/wiki/Q188748' },
        { '@type': 'AdministrativeArea', name: 'Lane County, Oregon' },
      ],
      hasCredential: [
        { '@type': 'EducationalOccupationalCredential', credentialCategory: 'License', name: 'Oregon CCB License #261742' },
        
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.question,
        acceptedAnswer: { '@type': 'Answer', text: faq.answer },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.ddlandworks.com/' },
        { '@type': 'ListItem', position: 2, name: 'Service Areas', item: 'https://www.ddlandworks.com/service-area/' },
        { '@type': 'ListItem', position: 3, name: 'Corvallis Area', item: 'https://www.ddlandworks.com/excavation-contractor-corvallis-or/' },
      ],
    },
  ],
};
---

<LocationPageTemplate
  pageTitle="Excavation Contractor near Corvallis, OR | D&D Land Works"
  pageDescription="D&D Land Works provides excavation, land clearing, grading, trenching, and drainage work near Corvallis, OR. Based in Springfield, call to confirm service area. CCB #261742. Free estimates, 541-401-8726."
  schema={schema}
  cityState="Corvallis, Oregon"
  heroH1Light="Excavation contractor"
  heroH1Bold="near Corvallis, Oregon"
  heroSub="D&D Land Works provides excavation and related site work for property projects. If your property is in or near the Corvallis area, call to discuss the work you need and confirm whether it fits the current service area."
  heroImage="/service-site-preparation.webp"
  factsBar={factsBar}
  breadcrumbLabel="Corvallis"
  introEyebrow="Excavation work near Corvallis"
  introH2Light="Excavation and site work"
  introH2Bold="near Corvallis, Oregon"
  davidQuote="I walk every site in person before I quote it."
  introPara1="Excavation means digging and moving earth to prepare a property for the next part of a project. You may need it before building, to shape land, clear an area, improve drainage, or run a trench for underground work."
  introPara2="D&D Land Works is based in Springfield. Call to confirm whether your Corvallis-area property is within the current service area before planning work. Free estimates provided for confirmed locations."
  introImage="/project-excavation-bucket.webp"
  servicesEyebrow="Our services"
  servicesH2Light="What does excavation"
  servicesH2Bold="include near Corvallis?"
  servicesDesc="Once service area is confirmed, the scope depends on your ground conditions, project type, and what the property requires."
  services={services}
  whenEyebrow="Corvallis-area excavation"
  whenH2Light="When does your"
  whenH2Bold="property need it?"
  whenDesc="Check off what sounds like your property. If any of these fit, call to confirm coverage first, then get a free site walk."
  checklistItems={checklistItems}
  processEyebrow="Getting started"
  processH2Light="How a Corvallis-area"
  processH2Bold="project gets started"
  processDesc="The first step is always a call to confirm your property fits the current service area. Free estimates follow for confirmed locations."
  processSteps={processSteps}
  whyH2Light="Why property owners"
  whyH2Bold="call D&D Land Works"
  bentoImage="/project-grading-driveway.webp"
  bentoImageAlt="Grading and excavation work on a Willamette Valley property"
  bentoFeatures={bentoFeatures}
  areaEyebrow="Our service area"
  areaH2Light="Excavation near Corvallis"
  areaH2Bold="and surrounding areas"
  areaDesc="Based in Springfield. Corvallis coverage is confirmed case by case. Other areas served regularly:"
  areaLinks={areaLinks}
  faqH2Light="Excavation near Corvallis:"
  faqH2Bold="common questions"
  faqs={faqs}
  relatedEyebrow="Related services"
  relatedServices={relatedServices}
  ctaEyebrow="Talk with David"
  ctaH2Light="Need excavation work"
  ctaH2Bold="near Corvallis?"
  ctaSub="Call first to confirm your property is within the current service area. Free estimates for confirmed locations, no obligation."
  ctaImage="/service-site-preparation.webp"
/>

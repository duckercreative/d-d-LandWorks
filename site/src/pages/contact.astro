---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact D&D Land Works | Free Estimates | Lane County, OR"
  description="Call or email D&D Land Works for a free excavation, grading, or septic estimate. Serving Eugene, Springfield, and Lane County, OR."
>

  <!-- Hero -->
  <section class="bg-slate-50 border-b border-slate-200 py-16 text-center px-4">
    <p class="font-display font-semibold uppercase tracking-widest text-sm text-brand-blue mb-3">Get in Touch</p>
    <h1 class="font-display font-black uppercase tracking-tight text-4xl text-ink md:text-5xl">
      Contact D&D Land Works
    </h1>
    <p class="mt-4 text-slate-600 max-w-xl mx-auto leading-relaxed">
      Have a project in mind? Need a free estimate? We're here to help, call, text, or fill out the form.
    </p>
  </section>

  <!-- Main content -->
  <section class="mx-auto max-w-6xl px-4 py-16 md:py-24">
    <div class="grid gap-12 lg:grid-cols-2 lg:gap-16 items-start">

      <!-- Form -->
      <div class="rounded-2xl border border-slate-200 bg-white p-8 shadow-sm">
        <h2 class="font-display font-bold uppercase tracking-wide text-xl text-ink mb-2">Send a Message</h2>
        <p class="text-slate-500 text-sm mb-8">Fill out the form and we'll get back to you as soon as possible.</p>

        <form
          action="https://formspree.io/f/david@ddlandworks.com"
          method="POST"
          class="flex flex-col gap-5"
        >
          <div>
            <label for="name" class="block text-sm font-semibold text-ink mb-1.5">Name <span class="text-red-500">*</span></label>
            <input
              type="text"
              id="name"
              name="name"
              required
              placeholder="Your full name"
              class="w-full rounded-lg border border-slate-300 px-4 py-3 text-sm text-ink placeholder:text-slate-400 focus:border-brand-blue focus:outline-none focus:ring-2 focus:ring-brand-blue/20 transition-colors"
            />
          </div>

          <div>
            <label for="phone" class="block text-sm font-semibold text-ink mb-1.5">Phone <span class="text-red-500">*</span></label>
            <input
              type="tel"
              id="phone"
              name="phone"
              required
              placeholder="Your phone number"
              class="w-full rounded-lg border border-slate-300 px-4 py-3 text-sm text-ink placeholder:text-slate-400 focus:border-brand-blue focus:outline-none focus:ring-2 focus:ring-brand-blue/20 transition-colors"
            />
          </div>

          <div>
            <label for="email" class="block text-sm font-semibold text-ink mb-1.5">Email <span class="text-red-500">*</span></label>
            <input
              type="email"
              id="email"
              name="email"
              required
              placeholder="your@email.com"
              class="w-full rounded-lg border border-slate-300 px-4 py-3 text-sm text-ink placeholder:text-slate-400 focus:border-brand-blue focus:outline-none focus:ring-2 focus:ring-brand-blue/20 transition-colors"
            />
          </div>

          <div>
            <label for="message" class="block text-sm font-semibold text-ink mb-1.5">Message <span class="text-red-500">*</span></label>
            <textarea
              id="message"
              name="message"
              required
              rows="5"
              placeholder="Describe your project, what do you need done and where?"
              class="w-full rounded-lg border border-slate-300 px-4 py-3 text-sm text-ink placeholder:text-slate-400 focus:border-brand-blue focus:outline-none focus:ring-2 focus:ring-brand-blue/20 transition-colors resize-none"
            ></textarea>
          </div>

          <button
            type="submit"
            class="w-full rounded-lg bg-brand-blue py-3.5 font-display font-bold uppercase tracking-wide text-sm text-white hover:bg-brand-blue-dark transition-colors"
          >
            Send Message
          </button>

          <p class="text-center text-xs text-slate-400">
            By submitting this form, you agree to be contacted by D&D Land Works regarding your inquiry.
          </p>
        </form>
      </div>

      <!-- Contact info -->
      <div class="flex flex-col gap-8">
        <div>
          <h2 class="font-display font-bold uppercase tracking-wide text-xl text-ink mb-2">Get in Touch</h2>
          <p class="text-slate-600 leading-relaxed">
            Whether you need excavation, land clearing, grading, drainage, or septic work, call us directly or fill out the form and we'll get back to you.
          </p>
        </div>

        <!-- Info cards -->
        <div class="flex flex-col gap-4">

          <div class="flex items-start gap-4 rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
            <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-brand-blue text-white">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.338c0-.53.313-.988.741-1.212l3.25-1.625a1.5 1.5 0 0 1 1.716.33l1.88 2.348a1.5 1.5 0 0 1-.255 2.118l-.931.7a10.507 10.507 0 0 0 4.388 4.387l.7-.931a1.5 1.5 0 0 1 2.118-.255l2.348 1.88a1.5 1.5 0 0 1 .33 1.716l-1.625 3.25a1.5 1.5 0 0 1-1.344.832C8.49 21.75 2.25 15.51 2.25 7.682a1.5 1.5 0 0 1 .832-1.344Z" />
              </svg>
            </span>
            <div>
              <p class="font-display font-bold text-ink">Phone</p>
              <a href="tel:5414018726" class="text-brand-blue font-semibold hover:underline">541-401-8726</a>
              <p class="text-sm text-slate-500 mt-0.5">Call or text, we'll call back if we miss you</p>
            </div>
          </div>

          <div class="flex items-start gap-4 rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
            <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-brand-blue text-white">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
              </svg>
            </span>
            <div>
              <p class="font-display font-bold text-ink">Hours</p>
              <p class="text-slate-700 font-semibold">Monday – Saturday</p>
              <p class="text-sm text-slate-500 mt-0.5">Site visits by appointment</p>
            </div>
          </div>

          <div class="flex items-start gap-4 rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
            <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-brand-blue text-white">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" />
              </svg>
            </span>
            <div>
              <p class="font-display font-bold text-ink">Service Area</p>
              <p class="text-brand-blue font-semibold">Eugene, Springfield & Lane County</p>
              <p class="text-sm text-slate-500 mt-0.5">
                <a href="/service-area" class="hover:underline">View full service area →</a>
              </p>
            </div>
          </div>

          <div class="flex items-start gap-4 rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
            <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-brand-blue text-white">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75" />
              </svg>
            </span>
            <div>
              <p class="font-display font-bold text-ink">Email</p>
              <a href="mailto:david@ddlandworks.com" class="text-brand-blue font-semibold hover:underline">david@ddlandworks.com</a>
              <p class="text-sm text-slate-500 mt-0.5">We respond within 24 hours</p>
            </div>
          </div>
        </div>

        <!-- CTA buttons -->
        <div class="flex flex-wrap gap-3">
          <a href="tel:5414018726" class="btn btn-cta flex-1 text-center justify-center">Call Now</a>
          <a href="mailto:david@ddlandworks.com" class="btn btn-outline flex-1 text-center justify-center">Send an Email</a>
        </div>
      </div>

    </div>
  </section>

</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ServiceCard from '../components/ServiceCard.astro';
import FAQ from '../components/FAQ.astro';
import CTABlock from '../components/CTABlock.astro';

const propertyFactors = [
  { title: 'Water Lines', description: 'A water line may need a trench from the water source to a home or building. A new home or rural property may need a longer water-line trench from the service point to the building.', href: '/contact', icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M12 3s6 7 6 11a6 6 0 1 1-12 0c0-4 6-11 6-11Z" />' },
  { title: 'Sewer Lines', description: 'A sewer line may cross part of the property. The route can depend on the building location, required grade, and where the sewer or septic system is located.', href: '/contact', icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M3 12h18M3 6h18M3 18h18" />' },
  { title: 'Electrical Conduit', description: 'If electrical service is being run underground, the conduit may need a planned trench from the service point to the building.', href: '/contact', icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />' },
  { title: 'Power Lines', description: 'Power lines may be placed underground when the project calls for it. The trench route and requirements depend on the specific property and utility plan.', href: '/contact', icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M9 3 5 21M15 3l4 18M12 8v2.5m0 4v2.5" />' },
  { title: 'Underground Utility Routes', description: 'A utility route may cross yards, driveways, or other parts of a property. Existing structures and underground lines can affect where excavation takes place.', href: '/contact', icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M3 17h4l4-9 4 5 3-4h3M17 6h3v3" />' },
  { title: 'Utility Excavation', description: 'D&D Land Works focuses on the excavation needed to create the utility trench. The utility provider or qualified professional handles work outside the excavation scope.', href: '/contact', icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m0 0-4-4m4 4 4-4M4 8h16" />' },
];

const faqs = [
  {
    question: 'How deep does a water service line need to be buried in Lane County, Oregon?',
    answer: 'Water service lines must be buried at least 24 inches below grade in Lane County — 12 inches below the local 12-inch frost depth, as required by Oregon Plumbing Specialty Code 609.1. Deeper burial may be required under driveways, parking areas, or where the inspector specifies additional depth.',
  },
  {
    question: 'How deep does a sewer lateral need to be buried?',
    answer: 'Sanitary sewer laterals need at least 12 inches of cover above the pipe in Lane County (OPSC 718.1). The pipe must also slope at least ¼ inch per foot toward the sewer main or septic tank to ensure gravity drainage. Inadequate slope is the most common cause of sewer lateral failure.',
  },
  {
    question: 'How deep does electrical conduit need to be buried in Oregon?',
    answer: 'In Oregon, PVC electrical conduit must be at least 18 inches deep in open ground and 24 inches deep under driveways or parking areas, per NEC Table 300.5 (adopted by Oregon\'s Electrical Specialty Code). Rigid metal conduit can be as shallow as 6 inches in both conditions. Direct-burial cable requires 24 inches.',
  },
  {
    question: 'How deep does a gas line need to be buried in Oregon?',
    answer: 'Standard residential gas piping must be at least 18 inches below grade in Oregon (Oregon Residential Specialty Code G2415.12). Lines feeding portable outdoor appliances — generators, outdoor heaters, BBQ drops — can be as shallow as 8 inches under ORSC G2415.12.1.',
  },
  {
    question: 'Can water, sewer, electrical, and gas go in the same trench?',
    answer: 'Yes — joint trenching is code-permitted in Lane County with modern pipe materials. The one key separation rule: where a water line crosses above a sewer line, the bottom of the water pipe must be at least 12 inches above the top of the sewer pipe (OPSC 720.1). Individual utility companies may have additional separation specifications beyond code minimums — confirm these when you initiate the service application.',
  },
  {
    question: 'Who is required to call Oregon 811 before utility trenching?',
    answer: 'Under ORS Chapter 757, both the property owner and the excavation contractor are legally required to notify Oregon 811 at least two business days before any digging begins. The service is free — call 811 or 1-800-332-2344, or submit at digsafelyoregon.com, 24/7. D&D calls Oregon 811 on every project.',
  },
];

const serviceSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'GeneralContractor',
      '@id': 'https://www.ddlandworks.com/#business',
      name: 'D&D Land Works',
      url: 'https://www.ddlandworks.com/',
      telephone: '+15414018726',
      email: 'david@ddlandworks.com',
      description: 'Full-service excavation, grading, and site preparation contractor serving Eugene, Springfield, and Lane County, Oregon. Licensed and bonded CCB #261742, DEQ Certified.',
      priceRange: '$$',
      areaServed: [
        { '@type': 'City', name: 'Eugene', sameAs: 'https://www.wikidata.org/wiki/Q49330' },
        { '@type': 'City', name: 'Springfield', sameAs: 'https://www.wikidata.org/wiki/Q49431' },
        { '@type': 'AdministrativeArea', name: 'Lane County, Oregon' },
      ],
      knowsAbout: ['Foundation Excavation', 'Land Clearing', 'Site Preparation', 'Grading', 'Septic Installation'],
      hasCredential: [
        { '@type': 'EducationalOccupationalCredential', credentialCategory: 'License', name: 'Oregon CCB License #261742' },
        { '@type': 'EducationalOccupationalCredential', credentialCategory: 'Certification', name: 'Oregon DEQ Certification — Septic Install & Repair' },
      ],
      sameAs: ['https://search.ccb.state.or.us/search/'],
    },
    {
      '@type': 'Service',
      '@id': 'https://www.ddlandworks.com/foundation-excavation-eugene-oregon/#service',
      name: 'Foundation Excavation Services in Eugene, Oregon',
      serviceType: 'Foundation Excavation',
      description: 'Foundation excavation for new home construction in Eugene and Lane County, Oregon. D&D Land Works excavates to the depth and dimensions your plans call for, with footing trenching, soil haul-off, and rough grading.',
      url: 'https://www.ddlandworks.com/foundation-excavation-eugene-oregon/',
      provider: { '@id': 'https://www.ddlandworks.com/#business' },
      areaServed: ['Eugene, Oregon', 'Springfield, Oregon', 'Lane County, Oregon'],
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.question,
        acceptedAnswer: { '@type': 'Answer', text: faq.answer },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.ddlandworks.com/' },
        { '@type': 'ListItem', position: 2, name: 'Foundation Excavation', item: 'https://www.ddlandworks.com/foundation-excavation-eugene-oregon/' },
      ],
    },
  ],
};
---

<BaseLayout
  title="Utility Trenching Services in Eugene, Oregon | D&D Land Works"
  description="Utility trenching in Eugene & Lane County, OR. Water, sewer, and power line trenching for new homes and buildings. Licensed and bonded CCB #261742. Free estimates — call 541-401-8726."
>
  <Hero
    eyebrow="Utility Trenching in Eugene, Oregon"
    headline="Utility Trenching Services in Eugene, Oregon"
    subheadline="Water, sewer, or power lines may need to cross your property before a new home or building can be used. D&D Land Works digs the utility trenches needed for these projects, based on your plans, site conditions, and access."
    primaryCta={{ label: 'Call 541-401-8726', href: 'tel:5414018726' }}
    secondaryCta={{ label: 'Free Estimate', href: '/contact' }}
  />

  <!-- Why Is Water Collecting -->
  <section class="relative bg-white overflow-hidden">
    <div
      class="pointer-events-none absolute -right-32 -top-16 h-96 w-96 rounded-full bg-brand-blue-light/40 blur-3xl"
      aria-hidden="true"
    ></div>
    <div class="mx-auto max-w-6xl px-4 py-20 md:py-32">
      <div class="grid gap-12 lg:gap-20 lg:grid-cols-2 lg:items-center">
        <!-- Text column -->
        <div>
          <div class="mb-4 flex items-center gap-2">
            <img src="/logo.png" alt="" class="h-6 w-auto" aria-hidden="true" />
            <p class="font-display font-semibold uppercase tracking-widest text-sm text-brand-blue">
              What Is Utility Trenching?
            </p>
          </div>
          <h2 class="font-display font-black uppercase tracking-tight text-3xl text-ink md:text-4xl">
            What Is Utility Trenching?
          </h2>
          <div class="mt-5 flex flex-col gap-4 text-slate-700 leading-relaxed">
            <p>Adding a water line, sewer line, or electrical conduit means creating a safe underground path for the utility. On Eugene-area properties, slope, wet ground, long utility runs, and site access can affect how that trench is approached. We look at the property and planned route before excavation begins.</p>
            <p>The trench follows a planned <strong>trench route</strong> based on the project requirements. Its depth and location can change with the utility type, soil, slope, wet ground, and site access. The excavation needs to follow the plans for the project.</p>
            <p>Once the utility work is ready, <strong>backfill</strong> may be used to fill the trench as part of the project. D&D Land Works handles the excavation side, while utility design, connections, and other specialized work may be handled by the proper utility professional.</p>
            <p>Trenching time depends on the length and depth of the excavation, soil, access, existing utilities, weather, and the overall project. Wet ground or difficult access can make the work take longer.</p>
          </div>
          <a href="/contact" class="btn-pill mt-8 inline-flex">
            Talk About Your Project
            <span class="btn-pill-icon">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M17 7H7M17 7V17" />
              </svg>
            </span>
          </a>
        </div>
        <!-- Image column -->
        <div class="relative pb-6">
          <img
            src="/before-lot.webp"
            alt="Foundation excavation site preparation in Lane County, Oregon"
            class="w-full rounded-(--radius-brand-card) object-cover aspect-4/3 shadow-xl"
            loading="lazy"
          />
          <div class="absolute bottom-10 left-4 sm:left-6 flex items-center gap-3 rounded-(--radius-brand-card) bg-brand-blue px-4 py-3 text-white shadow-lg">
            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-white/15">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 3l8 3v5c0 5.25-3.5 10.15-8 11.5C7.5 21.15 4 16.25 4 11V6l8-3Z" />
              </svg>
            </span>
            <div class="leading-tight">
              <p class="font-display font-bold text-sm">CCB #261742</p>
              <p class="font-body text-xs text-white/80">Licensed &amp; Bonded</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Before We Dig -->
  <section id="before-we-dig" class="relative">
    <div class="relative bg-ink overflow-hidden">
      <img src="/project-site-excavation.webp" alt="" aria-hidden="true" class="absolute inset-0 h-full w-full object-cover opacity-45" loading="lazy" />
      <div class="absolute inset-0 bg-linear-to-b from-ink/80 via-ink/70 to-ink"></div>
      <div class="relative mx-auto max-w-3xl px-4 pt-20 pb-40 text-center md:pt-28 md:pb-52">
        <p class="font-display font-semibold uppercase tracking-widest text-sm text-brand-blue-light">Underground Utilities</p>
        <h2 class="mt-2 font-display font-black uppercase tracking-tight text-3xl text-white md:text-5xl">
          What Kind of Utility Needs a Trench?
        </h2>
        <p class="mt-5 text-slate-300 leading-relaxed">
          Water, sewer, and electrical lines each have their own depth and route requirements. If your new water or power line needs a trench, the utility type and property conditions both affect how the excavation is planned.
        </p>
      </div>
    </div>
    <div class="relative mx-auto max-w-6xl px-4 -mt-32 pb-6 md:-mt-40">
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {propertyFactors.map((item) => <ServiceCard {...item} />)}
      </div>
    </div>
    <div class="mx-auto max-w-3xl px-4 pt-4 pb-20 md:pb-24 text-center flex flex-wrap justify-center gap-4">
      <a href="/contact" class="btn btn-cta inline-flex">Talk Through Your Project</a>
      <a href="/contact" class="btn btn-outline inline-flex">Request a Free Estimate</a>
    </div>
  </section>

  <!-- Finding the Right Way to Move Water -->
  <section class="bg-slate-50 border-y border-slate-200">
    <div class="mx-auto max-w-6xl px-4 py-20 md:py-28">
      <div class="mb-12 md:mb-14 text-center">
        <p class="font-display font-semibold uppercase tracking-widest text-sm text-brand-blue">Site Conditions</p>
        <h2 class="mt-2 font-display font-black uppercase tracking-tight text-3xl text-ink md:text-4xl">
          What Can Make Utility Trenching Harder?
        </h2>
        <p class="mt-4 text-slate-700 max-w-2xl mx-auto leading-relaxed">
          A utility trench can be simple on an open lot, but every property is different. Around Eugene and Lane County, rain, wet ground, slopes, driveways, and existing underground lines can change how the work is planned.
        </p>
      </div>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {[
          { title: 'Wet Ground', description: 'After heavy rain, some Eugene-area properties can have wet ground that makes equipment access harder. We look at the ground and site conditions before trenching so the work fits the actual property.', href: '/contact', linkLabel: 'Talk to David' },
          { title: 'Sloped Property', description: 'A sloped lot can make the utility route more involved. The trench still needs to follow the project requirements while working with the shape of the property.', href: '/contact', linkLabel: 'Talk to David' },
          { title: 'Driveway Crossings', description: 'If a utility line needs to cross a driveway, the excavation has to account for the existing surface and access to the property.', href: '/contact', linkLabel: 'Talk to David' },
          { title: 'Existing Utilities', description: 'Water, sewer, electric, or other underground lines may already be on the property. Their location needs to be considered before excavation begins.', href: '/contact', linkLabel: 'Talk to David' },
          { title: 'Long Utility Runs', description: 'On some rural Lane County properties, a new building may sit farther from existing services. A longer trench means more excavation, soil movement, and site access to consider.', href: '/contact', linkLabel: 'Talk to David' },
          { title: 'How D&D Approaches the Site', description: 'David looks at the property and the planned utility route before the digging starts. The goal is to understand the ground, access, and work area so the excavation fits the actual site.', href: '/contact', linkLabel: 'Talk to David' },
        ].map((card) => (
          <div class="card flex flex-col gap-3">
            <h3 class="font-display font-bold uppercase tracking-wide text-base text-ink">{card.title}</h3>
            <p class="text-sm text-slate-600 leading-relaxed flex-1">{card.description}</p>
            <a href={card.href} class="inline-flex items-center gap-1 text-sm font-semibold text-brand-blue hover:underline">
              {card.linkLabel}
              <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M17 7H7M17 7V17" />
              </svg>
            </a>
          </div>
        ))}
      </div>
      <div class="mt-12 text-center">
        <a href="/contact" class="btn-pill inline-flex">
          Talk About Your Property
          <span class="btn-pill-icon">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M17 7H7M17 7V17" />
            </svg>
          </span>
        </a>
      </div>
    </div>
  </section>

  <!-- Local Ground Conditions -->
  <section class="relative bg-ink text-white overflow-hidden">
    <div
      class="pointer-events-none absolute right-0 top-0 h-[480px] w-[480px] rounded-full bg-brand-blue/10 blur-3xl"
      aria-hidden="true"
    ></div>
    <div class="relative mx-auto max-w-6xl px-4 py-20 md:py-28">
      <div class="mb-12 md:mb-16 text-center">
        <p class="font-display font-semibold uppercase tracking-widest text-sm text-brand-blue-light">Sewer Line Trenching</p>
        <h2 class="mt-2 font-display font-bold uppercase tracking-tight text-3xl text-white md:text-4xl">
          What About Sewer Line Trenching in Eugene?
        </h2>
        <p class="mt-4 text-slate-300 max-w-2xl mx-auto leading-relaxed">
          Sewer trenching can be part of a new home or property project. The route, grade, soil, and final connection all affect how the excavation is planned.
        </p>
      </div>
      <div class="grid gap-4 sm:grid-cols-2 sm:gap-6">
        {[
          { title: 'Why a Sewer Trench Needs a Steady Slope', detail: 'A sewer line may need a planned slope so wastewater can move as intended. The required grade comes from the project plans and applicable requirements.' },
          { title: 'Sewer Lines to a Septic System', detail: 'On some Lane County properties, a sewer trench may run to a septic system rather than a public sewer connection. The route and depth depend on the system location and approved project requirements.' },
          { title: 'Sewer Trenching on Sloped Property', detail: 'A sloped property can change the trench route and excavation depth. Existing grades and project plans help determine how the trench is laid out.' },
          { title: 'What D&D Handles', detail: 'D&D Land Works handles the excavation for the planned sewer route. Plumbing, septic design, connections, and other specialized work may be handled separately.' },
        ].map((item) => (
          <div class="rounded-(--radius-brand-card) bg-white/5 border border-white/10 p-6 sm:p-7">
            <p class="font-display font-bold uppercase tracking-wide text-sm text-white">{item.title}</p>
            <p class="mt-3 text-sm text-slate-300 leading-relaxed">{item.detail}</p>
          </div>
        ))}
      </div>
      <div class="mt-10 flex flex-wrap justify-center gap-4">
        <a href="/contact" class="btn btn-cta">Get a Free Estimate</a>
        <a href="tel:5414018726" class="btn btn-outline border-white/30 text-white hover:bg-white/10">Call 541-401-8726</a>
      </div>
    </div>
  </section>

  <!-- Where the Water Goes -->
  <section class="bg-white border-b border-slate-100">
    <div class="mx-auto max-w-6xl px-4 py-20 md:py-28">
      <div class="grid gap-12 lg:gap-20 lg:grid-cols-2 lg:items-center">
        <div>
          <p class="font-display font-semibold uppercase tracking-widest text-sm text-brand-blue mb-4">After the Dig</p>
          <h2 class="font-display font-black uppercase tracking-tight text-3xl text-ink md:text-4xl">
            What Happens With the Soil After the Trench Is Dug?
          </h2>
          <p class="mt-5 text-slate-600 leading-relaxed">
            Digging a utility trench leaves soil beside the work area. What happens next depends on the trench, the soil, the project plans, and whether the material can be used again.
          </p>
          <ul class="mt-10 flex flex-col gap-7">
            {[
              { title: 'Moving the Excavated Soil', description: 'Digging creates soil that has to be managed during the project. The amount depends on the trench length, depth, and property.', icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M3 20 9 8l4 6 2-3 6 9H3Z" />' },
              { title: 'Backfilling', description: 'Once the trench work is ready for the next stage, the excavated area can be backfilled as required by the project.', icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m0 0-4-4m4 4 4-4M4 8h16" />' },
              { title: 'Finishing the Work Area', description: 'A yard, driveway, or access area may be disturbed during trenching. The amount of finishing work depends on what was excavated.', icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M3 12h18M3 6h18M3 18h18" />' },
            ].map((item) => (
              <li class="flex items-start gap-4">
                <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-brand-blue-light text-brand-blue mt-0.5">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" set:html={item.icon} />
                </span>
                <div>
                  <p class="font-display font-bold text-ink">{item.title}</p>
                  <p class="mt-1 text-sm text-slate-600 leading-relaxed">{item.description}</p>
                </div>
              </li>
            ))}
          </ul>
          <a href="/contact" class="btn-pill mt-10 inline-flex">
            Talk About Your Property
            <span class="btn-pill-icon">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M17 7H7M17 7V17" />
              </svg>
            </span>
          </a>
        </div>
        <div class="relative">
          <img
            src="/service-land-clearing.webp"
            alt="Utility trenching work on a Lane County, Oregon property"
            class="w-full rounded-(--radius-brand-card) object-cover aspect-3/4 shadow-xl"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Service Areas -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-6xl px-4 py-20 md:py-28">
      <div class="mb-12 md:mb-14 text-center">
        <p class="font-display font-semibold uppercase tracking-widest text-sm text-brand-blue">Serving Local Properties</p>
        <h2 class="mt-2 font-display font-black uppercase tracking-tight text-3xl text-ink md:text-5xl">
          Utility Trenching Around Eugene and Lane County
        </h2>
        <div class="mt-5 text-slate-600 max-w-2xl mx-auto leading-relaxed flex flex-col gap-3">
          <p>Properties around Eugene and Lane County can be very different. A new home in town, a sloped lot, or a rural property may each have different trenching needs. Long utility runs, wet ground, driveway crossings, and existing underground lines can all affect the work.</p>
          <p>Before excavation starts, David can look at the property and talk through the planned utility route with you. That gives you a clearer idea of what the excavation will involve before the work begins.</p>
        </div>
      </div>
      <div class="grid gap-6 lg:grid-cols-2 lg:gap-8 items-stretch">
        <div class="overflow-hidden rounded-(--radius-brand-card) bg-ink shadow-lg">
          <a href="/locations/eugene" class="flex items-center gap-3 bg-brand-blue px-6 py-4 text-white transition-opacity hover:opacity-90">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 21c4.4-3.4 7-7 7-10.5A7 7 0 0 0 5 10.5C5 14 7.6 17.6 12 21Z" />
              <circle cx="12" cy="10.5" r="2" fill="currentColor" stroke="none" />
            </svg>
            <span class="font-display font-bold uppercase tracking-wide text-sm">Eugene, OR</span>
          </a>
          {[
            { label: 'Springfield', href: '/locations/springfield' },
            { label: 'Cottage Grove', href: '/locations/cottage-grove' },
            { label: 'Junction City', href: '/locations/junction-city' },
            { label: 'Creswell', href: '/locations/creswell' },
            { label: 'Veneta', href: '/locations/veneta' },
            { label: 'Florence', href: '/locations/florence' },
            { label: 'Oakridge', href: '/locations/oakridge' },
            { label: 'Coburg', href: '/locations/coburg' },
            { label: 'Lowell', href: '/locations/lowell' },
          ].map((area) => (
            <a href={area.href} class="flex items-center gap-3 border-t border-white/10 px-6 py-4 text-white/70 transition-colors hover:bg-white/5 hover:text-white">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0 text-white/40" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 21c4.4-3.4 7-7 7-10.5A7 7 0 0 0 5 10.5C5 14 7.6 17.6 12 21Z" />
                <circle cx="12" cy="10.5" r="2" fill="currentColor" stroke="none" />
              </svg>
              <span class="font-display font-bold uppercase tracking-wide text-sm">{area.label}, OR</span>
            </a>
          ))}
        </div>
        <div class="overflow-hidden rounded-(--radius-brand-card) border border-slate-200 shadow-md min-h-[400px]">
          <iframe
            title="D&D Land Works service area map, Lane County, Oregon"

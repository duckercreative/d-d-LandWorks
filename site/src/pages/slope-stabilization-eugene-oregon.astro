---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ServiceCard from '../components/ServiceCard.astro';
import FAQ from '../components/FAQ.astro';
import CTABlock from '../components/CTABlock.astro';
import ProcessSteps from '../components/ProcessSteps.astro';

const propertyFactors = [
  { title: 'Erosion and Soil Loss', description: 'Rain can carry soil off a slope over time. When the same areas erode year after year, the ground can become unstable or develop gullies.', href: '/contact', icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M3 20 9 8l4 6 2-3 6 9H3Z" />' },
  { title: 'Runoff and Water Flow', description: 'Water running down a slope can concentrate and cut channels into the ground. Where runoff goes and how fast it moves affects how much erosion occurs.', href: '/contact', icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M12 3s6 7 6 11a6 6 0 1 1-12 0c0-4 6-11 6-11Z" />' },
  { title: 'Slope Angle and Shape', description: 'Steeper slopes tend to erode faster. The shape of a slope — whether it curves, has flat spots, or funnels water — affects where problems develop.', href: '/contact', icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M3 17h4l4-9 4 5 3-4h3M17 6h3v3" />' },
  { title: 'Soil Type and Stability', description: 'Some soils hold together better than others when wet. Clay soils can slide when saturated, while loose sandy soils may erode more easily under rain.', href: '/contact', icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M3 12h18M3 6h18M3 18h18" />' },
  { title: 'Vegetation and Ground Cover', description: 'Plant roots help hold soil in place. A slope that has been cleared or has lost its vegetation may be more vulnerable to erosion and movement.', href: '/contact', icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M9 3 5 21M15 3l4 18M12 8v2.5m0 4v2.5" />' },
  { title: 'Cuts and Fill Areas', description: 'Grading that cuts into a hillside or builds up a slope with fill material can create unstable conditions if the ground is not properly prepared and supported.', href: '/contact', icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m0 0-4-4m4 4 4-4M4 8h16" />' },
];

const faqs = [
  {
    question: 'How do you stabilize a slope in Oregon?',
    answer: 'Slope stabilization depends on the cause of the problem. It may involve regrading, improving drainage, adding retaining features, or addressing how water moves across the slope. We look at the site before recommending an approach.',
  },
  {
    question: 'What causes slope erosion in the Eugene area?',
    answer: 'Eugene and Lane County receive heavy rain through the wet season. Rain that runs off a slope can carry soil with it, especially on steeper grades or where vegetation has been removed. Soil type and how water is directed across the slope also play a role.',
  },
  {
    question: 'Can grading help with slope erosion?',
    answer: 'Regrading can help by changing the slope angle or redirecting how water flows across the surface. Whether grading is the right solution depends on the cause of the erosion and the condition of the ground.',
  },
  {
    question: 'Do I need a permit for slope work in Lane County?',
    answer: 'Permit requirements depend on the scope of the work, where the slope is located, and how much grading or soil disturbance is involved. Larger projects or work near waterways may require permits. Confirm requirements before work begins.',
  },
  {
    question: 'How much does slope stabilization cost in Eugene?',
    answer: 'Cost depends on the size of the slope, the cause of the problem, the ground conditions, and what work is needed. We can look at the property and provide a free estimate based on the actual site.',
  },
  {
    question: 'Can D&D Land Works help with drainage on a sloped property?',
    answer: 'Drainage and slope conditions are often related. We can look at how water is moving across the slope and discuss what excavation or grading work may help address the drainage problem.',
  },
];

const serviceSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'GeneralContractor',
      '@id': 'https://www.ddlandworks.com/#business',
      name: 'D&D Land Works',
      url: 'https://www.ddlandworks.com/',
      telephone: '+15414018726',
      email: 'david@ddlandworks.com',
      description: 'Full-service excavation, grading, and site preparation contractor serving Eugene, Springfield, and Lane County, Oregon. Licensed and bonded CCB #261742, DEQ Certified.',
      priceRange: '$$',
      areaServed: [
        { '@type': 'City', name: 'Eugene', sameAs: 'https://www.wikidata.org/wiki/Q49330' },
        { '@type': 'City', name: 'Springfield', sameAs: 'https://www.wikidata.org/wiki/Q49431' },
        { '@type': 'AdministrativeArea', name: 'Lane County, Oregon' },
      ],
      knowsAbout: ['Slope Stabilization', 'Erosion Control', 'Grading', 'Drainage', 'Site Preparation', 'Excavation'],
      hasCredential: [
        { '@type': 'EducationalOccupationalCredential', credentialCategory: 'License', name: 'Oregon CCB License #261742' },
        { '@type': 'EducationalOccupationalCredential', credentialCategory: 'Certification', name: 'Oregon DEQ Certification — Septic Install & Repair' },
      ],
      sameAs: ['https://search.ccb.state.or.us/search/'],
    },
    {
      '@type': 'Service',
      '@id': 'https://www.ddlandworks.com/slope-stabilization-eugene-oregon/#service',
      name: 'Slope Stabilization Services in Eugene, Oregon',
      serviceType: 'Slope Stabilization',
      description: 'Slope stabilization in Eugene, Oregon for erosion, runoff, and unstable ground. D&D Land Works can assess site conditions and discuss excavation and grading needs.',
      url: 'https://www.ddlandworks.com/slope-stabilization-eugene-oregon/',
      provider: { '@id': 'https://www.ddlandworks.com/#business' },
      areaServed: ['Eugene, Oregon', 'Springfield, Oregon', 'Lane County, Oregon'],
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.question,
        acceptedAnswer: { '@type': 'Answer', text: faq.answer },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.ddlandworks.com/' },
        { '@type': 'ListItem', position: 2, name: 'Slope Stabilization', item: 'https://www.ddlandworks.com/slope-stabilization-eugene-oregon/' },
      ],
    },
  ],
};
---

<BaseLayout
  title="Slope Stabilization in Eugene, Oregon | Erosion & Drainage"
  description="Slope stabilization in Eugene, Oregon for erosion, runoff, and unstable ground. D&D Land Works can assess site conditions and discuss excavation and grading needs."
>
  <Hero
    eyebrow="Slope Stabilization in Eugene, Oregon"
    headline="Slope Stabilization Services in Eugene, Oregon"
    subheadline="Eugene-area slopes deal with heavy rain, wet soil, and runoff that can cause erosion and ground movement. We look at the slope, soil, and water flow before discussing what grading or excavation work may help."
    primaryCta={{ label: 'Call 541-401-8726', href: 'tel:5414018726' }}
    secondaryCta={{ label: 'Free Estimate', href: '/contact' }}
  />

  <!-- What Is Slope Stabilization -->
  <section class="relative bg-white overflow-hidden">
    <div
      class="pointer-events-none absolute -right-32 -top-16 h-96 w-96 rounded-full bg-brand-blue-light/40 blur-3xl"
      aria-hidden="true"
    ></div>
    <div class="mx-auto max-w-6xl px-4 py-20 md:py-32">
      <div class="grid gap-12 lg:gap-20 lg:grid-cols-2 lg:items-center">
        <div>
          <div class="mb-4 flex items-center gap-2">
            <img src="/logo.png" alt="" class="h-6 w-auto" aria-hidden="true" />
            <p class="font-display font-semibold uppercase tracking-widest text-sm text-brand-blue">
              What Is Slope Stabilization?
            </p>
          </div>
          <h2 class="font-display font-black uppercase tracking-tight text-3xl text-ink md:text-4xl">
            What Is Slope Stabilization?
          </h2>
          <div class="mt-5 flex flex-col gap-4 text-slate-700 leading-relaxed">
            <p>Slope stabilization refers to work done to reduce erosion, limit soil movement, and improve the condition of a sloped area. The goal is to address what is causing the slope to erode or become unstable.</p>
            <p>On sloped properties in Lane County, heavy rain is often a factor. Water running down a slope can carry away soil and cut channels into the ground over time. The shape of the slope, soil type, and existing drainage all affect how serious the problem becomes.</p>
            <p>The right approach depends on what is causing the erosion and what the slope needs to be used for. We look at the site before discussing what grading, drainage, or excavation work may help.</p>
          </div>
          <a href="/contact" class="btn-pill mt-8 inline-flex">
            Talk About Your Property
            <span class="btn-pill-icon">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M17 7H7M17 7V17" />
              </svg>
            </span>
          </a>
        </div>
        <div class="relative pb-6">
          <img
            src="/before-lot.webp"
            alt="Sloped property with erosion in Lane County, Oregon"
            class="w-full rounded-(--radius-brand-card) object-cover aspect-4/3 shadow-xl"
            loading="lazy"
          />
          <div class="absolute bottom-10 left-4 sm:left-6 flex items-center gap-3 rounded-(--radius-brand-card) bg-brand-blue px-4 py-3 text-white shadow-lg">
            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-white/15">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 3l8 3v5c0 5.25-3.5 10.15-8 11.5C7.5 21.15 4 16.25 4 11V6l8-3Z" />
              </svg>
            </span>
            <div class="leading-tight">
              <p class="font-display font-bold text-sm">CCB #261742</p>
              <p class="font-body text-xs text-white/80">Licensed &amp; Bonded</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- What Causes Slope Problems -->
  <section class="relative">
    <div class="relative bg-ink overflow-hidden">
      <img src="/project-site-excavation.webp" alt="" aria-hidden="true" class="absolute inset-0 h-full w-full object-cover opacity-45" loading="lazy" />
      <div class="absolute inset-0 bg-linear-to-b from-ink/80 via-ink/70 to-ink"></div>
      <div class="relative mx-auto max-w-3xl px-4 pt-20 pb-40 text-center md:pt-28 md:pb-52">
        <p class="font-display font-semibold uppercase tracking-widest text-sm text-brand-blue-light">Slope Conditions</p>
        <h2 class="mt-2 font-display font-black uppercase tracking-tight text-3xl text-white md:text-5xl">
          What Causes Slope Erosion and Instability?
        </h2>
        <p class="mt-5 text-slate-300 leading-relaxed">
          Several factors affect how a slope holds up under rain and repeated wet seasons. Understanding what is happening on the slope helps determine what work may address the problem.
        </p>
      </div>
    </div>
    <div class="relative mx-auto max-w-6xl px-4 -mt-32 pb-6 md:-mt-40">
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {propertyFactors.map((item) => <ServiceCard {...item} />)}
      </div>
    </div>
    <div class="mx-auto max-w-3xl px-4 pt-4 pb-20 md:pb-24 text-center flex flex-wrap justify-center gap-4">
      <a href="/contact" class="btn btn-cta inline-flex">Talk Through Your Project</a>
      <a href="/contact" class="btn btn-outline inline-flex">Request a Free Estimate</a>
    </div>
  </section>

  <!-- When Does a Slope Need Work -->
  <section class="bg-slate-50 border-y border-slate-200">
    <div class="mx-auto max-w-6xl px-4 py-20 md:py-28">
      <div class="mb-12 md:mb-14 text-center">
        <p class="font-display font-semibold uppercase tracking-widest text-sm text-brand-blue">Slope Assessment</p>
        <h2 class="mt-2 font-display font-black uppercase tracking-tight text-3xl text-ink md:text-4xl">
          When Does a Slope Need Stabilization Work?
        </h2>
        <p class="mt-4 text-slate-700 max-w-2xl mx-auto leading-relaxed">
          Slope problems do not always look serious at first. Some signs appear gradually over several wet seasons. Others become visible quickly after heavy rain.
        </p>
      </div>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {[
          { title: 'Visible Erosion Channels', description: 'Channels or gullies cut into a slope by running water are a sign that erosion is removing soil. The problem can grow larger each wet season.', href: '/contact', linkLabel: 'Get an Estimate' },
          { title: 'Soil Moving After Rain', description: 'If soil is moving downhill after rainstorms, the slope may need help redirecting water or stabilizing the ground surface.', href: '/contact', linkLabel: 'Get an Estimate' },
          { title: 'Exposed Roots or Bare Ground', description: 'Exposed tree roots or bare patches on a slope can be a sign that the soil above has washed away. These areas may be more vulnerable to further erosion.', href: '/contact', linkLabel: 'Get an Estimate' },
          { title: 'Runoff Reaching Structures', description: 'Water carrying soil off a slope and reaching a driveway, building, or other structure can indicate that the slope needs drainage attention.', href: '/contact', linkLabel: 'Get an Estimate' },
          { title: 'After Clearing or Grading', description: 'Slopes that have been recently cleared of vegetation or regraded may be more vulnerable to erosion until the ground is stabilized.', href: '/contact', linkLabel: 'Get an Estimate' },
          { title: 'Unstable-Feeling Ground', description: 'Ground that shifts or feels soft on a slope can be a sign of deeper soil movement. The area may need assessment before further work is done nearby.', href: '/contact', linkLabel: 'Get an Estimate' },
        ].map((card) => (
          <div class="card flex flex-col gap-3">
            <h3 class="font-display font-bold uppercase tracking-wide text-base text-ink">{card.title}</h3>
            <p class="text-sm text-slate-600 leading-relaxed flex-1">{card.description}</p>
            <a href={card.href} class="inline-flex items-center gap-1 text-sm font-semibold text-brand-blue hover:underline">
              {card.linkLabel}
              <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M17 7H7M17 7V17" />
              </svg>
            </a>
          </div>
        ))}
      </div>
      <div class="mt-12 text-center">
        <a href="/contact" class="btn-pill inline-flex">
          Talk About Your Property
          <span class="btn-pill-icon">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M17 7H7M17 7V17" />
            </svg>
          </span>
        </a>
      </div>
    </div>
  </section>

  <!-- What Happens During Slope Work -->
  <section class="relative bg-ink text-white overflow-hidden">
    <div
      class="pointer-events-none absolute right-0 top-0 h-[480px] w-[480px] rounded-full bg-brand-blue/10 blur-3xl"
      aria-hidden="true"
    ></div>
    <div class="relative mx-auto max-w-6xl px-4 py-20 md:py-28">
      <div class="mb-12 md:mb-16 text-center">
        <p class="font-display font-semibold uppercase tracking-widest text-sm text-brand-blue-light">Slope Work</p>
        <h2 class="mt-2 font-display font-bold uppercase tracking-tight text-3xl text-white md:text-4xl">
          What Happens When We Look at a Slope Problem?
        </h2>
        <p class="mt-4 text-slate-300 max-w-2xl mx-auto leading-relaxed">
          Before any work is done, we look at the slope, soil, water flow, and surrounding conditions. This helps determine what excavation or grading work may address the problem.
        </p>
      </div>
      <div class="grid gap-4 sm:grid-cols-2 sm:gap-6">
        {[
          { title: 'Assess the Slope', detail: 'We look at the slope angle, soil type, erosion areas, and how water is moving across the surface. This shapes what work may be needed.' },
          { title: 'Check the Drainage', detail: 'Where water goes on and around the slope affects how erosion develops. We look at existing drainage and where runoff is concentrating.' },
          { title: 'Discuss the Options', detail: 'After looking at the site, we can discuss what grading, drainage, or excavation work may help and what the work would involve.' },
          { title: 'Plan Around the Property', detail: 'Slope work needs to account for access, nearby structures, and what the property will be used for. We plan around the actual conditions on site.' },
        ].map((item) => (
          <div class="rounded-(--radius-brand-card) bg-white/5 border border-white/10 p-6 sm:p-7">
            <p class="font-display font-bold uppercase tracking-wide text-sm text-white">{item.title}</p>
            <p class="mt-3 text-sm text-slate-300 leading-relaxed">{item.detail}</p>
          </div>
        ))}
      </div>
      <div class="mt-10 flex flex-wrap justify-center gap-4">
        <a href="/contact" class="btn btn-cta">Get a Free Estimate</a>
        <a href="tel:5414018726" class="btn btn-outline border-white/30 text-white hover:bg-white/10">Call 541-401-8726</a>
      </div>
    </div>
  </section>

  <!-- What D&D Can Help With -->
  <section class="bg-white border-b border-slate-100">
    <div class="mx-auto max-w-6xl px-4 py-20 md:py-28">
      <div class="grid gap-12 lg:gap-20 lg:grid-cols-2 lg:items-center">
        <div>
          <p class="font-display font-semibold uppercase tracking-widest text-sm text-brand-blue mb-4">Why D&D Land Works</p>
          <h2 class="font-display font-black uppercase tracking-tight text-3xl text-ink md:text-4xl">
            Why Hire D&D Land Works for Slope Work?
          </h2>
          <p class="mt-5 text-slate-600 leading-relaxed">
            When David looks at a slope problem, the goal is to understand what is causing the erosion or instability before deciding what excavation or grading work may help.
          </p>
          <ul class="mt-10 flex flex-col gap-7">
            {[
              { title: 'Licensed and Bonded in Oregon', description: 'D&D Land Works is licensed and bonded in Oregon under CCB #261742. You can verify the license through the Oregon Construction Contractors Board.', icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z" />' },
              { title: 'Drainage Is Part of the Assessment', description: 'Slope erosion and drainage are often connected. We look at how water moves across the slope to understand whether drainage changes may be part of the solution.', icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M12 3s6 7 6 11a6 6 0 1 1-12 0c0-4 6-11 6-11Z" />' },
              { title: 'Grading and Excavation Experience', description: 'Slope stabilization may involve regrading, excavation, or both. We have experience with grading and excavation work on sloped properties throughout Lane County.', icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M3 20 9 8l4 6 2-3 6 9H3Z" />' },
              { title: 'Free Estimates in Lane County', description: 'We provide free estimates throughout Lane County. We can look at the slope, discuss what you are seeing, and explain what the work may involve.', icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 6z" />' },
              { title: 'DEQ Septic Certification', description: 'D&D Land Works carries Oregon DEQ certification for septic work. When slope projects intersect with septic system areas, that experience can be relevant to planning the work.', icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M11.48 3.499a.562.562 0 0 1 1.04 0l2.125 5.111a.563.563 0 0 0 .475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 0 0-.182.557l1.285 5.385a.562.562 0 0 1-.84.61l-4.725-2.885a.562.562 0 0 0-.586 0L6.982 20.54a.562.562 0 0 1-.84-.61l1.285-5.386a.562.562 0 0 0-.182-.557l-4.204-3.602a.562.562 0 0 1 .321-.988l5.518-.442a.563.563 0 0 0 .475-.345L11.48 3.5Z" />' },
            ].map((item) => (
              <li class="flex items-start gap-4">
                <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-brand-blue-light text-brand-blue mt-0.5">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" set:html={item.icon} />
                </span>
                <div>
                  <p class="font-display font-bold text-ink">{item.title}</p>
                  <p class="mt-1 text-sm text-slate-600 leading-relaxed">{item.description}</p>
                </div>
              </li>
            ))}
          </ul>
          <a href="/contact" class="btn-pill mt-10 inline-flex">
            Talk About Your Property
            <span class="btn-pill-icon">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M17 7H7M17 7V17" />
              </svg>
            </span>
          </a>
        </div>
        <div class="relative">
          <img
            src="/service-land-clearing.webp"
            alt="Slope grading and stabilization work on a Lane County, Oregon property"
            class="w-full rounded-(--radius-brand-card) object-cover aspect-3/4 shadow-xl"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Service Areas -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-6xl px-4 py-20 md:py-28">
      <div class="mb-12 md:mb-14 text-center">
        <p class="font-display font-semibold uppercase tracking-widest text-sm text-brand-blue">Serving Local Properties</p>
        <h2 class="mt-2 font-display font-black uppercase tracking-tight text-3xl text-ink md:text-5xl">
          Slope Stabilization in Eugene, Springfield, and Lane County
        </h2>
        <div class="mt-5 text-slate-600 max-w-2xl mx-auto leading-relaxed flex flex-col gap-3">
          <p>Lane County receives heavy rain through the wet season, and sloped properties can see erosion develop year after year. Hillside lots, cut slopes, and rural land are all common situations where slope and drainage issues arise.</p>
          <p>We work with property owners throughout Eugene, Springfield, and nearby Lane County communities. We can look at the slope and discuss what grading or excavation work may help.</p>
        </div>
      </div>
      <div class="grid gap-6 lg:grid-cols-2 lg:gap-8 items-stretch">
        <div class="overflow-hidden rounded-(--radius-brand-card) bg-ink shadow-lg">
          <a href="/locations/eugene" class="flex items-center gap-3 bg-brand-blue px-6 py-4 text-white transition-opacity hover:opacity-90">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 21c4.4-3.4 7-7 7-10.5A7 7 0 0 0 5 10.5C5 14 7.6 17.6 12 21Z" />
              <circle cx="12" cy="10.5" r="2" fill="currentColor" stroke="none" />
            </svg>
            <span class="font-display font-bold uppercase tracking-wide text-sm">Eugene, OR</span>
          </a>
          {[
            { label: 'Springfield', href: '/locations/springfield' },
            { label: 'Cottage Grove', href: '/locations/cottage-grove' },
            { label: 'Junction City', href: '/locations/junction-city' },
            { label: 'Creswell', href: '/locations/creswell' },
            { label: 'Veneta', href: '/locations/veneta' },
            { label: 'Florence', href: '/locations/florence' },
            { label: 'Oakridge', href: '/locations/oakridge' },

---
import BaseLayout from './BaseLayout.astro';

interface FactsBarItem {
  label: string;
  value: string;
}

interface ServiceItem {
  num: string;
  title: string;
  desc: string;
  href: string;
}

interface ChecklistItem {
  title: string;
  desc: string;
  href: string;
}

interface ProcessStep {
  num: string;
  title: string;
  desc: string;
  dark?: boolean;
}

interface BentoFeature {
  title: string;
  desc: string;
  dark?: boolean;
}

interface FaqItem {
  question: string;
  answer: string;
}

interface RelatedService {
  title: string;
  desc: string;
  href: string;
}

interface AreaLink {
  label: string;
  href: string;
}

interface Props {
  // Meta
  pageTitle: string;
  pageDescription: string;
  schema: object;

  // Hero
  cityState: string;
  heroH1Light: string;
  heroH1Bold: string;
  heroSub: string;
  heroImage: string;
  factsBar: FactsBarItem[];
  breadcrumbLabel: string;

  // Local intro (cream bg)
  introEyebrow: string;
  introH2Light: string;
  introH2Bold: string;
  davidQuote: string;
  introPara1: string;
  introPara2: string;
  introImage: string;

  // Services grid (dark bg)
  servicesEyebrow?: string;
  servicesH2Light: string;
  servicesH2Bold: string;
  servicesDesc: string;
  services: ServiceItem[];

  // When you need it checklist (white bg)
  whenEyebrow?: string;
  whenH2Light: string;
  whenH2Bold: string;
  whenDesc: string;
  checklistItems: ChecklistItem[];

  // Process steps (cream bg)
  processEyebrow?: string;
  processH2Light: string;
  processH2Bold: string;
  processDesc: string;
  processSteps: ProcessStep[];

  // Why choose bento (white bg)
  whyH2Light: string;
  whyH2Bold: string;
  bentoImage: string;
  bentoImageAlt: string;
  bentoFeatures: BentoFeature[];

  // Service area (cream bg)
  areaEyebrow?: string;
  areaH2Light: string;
  areaH2Bold: string;
  areaDesc: string;
  areaLinks: AreaLink[];

  // FAQ (white bg)
  faqH2Light: string;
  faqH2Bold: string;
  faqs: FaqItem[];

  // Related services strip (dark bg)
  relatedEyebrow?: string;
  relatedServices: RelatedService[];

  // Final CTA (photo bg)
  ctaEyebrow?: string;
  ctaH2Light: string;
  ctaH2Bold: string;
  ctaSub: string;
  ctaImage: string;
}

const {
  pageTitle,
  pageDescription,
  schema,
  cityState,
  heroH1Light,
  heroH1Bold,
  heroSub,
  heroImage,
  factsBar,
  breadcrumbLabel,
  introEyebrow,
  introH2Light,
  introH2Bold,
  davidQuote,
  introPara1,
  introPara2,
  introImage,
  servicesEyebrow = 'Our services',
  servicesH2Light,
  servicesH2Bold,
  servicesDesc,
  services,
  whenEyebrow,
  whenH2Light,
  whenH2Bold,
  whenDesc,
  checklistItems,
  processEyebrow = 'Getting started',
  processH2Light,
  processH2Bold,
  processDesc,
  processSteps,
  whyH2Light,
  whyH2Bold,
  bentoImage,
  bentoImageAlt,
  bentoFeatures,
  areaEyebrow = 'Our service area',
  areaH2Light,
  areaH2Bold,
  areaDesc,
  areaLinks,
  faqH2Light,
  faqH2Bold,
  faqs,
  relatedEyebrow,
  relatedServices,
  ctaEyebrow = 'Talk with David',
  ctaH2Light,
  ctaH2Bold,
  ctaSub,
  ctaImage,
} = Astro.props;
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <!-- ── HERO ─────────────────────────────────────────────────────────── -->
  <section class="relative bg-ink overflow-hidden">
    <!-- Photo + overlay -->
    <div class="absolute inset-0">
      <img
        src={heroImage}
        alt={`D&D Land Works excavation contractor in ${cityState}`}
        class="absolute inset-0 w-full h-full object-cover object-[50%_35%]"
        loading="eager"
      />
      <div class="absolute inset-0 bg-ink/75"></div>
    </div>

    <!-- Centered hero content -->
    <div class="relative z-10 flex flex-col items-center text-center text-white px-4 pt-20 pb-48 md:pt-28 md:pb-56">
      <!-- Breadcrumb -->
      <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-sm text-white/60 mb-8">
        <a href="/" class="hover:text-white transition-colors">Home</a>
        <span>/</span>
        <a href="/service-area" class="hover:text-white transition-colors">Service Area</a>
        <span>/</span>
        <span class="text-white">{breadcrumbLabel}</span>
      </nav>

      <!-- Eyebrow -->
      <div class="flex items-center gap-4 mb-6">
        <span class="w-10 h-px bg-accent-light"></span>
        <span class="font-display text-sm font-semibold tracking-[0.22em] uppercase text-accent-light">{cityState}</span>
        <span class="w-10 h-px bg-accent-light"></span>
      </div>

      <!-- H1 -->
      <h1 class="font-display leading-[0.95] mb-6" style="font-size: clamp(3rem, 6vw, 5.5rem)">
        <span class="block font-light">{heroH1Light}</span>
        <span class="block font-semibold">{heroH1Bold}</span>
      </h1>

      <!-- Sub -->
      <p class="max-w-2xl text-lg text-white/85 leading-relaxed mb-8">{heroSub}</p>

      <!-- CTAs -->
      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="#estimate"
          class="inline-flex items-center h-14 px-8 bg-accent text-white font-display font-semibold text-lg tracking-widest uppercase rounded"
        >
          Get a Free Estimate
        </a>
        <a
          href="tel:5414018726"
          class="inline-flex items-center h-14 px-8 border border-white/50 text-white font-display font-semibold text-lg tracking-widest uppercase rounded"
        >
          Call 541-401-8726
        </a>
      </div>
    </div>

    <!-- Facts bar (floating card) -->
    <div class="relative z-10 mx-auto max-w-5xl px-4 -mt-24 pb-0">
      <div class="bg-white rounded shadow-2xl grid grid-cols-2 md:grid-cols-4">
        {factsBar.map((fact, i) => (
          <div class:list={['px-6 py-7 flex flex-col gap-1', i > 0 ? 'border-t md:border-t-0 md:border-l border-[#DDD8CF]' : '']}>
            <span class="font-display text-xs font-semibold tracking-[0.16em] uppercase text-slate-400">{fact.label}</span>
            <span class="font-display text-xl font-semibold leading-tight text-ink">{fact.value}</span>
          </div>
        ))}
      </div>
    </div>
    <!-- Spacer so next section clears the card -->
    <div class="h-12 bg-cream"></div>
  </section>

  <!-- ── LOCAL INTRO ────────────────────────────────────────────────── -->
  <section class="bg-cream py-24 md:py-32 px-4">
    <div class="mx-auto max-w-6xl">
      <!-- Top: eyebrow + H2 left  | quote right -->
      <div class="grid md:grid-cols-12 gap-10 md:gap-6 items-end mb-14">
        <div class="md:col-span-7 flex flex-col gap-5">
          <div class="flex items-center gap-4">
            <span class="w-10 h-px bg-accent"></span>
            <span class="font-display text-sm font-semibold tracking-[0.22em] uppercase text-accent">{introEyebrow}</span>
          </div>
          <h2 class="font-display leading-tight m-0" style="font-size: clamp(2rem, 4vw, 3.75rem)">
            <span class="block font-light">{introH2Light}</span>
            <span class="block font-semibold">{introH2Bold}</span>
          </h2>
        </div>
        <div class="md:col-start-9 md:col-span-4 flex flex-col gap-3 pt-6 border-t-[3px] border-ink">
          <p class="font-display text-2xl font-medium leading-snug text-ink">"{davidQuote}"</p>
          <p class="text-sm text-slate-500">David Deggelman, owner &amp; operator</p>
        </div>
      </div>

      <!-- Bottom: two body paragraphs + image + link -->
      <div class="grid md:grid-cols-3 gap-10">
        <p class="text-base leading-relaxed text-slate-600">{introPara1}</p>
        <p class="text-base leading-relaxed text-slate-600">{introPara2}</p>
        <div class="flex flex-col gap-5">
          <img
            src={introImage}
            alt={`Site work in ${breadcrumbLabel}, Oregon`}
            class="w-full aspect-[4/3] object-cover rounded"
            loading="lazy"
          />
          <a
            href="/about"
            class="inline-flex items-center gap-2 self-start font-display text-sm font-semibold tracking-widest uppercase text-ink border-b-2 border-accent pb-1"
          >
            About D&amp;D Land Works
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ── SERVICES GRID ──────────────────────────────────────────────── -->
  <section class="bg-ink text-white py-24 md:py-32 px-4">
    <div class="mx-auto max-w-6xl flex flex-col gap-14">
      <!-- Header row -->
      <div class="flex flex-col md:flex-row md:justify-between md:items-end gap-8">
        <div class="flex flex-col gap-5">
          <div class="flex items-center gap-4">
            <span class="w-10 h-px bg-accent-light"></span>
            <span class="font-display text-sm font-semibold tracking-[0.22em] uppercase text-accent-light">{servicesEyebrow}</span>
          </div>
          <h2 class="font-display leading-tight m-0" style="font-size: clamp(1.75rem, 3.5vw, 3.5rem)">
            <span class="block font-light">{servicesH2Light}</span>
            <span class="block font-semibold">{servicesH2Bold}</span>
          </h2>
        </div>
        <p class="md:max-w-sm text-lg leading-relaxed text-white/75">{servicesDesc}</p>
      </div>

      <!-- 3×2 bordered grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 border border-white/15 rounded">
        {services.map((svc, i) => {
          const isLastCol = (i + 1) % 3 === 0;
          const isLastRow = i >= services.length - 3;
          return (
            <a
              href={svc.href}
              class:list={[
                'group flex flex-col gap-3 p-10 min-h-[200px]',
                !isLastCol ? 'lg:border-r border-white/15' : '',
                !isLastRow ? 'border-b border-white/15' : '',
              ]}
            >
              <span class="flex justify-between items-start">
                <span class="font-display text-base font-semibold tracking-[0.16em] text-accent-light">{svc.num}</span>
                <svg class="text-white/50 group-hover:text-accent-light transition-colors" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9"/></svg>
              </span>
              <span class="font-display text-2xl font-semibold leading-tight group-hover:text-accent-light transition-colors">{svc.title}</span>
              <span class="text-sm leading-relaxed text-white/65">{svc.desc}</span>
            </a>
          );
        })}
      </div>

      <!-- CTAs -->
      <div class="flex flex-wrap gap-4">
        <a href="#estimate" class="inline-flex items-center h-14 px-8 bg-accent text-white font-display font-semibold text-base tracking-widest uppercase rounded">
          Request a Free Estimate
        </a>
        <a href="/services" class="inline-flex items-center h-14 px-8 border border-white/50 text-white font-display font-semibold text-base tracking-widest uppercase rounded">
          Explore all services
        </a>
      </div>
    </div>
  </section>

  <!-- ── WHEN DO YOU NEED IT ────────────────────────────────────────── -->
  <section class="bg-white py-24 md:py-32 px-4">
    <div class="mx-auto max-w-6xl grid md:grid-cols-[4fr_8fr] gap-16 items-start">
      <!-- Left: headline + CTA -->
      <div class="flex flex-col gap-6 sticky top-24">
        {whenEyebrow && (
          <div class="flex items-center gap-4">
            <span class="w-10 h-px bg-accent"></span>
            <span class="font-display text-sm font-semibold tracking-[0.22em] uppercase text-accent">{whenEyebrow}</span>
          </div>
        )}
        <h2 class="font-display leading-tight m-0" style="font-size: clamp(2rem, 3.5vw, 3.5rem)">
          <span class="block font-light">{whenH2Light}</span>
          <span class="block font-semibold">{whenH2Bold}</span>
        </h2>
        <p class="text-lg leading-relaxed text-slate-600">{whenDesc}</p>
        <div>
          <a href="#estimate" class="inline-flex items-center h-14 px-8 bg-accent text-white font-display font-semibold text-base tracking-widest uppercase rounded">
            Talk about your property
          </a>
        </div>
      </div>

      <!-- Right: 2-col checklist -->
      <div class="grid grid-cols-1 sm:grid-cols-2 border-b border-[#DDD8CF]">
        {checklistItems.map((item) => (
          <div class="grid grid-cols-[36px_1fr] gap-4 items-start py-7 border-t border-[#DDD8CF]">
            <svg class="text-accent shrink-0 mt-0.5" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="3"/><path d="m8 12 3 3 5-6"/></svg>
            <div class="flex flex-col gap-2">
              <span class="font-display text-xl font-semibold leading-tight">{item.title}</span>
              <span class="text-sm leading-relaxed text-slate-600">{item.desc}</span>
              <a href={item.href} class="inline-flex items-center gap-2 self-start font-display text-xs font-semibold tracking-widest uppercase text-ink">
                Get an estimate
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── PROCESS ────────────────────────────────────────────────────── -->
  <section class="bg-cream py-24 md:py-32 px-4">
    <div class="mx-auto max-w-6xl flex flex-col gap-14">
      <!-- Header row -->
      <div class="grid md:grid-cols-2 gap-10 items-end">
        <div class="flex flex-col gap-5">
          <div class="flex items-center gap-4">
            <span class="w-10 h-px bg-accent"></span>
            <span class="font-display text-sm font-semibold tracking-[0.22em] uppercase text-accent">{processEyebrow}</span>
          </div>
          <h2 class="font-display leading-tight m-0" style="font-size: clamp(1.75rem, 3.5vw, 3.5rem)">
            <span class="block font-light">{processH2Light}</span>
            <span class="block font-semibold">{processH2Bold}</span>
          </h2>
        </div>
        <p class="text-lg leading-relaxed text-slate-600">{processDesc}</p>
      </div>

      <!-- 4-col steps -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 bg-white border border-[#DDD8CF] rounded overflow-hidden">
        {processSteps.map((step, i) => (
          <div class:list={[
            'flex flex-col gap-3 p-10',
            i > 0 ? 'lg:border-l border-[#DDD8CF]' : '',
            step.dark ? 'bg-ink text-white' : '',
          ]}>
            <span class:list={[
              'font-display text-xs font-semibold tracking-[0.18em] uppercase',
              step.dark ? 'text-accent-light' : 'text-accent',
            ]}>Step {step.num}</span>
            <span class:list={[
              'font-display text-xl font-semibold leading-tight',
              step.dark ? 'text-white' : 'text-ink',
            ]}>{step.title}</span>
            <span class:list={[
              'text-sm leading-relaxed',
              step.dark ? 'text-white/70' : 'text-slate-600',
            ]}>{step.desc}</span>
          </div>
        ))}
      </div>

      <!-- CTAs -->
      <div class="flex flex-wrap items-center gap-6">
        <a href="#estimate" class="inline-flex items-center h-14 px-8 bg-accent text-white font-display font-semibold text-base tracking-widest uppercase rounded">
          Get a Free Estimate
        </a>
        <a href="tel:5414018726" class="inline-flex items-center gap-3 font-display text-lg font-semibold text-ink">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z"/></svg>
          or call 541-401-8726
        </a>
      </div>
    </div>
  </section>

  <!-- ── WHY CHOOSE (BENTO) ─────────────────────────────────────────── -->
  <section class="bg-white py-24 md:py-32 px-4">
    <div class="mx-auto max-w-6xl flex flex-col gap-14">
      <!-- Centered header -->
      <div class="flex flex-col items-center text-center gap-5">
        <div class="flex items-center gap-4">
          <span class="w-10 h-px bg-accent"></span>
          <span class="font-display text-sm font-semibold tracking-[0.22em] uppercase text-accent">Why D&amp;D Land Works</span>
          <span class="w-10 h-px bg-accent"></span>
        </div>
        <h2 class="font-display leading-tight m-0" style="font-size: clamp(1.75rem, 3.5vw, 3.5rem)">
          <span class="block font-light">{whyH2Light}</span>
          <span class="block font-semibold">{whyH2Bold}</span>
        </h2>
      </div>

      <!-- Bento grid -->
      <div class="grid grid-cols-1 lg:grid-cols-4 lg:grid-rows-2 gap-6 auto-rows-[260px]">
        <!-- Large photo card (spans 2x2) -->
        <div class="lg:col-span-2 lg:row-span-2 relative rounded overflow-hidden bg-ink text-white">
          <img src={bentoImage} alt={bentoImageAlt} class="absolute inset-0 w-full h-full object-cover object-[50%_60%]" loading="lazy" />
          <div class="absolute inset-0 bg-gradient-to-t from-ink/95 via-ink/40 to-ink/15"></div>
          <div class="absolute left-8 right-8 bottom-8 flex flex-col gap-3">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class="text-accent-light" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
            <span class="font-display text-3xl font-semibold leading-tight">Licensed &amp; bonded</span>
            <p class="text-sm leading-relaxed text-white/80">Oregon CCB #261742. Check it on the state's CCB license lookup before you call.</p>
            <a
              href="https://search.ccb.state.or.us/search/"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 self-start font-display text-xs font-semibold tracking-widest uppercase border-b-2 border-accent-light pb-1"
            >
              Verify CCB license
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </a>
          </div>
        </div>

        <!-- Feature cards -->
        {bentoFeatures.map((feat) => (
          <div class:list={[
            'rounded p-8 flex flex-col gap-3',
            feat.dark
              ? 'bg-ink text-white'
              : 'bg-white border border-[#DDD8CF] text-ink',
          ]}>
            <span class:list={[
              'font-display text-xl font-semibold leading-tight',
              feat.dark ? 'text-white' : 'text-ink',
            ]}>{feat.title}</span>
            <p class:list={[
              'text-sm leading-relaxed',
              feat.dark ? 'text-white/70' : 'text-slate-600',
            ]}>{feat.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── SERVICE AREA ───────────────────────────────────────────────── -->
  <section class="bg-cream py-24 md:py-32 px-4">
    <div class="mx-auto max-w-6xl grid md:grid-cols-[7fr_5fr] gap-16 items-center">
      <!-- Schematic map -->
      <div class="relative h-[400px] md:h-[500px] bg-ink rounded overflow-hidden text-white flex items-center justify-center">
        <div class="text-center px-8">
          <p class="font-display text-sm font-semibold tracking-[0.2em] uppercase text-white/40 mb-6">Lane County, Oregon</p>
          <div class="grid grid-cols-2 gap-3 text-left">
            {[
              { city: 'Eugene', base: false },
              { city: 'Springfield', base: true },
              { city: 'Junction City', base: false },
              { city: 'Coburg', base: false },
              { city: 'Creswell', base: false },
              { city: breadcrumbLabel, base: false, highlight: true },
              { city: 'Veneta', base: false },
              { city: 'Lowell', base: false },
              { city: 'Oakridge', base: false },
              { city: 'Florence', base: false },
            ].map((loc) => (
              <div class="flex items-center gap-2">
                {loc.base ? (
                  <span class="w-5 h-5 rounded bg-white flex items-center justify-center shrink-0">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#16191B" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 11 12 4l9 7v9H3z"/></svg>
                  </span>
                ) : loc.highlight ? (
                  <span class="w-4 h-4 rounded-full border-4 border-white bg-accent shrink-0"></span>
                ) : (
                  <span class="w-2.5 h-2.5 rounded-full bg-white/60 shrink-0"></span>
                )}
                <span class:list={[
                  'font-display text-sm',
                  loc.base ? 'font-semibold text-white' : loc.highlight ? 'font-bold text-white text-base' : 'font-medium text-white/70',
                ]}>{loc.city}{loc.base ? <span class="text-xs text-white/50 font-normal"> · home base</span> : ''}</span>
              </div>
            ))}
          </div>
          <p class="font-display text-xs tracking-[0.2em] uppercase text-white/35 mt-8">Based in Springfield · Serving south Lane County</p>
        </div>
      </div>

      <!-- Copy + area pills -->
      <div class="flex flex-col gap-6">
        <div class="flex items-center gap-4">
          <span class="w-10 h-px bg-accent"></span>
          <span class="font-display text-sm font-semibold tracking-[0.22em] uppercase text-accent">{areaEyebrow}</span>
        </div>
        <h2 class="font-display leading-tight m-0" style="font-size: clamp(1.75rem, 3vw, 3.25rem)">
          <span class="block font-light">{areaH2Light}</span>
          <span class="block font-semibold">{areaH2Bold}</span>
        </h2>
        <p class="text-lg leading-relaxed text-slate-600">{areaDesc}</p>
        <div class="flex flex-wrap gap-2">
          {areaLinks.map((link) => (
            <a
              href={link.href}
              class="px-4 py-2 bg-white border border-[#D8D2C7] rounded font-display text-base font-medium text-ink hover:border-accent hover:text-accent transition-colors"
            >
              {link.label}
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ── FAQ ───────────────────────────────────────────────────────── -->
  <section class="bg-white py-24 md:py-32 px-4">
    <div class="mx-auto max-w-6xl flex flex-col gap-12">
      <!-- Header row -->
      <div class="flex flex-col md:flex-row md:justify-between md:items-end gap-6">
        <div class="flex flex-col gap-5">
          <div class="flex items-center gap-4">
            <span class="w-10 h-px bg-accent"></span>
            <span class="font-display text-sm font-semibold tracking-[0.22em] uppercase text-accent">FAQ</span>
          </div>
          <h2 class="font-display leading-tight m-0" style="font-size: clamp(1.75rem, 3.5vw, 3.5rem)">
            <span class="block font-light">{faqH2Light}</span>
            <span class="block font-semibold">{faqH2Bold}</span>
          </h2>
        </div>
        <a
          href="tel:5414018726"
          class="inline-flex items-center h-12 px-7 border border-ink text-ink font-display font-semibold text-sm tracking-widest uppercase rounded whitespace-nowrap self-start md:self-auto"
        >
          Ask David a question
        </a>
      </div>

      <!-- Q&A list -->
      <div class="flex flex-col border-b border-[#DDD8CF]">
        {faqs.map((faq) => (
          <div class="grid md:grid-cols-[5fr_7fr] gap-6 md:gap-12 py-8 border-t border-[#DDD8CF]">
            <h3 class="font-display text-xl font-semibold leading-snug m-0 text-ink">{faq.question}</h3>
            <p class="text-base leading-relaxed text-slate-600 m-0">{faq.answer}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── RELATED SERVICES STRIP ─────────────────────────────────────── -->
  <section class="bg-ink text-white py-16 px-4">
    <div class="mx-auto max-w-6xl flex flex-col gap-8">
      {relatedEyebrow && (
        <span class="font-display text-sm font-semibold tracking-[0.22em] uppercase text-accent-light">{relatedEyebrow}</span>
      )}
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {relatedServices.map((svc) => (
          <a href={svc.href} class="group flex flex-col gap-2 pt-6 border-t-2 border-white/20 hover:border-accent-light transition-colors">
            <span class="flex justify-between items-center">
              <span class="font-display text-xl font-semibold group-hover:text-accent-light transition-colors">{svc.title}</span>
              <svg class="text-white/50 group-hover:text-accent-light transition-colors" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </span>
            <span class="text-sm leading-snug text-white/60">{svc.desc}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ── FINAL CTA ──────────────────────────────────────────────────── -->
  <section id="estimate" class="relative overflow-hidden text-white" style="min-height: 520px;">
    <img
      src={ctaImage}
      alt=""
      class="absolute inset-0 w-full h-full object-cover object-[50%_60%]"
      loading="lazy"
      aria-hidden="true"
    />
    <div class="absolute inset-0 bg-ink/80"></div>
    <div class="relative z-10 flex flex-col items-center justify-center text-center px-4 py-24 md:py-32">
      <div class="flex items-center gap-4 mb-6">
        <span class="w-10 h-px bg-accent-light"></span>
        <span class="font-display text-sm font-semibold tracking-[0.22em] uppercase text-accent-light">{ctaEyebrow}</span>
        <span class="w-10 h-px bg-accent-light"></span>
      </div>
      <h2 class="font-display leading-tight m-0 mb-6" style="font-size: clamp(2.25rem, 5vw, 4.5rem)">
        <span class="block font-light">{ctaH2Light}</span>
        <span class="block font-semibold">{ctaH2Bold}</span>
      </h2>
      <p class="max-w-xl text-lg leading-relaxed text-white/85 mb-8">{ctaSub}</p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/contact" class="inline-flex items-center h-14 px-8 bg-accent text-white font-display font-semibold text-base tracking-widest uppercase rounded">
          Request a Free Estimate
        </a>
        <a href="tel:5414018726" class="inline-flex items-center h-14 px-8 border border-white/50 text-white font-display font-semibold text-base tracking-widest uppercase rounded">
          Call 541-401-8726
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

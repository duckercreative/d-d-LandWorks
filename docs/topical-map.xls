   <Row>
    <Cell ss:StyleID="sWrap"><Data ss:Type="String">Land Clearing (/land-clearing/)</Data></Cell>
    <Cell ss:StyleID="sWrap"><Data ss:Type="String">Land clearing</Data></Cell>
    <Cell ss:StyleID="sWrap"><Data ss:Type="String">Commercial</Data></Cell>
    <Cell ss:StyleID="sWrap"><Data ss:Type="String">Lot/property clearing, clearing for construction, clearing before grading/excavation, brush &amp; overgrowth removal, vegetation clearing</Data></Cell>
    <Cell ss:StyleID="sFence"><Data ss:Type="String">NO tree removal, stump grinding, forestry mulching, hauling</Data></Cell>
    <Cell ss:StyleID="sNum"><Data ss:Type="String">P0</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="sWrap"><Data ss:Type="String">Septic Install &amp; Repair (/septic/)</Data></Cell>
    <Cell ss:StyleID="sWrap"><Data ss:Type="String">Septic system installation</Data></Cell>
    <Cell ss:StyleID="sWrap"><Data ss:Type="String">Commercial</Data></Cell>
    <Cell ss:StyleID="sWrap"><Data ss:Type="String">Septic installation, septic repair, drainfield/tank excavation, septic site prep, DEQ-certified install</Data></Cell>
    <Cell ss:StyleID="sFence"><Data ss:Type="String">NO pumping, no inspection/cert claims beyond DEQ install, no soil/engineering claims</Data></Cell>
    <Cell ss:StyleID="sNum"><Data ss:Type="String">P0</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="sWrap"><Data ss:Type="String">Foundation Excavation (/foundation-excavation/)</Data></Cell>
    <Cell ss:StyleID="sWrap"><Data ss:Type="String">Foundation excavation</Data></Cell>
    <Cell ss:StyleID="sWrap"><Data ss:Type="String">Commercial</Data></Cell>
    <Cell ss:StyleID="sWrap"><Data ss:Type="String">Residential/commercial foundation excavation, new-construction excavation, foundation site prep, backfill, process/what to expect</Data></Cell>
    <Cell ss:StyleID="sFence"><Data ss:Type="String">No structural/engineering guarantees</Data></Cell>
    <Cell ss:StyleID="sNum"><Data ss:Type="String">P1</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="sWrap"><Data ss:Type="String">Drainage Excavation (/drainage-excavation/)</Data></Cell>
    <Cell ss:StyleID="sWrap"><Data ss:Type="String">Drainage excavation</Data></Cell>
    <Cell ss:StyleID="sWrap"><Data ss:Type="String">Problem/commercial</Data></Cell>
    <Cell ss:StyleID="sWrap"><Data ss:Type="String">Drainage trenches, swales, channels, regrading for runoff, yard/property drainage, standing-water fixes</Data></Cell>
    <Cell ss:StyleID="sFence"><Data ss:Type="String">Frame as excavation/grading FOR drainage; confirm French drain/culvert product installs before claiming</Data></Cell>
    <Cell ss:StyleID="sNum"><Data ss:Type="String">P1</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="sWrap"><Data ss:Type="String">Utility Excavation (/utility-excavation/)</Data></Cell>
    <Cell ss:StyleID="sWrap"><Data ss:Type="String">Utility excavation / trenching</Data></Cell>
    <Cell ss:StyleID="sWrap"><Data ss:Type="String">Commercial</Data></Cell>
    <Cell ss:StyleID="sWrap"><Data ss:Type="String">Underground utility trenching, water/sewer/electrical/conduit trenching, residential vs commercial, trench prep + backfill/compaction</Data></Cell>
    <Cell ss:StyleID="sFence"><Data ss:Type="String">Excavation/trenching FOR utilities - NOT utility installation/connection</Data></Cell>
    <Cell ss:StyleID="sNum"><Data ss:Type="String">P1</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="sWrap"><Data ss:Type="String">Driveway Repair (/driveway-repair/)</Data></Cell>
    <Cell ss:StyleID="sWrap"><Data ss:Type="String">Gravel driveway repair</Data></Cell>
    <Cell ss:StyleID="sWrap"><Data ss:Type="String">Problem/commercial</Data></Cell>
    <Cell ss:StyleID="sWrap"><Data ss:Type="String">Gravel driveway repair/regrading, driveway drainage, driveway excavation/prep, potholes/washboarding, residential/commercial</Data></Cell>
    <Cell ss:StyleID="sFence"><Data ss:Type="String">NO asphalt paving, concrete, or sealing</Data></Cell>
    <Cell ss:StyleID="sNum"><Data ss:Type="String">P1</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="sWrap"><Data ss:Type="String">Slope Stabilization (/slope-stabilization/)</Data></Cell>
    <Cell ss:StyleID="sWrap"><Data ss:Type="String">Slope stabilization / erosion control</Data></Cell>
    <Cell ss:StyleID="sWrap"><Data ss:Type="String">Problem/commercial</Data></Cell>
    <Cell ss:StyleID="sWrap"><Data ss:Type="String">Sloped-property grading, erosion control, drainage on slopes, slope excavation/regrading, soil erosion</Data></Cell>
    <Cell ss:StyleID="sFence"><Data ss:Type="String">NO structural guarantees or retaining-wall engineering claims</Data></Cell>
    <Cell ss:StyleID="sNum"><Data ss:Type="String">P2</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="sWrap"><Data ss:Type="String">Brush Clearing (section - graduate)</Data></Cell>
    <Cell ss:StyleID="sWrap"><Data ss:Type="String">Brush clearing</Data></Cell>
    <Cell ss:StyleID="sWrap"><Data ss:Type="String">Commercial</Data></Cell>
    <Cell ss:StyleID="sWrap"><Data ss:Type="String">Overgrowth/brush removal, lot prep, clearing before grading/excavation - lives in Land Clearing until it earns its own page</Data></Cell>
    <Cell ss:StyleID="sWrap"><Data ss:Type="String">Same fence as Land Clearing</Data></Cell>
    <Cell ss:StyleID="sNum"><Data ss:Type="String">P2</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="sWrap"><Data ss:Type="String">Trenching &amp; Backfill (section - graduate)</Data></Cell>
    <Cell ss:StyleID="sWrap"><Data ss:Type="String">Trenching and backfill</Data></Cell>
    <Cell ss:StyleID="sWrap"><Data ss:Type="String">Commercial</Data></Cell>
    <Cell ss:StyleID="sWrap"><Data ss:Type="String">Trenching, trench prep, backfill/compaction - lives in Utility Excavation until it earns its own page</Data></Cell>
    <Cell ss:StyleID="sWrap"><Data ss:Type="String">Same fence as Utility Excavation</Data></Cell>
    <Cell ss:StyleID="sNum"><Data ss:Type="String">P2</Data></Cell>
   </Row>
  </Table>
  <WorksheetOptions xmlns="urn:schemas-microsoft-com:office:excel">
   <FreezePanes/>
   <FrozenNoSplit/>
   <SplitHorizontal>3</SplitHorizontal>
   <TopRowBottomPane>3</TopRowBottomPane>
   <ActivePane>2</ActivePane>
  </WorksheetOptions>
 </Worksheet>

 <!-- ============ SHEET 4: ENTITY MAP ============ -->
 <Worksheet ss:Name="Entity Map">
  <Table ss:DefaultColumnWidth="90">
   <Column ss:Width="200"/>
   <Column ss:Width="150"/>
   <Column ss:Width="320"/>
   <Row ss:Height="26">
    <Cell ss:StyleID="sTitle"><Data ss:Type="String">Entity Relationship Map</Data></Cell>
   </Row>
   <Row ss:Height="16">
    <Cell ss:StyleID="sSub"><Data ss:Type="String">Subject → Relationship → Object. Every service resolves back to the central entity; septic is a branch, not the trunk.</Data></Cell>
   </Row>
   <Row/>
   <Row ss:Height="24">
    <Cell ss:StyleID="sHeader"><Data ss:Type="String">Subject Entity</Data></Cell>
    <Cell ss:StyleID="sHeader"><Data ss:Type="String">Relationship</Data></Cell>
    <Cell ss:StyleID="sHeader"><Data ss:Type="String">Object Entity</Data></Cell>
   </Row>
   <Row><Cell ss:StyleID="sWrap"><Data ss:Type="String">D&amp;D Land Works</Data></Cell><Cell ss:StyleID="sRel"><Data ss:Type="String">is a</Data></Cell><Cell ss:StyleID="sWrap"><Data ss:Type="String">Excavation &amp; Landworks Contractor (central entity)</Data></Cell></Row>
   <Row><Cell ss:StyleID="sWrap"><Data ss:Type="String">D&amp;D Land Works</Data></Cell><Cell ss:StyleID="sRel"><Data ss:Type="String">holds</Data></Cell><Cell ss:StyleID="sWrap"><Data ss:Type="String">CCB #261742 (Licensed &amp; Bonded)</Data></Cell></Row>
   <Row><Cell ss:StyleID="sWrap"><Data ss:Type="String">D&amp;D Land Works</Data></Cell><Cell ss:StyleID="sRel"><Data ss:Type="String">holds</Data></Cell><Cell ss:StyleID="sWrap"><Data ss:Type="String">DEQ Certification (septic)</Data></Cell></Row>
   <Row><Cell ss:StyleID="sWrap"><Data ss:Type="String">DEQ Certification</Data></Cell><Cell ss:StyleID="sRel"><Data ss:Type="String">qualifies for</Data></Cell><Cell ss:StyleID="sWrap"><Data ss:Type="String">Septic Install &amp; Repair</Data></Cell></Row>
   <Row><Cell ss:StyleID="sWrap"><Data ss:Type="String">D&amp;D Land Works</Data></Cell><Cell ss:StyleID="sRel"><Data ss:Type="String">serves</Data></Cell><Cell ss:StyleID="sWrap"><Data ss:Type="String">Residential customers</Data></Cell></Row>
   <Row><Cell ss:StyleID="sWrap"><Data ss:Type="String">D&amp;D Land Works</Data></Cell><Cell ss:StyleID="sRel"><Data ss:Type="String">serves</Data></Cell><Cell ss:StyleID="sWrap"><Data ss:Type="String">Commercial customers / builders / developers</Data></Cell></Row>
   <Row><Cell ss:StyleID="sWrap"><Data ss:Type="String">D&amp;D Land Works</Data></Cell><Cell ss:StyleID="sRel"><Data ss:Type="String">operates in</Data></Cell><Cell ss:StyleID="sWrap"><Data ss:Type="String">Lane County, Oregon (Eugene, Springfield, Cottage Grove, Junction City, Creswell, Veneta, Florence, Oakridge, Coburg, Lowell)</Data></Cell></Row>
   <Row><Cell ss:StyleID="sWrap"><Data ss:Type="String">D&amp;D Land Works</Data></Cell><Cell ss:StyleID="sRel"><Data ss:Type="String">provides</Data></Cell><Cell ss:StyleID="sWrap"><Data ss:Type="String">Site Preparation</Data></Cell></Row>
   <Row><Cell ss:StyleID="sWrap"><Data ss:Type="String">Site Preparation</Data></Cell><Cell ss:StyleID="sRel"><Data ss:Type="String">uses</Data></Cell><Cell ss:StyleID="sWrap"><Data ss:Type="String">Land Clearing + Grading + Drainage + Excavation</Data></Cell></Row>
   <Row><Cell ss:StyleID="sWrap"><Data ss:Type="String">D&amp;D Land Works</Data></Cell><Cell ss:StyleID="sRel"><Data ss:Type="String">provides</Data></Cell><Cell ss:StyleID="sWrap"><Data ss:Type="String">Excavation &amp; Grading</Data></Cell></Row>
   <Row><Cell ss:StyleID="sWrap"><Data ss:Type="String">Excavation &amp; Grading</Data></Cell><Cell ss:StyleID="sRel"><Data ss:Type="String">enables</Data></Cell><Cell ss:StyleID="sWrap"><Data ss:Type="String">Foundation Excavation</Data></Cell></Row>
   <Row><Cell ss:StyleID="sWrap"><Data ss:Type="String">D&amp;D Land Works</Data></Cell><Cell ss:StyleID="sRel"><Data ss:Type="String">provides</Data></Cell><Cell ss:StyleID="sWrap"><Data ss:Type="String">Land Clearing</Data></Cell></Row>
   <Row><Cell ss:StyleID="sWrap"><Data ss:Type="String">Land Clearing</Data></Cell><Cell ss:StyleID="sRel"><Data ss:Type="String">includes</Data></Cell><Cell ss:StyleID="sWrap"><Data ss:Type="String">Brush Clearing</Data></Cell></Row>
   <Row><Cell ss:StyleID="sWrap"><Data ss:Type="String">D&amp;D Land Works</Data></Cell><Cell ss:StyleID="sRel"><Data ss:Type="String">provides</Data></Cell><Cell ss:StyleID="sWrap"><Data ss:Type="String">Grading &amp; Leveling</Data></Cell></Row>
   <Row><Cell ss:StyleID="sWrap"><Data ss:Type="String">Grading &amp; Leveling</Data></Cell><Cell ss:StyleID="sRel"><Data ss:Type="String">solves</Data></Cell><Cell ss:StyleID="sWrap"><Data ss:Type="String">Uneven land / standing water</Data></Cell></Row>
   <Row><Cell ss:StyleID="sWrap"><Data ss:Type="String">D&amp;D Land Works</Data></Cell><Cell ss:StyleID="sRel"><Data ss:Type="String">provides</Data></Cell><Cell ss:StyleID="sWrap"><Data ss:Type="String">Drainage Excavation</Data></Cell></Row>
   <Row><Cell ss:StyleID="sWrap"><Data ss:Type="String">Drainage Excavation</Data></Cell><Cell ss:StyleID="sRel"><Data ss:Type="String">solves</Data></Cell><Cell ss:StyleID="sWrap"><Data ss:Type="String">Standing water / erosion</Data></Cell></Row>
   <Row><Cell ss:StyleID="sWrap"><Data ss:Type="String">D&amp;D Land Works</Data></Cell><Cell ss:StyleID="sRel"><Data ss:Type="String">provides</Data></Cell><Cell ss:StyleID="sWrap"><Data ss:Type="String">Utility Excavation</Data></Cell></Row>
   <Row><Cell ss:StyleID="sWrap"><Data ss:Type="String">Utility Excavation</Data></Cell><Cell ss:StyleID="sRel"><Data ss:Type="String">includes</Data></Cell><Cell ss:StyleID="sWrap"><Data ss:Type="String">Trenching &amp; Backfill</Data></Cell></Row>
   <Row><Cell ss:StyleID="sWrap"><Data ss:Type="String">Utility Excavation</Data></Cell><Cell ss:StyleID="sRel"><Data ss:Type="String">is excavation FOR (not)</Data></Cell><Cell ss:StyleID="sWrap"><Data ss:Type="String">Utility installation/connection</Data></Cell></Row>
   <Row><Cell ss:StyleID="sWrap"><Data ss:Type="String">D&amp;D Land Works</Data></Cell><Cell ss:StyleID="sRel"><Data ss:Type="String">provides</Data></Cell><Cell ss:StyleID="sWrap"><Data ss:Type="String">Septic Install &amp; Repair</Data></Cell></Row>
   <Row><Cell ss:StyleID="sWrap"><Data ss:Type="String">Septic Install &amp; Repair</Data></Cell><Cell ss:StyleID="sRel"><Data ss:Type="String">includes</Data></Cell><Cell ss:StyleID="sWrap"><Data ss:Type="String">Drainfield / tank excavation</Data></Cell></Row>
   <Row><Cell ss:StyleID="sWrap"><Data ss:Type="String">D&amp;D Land Works</Data></Cell><Cell ss:StyleID="sRel"><Data ss:Type="String">provides</Data></Cell><Cell ss:StyleID="sWrap"><Data ss:Type="String">Driveway Repair</Data></Cell></Row>
   <Row><Cell ss:StyleID="sWrap"><Data ss:Type="String">Driveway Repair</Data></Cell><Cell ss:StyleID="sRel"><Data ss:Type="String">uses (gravel only)</Data></Cell><Cell ss:StyleID="sWrap"><Data ss:Type="String">Grading + Drainage</Data></Cell></Row>
   <Row><Cell ss:StyleID="sWrap"><Data ss:Type="String">D&amp;D Land Works</Data></Cell><Cell ss:StyleID="sRel"><Data ss:Type="String">provides</Data></Cell><Cell ss:StyleID="sWrap"><Data ss:Type="String">Slope Stabilization</Data></Cell></Row>
   <Row><Cell ss:StyleID="sWrap"><Data ss:Type="String">Slope Stabilization</Data></Cell><Cell ss:StyleID="sRel"><Data ss:Type="String">uses</Data></Cell><Cell ss:StyleID="sWrap"><Data ss:Type="String">Grading + Drainage + Erosion control</Data></Cell></Row>
  </Table>
  <WorksheetOptions xmlns="urn:schemas-microsoft-com:office:excel">
   <FreezePanes/>
   <FrozenNoSplit/>
   <SplitHorizontal>4</SplitHorizontal>
   <TopRowBottomPane>4</TopRowBottomPane>
   <ActivePane>2</ActivePane>
  </WorksheetOptions>
 </Worksheet>

 <!-- ============ SHEET 5: INTERNAL LINKING ============ -->
 <Worksheet ss:Name="Internal Linking">
  <Table ss:DefaultColumnWidth="90">
   <Column ss:Width="185"/>
   <Column ss:Width="360"/>
   <Column ss:Width="240"/>
   <Row ss:Height="26">
    <Cell ss:StyleID="sTitle"><Data ss:Type="String">Internal Linking Architecture</Data></Cell>
   </Row>
   <Row ss:Height="16">
    <Cell ss:StyleID="sSub"><Data ss:Type="String">Hub-and-spoke + geo + problem links. Every spoke links to its hub; every hub links down to 3+ spokes; vary anchor text (avoid exact-match stuffing).</Data></Cell>
   </Row>
   <Row/>
   <Row ss:Height="24">
    <Cell ss:StyleID="sHeader"><Data ss:Type="String">Page</Data></Cell>
    <Cell ss:StyleID="sHeader"><Data ss:Type="String">Links To</Data></Cell>
    <Cell ss:StyleID="sHeader"><Data ss:Type="String">Purpose</Data></Cell>
   </Row>
   <Row><Cell ss:StyleID="sWrap"><Data ss:Type="String">Homepage</Data></Cell><Cell ss:StyleID="sWrap"><Data ss:Type="String">Site Prep, Excavation, Grading, Land Clearing, Septic, Drainage, Utility, Driveway, Service-Areas hub, Contact</Data></Cell><Cell ss:StyleID="sWrap"><Data ss:Type="String">Entity hub distributes authority to all P0 core services + local hub</Data></Cell></Row>
   <Row><Cell ss:StyleID="sWrap"><Data ss:Type="String">Site Preparation (umbrella)</Data></Cell><Cell ss:StyleID="sWrap"><Data ss:Type="String">DOWN: Land Clearing, Grading, Foundation Excavation, Drainage · UP: Homepage · LOCAL: Eugene, Springfield</Data></Cell><Cell ss:StyleID="sWrap"><Data ss:Type="String">Umbrella service links to its component services</Data></Cell></Row>
   <Row><Cell ss:StyleID="sWrap"><Data ss:Type="String">Excavation &amp; Grading</Data></Cell><Cell ss:StyleID="sWrap"><Data ss:Type="String">UP: Home · SIBLING: Grading-Leveling, Foundation Excavation · DOWN: Utility, Drainage · LOCAL: Eugene excavation</Data></Cell><Cell ss:StyleID="sWrap"><Data ss:Type="String">Head service ties the excavation cluster together</Data></Cell></Row>
   <Row><Cell ss:StyleID="sWrap"><Data ss:Type="String">Grading &amp; Leveling</Data></Cell><Cell ss:StyleID="sWrap"><Data ss:Type="String">UP: Excavation · SIBLING: Drainage, Driveway, Slope Stabilization</Data></Cell><Cell ss:StyleID="sWrap"><Data ss:Type="String">Cross-links resolve grading/drainage overlap</Data></Cell></Row>
   <Row><Cell ss:StyleID="sWrap"><Data ss:Type="String">Land Clearing</Data></Cell><Cell ss:StyleID="sWrap"><Data ss:Type="String">UP: Home / Site Prep · DOWN: Brush Clearing (when standalone) · LOCAL: Eugene/Springfield land-clearing</Data></Cell><Cell ss:StyleID="sWrap"><Data ss:Type="String">Anchors the clearing cluster</Data></Cell></Row>
   <Row><Cell ss:StyleID="sWrap"><Data ss:Type="String">Foundation Excavation</Data></Cell><Cell ss:StyleID="sWrap"><Data ss:Type="String">UP: Excavation, Site Prep</Data></Cell><Cell ss:StyleID="sWrap"><Data ss:Type="String">Feeds builder/new-construction intent up to hubs</Data></Cell></Row>
   <Row><Cell ss:StyleID="sWrap"><Data ss:Type="String">Drainage Excavation</Data></Cell><Cell ss:StyleID="sWrap"><Data ss:Type="String">SIBLING: Grading, Slope Stabilization · SUPPORT: "fix standing water" article</Data></Cell><Cell ss:StyleID="sWrap"><Data ss:Type="String">Owns the water-management intent</Data></Cell></Row>
   <Row><Cell ss:StyleID="sWrap"><Data ss:Type="String">Utility Excavation</Data></Cell><Cell ss:StyleID="sWrap"><Data ss:Type="String">UP: Excavation · DOWN: Trenching &amp; Backfill (when standalone)</Data></Cell><Cell ss:StyleID="sWrap"><Data ss:Type="String">Holds trenching as a section until it graduates</Data></Cell></Row>
   <Row><Cell ss:StyleID="sWrap"><Data ss:Type="String">Septic Install &amp; Repair</Data></Cell><Cell ss:StyleID="sWrap"><Data ss:Type="String">UP: Home · LOCAL: Eugene/Springfield septic · SUPPORT: "Oregon septic basics"</Data></Cell><Cell ss:StyleID="sWrap"><Data ss:Type="String">DEQ cluster hub; informational feeds it</Data></Cell></Row>
   <Row><Cell ss:StyleID="sWrap"><Data ss:Type="String">Driveway Repair</Data></Cell><Cell ss:StyleID="sWrap"><Data ss:Type="String">SIBLING: Grading, Drainage</Data></Cell><Cell ss:StyleID="sWrap"><Data ss:Type="String">Shares earthwork context with grading/drainage</Data></Cell></Row>
   <Row><Cell ss:StyleID="sWrap"><Data ss:Type="String">Slope Stabilization</Data></Cell><Cell ss:StyleID="sWrap"><Data ss:Type="String">SIBLING: Grading, Drainage</Data></Cell><Cell ss:StyleID="sWrap"><Data ss:Type="String">Erosion/earthwork context</Data></Cell></Row>
   <Row><Cell ss:StyleID="sWrap"><Data ss:Type="String">Commercial Excavation</Data></Cell><Cell ss:StyleID="sWrap"><Data ss:Type="String">Each core service (commercial section) + Contact</Data></Cell><Cell ss:StyleID="sWrap"><Data ss:Type="String">Audience hub routes developers to services</Data></Cell></Row>
   <Row><Cell ss:StyleID="sWrap"><Data ss:Type="String">Service-Areas hub</Data></Cell><Cell ss:StyleID="sWrap"><Data ss:Type="String">Lane County + every city page</Data></Cell><Cell ss:StyleID="sWrap"><Data ss:Type="String">Geo hub distributes to all locations</Data></Cell></Row>
   <Row><Cell ss:StyleID="sWrap"><Data ss:Type="String">Lane County page</Data></Cell><Cell ss:StyleID="sWrap"><Data ss:Type="String">All city pages</Data></Cell><Cell ss:StyleID="sWrap"><Data ss:Type="String">County anchor links down to cities</Data></Cell></Row>
   <Row><Cell ss:StyleID="sWrap"><Data ss:Type="String">City page (e.g. Eugene)</Data></Cell><Cell ss:StyleID="sWrap"><Data ss:Type="String">Services offered there + adjacent city (Springfield) + its city×service pages</Data></Cell><Cell ss:StyleID="sWrap"><Data ss:Type="String">Eugene↔Springfield; Creswell↔Cottage Grove adjacency</Data></Cell></Row>
   <Row><Cell ss:StyleID="sWrap"><Data ss:Type="String">City × Service page</Data></Cell><Cell ss:StyleID="sWrap"><Data ss:Type="String">Parent city page + parent service page (BOTH directions)</Data></Cell><Cell ss:StyleID="sFence"><Data ss:Type="String">Critical: this is what stops city×service pages becoming orphaned doorways</Data></Cell></Row>
   <Row><Cell ss:StyleID="sWrap"><Data ss:Type="String">Cost / info article</Data></Cell><Cell ss:StyleID="sWrap"><Data ss:Type="String">The commercial service page it supports (e.g. excavation cost → /excavation/; standing water → /drainage-excavation/)</Data></Cell><Cell ss:StyleID="sWrap"><Data ss:Type="String">Informational passes equity to money pages</Data></Cell></Row>
   <Row><Cell ss:StyleID="sWrap"><Data ss:Type="String">General rule (every service page)</Data></Cell><Cell ss:StyleID="sWrap"><Data ss:Type="String">Its hub + 1-2 siblings + most relevant city×service + Contact</Data></Cell><Cell ss:StyleID="sWrap"><Data ss:Type="String">Reinforces topical relationships, not random links</Data></Cell></Row>
  </Table>
  <WorksheetOptions xmlns="urn:schemas-microsoft-com:office:excel">
   <FreezePanes/>
   <FrozenNoSplit/>
   <SplitHorizontal>4</SplitHorizontal>
   <TopRowBottomPane>4</TopRowBottomPane>
   <ActivePane>2</ActivePane>
  </WorksheetOptions>
 </Worksheet>

 <!-- ============ SHEET 6: PUBLISHING ROADMAP ============ -->
 <Worksheet ss:Name="Publishing Roadmap">
  <Table ss:DefaultColumnWidth="90">
   <Column ss:Width="150"/>
   <Column ss:Width="450"/>
   <Column ss:Width="260"/>
   <Row ss:Height="26">
    <Cell ss:StyleID="sTitle"><Data ss:Type="String">Content Publishing Roadmap</Data></Cell>
   </Row>
   <Row/>
   <Row ss:Height="24">
    <Cell ss:StyleID="sHeader"><Data ss:Type="String">Phase</Data></Cell>
    <Cell ss:StyleID="sHeader"><Data ss:Type="String">Pages</Data></Cell>
    <Cell ss:StyleID="sHeader"><Data ss:Type="String">Reason</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="sPhase"><Data ss:Type="String">Phase 1 (wk 1-4)</Data></Cell>
    <Cell ss:StyleID="sWrap"><Data ss:Type="String">Homepage, Site Preparation, Excavation &amp; Grading, Grading &amp; Leveling, Land Clearing, Septic, Foundation Excavation, Drainage, Utility Excavation, Driveway Repair, Contact, About, Commercial, Service-Areas hub, Lane County</Data></Cell>
    <Cell ss:StyleID="sWrap"><Data ss:Type="String">Establishes the central entity and captures highest-intent commercial demand. Parents before children.</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="sPhase"><Data ss:Type="String">Phase 2 (wk 4-7)</Data></Cell>
    <Cell ss:StyleID="sWrap"><Data ss:Type="String">Eugene city page + Eugene x (Excavation, Land Clearing, Septic); Springfield city page + Springfield x (Septic, Land Clearing, Excavation)</Data></Cell>
    <Cell ss:StyleID="sWrap"><Data ss:Type="String">Exploit the competitor city-page gap in the two biggest markets.</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="sPhase"><Data ss:Type="String">Phase 3 (wk 7-10)</Data></Cell>
    <Cell ss:StyleID="sWrap"><Data ss:Type="String">Cottage Grove, Junction City, Creswell, Veneta (city-only); add Eugene x (Grading, Drainage) + Springfield city x service if Phase 2 performs; Slope Stabilization</Data></Cell>
    <Cell ss:StyleID="sWrap"><Data ss:Type="String">Widen the county footprint where competition is thinner.</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="sPhase"><Data ss:Type="String">Phase 4 (wk 10-12)</Data></Cell>
    <Cell ss:StyleID="sWrap"><Data ss:Type="String">Florence (confirm), Oakridge, Coburg, Lowell city pages - only where coverage verified</Data></Cell>
    <Cell ss:StyleID="sWrap"><Data ss:Type="String">Complete honest coverage; skip anything that would be a doorway page.</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="sPhase"><Data ss:Type="String">Phase 5 (ongoing)</Data></Cell>
    <Cell ss:StyleID="sWrap"><Data ss:Type="String">Cost guides, problem/solution + hiring articles, FAQ, graduate Brush Clearing &amp; Trenching/Backfill to standalone pages, projects/gallery, reviews</Data></Cell>
    <Cell ss:StyleID="sWrap"><Data ss:Type="String">Deepen topical authority and feed internal links to money pages.</Data></Cell>
   </Row>
   <Row/>
   <Row>
    <Cell ss:StyleID="sFence"><Data ss:Type="String">Every phase: publish parent before child · run all AI drafts through humanizer before shipping · default CMS to draft until reviewed.</Data></Cell>
   </Row>
  </Table>
 </Worksheet>

 <!-- ============ SHEET 7: SCOPE & OPEN ITEMS ============ -->
 <Worksheet ss:Name="Scope &amp; Open Items">
  <Table ss:DefaultColumnWidth="90">
   <Column ss:Width="300"/>
   <Column ss:Width="360"/>
   <Row ss:Height="26">
    <Cell ss:StyleID="sTitle"><Data ss:Type="String">Scope, Do-Not-Claim &amp; Open Items</Data></Cell>
   </Row>

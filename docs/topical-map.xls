   </Row>
   <Row>
    <Cell ss:StyleID="sWrap"><Data ss:Type="String">Site Preparation (/site-preparation/)</Data></Cell>
    <Cell ss:StyleID="sWrap"><Data ss:Type="String">Construction site preparation</Data></Cell>
    <Cell ss:StyleID="sWrap"><Data ss:Type="String">Commercial</Data></Cell>
    <Cell ss:StyleID="sWrap"><Data ss:Type="String">Residential/commercial site prep, lot/pad prep, clear-grade-drain sequence, access prep, construction-ready land</Data></Cell>
    <Cell ss:StyleID="sWrap"><Data ss:Type="String">No permitting/engineering guarantees</Data></Cell>

{
  "skill_name": "google-ads-copy",
  "evals": [
    {
      "id": 0,
      "name": "emergency-rsa-pack",
      "prompt": "Write me the complete creative pack for the Emergency AC Repair campaign at 75 Degree AC. Business details: phone (713) 598-2737, license TACLA72152E, Houston HVAC contractor founded in 2016, serves Houston + Katy + Sugar Land + Cypress + Richmond TX. I need: full RSA — 15 headlines (categorized by formula), 4 descriptions, plus all extensions: 8+ callouts, 4+ sitelinks with text/URL/2 descriptions each, structured snippets, call asset config, location asset config, image asset spec, and a recommended display URL path. Headlines must respect 30-char limit, descriptions 90-char.",
      "files": [],
      "assertions": [
        {"name": "produces_exactly_15_headlines", "check": "regex_count", "pattern": "(?im)^\\s*(?:H\\d+|\\d+[.):]?\\s|\\|\\s*\\d+\\s*\\|)", "min": 15},
        {"name": "produces_4_descriptions", "check": "regex_count", "pattern": "(?im)^\\s*(?:D\\d+|Description\\s*\\d+|\\|\\s*D\\d|\\b[Dd]escription\\s*\\d+)", "min": 4},
        {"name": "headlines_categorized_by_formula", "check": "regex_count", "pattern": "(?im)keyword|symptom|trust|cta|usp|offer|finance", "min": 5},
        {"name": "lists_at_least_8_callouts", "check": "regex_count", "pattern": "(?im)same.day|free\\s*estimat|licensed|insured|24/7|emergency|financing|since\\s*2016|first\\s*visit|all\\s*major\\s*brands|tacla|five.star|reviews|stocked", "min": 8},
        {"name": "lists_at_least_4_sitelinks", "check": "regex_count", "pattern": "(?im)/(?:ac-repair|ac-installation|ac-tune-up|maintenance|emergency|about|service-areas|booking|contact)", "min": 4},
        {"name": "includes_phone_in_call_asset_only", "check": "regex_ci", "pattern": "call\\s*asset|call\\s*extension"},
        {"name": "phone_number_present_713_598_2737", "check": "regex", "pattern": "\\(?713\\)?\\s*[-.]?\\s*598\\s*[-.]?\\s*2737"},
        {"name": "tacla_license_referenced", "check": "regex_ci", "pattern": "tacla(?:72152e)?|licensed"},
        {"name": "structured_snippets_present", "check": "regex_ci", "pattern": "structured\\s*snippets?"},
        {"name": "location_asset_referenced", "check": "regex_ci", "pattern": "location\\s*asset|gbp.*link|google\\s*business\\s*profile"},
        {"name": "image_assets_referenced", "check": "regex_ci", "pattern": "image\\s*assets?|technician\\s*photo|service\\s*van|action\\s*shot"},
        {"name": "specifies_display_url_path", "check": "regex_ci", "pattern": "(?:display\\s*)?(?:url\\s*)?path|emergency-ac-repair|/Emergency"},
        {"name": "headlines_under_30_chars_acknowledged", "check": "regex_ci", "pattern": "30\\s*char|character\\s*limit"},
        {"name": "discusses_pinning_strategy", "check": "regex_ci", "pattern": "pin(?:ning)?|pos(?:ition)?\\s*[12]"},
        {"name": "houston_in_at_least_one_headline", "check": "regex_ci", "pattern": "houston"}
      ]
    },
    {
      "id": 1,
      "name": "landing-and-tracking-audit",
      "prompt": "Audit this ad → landing page → conversion tracking flow for the Emergency campaign at 75 Degree AC. Tell me what's broken, the priority order to fix, the expected QS / CPC impact of each, and exact what-to-do steps for the conversion tracking issues.\n\nAd headlines:\n- H1: 'Emergency AC Repair Houston'\n- H2: 'Same-Day Service · Call 24/7'\n- H3: 'Licensed Houston HVAC'\n\nLanding page:\n- URL: /emergency-ac-repair/\n- H1: 'Welcome to 75 Degree AC – Houston's Trusted HVAC Partner'\n- Phone: in footer only, no header phone or sticky button\n- Form: 7 fields (name, email, phone, address, service type, preferred time, message)\n- Trust: no review count visible above the fold\n- LCP on mobile: 4.2s\n\nConversion tracking:\n- Only 'form submission' counted as a conversion\n- No call tracking (CallRail not installed)\n- Attribution model: last-click\n- Click-through window: 90 days\n- Conversion count setting: Every (not One)\n- No Enhanced Conversions for Leads",
      "files": [],
      "assertions": [
        {"name": "flags_h1_message_match_problem", "check": "regex_ci", "pattern": "h1.*(?:doesn.?t|does\\s*not|fails\\s*to|not).*match|message\\s*match|h1.*welcome"},
        {"name": "flags_phone_in_footer_only", "check": "regex_ci", "pattern": "phone.*(?:footer|hero|header|sticky|prominent|visible)"},
        {"name": "flags_form_too_many_fields", "check": "regex_ci", "pattern": "(?:7|seven|too\\s*many).*fields?|form.*(?:friction|long|reduce)"},
        {"name": "flags_lcp_too_slow", "check": "regex_ci", "pattern": "(?:lcp|page\\s*speed|load).*(?:4\\.2|too\\s*slow|fix|2\\.5)|core\\s*web\\s*vitals"},
        {"name": "flags_no_call_tracking", "check": "regex_ci", "pattern": "callrail|call\\s*tracking|no\\s*phone\\s*tracking|install\\s*callrail"},
        {"name": "flags_count_every_setting", "check": "regex_ci", "pattern": "count.*one|count.*every|count\\s*setting|conversion\\s*count"},
        {"name": "flags_90_day_window_too_long", "check": "regex_ci", "pattern": "90\\s*day|click[\\s-]*through\\s*window|attribution\\s*window|30\\s*day"},
        {"name": "recommends_enhanced_conversions", "check": "regex_ci", "pattern": "enhanced\\s*conversions|enhanced.*leads"},
        {"name": "recommends_data_driven_attribution", "check": "regex_ci", "pattern": "data[-\\s]*driven|attribution\\s*model"},
        {"name": "produces_priority_order", "check": "regex_ci", "pattern": "priority|p0|p1|p2|first|step\\s*1|order|critical"},
        {"name": "names_qs_or_cpc_impact", "check": "regex_ci", "pattern": "(?:quality\\s*score|qs).*(?:improve|drop|impact|lift)|cpc\\s*(?:reduction|drop|down|save)|landing\\s*page\\s*experience"},
        {"name": "flags_review_count_missing", "check": "regex_ci", "pattern": "review\\s*count|trust\\s*signal|aggregaterating|five.star"},
        {"name": "addresses_minimum_call_duration", "check": "regex_ci", "pattern": "60\\s*sec|minimum\\s*call|call\\s*duration"},
        {"name": "specific_h1_rewrite_or_recommendation", "check": "regex_ci", "pattern": "(?:rewrite|change|update).*h1|h1.*(?:should|recommend|change\\s*to)|emergency\\s*ac\\s*repair\\s*houston"}
      ]
    }
  ]
}
